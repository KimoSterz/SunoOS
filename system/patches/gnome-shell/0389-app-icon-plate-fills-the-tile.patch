diff --git a/js/ui/SunoAppIconPlate.js b/js/ui/SunoAppIconPlate.js
new file mode 100644
index 0000000..114890d
--- /dev/null
+++ b/js/ui/SunoAppIconPlate.js
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The SunoUI app-icon plate. A v4 Suno app icon draws its plate as a
+// rounded square centred on its canvas, 860 on 1024: an icon drawn at a
+// tile's size shows its plate 84% as large, inside a transparent margin.
+// The Shell draws such an icon at the plate's scale, so the plate fills the
+// tile and the tile's clip takes the margin. An icon without a plate (a
+// raster, an older or third-party icon, anything this cannot read) is drawn
+// at the tile's size on a plate the Shell draws behind it, never cropped.
+//
+// Pure: Gio only, so the build's %check runs it without a display.
+import Gio from 'gi://Gio';
+
+// A plate smaller than this share of the canvas is art, not a plate.
+const MIN_PLATE_SHARE = 0.6;
+const DRAWN = /<(rect|path|circle|ellipse|polygon|polyline|line|image|use|text)\b[^>]*>/;
+
+function attr(tag, name) {
+    const match = tag.match(new RegExp(`\\s${name}\\s*=\\s*["']\\s*(-?[\\d.]+)(px)?\\s*["']`));
+    return match ? Number(match[1]) : NaN;
+}
+
+// The scale at which the SVG's plate covers its canvas (1024/860 for a v4
+// icon on its full canvas, 1 for one already cropped to its plate), or null
+// when the first thing it draws is not a rounded square centred on a square
+// canvas.
+export function plateScaleFromSvg(text) {
+    const svg = text.match(/<svg\b[^>]*>/)?.[0];
+    if (!svg)
+        return null;
+    let box = svg.match(/\sviewBox\s*=\s*["']([^"']+)["']/)?.[1]?.trim().split(/[\s,]+/).map(Number);
+    if (!box || box.length !== 4 || box.some(Number.isNaN))
+        box = [0, 0, attr(svg, 'width'), attr(svg, 'height')];
+    const [bx, by, bw, bh] = box;
+    if (!(bw > 0) || Math.abs(bw - bh) > 0.5)
+        return null;
+    const body = text.slice(text.indexOf(svg) + svg.length)
+        .replace(/<defs\b[\s\S]*?<\/defs>/g, '')
+        .replace(/<(clipPath|mask|pattern|symbol)\b[\s\S]*?<\/\1>/g, '');
+    const first = body.match(DRAWN);
+    if (!first || first[1] !== 'rect')
+        return null;
+    const rect = first[0];
+    const x = attr(rect, 'x') || 0, y = attr(rect, 'y') || 0;
+    const w = attr(rect, 'width'), h = attr(rect, 'height'), rx = attr(rect, 'rx');
+    if (!(w > 0) || Math.abs(w - h) > 0.5 || !(rx > 0))
+        return null;
+    if (w < MIN_PLATE_SHARE * bw || w > bw + 0.5)
+        return null;
+    if (Math.abs(x + w / 2 - (bx + bw / 2)) > 0.5 || Math.abs(y + h / 2 - (by + bh / 2)) > 0.5)
+        return null;
+    return bw / w;
+}
+
+const cache = new Map();
+
+// plateScaleFromSvg for an icon file, read once per path and modification
+// time. Anything but a readable .svg has no plate.
+export function plateScaleForFile(path) {
+    if (!path)
+        return null;
+    const file = Gio.File.new_for_path(path);
+    let stamp;
+    try {
+        const info = file.query_info('time::modified,time::modified-usec',
+            Gio.FileQueryInfoFlags.NONE, null);
+        stamp = `${info.get_attribute_uint64('time::modified')}.${info.get_attribute_uint32('time::modified-usec')}`;
+    } catch {
+        return null;
+    }
+    const hit = cache.get(path);
+    if (hit?.stamp === stamp)
+        return hit.scale;
+    let scale = null;
+    if (/\.svg$/i.test(path)) {
+        try {
+            const [, bytes] = file.load_contents(null);
+            scale = plateScaleFromSvg(new TextDecoder().decode(bytes));
+        } catch {
+            scale = null;
+        }
+    }
+    cache.set(path, {stamp, scale});
+    return scale;
+}
+
+// The size to render an icon's texture at so its plate is at least `size`
+// pixels across (size x scale, rounded up to size's parity).
+export function platedIconSize(size, scale) {
+    if (!(scale > 1))
+        return size;
+    return size + 2 * Math.ceil((size * scale - size) / 2 - 1e-9);
+}
