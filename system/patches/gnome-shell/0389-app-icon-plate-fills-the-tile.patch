+
+// Draws an app icon so a plate fills its clip, the masked tile it sits in:
+// an icon with a plate at the plate's scale (the clip takes the margin
+// around it), any other at the clip's size on the plate the clip draws
+// (Suno-app-icon-plate). size is the tile's in logical pixels; without it the
+// icon's own CSS icon-size is the tile's.
+export function syncAppIconPlate(icon, clip, size = null) {
+    let base = size;
+    if (base === null) {
+        if (!icon.get_stage())
+            return;
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        base = Math.round(icon.get_theme_node().get_length('icon-size') / scale);
+    }
+    const plate = icon.gicon ? appIconPlateScale(icon.gicon) : null;
+    const want = plate === null ? base : platedIconSize(base, plate);
+    if (icon.icon_size !== want)
+        icon.icon_size = want;
+    // A layout gives a child no more than the clip; negative margins let the
+    // icon take its full size, centred, for the clip to crop.
+    setOverhang(icon, plate ?? 1);
+    if (plate === null && icon.gicon)
+        clip.add_style_class_name('Suno-app-icon-plate');
+    else
+        clip.remove_style_class_name('Suno-app-icon-plate');
+}
+
+// Lets an icon take its CSS size and its clip no plate again (a glyph or a
+// picture in the same tile).
+export function clearAppIconPlate(icon, clip) {
+    if (icon.icon_size !== -1)
+        icon.icon_size = -1;
+    setOverhang(icon, 1);
+    clip.remove_style_class_name('Suno-app-icon-plate');
+}
