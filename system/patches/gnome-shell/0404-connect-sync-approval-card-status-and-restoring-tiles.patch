+// SPDX-License-Identifier: GPL-2.0-or-later
+// What Luma Connect Sync shows in the Shell, without a Shell: the status
+// cell and its popover, the banners, the approval card's words and the
+// restoring tile. No gi imports, so %check runs it under plain gjs.
+// Design: design-center 38858a5, mockups/connect-sync (cs.js STATES).
+// Behaviour: ADR-054; data: org.projectluma.ConnectSync1 GetState,
+// ListJoinRequests and GetRestore (luma-connect-sync).
+
+// Glyphs (data/icons/scalable/status/luma-sync-*-symbolic.svg, Lucide).
+export const ICON = Object.freeze({
+    cloud: 'luma-sync-cloud-symbolic',
+    'cloud-off': 'luma-sync-cloud-off-symbolic',
+    'cloud-alert': 'luma-sync-cloud-alert-symbolic',
+    'refresh-cw': 'luma-sync-refresh-cw-symbolic',
+    laptop: 'luma-sync-laptop-symbolic',
+    smartphone: 'luma-sync-smartphone-symbolic',
+    tv: 'luma-sync-tv-symbolic',
+    'key-round': 'luma-sync-key-round-symbolic',
+    'loader-circle': 'luma-sync-loader-circle-symbolic',
+});
+
+// Tones: cs.css --cs-ok, --cs-warn, --cs-bad.
+export const TONE = Object.freeze({ok: 'ok', warn: 'warn', bad: 'bad', none: ''});
+
+export const SOURCE = 'Luma Connect';
+export const POPOVER_TITLE = 'Luma Connect';
+export const SETTINGS_LINK = 'Sync settings';
+
+// Settings' routes (gnome-control-center 0111): launch-panel ('users', [...]).
+export const ROUTE = Object.freeze({
+    settings: ['sync'],
+    join: ['sync', 'join'],
+    newKey: ['sync', 'newkey'],
+});
+
+// What each action does: a method on the service, a Settings route, or an
+// app. Show versions opens the app's versions page (Settings › Sync › App).
+export const ACTION = Object.freeze({
+    'Sync now': {method: 'SyncNow'},
+    'Show versions': {route: ['sync', 'versions']},
+    'Manage storage': {route: ROUTE.settings},
+    'Sign in again': {app: 'org.projectluma.Connect.desktop'},
+    // Settings asks for the password (polkit) and shows the new words, with their tick and Done.
+    'Show new key…': {route: ROUTE.newKey},
+});
+
+// The route or app an action of a popover opens; `subject` is the app a
+// conflict names (Show versions) or the device a banner names (Remove…).
+export function actionTarget(action, subject = null) {
+    const what = ACTION[action];
+    if (!what)
+        return null;
+    if (what.route && subject && action === 'Show versions')
+        return {route: [...what.route, subject]};
+    return what;
+}
+
+const DAY = 86400;
+
+// "today", "yesterday", else "21 Nov".
+export function day(at, now) {
+    if (!at)
+        return '';
+    const start = d => {
+        const t = new Date(d * 1000);
+        return new Date(t.getFullYear(), t.getMonth(), t.getDate()).getTime() / 1000;
+    };
+    const days = Math.round((start(now) - start(at)) / DAY);
+    if (days <= 0)
+        return 'today';
+    if (days === 1)
+        return 'yesterday';
+    const t = new Date(at * 1000);
+    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+    return `${t.getDate()} ${months[t.getMonth()]}`;
+}
+
+// "Synced 2 minutes ago" (cs.js done).
+export function ago(at, now) {
+    if (!at)
+        return '';
+    const seconds = Math.max(0, now - at);
+    if (seconds < 60)
+        return 'Synced just now';
+    const minutes = Math.floor(seconds / 60);
+    if (minutes < 60)
+        return `Synced ${minutes} ${minutes === 1 ? 'minute' : 'minutes'} ago`;
+    const hours = Math.floor(minutes / 60);
+    if (hours < 24)
+        return `Synced ${hours} ${hours === 1 ? 'hour' : 'hours'} ago`;
+    const when = day(at, now);
+    return `Synced ${when}`;
+}
+
+// 5368709120 -> "5 GB", 1932735283 -> "1.8 GB", 35651584 -> "34 MB".
+export function size(bytes) {
+    const n = Number(bytes) || 0;
+    const units = [['GB', 1024 ** 3], ['MB', 1024 ** 2], ['KB', 1024]];
+    for (const [unit, scale] of units) {
+        if (n >= scale) {
+            const value = n / scale;
+            const text = value >= 10 || Number.isInteger(value) ? Math.round(value).toString()
+                : (Math.round(value * 10) / 10).toString();
+            return `${text} ${unit}`;
+        }
+    }
+    return `${n} bytes`;
+}
+
+// Which state the Shell shows for GetState, or null when it shows nothing.
+// Off, joining and up to date show nothing; the person turning Sync off
+// ("paused" with enabled false) is not something to say either.
+export function kind(state) {
+    if (!state || state.enabled === false)
+        return null;
+    switch (state.state) {
+    case 'syncing':
+        return 'syncing';
+    case 'paused':
+        return 'paused';
+    case 'attention': {
+        const reason = state.attention?.reason;
+        if (reason === 'new_recovery_key')
+            return 'newkey';
+        return ['conflict', 'quota', 'revoked'].includes(reason) ? reason : null;
+    }
+    default:
+        return null;
+    }
+}
+
+// The cell: visible only when there's something to say.
+export function cell(state) {
+    const k = kind(state);
+    if (!k)
+        return {visible: false};
+    const view = popover(state, 0);
+    return {visible: true, icon: view.icon, tone: view.tone, title: view.title};
+}
+
+// The popover (cs.js pop()): state tile, title, subline, progress while
+// syncing, one sentence when there's something to know, at most one action.
+// `done` is drawn for the reference; the cell is never shown for it.
+export function popover(state, now) {
+    const a = state?.attention ?? {};
+    const k = state?.state === 'up_to_date' ? 'done' : kind(state);
+    switch (k) {
+    case 'syncing': {
+        const p = state?.progress ?? null;
+        const left = p && p.left != null ? `${size(p.left)} left` : '';
+        const from = p?.from ? `from ${p.from}` : '';
+        const sub = [left, from].filter(Boolean).join(' · ') || (state?.detail ?? '');
+        return {kind: k, icon: ICON['refresh-cw'], tone: TONE.none, title: 'Syncing', sub,
+            progress: p && p.fraction != null ? Math.max(0, Math.min(1, p.fraction)) : null,
+            message: '', action: null};
+    }
+    case 'done':
+        return {kind: k, icon: ICON.cloud, tone: TONE.ok, title: 'Up to date', sub: ago(state?.last_sync, now),
+            progress: null, message: '', action: null};
+    case 'paused':
+        return {kind: k, icon: ICON['cloud-off'], tone: TONE.none, title: 'Paused',
+            sub: state?.metered ? 'On a metered connection' : 'Offline', progress: null, message: '',
+            action: 'Sync now'};
+    case 'conflict': {
+        const from = a.from ?? 'your other device';
+        return {kind: k, icon: ICON['cloud-alert'], tone: TONE.warn, title: a.detail || 'Changed on two devices',
+            subject: a.app ?? null,
+            sub: `Kept both · ${day(a.at, now) || 'today'}`,
+            progress: null,
+            message: `This device’s copy is in use. The copy from ${from} is kept for 30 days.`,
+            action: 'Show versions'};
+    }
+    case 'quota': {
+        const quota = a.quota ?? state?.storage?.quota;
+        const used = a.used ?? state?.storage?.used ?? quota;
+        return {kind: k, icon: ICON['cloud-alert'], tone: TONE.warn, title: 'Storage full',
+            sub: quota ? `${size(used)} of ${size(quota)}` : '',
+            progress: null, message: 'New changes stay on this device until there’s room.',
+            action: 'Manage storage'};
+    }
+    case 'revoked': {
+        const when = day(a.at, now) || 'today';
+        return {kind: k, icon: ICON['cloud-off'], tone: TONE.bad, title: 'Removed from Sync',
+            sub: a.by ? `On ${a.by} · ${when}` : `${when[0].toUpperCase()}${when.slice(1)}`,
+            progress: null,
+            message: 'This device no longer syncs. Everything on it stays. Sign in to Luma Connect again to rejoin.',
+            action: 'Sign in again'};
+    }
+    case 'newkey':
+        // S1: never silent; shown until the person keeps the new words (AcknowledgeRecoveryKey).
+        return {kind: k, icon: ICON['key-round'], tone: TONE.warn, title: 'New recovery key',
+            sub: 'Your old words stopped working', progress: null,
+            message: 'A device was removed from Sync, so your recovery key was replaced. Write down the new words.',
+            action: 'Show new key…'};
+    default:
+        return null;
+    }
+}
+
+// Banners: quota full and removed post one standard banner each when the
+// state is entered; conflicts never do (they resolve on their own).
+export function banner(previous, state) {
+    const k = kind(state);
+    if ((k !== 'quota' && k !== 'revoked') || kind(previous) === k)
+        return null;
+    const view = popover(state, 0);
+    return {kind: k, source: SOURCE, title: view.title, body: view.message, action: view.action};
+}
+
+// A device joined with the recovery key (RecoveryJoined): no card, as
+// nothing waits on it; one banner on every syncing device that stays in the
+// list until it is answered. Remove… opens Settings' Remove confirm.
+export function keyJoinBanner(device, name) {
+    return {
+        kind: 'keyjoin', source: SOURCE, device,
+        title: `${name || 'A device'} joined with your recovery key`,
+        body: 'If this wasn’t you, remove it now.',
+        actions: ['Remove…', 'It was me'],
+        route: ['sync', 'remove', device],
+    };
+}
+
+// ── The approval card ───────────────────────────────────────────────────
+const CLASS = Object.freeze({
+    computer: {icon: ICON.laptop, word: 'Computer', noun: 'computer'},
+    handheld: {icon: ICON.smartphone, word: 'Handheld', noun: 'phone'},
+    tv: {icon: ICON.tv, word: 'TV', noun: 'TV'},
+});
+
+export function deviceClass(name) {
+    return CLASS[name] ?? CLASS.computer;
+}
+
+// Two groups of three: "418207" -> ["418", "207"].
+export function codeGroups(code) {
+    const digits = `${code ?? ''}`.replace(/\D/g, '');
+    return digits.length === 6 ? [digits.slice(0, 3), digits.slice(3)] : [];
+}
+
+// A device asking to join (ListJoinRequests row / JoinRequested).
+export function card(request) {
+    const c = deviceClass(request.class);
+    const name = request.name || 'device';
+    const code = codeGroups(request.code);
+    // B3: the card comes as soon as this device answers, before the code exists; Approve waits for it.
+    const early = code.length === 0;
+    return {
+        id: request.id, icon: c.icon, source: SOURCE,
+        title: `Approve ${name}?`,
+        sub: `${c.word} · wants to sync with your devices`,
+        body: early
+            ? `Its code appears here in a moment. Only approve if the ${name} shows the same code.`
+            : `Only approve if the ${name} shows this code. It will get your passwords, apps and settings.`,
+        code, early, waiting: 'Waiting for its code',
+        buttons: ['Not me', 'Approve'],
+        // On a TV the remote's focus starts on Not me: an OK pressed by
+        // habit never lets a device in.
+        focus: 0,
+    };
+}
+
+// The cards on screen after a change: requests the service lists stay until
+// answered (here or on another device: JoinCleared); nothing times out.
+export function cards(current, listed) {
+    const ids = new Set(listed.map(r => r.id));
+    const kept = current.filter(c => ids.has(c.id));
+    for (const r of listed)
+        if (!kept.some(c => c.id === r.id) && !r.tampered && !r.held)
+            kept.push(r);
+    return kept;
+}
+
+// ── Restoring apps ─────────────────────────────────────────────────────
+// GetRestore rows: {app, name, kind, state: installing|restoring|waiting|
+// ready|unavailable|failed|offered, progress}.
+export const RESTORING = new Set(['installing', 'restoring', 'waiting']);
+
+// The service names apps by Flatpak or store ID; the Shell by desktop file.
+export function appIdForDesktop(desktopId) {
+    return `${desktopId ?? ''}`.replace(/\.desktop$/, '');
+}
+
+export function tile(row) {
+    if (!row || !RESTORING.has(row.state))
+        return null;
+    const fraction = typeof row.progress === 'number' ? row.progress
+        : row.progress && row.progress.total ? row.progress.done / row.progress.total : 0;
+    return {
+        opacity: Math.round(0.55 * 255),
+        saturation: 0.5,
+        ring: Math.max(0, Math.min(1, fraction > 1 ? fraction / 100 : fraction)),
+        caption: 'Restoring…',
+        // Opening it before it's ready shows its row in Valet, not a broken launch.
+        launch: ['luma-installer', '--restore', row.app],
+    };
+}
+
+// Valet opens on its own once, when rows first appear after a join.
+export function openValet(previousRows, rows) {
+    const busy = r => (r ?? []).some(row => RESTORING.has(row.state));
+    return !busy(previousRows) && busy(rows) && (previousRows ?? []).length === 0;
+}
diff --git a/js/ui/lumaConnectSyncRestore.js b/js/ui/lumaConnectSyncRestore.js
new file mode 100644
index 0000000..f90fceb
--- /dev/null
+++ b/js/ui/lumaConnectSyncRestore.js
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// An app still restoring from the person's other devices (ADR-054 §6,
+// design-center 38858a5 restore.html .cs-tile): its launcher and dock tile
+// at 55% opacity and saturation 0.5, a 3 px progress ring in the accent and
+// "Restoring…" under its name. Opening it shows its row in Valet instead of
+// a launch that would find no data. lumaConnectSync.js feeds the rows from
+// org.projectluma.ConnectSync1 GetRestore.
+import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
+import Graphene from 'gi://Graphene';
+import St from 'gi://St';
+
+import * as Model from './lumaConnectSyncModel.js';
+
+const _rows = new Map();
+// cs.css .cs-ring: a 74 px ring around a 64 px icon.
+const RING_SCALE = 74 / 64;
+
+// rows: GetRestore.
+export function setRows(rows) {
+    _rows.clear();
+    for (const row of rows ?? [])
+        _rows.set(row.app, row);
+    for (const tile of [..._tiles])
+        sync(tile);
+}
+
+export function tileFor(app) {
+    return Model.tile(_rows.get(Model.appIdForDesktop(app?.get_id?.())));
+}
+
+export function tileForId(appId) {
+    return Model.tile(_rows.get(appId));
+}
+
+// AppIcon.activate: true when the app is restoring and Valet was asked
+// to show it instead.
+export function redirect(app) {
+    const view = tileFor(app);
+    if (!view)
+        return false;
+    try {
+        GLib.spawn_async(null, view.launch, null, GLib.SpawnFlags.SEARCH_PATH, null);
+    } catch (e) {
+        logError(e, 'Could not show the app in Valet');
+    }
+    return true;
+}
+
+function drawRing(area, fraction) {
+    const cr = area.get_context();
+    const [w, h] = area.get_surface_size();
+    const node = area.get_theme_node();
+    const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+    // Drawn at the artwork's size and scaled out by RING_SCALE (layout stays put).
+    const width = 3 * scale / RING_SCALE;
+    const r = Math.min(w, h) / 2 - width / 2;
+    cr.setLineWidth(width);
+    cr.setSourceRGBA(1, 1, 1, 0.15);
+    cr.arc(w / 2, h / 2, r, 0, 2 * Math.PI);
+    cr.stroke();
+    if (fraction > 0) {
+        const c = node.get_foreground_color();
+        cr.setSourceRGBA(c.red / 255, c.green / 255, c.blue / 255, c.alpha / 255);
+        cr.setLineCap(1 /* ROUND */);
+        cr.arc(w / 2, h / 2, r, -Math.PI / 2, -Math.PI / 2 + 2 * Math.PI * fraction);
+        cr.stroke();
+    }
+    cr.$dispose();
+}
+
+// The tile's look follows its row: called on attach and on every change.
+// A tile is {owner, app, artwork, captionBox}: the actor whose life it
+// shares, the Shell.App, the icon artwork to dim and ring, and the vertical
+// box that takes "Restoring…" under the name (null where there is no name).
+function sync(tile) {
+    const view = tileFor(tile.app);
+    const artwork = tile.artwork;
+    let state = tile.state;
+    if (!view) {
+        if (state) {
+            artwork.opacity = 255;
+            artwork.remove_effect_by_name('luma-restore-desaturate');
+            state.ring.destroy();
+            state.caption?.destroy();
+            tile.state = null;
+        }
+        return;
+    }
+    if (!state) {
+        const ring = new St.DrawingArea({style_class: 'luma-sync-restore-ring', reactive: false});
+        ring.connect('repaint', () => drawRing(ring, tile.state?.fraction ?? 0));
+        const parent = artwork.get_parent();
+        const holder = new St.Widget({layout_manager: new Clutter.BinLayout(), x_align: artwork.x_align});
+        parent.replace_child(artwork, holder);
+        holder.add_child(artwork);
+        holder.add_child(ring);
+        ring.set({x_expand: true, y_expand: true, pivot_point: new Graphene.Point({x: 0.5, y: 0.5}),
+            scale_x: RING_SCALE, scale_y: RING_SCALE});
+        let caption = null;
+        if (tile.captionBox) {
+            caption = new St.Label({style_class: 'luma-sync-restore-caption', text: view.caption,
+                x_align: Clutter.ActorAlign.CENTER});
+            tile.captionBox.add_child(caption);
+        }
+        state = tile.state = {ring, caption, fraction: 0};
+    }
+    artwork.opacity = view.opacity;
+    if (!artwork.get_effect('luma-restore-desaturate'))
+        artwork.add_effect_with_name('luma-restore-desaturate', new Clutter.DesaturateEffect({factor: view.saturation}));
+    state.fraction = view.ring;
+    state.ring.queue_repaint();
+}
+
+const _tiles = new Set();
+
+// Any launcher tile: the app grid's and dock's AppIcon (appDisplay.js) and
+// the launcher drawer's tile (lumaPresentation/appDrawer.js).
+export function attachTile(owner, app, artwork, captionBox = null) {
+    const tile = {owner, app, artwork, captionBox, state: null};
+    _tiles.add(tile);
+    owner.connect('destroy', () => _tiles.delete(tile));
+    if (_rows.size)
+        sync(tile);
+}
+
+// AppIcon._init (grid and dock).
+export function attach(appIcon) {
+    const base = appIcon.icon;
+    if (!base?._iconBin)
+        return;
+    attachTile(appIcon, appIcon.app, base._iconBin, base.label && base._box ? base._box : null);
+}
