diff --git a/data/theme/luma-shelf.css b/data/theme/luma-shelf.css
index a1a877f..ae75eb6 100644
--- a/data/theme/luma-shelf.css
+++ b/data/theme/luma-shelf.css
@@ -3449,3 +3449,163 @@ StBoxLayout.luma-notification-tray.luma-surface-dark .luma-notification-tray-cou
 /* The dock's tile is already a plate (the overview icon's gradient and
  * shadow): an app icon without a plate of its own sits on that one. */
 .luma-shelf-dock-island #dash .dash-item-container .overview-tile .overview-icon .luma-app-icon-plate { background-color: transparent; }
+
+/* ── Luma Connect Sync (design-center 38858a5, mockups/connect-sync) ─────── */
+/* Tones (cs.css): ok oklch(0.74 0.13 150) = #69c27e, warn oklch(0.8 0.14 75)
+ * = #f2af48, bad oklch(0.7 0.17 25) = #f66d67. */
+.luma-sync-ok { color: #69c27e; }
+.luma-sync-warn { color: #f2af48; }
+.luma-sync-bad { color: #f66d67; }
+.luma-status-cluster .luma-status-slot .system-status-icon.luma-sync-warn { color: #f2af48; }
+.luma-status-cluster .luma-status-slot .system-status-icon.luma-sync-bad { color: #f66d67; }
+
+/* The status cell: one of the island's slots, its own button. */
+.luma-sync-cell { padding: 0; border-radius: 8px; }
+.luma-sync-cell:hover { background-color: rgba(255,255,255,.08); }
+.luma-sync-cell-phone { margin: 0 6px; }
+.luma-sync-cell-tv { margin: 0 18px 0 0; }
+.luma-sync-cell-phone .luma-sync-glyph, .luma-sync-cell-tv .luma-sync-glyph { icon-size: 16px; }
+
+/* The popover (cs.js pop(): .pop.k-qs .q2 with .cs-pop), the shell pop: 312 px.
+ * The menu content's own inset puts the title 6 px left of the rest (.q2h). */
+.luma-sync-popover .popup-menu-content.luma-sync-pop,
+.luma-sync-pop.luma-sync-sheet {
+  width: 298px; padding: 14px 4px 12px 10px; spacing: 0; border-radius: 26px; border: none;
+  background-color: rgba(32,33,36,.86); color: #e7e9e8; font-family: Figtree;
+  box-shadow: inset 0 0 0 1px rgba(255,255,255,.16); }
+/* The message may run 12 px into the right inset: Pango sets the reference's one-line
+ * sentences a few pixels wider than Chromium. */
+.luma-sync-pop-head { height: 20px; margin-right: 12px; }
+.luma-sync-pop-title { font-size: 14.5px; font-weight: 650; letter-spacing: -0.145px; }
+.luma-sync-line { margin: 18px 12px 0 6px; padding: 4px 2px; spacing: 12px; }
+.luma-sync-tile { width: 36px; height: 36px; border-radius: 10px; background-color: rgba(255,255,255,.07); }
+.luma-sync-tile-glyph { icon-size: 18px; color: #e7e9e8; }
+.luma-sync-words { spacing: 1px; }
+.luma-sync-title { font-size: 13px; font-weight: 650; }
+.luma-sync-sub { font-size: 11.5px; color: rgba(231,233,232,.62); }
+.luma-sync-prog { margin: 18px 12px 0 6px; height: 4px; border-radius: 2px; background-color: rgba(0,0,0,.2); }
+.luma-sync-prog-fill { height: 4px; border-radius: 2px; background-color: #3584e4; }
+.luma-sync-msg { margin: 20px 0 0 8px; font-size: 12px; color: rgba(231,233,232,.62); }
+.luma-sync-row { margin: 18px 12px 0 6px; }
+.luma-sync-action { height: 28px; padding: 0 12px; border-radius: 9px; font-size: 12px; font-weight: 650;
+  color: #e7e9e8; background-color: rgba(255,255,255,.12); }
+.luma-sync-action:hover, .luma-sync-action:focus { background-color: rgba(255,255,255,.17); }
+.luma-sync-link { height: 28px; margin: 14px 0 0 4px; padding: 0 8px; border-radius: 8px;
+  font-size: 12px; font-weight: 600; color: #e7e9e8; }
+.luma-sync-link:hover, .luma-sync-link:focus { background-color: rgba(255,255,255,.08); }
+/* Light surfaces: the desktop pop's light rule stands alone to outrank its dark rule. */
+.luma-sync-popover .popup-menu-content.luma-sync-pop.luma-surface-light {
+  background-color: #eceef1; color: #16191d; box-shadow: 0 4px 12px rgba(0,0,0,.2); }
+.luma-sync-pop.luma-surface-light {
+  background-color: #eceef1; color: #16191d; box-shadow: 0 4px 12px rgba(0,0,0,.2); }
+.luma-surface-light .luma-sync-tile { background-color: rgba(20,22,26,.05); }
+.luma-surface-light .luma-sync-tile-glyph { color: #16191d; }
+.luma-surface-light .luma-sync-sub, .luma-surface-light .luma-sync-msg { color: rgba(22,25,29,.76); }
+.luma-surface-light .luma-sync-prog { background-color: rgba(25,27,31,.055); }
+.luma-surface-light .luma-sync-action { color: #16191d; background-color: rgba(20,22,26,.09); }
+.luma-surface-light .luma-sync-action:hover, .luma-surface-light .luma-sync-action:focus { background-color: rgba(20,22,26,.14); }
+.luma-surface-light .luma-sync-link { color: #16191d; }
+.luma-surface-light .luma-sync-link:hover { background-color: rgba(25,27,31,.06); }
+.luma-surface-light .luma-sync-tile-glyph.luma-sync-ok { color: #69c27e; }
+.luma-surface-light .luma-sync-tile-glyph.luma-sync-warn { color: #f2af48; }
+.luma-surface-light .luma-sync-tile-glyph.luma-sync-bad { color: #f66d67; }
+.luma-sync-tile-glyph.luma-sync-ok { color: #69c27e; }
+.luma-sync-tile-glyph.luma-sync-warn { color: #f2af48; }
+.luma-sync-tile-glyph.luma-sync-bad { color: #f66d67; }
+/* Phone: a bottom drawer, full width. TV: a page at TV scale (x1.5), top right. */
+.luma-sync-sheet-shade { background-color: rgba(0,0,0,.32); }
+/* Phone: a bottom drawer (status.html ?posture=phone, cs.css .cs-drawer): 400 px, radius 28 at the
+ * top, a grab handle, a 44 px tile, and the action and Sync settings as 44 px buttons side by side. */
+.luma-sync-pop.luma-sync-sheet.luma-sync-phone { width: auto; padding: 10px 20px 30px; border-radius: 28px 28px 0 0;
+  background-color: #1d2026; box-shadow: none; color: #eceef1; }
+.luma-sync-pop.luma-sync-sheet.luma-sync-phone.luma-surface-light { background-color: #f4f5f7; box-shadow: none; color: #1f2328; }
+.luma-sync-phone .luma-sync-grab { width: 36px; height: 4px; margin-bottom: 16px; border-radius: 2px; background-color: rgba(236,238,241,.25); }
+.luma-sync-phone.luma-surface-light .luma-sync-grab { background-color: rgba(31,35,40,.25); }
+.luma-sync-phone .luma-sync-dh { font-size: 17px; font-weight: 650; }
+.luma-sync-phone .luma-sync-line { margin: 16px 0 0; padding: 0; spacing: 14px; }
+.luma-sync-phone .luma-sync-tile { width: 44px; height: 44px; border-radius: 12px; background-color: rgba(127,127,127,.16); }
+.luma-sync-phone .luma-sync-words { spacing: 2px; }
