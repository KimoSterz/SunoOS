diff --git a/js/ui/lumaConnectSync.js b/js/ui/lumaConnectSync.js
new file mode 100644
index 0000000..59b750e
--- /dev/null
+++ b/js/ui/lumaConnectSync.js
@@ -0,0 +1,836 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Luma Connect Sync in the Shell (ADR-054; design-center 38858a5,
+// mockups/connect-sync: approve.html, status.html, cs.css, cs.js).
+//
+// - The approval card: when another device asks to join, every device that
+//   syncs shows a Shell-owned card at the top centre, above windows: the
+//   source line, "Approve ThinkPad?", the six digits in two wells, and Not
+//   me and Approve at equal width. It stays until it is answered here or on
+//   another device (JoinCleared, or the request leaves ListJoinRequests);
+//   it never times out on its own. Not me denies the request, which tells
+//   the new device. Phone: a bottom sheet with 44 px buttons. TV: x1.5 with
+//   the remote's focus on Not me.
+// - The status cell: in the island's status slots only while there's
+//   something to say (syncing, paused, needs attention); a click opens the
+//   popover (state, one sentence, at most one action, Sync settings).
+//   Phone: in the status bar's right group, the popover a bottom drawer;
+//   TV: in the top bar's status group, the popover a page at TV scale.
+// - Banners: storage full and removed from Sync post one standard banner
+//   each; conflicts never do.
+// - Restoring apps: lumaConnectSyncRestore.js marks their tiles; Valet opens
+//   once when apps start arriving after a join.
+import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
+import Gio from 'gi://Gio';
+import Pango from 'gi://Pango';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as MessageTray from './messageTray.js';
+import * as PopupMenu from './popupMenu.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import * as Model from './lumaConnectSyncModel.js';
+import * as Restore from './lumaConnectSyncRestore.js';
+
+const BUS_NAME = 'org.projectluma.ConnectSync1';
+const OBJECT_PATH = '/org/projectluma/ConnectSync1';
+const INTERFACE = 'org.projectluma.ConnectSync1';
+const CONNECT_ICON = 'org.projectluma.Connect';
+// While a card is up, the requests are read again this often, so a card
+// answered on another device leaves even if its JoinCleared was missed.
+const CARD_RECHECK_S = 20;
+const EARLY_RECHECK_S = 2;
+
+export function posture() {
+    if (Main.presentation?._state?.posture?.effective === 'tv')
+        return 'tv';
+    return Main.presentation?.mode === 'mobile' ? 'phone' : 'desktop';
+}
+
+function now() {
+    return Math.floor(GLib.get_real_time() / GLib.USEC_PER_SEC);
+}
+
+function icon(name, size, styleClass = '') {
+    return new St.Icon({icon_name: name, icon_size: size, style_class: styleClass});
+}
+
+export function openSettings(route) {
+    const app = Shell.AppSystem.get_default().lookup_app('org.gnome.Settings.desktop');
+    const param = new GLib.Variant('av', [new GLib.Variant('(sav)',
+        ['users', route.map(part => new GLib.Variant('s', part))])]);
+    Main.overview.hide();
+    app?.activate_action('launch-panel', param, 0, -1, null).catch(e =>
+        log(`Failed to open Sync settings: ${e.message}`));
+}
+
+// ── The service ─────────────────────────────────────────────────────────
+class Service {
+    constructor(handlers) {
+        this._handlers = handlers;
+        this._signals = [];
+        this._watch = Gio.bus_watch_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameWatcherFlags.NONE,
+            () => this._appeared(), () => this._vanished());
+    }
+
+    _appeared() {
+        const bus = Gio.DBus.session;
+        for (const [name, handler] of Object.entries(this._handlers.signals)) {
+            this._signals.push(bus.signal_subscribe(BUS_NAME, INTERFACE, name, OBJECT_PATH, null,
+                Gio.DBusSignalFlags.NONE, (_c, _s, _p, _i, _n, params) => handler(params.deepUnpack())));
+        }
+        this.present = true;
+        this._handlers.appeared();
+    }
+
+    _vanished() {
+        for (const id of this._signals)
+            Gio.DBus.session.signal_unsubscribe(id);
+        this._signals = [];
+        this.present = false;
+        this._handlers.vanished();
+    }
+
+    async call(method, params = null, replyType = null, timeout = 30000) {
+        const reply = await Gio.DBus.session.call(BUS_NAME, OBJECT_PATH, INTERFACE, method, params,
+            replyType ? new GLib.VariantType(replyType) : null,
+            Gio.DBusCallFlags.NO_AUTO_START | Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION,
+            timeout, null);
+        return reply?.deepUnpack();
+    }
+
+    async json(method) {
+        const [text] = await this.call(method, null, '(s)');
+        return JSON.parse(text);
+    }
+
+    destroy() {
+        this._vanished();
+        Gio.bus_unwatch_name(this._watch);
+    }
+}
+
+// ── The status cell and its popover ────────────────────────────────────
+// One of the island's status slots (it has .icon, as the others do, so the
+// island sizes it); its own button, so a press opens the popover and never
+// Quick Options.
+class StatusCell {
+    constructor(onActivate) {
+        this.actor = new St.Button({
+            style_class: 'luma-status-slot luma-sync-cell',
+            reactive: true, can_focus: true, track_hover: true, visible: false,
+            y_align: Clutter.ActorAlign.CENTER,
+        });
+        this.actor._lumaSyncCell = true;
+        this.actor.icon = icon(Model.ICON['refresh-cw'], 16, 'system-status-icon luma-sync-glyph');
+        this.actor.icon.x_expand = true;
+        this.actor.icon.x_align = Clutter.ActorAlign.CENTER;
+        this.actor.set_child(this.actor.icon);
+        this.actor.connect('clicked', () => onActivate(this.actor));
+    }
+
+    set(view) {
+        this.actor.icon.icon_name = view.icon;
+        for (const tone of ['ok', 'warn', 'bad'])
+            this.actor.icon.remove_style_class_name(`luma-sync-${tone}`);
+        if (view.tone)
+            this.actor.icon.add_style_class_name(`luma-sync-${view.tone}`);
+        this.actor.accessible_name = view.title;
+    }
+}
+
+// The popover's content (cs.js pop()), the same in the desktop pop, the
+// phone drawer and the TV page.
+export function fillPopover(box, view, {onAction, onSettings, header = true, phone = false}) {
+    box.destroy_all_children();
+    // Phone (status.html ?posture=phone): a bottom drawer with a grab handle, a larger tile and
+    // words, and the action and Sync settings side by side as 44 px buttons.
+    if (phone) {
+        box.add_child(new St.Widget({style_class: 'luma-sync-grab', x_align: Clutter.ActorAlign.CENTER}));
+        box.add_child(new St.Label({style_class: 'luma-sync-dh', text: Model.POPOVER_TITLE}));
+    } else if (header) {
+        const head = new St.BoxLayout({style_class: 'luma-sync-pop-head'});
+        head.add_child(new St.Label({style_class: 'luma-sync-pop-title', text: Model.POPOVER_TITLE, x_expand: true}));
+        box.add_child(head);
+    }
+    const line = new St.BoxLayout({style_class: 'luma-sync-line'});
+    const tile = new St.Bin({style_class: 'luma-sync-tile', y_align: Clutter.ActorAlign.CENTER});
+    const glyph = icon(view.icon, phone ? 22 : 18, 'luma-sync-tile-glyph');
+    if (view.tone)
+        glyph.add_style_class_name(`luma-sync-${view.tone}`);
+    tile.set_child(glyph);
+    line.add_child(tile);
+    const words = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL, style_class: 'luma-sync-words',
+        y_align: Clutter.ActorAlign.CENTER, x_expand: true});
+    words.add_child(new St.Label({style_class: 'luma-sync-title', text: view.title}));
+    if (view.sub)
+        words.add_child(new St.Label({style_class: 'luma-sync-sub', text: view.sub}));
+    line.add_child(words);
+    box.add_child(line);
+    if (view.progress !== null && view.progress !== undefined) {
+        const track = new St.BoxLayout({style_class: 'luma-sync-prog', x_expand: true});
+        const fill = new St.Widget({style_class: 'luma-sync-prog-fill', y_expand: true});
+        track.add_child(fill);
+        track.connect('notify::width', () => fill.set_width(Math.round(track.width * view.progress)));
+        box.add_child(track);
+    }
+    let focus = null;
+    if (view.message) {
+        const message = paragraph('luma-sync-msg', view.message, phone ? 20 : posture() === 'tv' ? 26.1 : 17.4);
+        box.add_child(message);
+    }
+    if (phone) {
+        const row = new St.BoxLayout({style_class: 'luma-sync-dacts', x_expand: true});
+        row.layout_manager.homogeneous = true;
+        const labels = view.action ? [view.action, Model.SETTINGS_LINK] : [Model.SETTINGS_LINK];
+        for (const text of labels) {
+            const button = new St.Button({style_class: 'luma-sync-daction', label: text, can_focus: true, x_expand: true});
+            button.connect('clicked', () => text === view.action ? onAction(view.action, view.subject ?? null) : onSettings());
+            row.add_child(button);
+            focus ??= button;
+        }
+        box.add_child(row);
+        return focus;
+    }
+    if (view.action) {
+        const row = new St.BoxLayout({style_class: 'luma-sync-row'});
+        const button = new St.Button({style_class: 'luma-sync-action', label: view.action, can_focus: true});
+        button.connect('clicked', () => onAction(view.action, view.subject ?? null));
+        row.add_child(button);
+        box.add_child(row);
+        focus = button;
+    }
+    const more = new St.Button({style_class: 'luma-sync-link', label: Model.SETTINGS_LINK, can_focus: true,
+        x_align: Clutter.ActorAlign.START});
+    more.connect('clicked', () => onSettings());
+    box.add_child(more);
+    return focus ?? more;
+}
+
+// Desktop: a shelf surface from the island (lumaShelfSurface.js places it);
+// phone: a bottom drawer (status.html ?posture=phone); TV: a page at TV scale at the top right.
+class StatusPopover {
+    constructor(handlers) {
+        this._handlers = handlers;
+        this._view = null;
+    }
+
+    get isOpen() {
+        return !!(this._menu?.isOpen || this._sheet?.visible);
+    }
+
+    setView(view) {
+        this._view = view;
+        if (!view)
+            this.close();
+        else if (this.isOpen)
+            this._fill(this._menu?.isOpen ? this._menu.box : this._sheetBox);
+    }
+
+    _fill(box, header = true) {
+        return fillPopover(box, this._view, {
+            header,
+            phone: box === this._sheetBox && this._sheetBox?.has_style_class_name('luma-sync-phone'),
+            onAction: (action, subject) => {
+                this.close();
+                this._handlers.onAction(action, subject);
+            },
+            onSettings: () => {
+                this.close();
+                openSettings(Model.ROUTE.settings);
+            },
+        });
+    }
+
+    toggle(source) {
+        if (this.isOpen) {
+            this.close();
+            return;
+        }
+        if (!this._view)
+            return;
+        const where = posture();
+        if (where === 'desktop')
+            this._openMenu(source);
+        else
+            this._openSheet(where);
+    }
+
+    _openMenu(source) {
+        if (this._menu?.sourceActor !== source) {
+            this._menu?.destroy();
+            this._menu = new PopupMenu.PopupMenu(source, 0.5, St.Side.BOTTOM);
+            this._menu.actor.add_style_class_name('luma-sync-popover');
+            this._menu.box.add_style_class_name('luma-sync-pop');
+            SurfaceMaterials.bindSurface(this._menu.box, {
+                cornerRadii: 26 * St.ThemeContext.get_for_stage(global.stage).scale_factor,
+                classActors: [this._menu.actor, this._menu.box],
+            });
+            Main.uiGroup.add_child(this._menu.actor);
+            this._menu.actor.hide();
+            Main.panel.menuManager.addMenu(this._menu);
+        }
+        this._fill(this._menu.box);
+        this._menu.open(true);
+    }
+
+    _openSheet(where) {
+        if (!this._sheet) {
+            this._sheet = new St.Widget({style_class: 'luma-sync-sheet-shade', reactive: true,
+                layout_manager: new Clutter.BinLayout(), visible: false});
+            this._sheetBox = new St.BoxLayout({style_class: 'luma-sync-pop luma-sync-sheet',
+                orientation: Clutter.Orientation.VERTICAL, reactive: true});
+            this._sheet.add_child(this._sheetBox);
+            SurfaceMaterials.bindSurface(this._sheetBox, {classActors: [this._sheetBox]});
+            const tap = new Clutter.ClickGesture();
+            tap.connect('may-recognize', g =>
+                global.stage.get_event_actor(g.get_point_event(0)) === this._sheet);
+            tap.connect('recognize', () => this.close());
+            this._sheet.add_action(tap);
+            this._sheet.connect('key-press-event', (_a, event) => {
+                if (event.get_key_symbol() === Clutter.KEY_Escape ||
+                    event.get_key_symbol() === Clutter.KEY_Back) {
+                    this.close();
+                    return Clutter.EVENT_STOP;
+                }
+                return global.focus_manager.navigate_from_event(event)
+                    ? Clutter.EVENT_STOP : Clutter.EVENT_PROPAGATE;
+            });
+            Main.layoutManager.addTopChrome(this._sheet);
+        }
+        const monitor = Main.layoutManager.primaryMonitor;
+        this._sheet.set_position(monitor.x, monitor.y);
+        this._sheet.set_size(monitor.width, monitor.height);
+        this._sheetBox.remove_style_class_name('luma-sync-phone');
+        this._sheetBox.remove_style_class_name('luma-sync-tv');
+        this._sheetBox.add_style_class_name(where === 'tv' ? 'luma-sync-tv' : 'luma-sync-phone');
+        if (where === 'tv') {
+            this._sheetBox.set({x_align: Clutter.ActorAlign.END, y_align: Clutter.ActorAlign.START,
+                x_expand: true, y_expand: true});
+        } else {
+            this._sheetBox.set({x_align: Clutter.ActorAlign.FILL, y_align: Clutter.ActorAlign.END,
+                x_expand: true, y_expand: true});
+        }
+        const focus = this._fill(this._sheetBox);
+        this._sheet.show();
+        this._grab = Main.pushModal(this._sheet);
+        (where === 'tv' ? focus : this._sheetBox)?.grab_key_focus();
+    }
+
+    close() {
+        if (this._menu?.isOpen)
+            this._menu.close(true);
+        if (this._sheet?.visible) {
+            this._sheet.hide();
+            if (this._grab)
+                Main.popModal(this._grab);
+            this._grab = null;
+        }
+    }
+
+    destroy() {
+        this.close();
+        this._menu?.destroy();
+        this._sheet?.destroy();
+    }
+}
+
+// A label with letter spacing (.cs-from .08em, .cs-code .06em) that is never
+// cut short.
+function spaced(styleClass, text, px) {
+    const label = new St.Label({style_class: styleClass, y_align: Clutter.ActorAlign.CENTER});
+    label.clutter_text.set_markup(
+        `<span letter_spacing="${Math.round(px * 1024)}">${GLib.markup_escape_text(text, -1)}</span>`);
+    // Pango counts the last letter's spacing when it ellipsizes, not when it measures.
+    label.clutter_text.ellipsize = Pango.EllipsizeMode.NONE;
+    return label;
+}
+
+// Wrapping words with the design's line height (cs.css line-height 1.45),
+// which St's CSS has no property for.
+function paragraph(styleClass, text, lineHeight) {
+    const label = new St.Label({style_class: styleClass});
+    label.clutter_text.set_markup(
+        `<span line_height="${Math.round(lineHeight * 1024)}">${GLib.markup_escape_text(text, -1)}</span>`);
+    label.clutter_text.ellipsize = Pango.EllipsizeMode.NONE;
+    label.clutter_text.line_wrap = true;
+    label.clutter_text.line_wrap_mode = Pango.WrapMode.WORD_CHAR;
+    return label;
+}
+
+// ── The approval card ───────────────────────────────────────────────────
+// Shell-owned, not a notification and not an app window: top centre, above
+// windows (cs.css .cs-appr).
+class ApprovalCard {
+    constructor(request, answer) {
+        this.request = request;
+        const view = Model.card(request);
+        this._where = posture();
+        this.actor = new St.BoxLayout({style_class: `luma-sync-appr luma-sync-appr-${this._where}`,
+            orientation: Clutter.Orientation.VERTICAL, reactive: true});
+        // Its own solid fill (cs.css .cs-appr), light or dark with the appearance.
+        if (SurfaceMaterials.LIGHT_FAMILY.has(SurfaceMaterials.effectiveTreatment()))
+            this.actor.add_style_class_name('luma-sync-light');
+        const from = new St.BoxLayout({style_class: 'luma-sync-appr-from'});
+        // The whole source line is at 55% (cs.css .cs-from), its icon too.
+        from.add_child(new St.Icon({gicon: new Gio.ThemedIcon({name: CONNECT_ICON}),
+            style_class: 'luma-sync-appr-from-icon', y_align: Clutter.ActorAlign.CENTER, opacity: 140}));
+        from.add_child(spaced('luma-sync-appr-from-text', view.source.toLocaleUpperCase(),
+            this._where === 'tv' ? 1.2 : 0.8));
+        this.actor.add_child(from);
+        const head = new St.BoxLayout({style_class: 'luma-sync-appr-head'});
+        const tile = new St.Bin({style_class: 'luma-sync-appr-tile', y_align: Clutter.ActorAlign.CENTER});
+        tile.set_child(new St.Icon({icon_name: view.icon, style_class: 'luma-sync-appr-glyph'}));
+        head.add_child(tile);
+        const words = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL,
+            y_align: Clutter.ActorAlign.CENTER, x_expand: true});
+        words.add_child(new St.Label({style_class: 'luma-sync-appr-title', text: view.title}));
+        words.add_child(new St.Label({style_class: 'luma-sync-appr-sub', text: view.sub}));
+        head.add_child(words);
+        this.actor.add_child(head);
+        this._body = paragraph('luma-sync-appr-body', view.body, this._where === 'tv' ? 27.19 : 18.13);
+        this.actor.add_child(this._body);
+        this._code = new St.BoxLayout({style_class: 'luma-sync-appr-code'});
+        this._fillCode(view);
+        this.actor.add_child(this._code);
+        // Not me and Approve at equal width: neither is the default.
+        const buttons = new St.BoxLayout({style_class: 'luma-sync-appr-buttons'});
+        buttons.layout_manager.homogeneous = true;
+        this._buttons = view.buttons.map((label, index) => {
+            const button = new St.Button({style_class: 'luma-sync-appr-button', label, can_focus: true,
+                x_expand: true});
+            button.connect('clicked', () => answer(this, index === 1));
+            buttons.add_child(button);
+            return button;
+        });
+        this.actor.add_child(buttons);
+        this._setEarly(view.early);
+        this._focusIndex = view.focus;
+        this.actor.connect('key-press-event', (_a, event) =>
+            global.focus_manager.navigate_from_event(event) ? Clutter.EVENT_STOP : Clutter.EVENT_PROPAGATE);
+    }
+
+    // The two halves of the code; before it exists (B3), "··· ···" at 35% and a turning loader.
+    _fillCode(view) {
+        this._code.destroy_all_children();
+        const spacing = this._where === 'tv' ? 2.52 : 1.68;
+        this._code.remove_style_class_name('luma-sync-appr-code-wait');
+        if (!view.early) {
+            for (const group of view.code)
+                this._code.add_child(spaced('luma-sync-appr-well', group, spacing));
+            return;
+        }
+        this._code.add_style_class_name('luma-sync-appr-code-wait');
+        for (let i = 0; i < 2; i++) {
+            const dots = spaced('luma-sync-appr-well', '···', spacing);
+            dots.opacity = Math.round(0.35 * 255);
+            this._code.add_child(dots);
+        }
+        const wait = new St.BoxLayout({style_class: 'luma-sync-appr-wait', y_align: Clutter.ActorAlign.CENTER,
+            opacity: Math.round(0.7 * 255)});
+        const loader = new St.Icon({icon_name: Model.ICON['loader-circle'], style_class: 'luma-sync-appr-wait-icon',
+            y_align: Clutter.ActorAlign.CENTER});
+        loader.set_pivot_point(0.5, 0.5);
+        if (St.Settings.get().enable_animations) {
+            loader.ease({rotation_angle_z: 360, duration: 1000, mode: Clutter.AnimationMode.LINEAR,
+                repeat_count: -1});
+        }
+        wait.add_child(loader);
+        wait.add_child(new St.Label({style_class: 'luma-sync-appr-wait-text', text: view.waiting,
+            y_align: Clutter.ActorAlign.CENTER}));
+        this._code.add_child(wait);
+    }
+
+    // Approve waits for the code; Not me works at once.
+    _setEarly(early) {
+        this._early = early;
+        const approve = this._buttons[1];
+        approve.reactive = !early;
+        approve.can_focus = !early;
+        approve.opacity = early ? Math.round(0.4 * 255) : 255;
+    }
+
+    // The code arrived: the same card becomes the approval card, in place.
+    update(request) {
+        const view = Model.card(request);
+        if (view.early === this._early)
+            return;
+        this.request = request;
+        this._body.clutter_text.set_markup(`<span line_height="${Math.round((this._where === 'tv' ? 27.19 : 18.13) * 1024)}">${
+            GLib.markup_escape_text(view.body, -1)}</span>`);
+        this._fillCode(view);
+        this._setEarly(view.early);
+        this.place();
+    }
+
+    setBusy(busy) {
+        for (const button of this._buttons)
+            button.reactive = !busy;
+        if (!busy)
+            this._setEarly(this._early);
+    }
+
+    show() {
+        Main.layoutManager.addTopChrome(this.actor);
+        this.place();
+        Main.layoutManager.connectObject('monitors-changed', () => this.place(), this);
+        // A phone's sheet sits on the screen's bottom edge at whatever height it lays out to
+        // (its words wrap at the screen's width only once it is allocated there).
+        if (this._where === 'phone')
+            this.actor.connectObject('notify::height', () => this.place(), this);
+        // A TV's remote needs the focus; it starts on Not me.
+        if (this._where === 'tv') {
+            this._grab = Main.pushModal(this.actor);
+            this._buttons[this._focusIndex].grab_key_focus();
+        }
+    }
+
+    place() {
+        const monitor = Main.layoutManager.primaryMonitor;
+        if (!monitor)
+            return;
+        const [, width] = this.actor.get_preferred_width(-1);
+        const [, height] = this.actor.get_preferred_height(width);
+        const scale = St.ThemeContext.get_for_stage(global.stage).scale_factor;
+        if (this._where === 'phone') {
+            this.actor.set_width(monitor.width);
+            this.actor.set_position(monitor.x, monitor.y + monitor.height - (this.actor.has_allocation() ? this.actor.height : height));
+        } else {
+            const top = (this._where === 'tv' ? 60 : 72) * scale;
+            this.actor.set_position(Math.round(monitor.x + (monitor.width - width) / 2), monitor.y + top);
+        }
+    }
+
+    destroy() {
+        Main.layoutManager.disconnectObject(this);
+        if (this._grab)
+            Main.popModal(this._grab);
+        this._grab = null;
+        this.actor.destroy();
+    }
+}
+
+// ── Everything together ─────────────────────────────────────────────────
+export class ConnectSync {
+    constructor() {
+        this._state = null;
+        this._requests = [];
+        this._cards = new Map();
+        this._restoreRows = null;
+        this._popover = new StatusPopover({onAction: (action, subject) => this._act(action, subject)});
+        this._cell = null;
+        this._service = new Service({
+            appeared: () => this._readAll(),
+            vanished: () => {
+                this._state = null;
+                this._syncCell();
+                this._setRequests([]);
+            },
+            signals: {
+                StateChanged: () => this._readState(),
+                JoinRequested: () => this._readRequests(),
+                JoinCleared: ([join]) => {
+                    this._requests = this._requests.filter(r => r.id !== join);
+                    this._syncCards();
+                    this._readRequests();
+                },
+                RestoreChanged: () => this._readRestore(),
+                AppsChanged: () => {},
+                RecoveryJoined: ([device, name]) => this._recoveryJoined(device, name),
+            },
+        });
+        Main.layoutManager.connectObject('monitors-changed', () => this._queuePlace(), this);
+        global.display.connectObject('workareas-changed', () => this._queuePlace(), this);
+    }
+
+    _readAll() {
+        this._readState();
+        this._readRequests();
+        this._readRestore();
+    }
+
+    async _readState() {
+        try {
+            const state = await this._service.json('GetState');
+            const banner = Model.banner(this._state, state);
+            this._state = state;
+            this._syncCell();
+            if (banner)
+                this._postBanner(banner);
+        } catch (e) {
+            if (!e.matches?.(Gio.DBusError, Gio.DBusError.SERVICE_UNKNOWN))
+                log(`Connect Sync: GetState: ${e.message}`);
+        }
+    }
+
+    async _readRequests() {
+        try {
+            this._setRequests(await this._service.json('ListJoinRequests'));
+        } catch (e) {
+            log(`Connect Sync: ListJoinRequests: ${e.message}`);
+        }
+    }
+
+    async _readRestore() {
+        try {
+            const rows = await this._service.json('GetRestore');
+            if (this._restoreRows !== null && Model.openValet(this._restoreRows, rows))
+                this._spawn(['luma-installer', '--restore']);
+            this.setRestoreRows(rows);
+        } catch (e) {
+            log(`Connect Sync: GetRestore: ${e.message}`);
+        }
+    }
+
+    _spawn(argv) {
+        try {
+            GLib.spawn_async(null, argv, null, GLib.SpawnFlags.SEARCH_PATH, null);
+        } catch (e) {
+            logError(e, `Could not run ${argv[0]}`);
+        }
+    }
+
+    // ── the cell
+    _ensureCell() {
+        if (this._cell?.actor && !this._cell.actor._lumaDestroyed)
+            return;
+        this._cell = new StatusCell(source => this._popover.toggle(source));
+        this._cell.actor.connect('destroy', actor => {
+            actor._lumaDestroyed = true;
+            this._popover.close();
+            this._queuePlace();
+        });
+    }
+
+    _queuePlace() {
+        if (this._placeIdle || this._destroyed)
+            return;
+        this._placeIdle = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
+            this._placeIdle = 0;
+            this._syncCell();
+            for (const card of this._cards.values())
+                card.place();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    _place() {
+        const where = posture();
+        const actor = this._cell.actor;
+        let parent = null;
+        if (where === 'phone')
+            parent = Main.presentation?._statusRight ?? null;
+        else if (where === 'tv')
+            parent = Main.presentation?._tv?._now ?? null;
+        const quick = Main.panel?.statusArea?.quickSettings;
+        if (!parent && quick?.setStatusCell) {
+            if (actor.get_parent() !== quick._statusSlots)
+                quick.setStatusCell(actor);
+            actor.set_style_class_name('luma-status-slot luma-sync-cell');
+            return;
+        }
+        if (!parent)
+            return;
+        if (actor.get_parent() !== parent) {
+            actor.get_parent()?.remove_child(actor);
+            parent.insert_child_at_index(actor, 0);
+        }
+        actor.set_style_class_name(`luma-sync-cell luma-sync-cell-${where}`);
+    }
+
+    _syncCell() {
+        const cell = Model.cell(this._state);
+        if (!cell.visible && !this._cell) {
+            this._popover.setView(null);
+            return;
+        }
+        this._ensureCell();
+        if (cell.visible)
+            this._cell.set(cell);
+        this._place();
+        this._cell.actor.visible = cell.visible;
+        this._popover.setView(cell.visible ? Model.popover(this._state, now()) : null);
+        Main.panel?.statusArea?.quickSettings?._syncStatusSlots?.();
+    }
+
+    async _act(action, subject = null) {
+        const what = Model.actionTarget(action, subject);
+        if (what?.route) {
+            openSettings(what.route);
+        } else if (what?.app) {
+            // The Luma Connect sign-in, as Settings' TV account page opens it.
+            Main.overview.hide();
+            Shell.AppSystem.get_default().lookup_app(what.app)?.activate();
+        } else if (what?.method)
+            await this._service.call(what.method).catch(e => log(`Connect Sync: ${what.method}: ${e.message}`));
+    }
+
+    // ── banners
+    _postBanner(banner) {
+        const source = new MessageTray.Source({
+            title: banner.source,
+            icon: new Gio.ThemedIcon({name: CONNECT_ICON}),
+            policy: new MessageTray.NotificationGenericPolicy(),
+        });
+        Main.messageTray.add(source);
+        const notification = new MessageTray.Notification({
+            source, title: banner.title, body: banner.body, isTransient: false,
+            urgency: MessageTray.Urgency.HIGH,
+        });
+        if (banner.action)
+            notification.addAction(banner.action, () => this._act(banner.action));
+        notification.connect('activated', () => openSettings(Model.ROUTE.settings));
+        source.addNotification(notification);
+    }
+
+    // A device joined with the recovery key: one standard banner on every
+    // syncing device, kept in the list until answered (no card: nothing waits
+    // on it). Remove… opens Settings' Remove confirm for that device.
+    _recoveryJoined(device, name) {
+        const banner = Model.keyJoinBanner(device, name);
+        const source = new MessageTray.Source({
+            title: banner.source,
+            icon: new Gio.ThemedIcon({name: CONNECT_ICON}),
+            policy: new MessageTray.NotificationGenericPolicy(),
+        });
+        Main.messageTray.add(source);
+        const notification = new MessageTray.Notification({
+            source, title: banner.title, body: banner.body, isTransient: false,
+            urgency: MessageTray.Urgency.HIGH,
+        });
+        // On a TV the shared TV toast says it (tv.js); Remove… and It was me wait in the quick panel.
+        notification.tvToast = {sub: _('Not you? Remove it from the quick panel.')};
+        notification.addAction(banner.actions[0], () => openSettings(banner.route));
+        notification.addAction(banner.actions[1], () => {});
+        source.addNotification(notification);
+        return notification;
+    }
+
+    // ── approval cards
+    _setRequests(requests) {
+        // Held requests (B2) wait their turn without a card; tampered ones never get one.
+        this._requests = requests.filter(r => !r.tampered && !r.held);
+        for (const r of this._requests)
+            this._cards.get(r.id)?.update(r);
+        this._syncCards();
+    }
+
+    _syncCards() {
+        const ids = new Set(this._requests.map(r => r.id));
+        for (const [id, card] of this._cards) {
+            if (!ids.has(id)) {
+                card.destroy();
+                this._cards.delete(id);
+            }
+        }
+        // One card at a time, the oldest first; the next shows when it's answered.
+        const first = [...this._requests].sort((a, b) => (a.created_at ?? 0) - (b.created_at ?? 0))[0];
+        if (first && !this._cards.size) {
+            const card = new ApprovalCard(first, (c, approve) => this._answer(c, approve));
+            this._cards.set(first.id, card);
+            card.show();
+        }
+        // A card waiting for its code reads the requests again every 2 s until the code is there.
+        const early = [...this._cards.values()].some(c => c._early);
+        if (early && !this._earlyRecheck) {
+            this._earlyRecheck = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, EARLY_RECHECK_S, () => {
+                this._readRequests();
+                return GLib.SOURCE_CONTINUE;
+            });
+        } else if (!early && this._earlyRecheck) {
+            GLib.source_remove(this._earlyRecheck);
+            this._earlyRecheck = 0;
+        }
+        if (this._cards.size && !this._recheck) {
+            this._recheck = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, CARD_RECHECK_S, () => {
+                this._readRequests();
+                return GLib.SOURCE_CONTINUE;
+            });
+        } else if (!this._cards.size && this._recheck) {
+            GLib.source_remove(this._recheck);
+            this._recheck = 0;
+        }
+    }
+
+    async _answer(card, approve) {
+        card.setBusy(true);
+        const {id, code} = card.request;
+        try {
+            if (approve)
+                await this._service.call('ApproveJoin', new GLib.Variant('(ss)', [id, code]), null, 180000);
+            else
+                await this._service.call('DenyJoin', new GLib.Variant('(s)', [id]));
+            this._requests = this._requests.filter(r => r.id !== id);
+            this._syncCards();
+        } catch (e) {
+            // Not authorised (the password prompt was cancelled) or the service
+            // refused: the card stays, to be answered again.
+            log(`Connect Sync: ${approve ? 'ApproveJoin' : 'DenyJoin'}: ${e.message}`);
+            card.setBusy(false);
+        }
+        this._readRequests();
+    }
+
+    // The session tests and the conform captures: the popover for a given
+    // GetState document (Up to date too, which the cell never offers), from
+    // the cell, or from the status island while the cell is hidden. Returns
+    // the popover's surface.
+    openPopoverFor(state) {
+        this._ensureCell();
+        this._place();
+        this._popover.close();
+        this._popover.setView(Model.popover(state, now()));
+        const quick = Main.panel?.statusArea?.quickSettings;
+        this._popover.toggle(this._cell.actor.visible || !quick ? this._cell.actor : quick);
+        return posture() === 'desktop' ? this._popover._menu?.box : this._popover._sheetBox;
+    }
+
+    // The approval card for a ListJoinRequests row, as if the service listed it
+    // (the conform captures, with the reference's ThinkPad and 418 207).
+    showCardFor(request) {
+        this._setRequests([request]);
+        return this._cards.get(request.id)?.actor;
+    }
+
+    // GetRestore rows to the tiles (the session test passes its own).
+    setRestoreRows(rows) {
+        this._restoreRows = rows;
+        Restore.setRows(rows);
+    }
+
+    // What an app's tile shows while it restores (the session test reads it).
+    restoreTile(appId) {
+        return Restore.tileForId(appId);
+    }
+
+    // Opening an app the way its grid and dock tile do (AppIcon.activate):
+    // a restoring app shows its row in Valet instead.
+    activateApp(appId) {
+        const app = Shell.AppSystem.get_default().lookup_app(`${appId}.desktop`);
+        if (!app)
+            return 'missing';
+        if (Restore.redirect(app))
+            return 'valet';
+        app.activate();
+        return 'launched';
+    }
+
+    destroy() {
+        this._destroyed = true;
+        Main.layoutManager.disconnectObject(this);
+        global.display.disconnectObject(this);
+        if (this._placeIdle)
+            GLib.source_remove(this._placeIdle);
+        if (this._recheck)
+            GLib.source_remove(this._recheck);
+        if (this._earlyRecheck)
+            GLib.source_remove(this._earlyRecheck);
+        this._earlyRecheck = 0;
+        for (const card of this._cards.values())
+            card.destroy();
+        this._popover.destroy();
+        this._cell?.actor.destroy();
+        this._service.destroy();
+    }
+}
