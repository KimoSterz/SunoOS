+            accessible_name: 'Continue'});
+        this._chips = new St.BoxLayout({});
+        this._appChip = new St.Label({y_align: Clutter.ActorAlign.CENTER});
+        this._fromChip = new St.Label({y_align: Clutter.ActorAlign.CENTER});
+        this._chipBoxes = [this._appChip, this._fromChip].map(label => {
+            const chip = new St.Bin({child: label, y_align: Clutter.ActorAlign.START});
+            this._chips.add_child(chip);
+            return chip;
+        });
+        // The artwork and its shade, full screen behind the hero; the TV
+        // places it above its own backdrop and below the bar.
+        this.backdrop = new St.Widget({layout_manager: new Clutter.BinLayout(), visible: false});
+        this._art = new St.Widget({x_expand: true, y_expand: true});
+        this._art.set_content_scaling_filters(Clutter.ScalingFilter.TRILINEAR, Clutter.ScalingFilter.LINEAR);
+        this._shade = new St.DrawingArea({x_expand: true, y_expand: true});
+        this._shade.connect('repaint', area => this._paintShade(area));
+        this.backdrop.add_child(this._art);
+        this.backdrop.add_child(this._shade);
+        for (const property of ['notify::width', 'notify::height']) {
+            this.backdrop.connect(property, () => {
+                if (this._offer)
+                    this._placeArt(Math.round(this.backdrop.width), Math.round(this.backdrop.height));
+            });
+        }
+        this._title = new St.Label({});
+        this._subtitle = new St.Label({});
+        this._progress = new St.BoxLayout({});
+        this._track = new St.Widget({layout_manager: new Clutter.FixedLayout(), y_align: Clutter.ActorAlign.CENTER});
+        this._fill = new St.Widget({});
+        this._track.add_child(this._fill);
+        this._left = new St.Label({y_align: Clutter.ActorAlign.CENTER});
+        this._progress.add_child(this._track);
+        this._progress.add_child(this._left);
+        this._row = new St.BoxLayout({});
+        this.buttons = [
+            this._button('lumaui-play-symbolic', 'Continue', false),
+            this._button('lumaui-rotate-ccw-symbolic', 'Start over', true),
+        ];
+        for (const part of [this._chips, this._title, this._subtitle, this._progress, this._row])
+            this.actor.add_child(part);
+    }
+
+    _button(icon, label, fromStart) {
+        const box = new St.BoxLayout({y_align: Clutter.ActorAlign.CENTER});
+        const glyph = new St.Icon({icon_name: icon, y_align: Clutter.ActorAlign.CENTER});
+        const text = new St.Label({text: label, y_align: Clutter.ActorAlign.CENTER});
+        box.add_child(glyph);
+        box.add_child(text);
+        const button = new St.Button({child: box, can_focus: false, reactive: true, accessible_name: label});
+        button.connect('clicked', () => this.activate(fromStart ? 1 : 0));
+        this._row.add_child(button);
+        return {button, box, glyph, text, fromStart};
+    }
+
+    get visible() {
+        return Boolean(this._offer) && this.actor.visible;
+    }
+
+    // offer: {id, name (the device), media: {app, name, item, subtitle,
+    // position, length}}; play(fromStart) starts it. null: the TV's own again.
+    set(offer, play) {
+        this._offer = offer?.media ? offer : null;
+        this._play = play;
+        this.actor.visible = Boolean(this._offer);
+        // The hero is the home's headline while it shows: the greeting steps
+        // aside and comes back when it leaves (Not now, played, expired).
+        if (this._tv._greeting)
+            this._tv._greeting.visible = !this._offer;
+        if (!this._offer)
+            return;
+        const {media} = this._offer;
+        this._appChip.text = media.name || media.app.replace(/\.desktop$/, '').split('.').pop();
+        this._fromChip.text = `From ${this._offer.name}`;
+        this._chipBoxes[1].visible = Boolean(this._offer.name);
+        this._title.text = media.item;
+        this._subtitle.text = media.subtitle ?? '';
+        this._subtitle.visible = Boolean(media.subtitle);
+        const left = minutesLeft(media);
+        this._progress.visible = left !== null;
+        this._left.text = left !== null ? `${left} min left` : '';
+        this._share = media.length > 0 ? Math.min(1, (media.position ?? 0) / media.length) : 0;
+        // Nothing played yet: there's nothing to start over.
+        this.buttons[1].button.visible = (media.position ?? 0) > 0;
+        this._artSource = media.art ?? null;
+        this._artSize = null;
+        this.restyle();
+    }
+
+    // Show the artwork while the home is the page (onHome) and there is one.
+    showBackdrop(onHome, duration = 0) {
+        const on = onHome && this.visible && Boolean(this._art.content);
+        this.backdrop.remove_all_transitions();
+        if (on)
+            this.backdrop.show();
+        this.backdrop.ease({opacity: on ? 255 : 0, duration, mode: Clutter.AnimationMode.EASE_OUT_QUAD,
+            onComplete: () => { if (!on) this.backdrop.hide(); }});
+    }
+
+    _placeArt(width, height) {
+        if (this._artSize?.width === width && this._artSize?.height === height)
+            return;
+        this._artSize = {width, height};
+        this._art.content = null;
+        const pixbuf = this._offer ? artPixbuf(this._artSource) : null;
+        if (pixbuf && width > 0 && height > 0) {
+            const crop = coverCrop(pixbuf.width, pixbuf.height, width, height, HERO.art_x, HERO.art_y);
+            const part = pixbuf.new_subpixbuf(crop.x, crop.y, crop.width, crop.height).copy();
+            const content = St.ImageContent.new_with_preferred_size(part.width, part.height);
+            content.set_bytes(global.stage.context.get_backend().get_cogl_context(), part.read_pixel_bytes(),
+                part.has_alpha ? Cogl.PixelFormat.RGBA_8888 : Cogl.PixelFormat.RGB_888,
+                part.width, part.height, part.rowstride);
+            this._art.content = content;
+        }
+        this._shade.queue_repaint();
+        this.showBackdrop(this._tv._page === 'home');
+    }
+
+    _paintShade(area) {
+        const cr = area.get_context();
+        const [width, height] = area.get_surface_size();
+        for (const [[x0, y0, x1, y1], stops] of SHADE) {
+            const gradient = new Cairo.LinearGradient(x0 * width, y0 * height, x1 * width, y1 * height);
+            for (const [offset, [r, g, b], alpha] of stops)
+                gradient.addColorStopRGBA(offset, r / 255, g / 255, b / 255, alpha);
+            cr.setSource(gradient);
+            cr.paint();
+        }
+        cr.$dispose();
+    }
+
+    activate(index) {
+        const offer = this._offer;
+        if (!offer)
+            return;
+        const fromStart = this.buttons[index]?.fromStart ?? false;
+        this.set(null);
+        this._play?.(fromStart, offer);
+    }
+
+    // Focusable items for the remote: the hero's buttons.
+    items() {
+        if (!this.visible)
+            return [];
+        return this.buttons.filter(b => b.button.visible).map(({button}, index) => {
+            const [x, y] = button.get_transformed_position();
+            const [ox, oy] = this._tv._home.get_transformed_position();
+            return {kind: 'hero', index, x: x - ox, y: y - oy, width: button.width, height: button.height};
+        });
+    }
+
+    restyle() {
+        const tv = this._tv;
+        if (!tv._u)
+            return;
+        const m = name => tv._material(name);
+        const px = value => tv._px(value);
+        this.actor.set_position(tv._tokens.layout.safe_x * tv._u, HERO.top * tv._u);
+        this.actor.style = `width: ${px(HERO.width)};`;
+        this._chips.style = `spacing: ${px(HERO.chip_gap)};`;
+        for (const [index, chip] of this._chipBoxes.entries()) {
+            chip.style = `height: ${px(HERO.chip_height)}; padding: 0 ${px(HERO.chip_padding_x)};
+                border-radius: ${px(HERO.chip_radius)}; background-color: ${m('chip')};`;
+            [this._appChip, this._fromChip][index].style =
+                `${tv._font(HERO.chip_size, HERO.chip_weight)} color: ${m('ink')};`;
+        }
+        // The title's line is 0.95 of its size (the reference's line-height):
+        // St lays out the font's own line, so the gaps around it give back
+        // half the difference each.
+        const titleFont = `${tv._font(HERO.title_size, HERO.title_weight)} color: ${m('ink')};
+            letter-spacing: ${px(HERO.title_size * HERO.title_tracking)};`;
+        this._title.style = titleFont;
+        this._title.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+        let half = 0;
