+
+    // The focused button is the key (the TV's one bright thing); the other
+    // sits on the chip material.
+    draw(focus) {
+        const tv = this._tv;
+        if (!this.visible || !tv._u)
+            return;
+        const m = name => tv._material(name);
+        const px = value => tv._px(value);
+        this.buttons.forEach(({button, box, glyph, text}, index) => {
+            const focused = focus?.kind === 'hero' && focus.index === index;
+            const ink = focused ? m('key_ink') : m('ink');
+            button.style = `height: ${px(HERO.button_height)}; padding: 0 ${px(HERO.button_padding_x)};
+                border-radius: ${px(HERO.button_radius)};` +
+                // The edge is a ring outside the box (lumaui-tv.css --key-edge),
+                // so focus doesn't change the button's size; at rest the chip
+                // has no edge, only its drop.
+                (focused
+                    ? `background-gradient-direction: vertical; background-gradient-start: ${m('key_top')};
+                       background-gradient-end: ${m('key_bottom')};
+                       box-shadow: 0 0 0 ${px(1.5)} ${m('key_rim')};`
+                    : `background-color: ${m('chip')};
+                       box-shadow: 0 ${px(2)} ${px(5)} ${m('chip_drop')};`);
+            box.style = `spacing: ${px(HERO.button_spacing)};`;
+            glyph.icon_size = Math.round(HERO.button_icon * tv._u /
+                (St.ThemeContext.get_for_stage(global.stage).scale_factor || 1));
+            glyph.style = `color: ${ink};`;
+            text.style = `${tv._font(HERO.button_size, HERO.button_weight)} color: ${ink};`;
+        });
+    }
+}
