+// Where Depot keeps a listing's picture (luma_depot.model.catalogue_v1.MediaCache).
+export function depotMediaPath(url, root = depotRoots()[1]) {
+    const clean = url.split('#')[0];
+    const digest = GLib.compute_checksum_for_string(GLib.ChecksumType.SHA256, clean, -1).slice(0, 32);
+    return GLib.build_filenamev([root, 'media', digest, clean.split('/').pop()]);
+}
+
+function isPicture(bytes) {
+    const head = bytes.slice(0, 256);
+    const png = [0x89, 0x50, 0x4e, 0x47].every((b, i) => head[i] === b);
+    const text = new TextDecoder().decode(head).trimStart();
+    return png || text.startsWith('<svg') || text.startsWith('<?xml');
+}
+
+async function fetchDepotIcon(url, path) {
+    fetching.add(url);
+    try {
+        soup ??= new Soup.Session({timeout: 15, max_conns: 2, max_conns_per_host: 1});
+        const message = Soup.Message.new('GET', url);
+        const bytes = await soup.send_and_read_async(message, GLib.PRIORITY_LOW, null);
+        if (message.get_status() !== Soup.Status.OK)
+            return;
+        const data = bytes.get_data() ?? new Uint8Array();
+        if (data.length === 0 || data.length > ICON_MAX_BYTES || !isPicture(data))
+            return;
+        // Content-addressed names are checked; other listing pictures come
+        // only from the hosts the signed catalogue names.
+        const name = url.split('/').pop().split('.')[0];
+        if (/^[0-9a-f]{64}$/.test(name) &&
+            GLib.compute_checksum_for_bytes(GLib.ChecksumType.SHA256, bytes) !== name)
+            return;
+        GLib.mkdir_with_parents(GLib.path_get_dirname(path), 0o700);
+        Gio.File.new_for_path(path).replace_contents(data, null, false,
+            Gio.FileCreateFlags.REPLACE_DESTINATION, null);
+        for (const listener of iconListeners)
+            listener();
+    } catch (e) {
+        log(`[luma-continue] Depot icon ${url}: ${e.message}`);
+    } finally {
+        fetching.delete(url);
+    }
+}
+
+function depotIcon(id) {
+    const entry = catalogueEntry(id);
+    const url = entry?.icon?.split('#')[0];
+    if (!url || !DEPOT_MEDIA_HOSTS.some(host => url.startsWith(host)))
+        return null;
+    // Depot may have drawn it under either root; a fetch goes to the root
+    // whose catalogue named it, so Depot finds it there too.
+    for (const root of [entry.root, ...depotRoots()]) {
+        const path = depotMediaPath(url, root);
+        if (GLib.file_test(path, GLib.FileTest.IS_REGULAR))
+            return Gio.FileIcon.new(Gio.File.new_for_path(path));
+    }
+    if (!fetching.has(url))
+        fetchDepotIcon(url, depotMediaPath(url, entry.root)).catch(() => {});
+    return null;
+}
