@@ -0,0 +1,304 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Continue on a TV (ADR-055 §6; design-center mockups/continue, target
+// tv-home): no prompt. The TV home's hero, the slot that shows what to
+// resume, carries what was playing on another device: the app chip, then
+// "From ThinkPad", the item, where it was, and Continue (focus starts there)
+// and Start over. A TV gets only media apps with a TV presentation, the item
+// and its position; never a document, another app's title or a sign-in.
+// Once played or replaced, the hero goes back to the TV's own. The item's
+// artwork, when the other device sent it, fills the home behind the hero
+// under the reference's shade.
+
+import Cairo from 'cairo';
+import Clutter from 'gi://Clutter';
+import Cogl from 'gi://Cogl';
+import GdkPixbuf from 'gi://GdkPixbuf';
+import GLib from 'gi://GLib';
+import Pango from 'gi://Pango';
+import St from 'gi://St';
+
+// The hero at 1080 (mockups/luma-tv.html .home .hero), in TV units.
+const HERO = {
+    top: 244, width: 960,
+    chip_gap: 16, chip_height: 40, chip_padding_x: 14, chip_radius: 12, chip_size: 22, chip_weight: 650,
+    title_gap: 22, title_size: 128, title_weight: 750, title_tracking: -0.05, title_line: 0.95,
+    subtitle_gap: 18, subtitle_size: 30, subtitle_weight: 600,
+    progress_gap: 25, track_width: 520, track_height: 6, track_label_gap: 20, label_size: 24, label_weight: 500,
+    buttons_gap: 39.5, button_gap: 16,
+    button_height: 72, button_padding_x: 32, button_radius: 20, button_size: 28, button_weight: 650,
+    button_icon: 30, button_spacing: 14,
+    // The artwork's focus point (background-position 50% 40%).
+    art_x: 0.5, art_y: 0.4,
+};
+
+// The home's shade over the artwork (.home .shade), back to front: [direction
+// (x0, y0, x1, y1 as a share of the screen), stops [offset, rgb, alpha]].
+const SHADE_TOP = [5, 6, 8];       // oklch(0.12 0.006 265)
+const SHADE_FOOT = [8, 9, 12];     // oklch(0.14 0.006 265)
+const SHADE = [
+    [[0, 0, 0, 1], [[0, SHADE_TOP, 0.82], [0.16, SHADE_TOP, 0.35], [0.26, SHADE_TOP, 0]]],
+    [[0, 0, 1, 0], [[0, SHADE_TOP, 0.92], [0.40, SHADE_TOP, 0.5], [0.58, SHADE_TOP, 0], [0.72, SHADE_TOP, 0.55],
+        [1, SHADE_TOP, 0.85]]],
+    [[0, 1, 0, 0], [[0, SHADE_FOOT, 1], [0.22, SHADE_FOOT, 0.82], [0.44, SHADE_FOOT, 0.4], [0.60, SHADE_FOOT, 0]]],
+];
+
+// base64 JPEG -> pixbuf, or null.
+export function artPixbuf(art) {
+    if (typeof art !== 'string' || !art)
+        return null;
+    try {
+        const loader = GdkPixbuf.PixbufLoader.new_with_type('jpeg');
+        loader.write_bytes(new GLib.Bytes(GLib.base64_decode(art)));
+        loader.close();
+        return loader.get_pixbuf();
+    } catch {
+        return null;
+    }
+}
+
+// The source rectangle that covers width x height around the focus point.
+export function coverCrop(sourceWidth, sourceHeight, width, height, fx = 0.5, fy = 0.5) {
+    const scale = Math.max(width / sourceWidth, height / sourceHeight);
+    const w = Math.min(sourceWidth, Math.round(width / scale));
+    const h = Math.min(sourceHeight, Math.round(height / scale));
+    return {x: Math.round((sourceWidth - w) * fx), y: Math.round((sourceHeight - h) * fy), width: w, height: h};
+}
+
+export function minutesLeft(media) {
+    if (!(media?.length > 0))
+        return null;
+    return Math.max(1, Math.round((media.length - Math.min(media.position ?? 0, media.length)) / 60));
+}
+
+export class TvContinueHero {
+    // tv: the TvPresentation (its units, fonts and materials).
+    constructor(tv) {
+        this._tv = tv;
+        this._offer = null;
