From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luma <engineering@projectluma.org>
Date: Wed, 25 Nov 2026 02:00:00 -0600
Subject: [PATCH] TV keyboard: only the focused app labels its action key

SetActionLabel labelled the focused window's action key for any caller.
The caller is now named by its process (a Flatpak by the .flatpak-info of
its bus proxy, a Luma sandbox by AppPermissions1 Identify, a host program
by its process or app scope; lumaPresentation/callerWindow.js) and must own
the focused window, and no Shell modal or Shell actor may hold the keys;
anything else gets AccessDenied.
---
diff --git a/js/js-resources.gresource.xml b/js/js-resources.gresource.xml
index 43b493d..fc9afdf 100644
--- a/js/js-resources.gresource.xml
+++ b/js/js-resources.gresource.xml
@@ -202,6 +202,7 @@
     <file>ui/lumaPresentation/tvAppSwitcher.js</file>
     <file>ui/lumaPresentation/tvAppSwitcherModel.js</file>
     <file>ui/lumaPresentation/tvPointer.js</file>
+    <file>ui/lumaPresentation/callerWindow.js</file>
     <file>ui/lumaPresentation/cellularStatus.js</file>
     <file>ui/lumaPresentation/mediaRow.js</file>
     <file>ui/lumaPresentation/mediaRowTokens.js</file>
diff --git a/js/ui/keyboard.js b/js/ui/keyboard.js
index ca80e98..85fad9f 100644
--- a/js/ui/keyboard.js
+++ b/js/ui/keyboard.js
@@ -21,6 +21,7 @@ import * as SwipeTracker from './swipeTracker.js';
 import * as Keycap from './lumaPresentation/keycap.js';
 import {bottomCornerClearance, readDisplayProfiles, selectDisplayProfile} from './lumaPresentation/safeAreas.js';
 import * as TvKeyboard from './lumaPresentation/tvKeyboard.js';
+import {actsForFocusedApp, callerIdentity} from './lumaPresentation/callerWindow.js';
 import {tv as TV_TOKENS} from './lumaPresentation/tvTokens.js';
 
 export const KEYBOARD_ANIMATION_TIME = 150;
@@ -1518,15 +1519,25 @@ class TvKeyboardService {
 
     // The label is the focused window's: an application asks as one of its
     // fields takes the focus, and an empty label gives the field's own back.
-    SetActionLabel(label) {
-        const window = global.display.focus_window;
-        if (!window)
-            return;
-        if (label)
-            this._labels.set(window, String(label));
-        else
-            this._labels.delete(window);
-        this._onLabel();
+    // Only the application that owns the focused window may label its key,
+    // and never while a Shell modal (polkit, unlock, a Shell dialog) or a
+    // Shell actor has the keys: the key pressed there is not the app's.
+    SetActionLabelAsync([label], invocation) {
+        callerIdentity(invocation.get_sender()).then(caller => {
+            const window = global.display.focus_window;
+            if (!actsForFocusedApp(caller, window, Main.modalCount, global.stage.key_focus, global.stage)) {
+                invocation.return_error_literal(Gio.DBusError, Gio.DBusError.ACCESS_DENIED,
+                    'Only the focused app can label the keyboard');
+                return;
+            }
+            if (label)
+                this._labels.set(window, String(label));
+            else
+                this._labels.delete(window);
+            this._onLabel();
+            invocation.return_value(null);
+        }).catch(error => invocation.return_error_literal(Gio.DBusError, Gio.DBusError.ACCESS_DENIED,
+            error.message));
     }
 
     labelFor(window) {
