diff --git a/data/theme/Suno-continue.css b/data/theme/Suno-continue.css
new file mode 100644
index 0000000..453ecfc
--- /dev/null
+++ b/data/theme/Suno-continue.css
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Continue (ADR-055): what the banner adds below its body. Design:
+ * design-center mockups/continue/cn.css. Light values first; the banner's
+ * smoked (dark) surface overrides; frost and glass are paper and keep them. */
+.Suno-continue { spacing: 0; }
+
+/* App strip: 24 px icons, 6 px apart, then +N in a 24 px chip, 9 px under the body. */
+/* 8 px: the content column already puts 1 px between the body and this box. */
+.Suno-continue-apps { spacing: 6px; margin-top: 8px; }
+.Suno-continue-more {
+  height: 24px; width: 24px; padding: 0; border-radius: 7px;
+  background-color: #dfe1e4; font-size: 11px; font-weight: 650; text-align: center;
+}
+
+/* The line when this device already has windows: neutral ink, never a warning. */
+.Suno-continue-note { spacing: 7px; margin-top: 9px; height: 16px; font-size: 12px; }
+.Suno-continue-note StIcon { margin-top: 1px; color: rgba(31, 35, 40, 0.78); }
+.Suno-continue-note StLabel { color: rgba(31, 35, 40, 0.78); }
+
+/* SunoUI progress: 4 px under the strip; 3 px in a list row. */
+.Suno-continue-progress {
+  height: 4px; margin-top: 10px; border-radius: 3px;
+  background-color: rgba(0, 0, 0, 0.10);
+}
+.Suno-continue-progress-small { height: 3px; margin-top: 6px; }
+.Suno-continue-progress-fill { height: 4px; border-radius: 3px; background-color: #3584e4; }
+.Suno-continue-progress-small .Suno-continue-progress-fill { height: 3px; }
+
+/* The result list, grown in place: 28 px icon, name 12.5/650, reason 12/400,
+ * each on a 16 px line; hairlines between rows. */
+/* 11 px: the content column already puts 1 px between the body and this box. */
+.Suno-continue-list { margin-top: 11px; border-top: 1px solid rgba(0, 0, 0, 0.08); }
+.Suno-continue-row { spacing: 12px; padding: 9px 0; }
+.Suno-continue-divider { height: 1px; background-color: rgba(0, 0, 0, 0.06); }
+.Suno-continue-row-name { font-size: 12.5px; font-weight: 650; min-height: 16px; }
+.Suno-continue-row-reason { font-size: 12px; font-weight: 400; min-height: 16px; color: rgba(31, 35, 40, 0.66); }
+.Suno-continue-open {
+  height: 26px; padding: 0 12px; border-radius: 9px;
+  background-color: #dfe1e4; font-size: 12px; font-weight: 650;
+}
+
+.Suno-surface-dark .Suno-continue-more,
+.Suno-surface-dark .Suno-continue-open { background-color: #32363c; }
+.Suno-surface-dark .Suno-continue-note StLabel,
+.Suno-surface-dark .Suno-continue-note StIcon,
+.Suno-surface-dark .Suno-continue-row-reason { color: rgba(231, 233, 232, 0.62); }
+.Suno-surface-dark .Suno-continue-list { border-top-color: rgba(255, 255, 255, 0.08); }
+.Suno-surface-dark .Suno-continue-divider { background-color: rgba(255, 255, 255, 0.06); }
+.Suno-surface-dark .Suno-continue-progress { background-color: rgba(255, 255, 255, 0.10); }
+
+/* Done, 6 px under the list. */
+.Suno-notification-lip .notification-banner.Suno-lip-card .message-action-bin.Suno-notification-actions-end { padding-top: 6px; }
