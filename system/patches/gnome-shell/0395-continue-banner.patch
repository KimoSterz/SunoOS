diff --git a/js/ui/SunoContinue.js b/js/ui/SunoContinue.js
new file mode 100644
index 0000000..96d6ecf
--- /dev/null
+++ b/js/ui/SunoContinue.js
@@ -0,0 +1,500 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The Continue banner (ADR-055; design: design-center mockups/continue).
+//
+// One standard shell banner that changes in place: the offer ("Continue
+// from ThinkPad?"), restoring (progress, Stop), and the result, which grows
+// into its list. The same banner reports a restore after restart on this
+// device that didn't reopen everything. It never times out while it offers
+// or restores; dismissed, it waits in the notification list.
+
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GObject from 'gi://GObject';
+import GLib from 'gi://GLib';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as MessageTray from './messageTray.js';
+import {peekNotificationLip} from './SunoNotificationBeacon.js';
+
+const STYLESHEET_URI = 'resource:///org/gnome/shell/theme/Suno-continue.css';
+const CONNECT_ICON = 'org.projectSuno.Connect';
+const DESKTOP_ICON = 'org.gnome.Settings';
+const STRIP_MAX = 6;
+const LIST_OUTDENT = 46;
+const RESTORE_BUDGET_MS = 20 * 1000;
+
+let stylesheetLoaded = false;
+
+// Lays its child out from `outdent` px left of its own box: the result
+// list starts under the card's source icon, not under the text column.
+const OutdentBin = GObject.registerClass(
+class OutdentBin extends St.Widget {
+    _init(child, outdent) {
+        super._init({x_expand: true});
+        this._outdent = outdent;
+        this.add_child(child);
+    }
+
+    vfunc_get_preferred_width(_forHeight) {
+        return [0, 0];
+    }
+
+    vfunc_get_preferred_height(forWidth) {
+        return this.get_first_child().get_preferred_height(forWidth < 0 ? -1 : forWidth + this._outdent);
+    }
+
+    vfunc_allocate(box) {
+        this.set_allocation(box);
+        const child = this.get_first_child();
+        const width = box.get_width() + this._outdent;
+        const [, height] = child.get_preferred_height(width);
+        child.allocate(new Clutter.ActorBox({x1: -this._outdent, y1: 0, x2: width - this._outdent, y2: height}));
+    }
+});
+
+function loadStylesheet() {
+    if (stylesheetLoaded)
+        return;
+    const theme = St.ThemeContext.get_for_stage(global.stage).get_theme();
+    try {
+        theme.load_stylesheet(Gio.File.new_for_uri(STYLESHEET_URI));
+        stylesheetLoaded = true;
+    } catch (e) {
+        logError(e, '[Suno-continue] stylesheet');
+    }
+}
+
+function plural(n, one, many) {
+    return n === 1 ? one : many;
+}
+
+export function windowsInApps(windows, apps) {
+    return `${windows} ${plural(windows, 'window', 'windows')} in ${apps} ${plural(apps, 'app', 'apps')}`;
+}
+
+function clock(seconds) {
+    return GLib.DateTime.new_from_unix_local(seconds).format('%R');
+}
+
+// The apps of a snapshot in stacking order (topmost first), each once,
+// with the name and icon the snapshot carries for them.
+export function snapshotApps(snapshot) {
+    const info = new Map((snapshot.apps ?? []).map(a => [a.app, a]));
+    const seen = new Map();
+    for (const w of [...(snapshot.windows ?? [])].reverse()) {
+        const id = w.app ?? `${w.ids?.wmClass}.desktop`;
+        if (!seen.has(id))
+            seen.set(id, {id, windows: 0, name: info.get(id)?.name ?? null, icon: info.get(id)?.icon ?? null});
+        seen.get(id).windows++;
+    }
+    return [...seen.values()];
+}
+
+// What the device that took the snapshot called each app and drew it with:
+// an app not installed here still shows its own name and icon.
+const known = new Map();
+
+export function rememberApps(apps) {
+    for (const app of apps ?? []) {
+        if (app.name || app.icon)
+            known.set(app.id, app);
+    }
+}
+
+function appFor(id) {
+    return Shell.AppSystem.get_default().lookup_app(id);
+}
+
+// Apps neither installed here nor named by the snapshot: the Depot's kept
+// catalogue (signed, verified by the installer when it was written; read here
+// for display only) gives the name, and Flathub's AppStream icon cache the
+// picture.
+const CATALOGUE_MAX_BYTES = 16 * 1024 * 1024;
+let catalogue = null;
+let iconTheme = null;
+
+function catalogueEntry(id) {
+    if (catalogue === null) {
+        catalogue = new Map();
+        try {
+            const path = GLib.build_filenamev([GLib.get_user_cache_dir(), 'Suno', 'depot', 'catalogue-v1.json']);
+            const file = Gio.File.new_for_path(path);
+            if (file.query_info('standard::size', 0, null).get_size() <= CATALOGUE_MAX_BYTES) {
+                const document = JSON.parse(new TextDecoder().decode(file.load_contents(null)[1]));
+                for (const row of document?.apps ?? []) {
+                    if (typeof row?.id === 'string' && typeof row?.name === 'string')
+                        catalogue.set(row.id.toLowerCase(), row.name.slice(0, 128));
+                }
+            }
+        } catch {}
+    }
+    return catalogue.get(id.replace(/\.desktop$/, '').toLowerCase()) ?? null;
+}
+
+function appstreamIcon(id) {
+    const bare = id.replace(/\.desktop$/, '');
+    const roots = [GLib.build_filenamev([GLib.get_user_data_dir(), 'flatpak', 'appstream']), '/var/lib/flatpak/appstream'];
+    for (const root of roots) {
+        for (const remote of ['flathub', 'Suno']) {
+            for (const size of ['128x128', '64x64']) {
+                const path = GLib.build_filenamev([root, remote, Shell.util_get_architecture?.() ?? 'x86_64',
+                    'active', 'icons', size, `${bare}.png`]);
+                if (GLib.file_test(path, GLib.FileTest.EXISTS))
+                    return Gio.FileIcon.new(Gio.File.new_for_path(path));
+            }
+        }
+    }
+    return null;
+}
+
+export function appName(id) {
+    return appFor(id)?.get_name() ?? known.get(id)?.name ?? catalogueEntry(id) ??
+        id.replace(/\.desktop$/, '').split('.').pop();
+}
+
+function appIcon(id, size) {
+    const app = appFor(id);
+    if (app)
+        return app.create_icon_texture(size);
+    let gicon = null;
+    try {
+        const name = known.get(id)?.icon;
+        const candidate = name ? Gio.Icon.new_for_string(name) : null;
+        // A themed name only counts when this computer's theme has it.
+        iconTheme ??= St.IconTheme.new?.() ?? null;
+        if (candidate instanceof Gio.ThemedIcon && iconTheme?.has_icon &&
+            !iconTheme.has_icon(candidate.get_names()[0]))
+            gicon = null;
+        else
+            gicon = candidate;
+    } catch {}
+    gicon ??= appstreamIcon(id);
+    return new St.Icon({gicon: gicon ?? new Gio.ThemedIcon({name: 'application-x-executable'}), icon_size: size});
+}
+
+// Rows of the result list, one per app that needs a word.
+export function resultRows(result) {
+    const rows = [];
+    for (const id of result.installing ?? [])
+        rows.push({id, reason: 'Installing · opens when it’s ready', progress: result.progress?.[id] ?? 0});
+    for (const id of result.missing ?? [])
+        rows.push({id, reason: 'Not available on this device'});
+    for (const id of [...(result.unplaced ?? []), ...(result.failed ?? [])])
+        rows.push({id, reason: 'Didn’t open in time', open: true});
+    for (const {id, document} of result.withoutDocuments ?? [])
+        rows.push({id, reason: `Opened without “${document}”. It hasn’t synced yet.`});
+    for (const {id, windows} of result.moved ?? [])
+        rows.push({id, reason: `${windows} ${plural(windows, 'window', 'windows')} on this screen. The other display isn’t here.`});
+    return rows;
+}
+
+// The line under "Reopened 8 of 11 windows".
+export function resultSummary(result) {
+    const installing = result.installing ?? [];
+    const failed = new Set([...(result.missing ?? []), ...(result.unplaced ?? []), ...(result.failed ?? [])]);
+    const parts = [];
+    if (installing.length)
+        parts.push(`${appName(installing[0])} is installing and opens when it’s ready.`);
+    if (failed.size === 1 && !installing.length)
+        parts.push(`${appName([...failed][0])} didn’t open${(result.unplaced ?? []).includes([...failed][0]) ? ' in time' : ''}.`);
+    else if (failed.size)
+        parts.push(`${failed.size} ${plural(failed.size, 'app', 'apps')} didn’t open.`);
+    return parts.join(' ');
+}
+
+export class ContinueBanner {
+    constructor() {
+        loadStylesheet();
+        this._notification = null;
+        this._state = null;
+    }
+
+    _ensure(sourceTitle, iconName, urgency) {
+        if (this._notification && this._sourceTitle !== sourceTitle)
+            this.close();
+        if (!this._notification) {
+            this._sourceTitle = sourceTitle;
+            const source = new MessageTray.Source({
+                title: sourceTitle,
+                icon: new Gio.ThemedIcon({name: iconName}),
+                policy: new MessageTray.NotificationGenericPolicy(),
+            });
+            Main.messageTray.add(source);
+            this._notification = new MessageTray.Notification({
+                source, title: '', body: '', isTransient: false, urgency,
+            });
+            this._notification.SunoContent = {
+                views: new Set(),
+                actions: [],
+                equalActions: false,
+                build: message => this._build(message),
+            };
+            this._notification.connect('destroy', () => {
+                this._notification = null;
+                this._stopTick();
+            });
+            this._source = source;
+        }
+        this._notification.urgency = urgency;
+        return this._notification;
+    }
+
+    // The tray measures a card when it places it: ask again after the
+    // content grew or shrank in place.
+    _relayout() {
+        GLib.idle_add(GLib.PRIORITY_DEFAULT, () => {
+            peekNotificationLip()?._queuePlace?.();
+            return GLib.SOURCE_REMOVE;
+        });
+    }
+
+    // when: what the banner is about happened then (a snapshot taken, a
+    // continue elsewhere); the source row shows its age. Otherwise now.
+    _set({title, body, actions = [], equal = false, state, when = null}) {
+        const n = this._notification;
+        this._state = state;
+        const datetime = when ? GLib.DateTime.new_from_unix_local(when) : GLib.DateTime.new_now_local();
+        n.set({title, body, datetime});
+        n.clearActions();
+        n.SunoContent.equalActions = equal;
+        // In-place buttons: a Notification action would mark the banner acted
+        // on and close it, and every state here changes the same banner.
+        n.SunoContent.actions = actions.map(([label, callback]) => ({label, callback, end: state === 'list'}));
+        for (const rebuild of n.SunoContent.views)
+            rebuild();
+        if (!this._shown) {
+            this._shown = true;
+            this._source.addNotification(n);
+        }
+        this._relayout();
+    }
+
+    close() {
+        this._stopTick();
+        this._notification?.destroy(MessageTray.NotificationDestroyedReason.SOURCE_CLOSED);
+        this._notification = null;
+        this._shown = false;
+    }
+
+    // --- states ----------------------------------------------------------
+
+    // 1, 2, 5 (reverse) and handheld: the question, with Continue and Not
+    // now of equal weight.
+    offer({device, windows, apps, busy = false, continuedAt = null, handheldApp = null, taken = null},
+        onContinue, onNotNow) {
+        this._ensure('Suno Connect', CONNECT_ICON, MessageTray.Urgency.CRITICAL);
+        rememberApps(apps);
+        this._apps = apps;
+        this._done = null;
+        this._busy = busy && !handheldApp;
+        const title = handheldApp
+            ? `Continue ${appName(handheldApp)} from ${device}?`
+            : `Continue from ${device}?`;
+        let body = handheldApp ? 'Opens beside what’s here.' : windowsInApps(windows, apps.length);
+        if (continuedAt && !handheldApp)
+            body += ` · you continued there at ${clock(continuedAt)}`;
+        this._set({
+            title, body, equal: true, state: 'offer', when: taken,
+            actions: [['Continue', onContinue], ['Not now', onNotNow]],
+        });
+    }
+
+    // 3: the same banner, counting windows as they are placed.
+    restoring({device, total, apps = null, onStop}) {
+        this._ensure('Suno Connect', CONNECT_ICON, MessageTray.Urgency.CRITICAL);
+        if (apps) {
+            rememberApps(apps);
+            this._apps = apps;
+        }
+        this._total = total;
+        this._placed = 0;
+        this._done = new Set();
+        this._busy = false;
+        this._started = GLib.get_monotonic_time();
+        this._set({
+            title: `Continuing from ${device}`,
+            body: `0 of ${total} windows`,
+            actions: [['Stop', onStop]],
+            state: 'restoring',
+        });
+        this._startTick();
+    }
+
+    placed(appId) {
+        if (this._state !== 'restoring')
+            return;
+        this._placed++;
+        this._done.add(appId);
+        this._notification?.set({body: `${this._placed} of ${this._total} windows`});
+        for (const rebuild of this._notification?.SunoContent.views ?? [])
+            rebuild();
+    }
+
+    // 4: the result, which grows into its list in place. When everything
+    // was placed the banner just closes.
+    result({result, device, at, local = false, apps = null, onOpen}) {
+        rememberApps(apps);
+        this._stopTick();
+        const rows = resultRows(result);
+        if (rows.length === 0) {
+            this.close();
+            return;
+        }
+        // After a restart: an ordinary banner (standard timeout, then the
+        // list; Do Not Disturb sends it straight to the list), shown as a
+        // banner rather than only in the notification island.
+        if (local) {
+            this._ensure('Desktop', DESKTOP_ICON, MessageTray.Urgency.NORMAL);
+            this._notification.forFeedback = true;
+        }
+        else
