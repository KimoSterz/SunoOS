diff --git a/js/ui/lumaAppPermissions.js b/js/ui/lumaAppPermissions.js
new file mode 100644
index 0000000..be0f491
--- /dev/null
+++ b/js/ui/lumaAppPermissions.js
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// App permissions for every format (ADR-052 step 3), the Shell's part:
+// - the folder offer. org.projectluma.AppPermissions1 emits Refused(app,
+//   folder) once per app and folder, ever, when the app was refused one of the
+//   person's folders; the Shell offers it with the standard banner
+//   (lumaPermissionOffer.js): "Music folder", "Let Tide use your Music
+//   folder?", Allow / Not now. The answer goes back with AnswerOffer, which
+//   remembers it (Not now and dismiss too) and on Allow makes the folder
+//   appear for the running app at once.
+// - the command-line review. A scripted install never waits on Valet's sheet;
+//   ReviewRequested(app, name) becomes a standard notification from Valet,
+//   "Kiln installed", whose Review opens the sheet in review mode.
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import Shell from 'gi://Shell';
+
+import * as Main from './main.js';
+import * as MessageTray from './messageTray.js';
+import * as Model from './lumaAppPermissionsModel.js';
+import {appInfo, showOffer} from './lumaPermissionOffer.js';
+
+const BUS_NAME = 'org.projectluma.AppPermissions1';
+const OBJECT_PATH = '/org/projectluma/AppPermissions';
+const VALET = 'io.luma.Valet';
+
+class AppPermissions {
+    constructor() {
+        this._offers = new Map();
+        this._bus = Gio.DBus.session;
+        this._signals = [
+            this._bus.signal_subscribe(BUS_NAME, BUS_NAME, 'Refused', OBJECT_PATH, null,
+                Gio.DBusSignalFlags.NONE, (_c, _s, _p, _i, _n, params) => this._refused(...params.deepUnpack())),
+            this._bus.signal_subscribe(BUS_NAME, BUS_NAME, 'ReviewRequested', OBJECT_PATH, null,
+                Gio.DBusSignalFlags.NONE, (_c, _s, _p, _i, _n, params) => this._review(...params.deepUnpack())),
+            this._bus.signal_subscribe(BUS_NAME, BUS_NAME, 'RestartRequested', OBJECT_PATH, null,
+                Gio.DBusSignalFlags.NONE, (_c, _s, _p, _i, _n, params) => this._restart(...params.deepUnpack())),
+        ];
+    }
+
+    _call(method, args) {
+        this._bus.call(BUS_NAME, OBJECT_PATH, BUS_NAME, method, args, null,
+            Gio.DBusCallFlags.NONE, 15000, null, (bus, result) => {
+                try {
+                    bus.call_finish(result);
+                } catch (e) {
+                    logError(e, `AppPermissions1.${method}`);
+                }
+            });
+    }
+
+    _refused(app, folder) {
+        if (!app || !Model.offerable(folder))
+            return;
+        const key = Model.offerKey(app, folder);
+        if (this._offers.has(key))
+            return;
+        const {name} = appInfo(app);
+        const words = Model.offerWords(name, folder);
+        const notification = showOffer({
+            appId: app, title: words.title, body: words.body, allow: words.allow, notNow: words.notNow,
+            decide: allowed => this._call('AnswerOffer', new GLib.Variant('(ssb)', [app, folder, allowed])),
+        });
+        this._offers.set(key, notification);
+        notification.connect('destroy', () => this._offers.delete(key));
+    }
+
+    // Settings' "Restart <App>": ask the app to quit the normal way (its own unsaved-work
+    // prompt can appear and keep it open), then open it again once it has closed. Never killed.
+    _restart(app) {
+        const {app: shellApp} = appInfo(app);
+        if (!shellApp || shellApp.get_state() === Shell.AppState.STOPPED)
+            return;
+        let timeout = 0;
+        const id = shellApp.connect('notify::state', () => {
+            if (shellApp.get_state() !== Shell.AppState.STOPPED)
+                return;
+            shellApp.disconnect(id);
+            GLib.source_remove(timeout);
+            shellApp.activate();
+        });
+        // The person kept it open from its own prompt: stop waiting after a while.
+        timeout = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT, 300, () => {
+            shellApp.disconnect(id);
+            return GLib.SOURCE_REMOVE;
+        });
+        shellApp.request_quit();
+    }
+
+    _review(app, name) {
+        const valet = Shell.AppSystem.get_default().lookup_app(`${VALET}.desktop`);
+        const source = new MessageTray.Source({
+            title: valet?.get_name() ?? 'Valet',
+            icon: valet?.get_icon() ?? new Gio.ThemedIcon({name: VALET}),
+            policy: new MessageTray.NotificationGenericPolicy(),
+        });
+        Main.messageTray.add(source);
+        const words = Model.reviewWords(name || app);
+        const notification = new MessageTray.Notification({source, title: words.title, isTransient: false});
+        const open = () => {
+            try {
+                Gio.Subprocess.new(['luma-install', '--review', app], Gio.SubprocessFlags.NONE);
+            } catch (e) {
+                logError(e, 'Opening the review');
+            }
+        };
+        notification.addAction(words.action, open);
+        notification.connect('activated', open);
+        source.addNotification(notification);
+    }
+
+    destroy() {
+        for (const id of this._signals)
+            this._bus.signal_unsubscribe(id);
+        this._signals = [];
+    }
+}
+
+let _instance = null;
+
+export function init() {
+    if (!_instance)
+        _instance = new AppPermissions();
+    return _instance;
+}
diff --git a/js/ui/lumaAppPermissionsModel.js b/js/ui/lumaAppPermissionsModel.js
new file mode 100644
index 0000000..6e1770f
--- /dev/null
+++ b/js/ui/lumaAppPermissionsModel.js
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// What the folder offer and the command-line review say (ADR-052 step 3,
+// design-center 8bd4ccf mockups/app-perms). Pure: tests/gnome-shell/app-permissions-policy.js.
+
+// A folder the person can give an app: one of the folders in their home
+// folder, by name. Keys, other apps' data and anything hidden are never offered.
+export function offerable(folder) {
+    return typeof folder === 'string' && folder.length > 0 && !folder.includes('/') &&
+        !folder.startsWith('.') && folder !== '..';
+}
+
+// The standard banner's words: the folder's display name plus "folder", and the question.
+export function offerWords(appName, folder) {
+    return {
+        title: `${folder} folder`,
+        body: `Let ${appName} use your ${folder} folder?`,
+        allow: 'Allow',
+        notNow: 'Not now',
+    };
+}
+
+// A command-line install finished at the suggested level: "Kiln installed", with Review.
+export function reviewWords(appName) {
+    return {title: `${appName} installed`, action: 'Review'};
+}
+
+// One offer per app and folder at a time; the service remembers the answer for good.
+export function offerKey(app, folder) {
+    return `${app}\u0000${folder}`;
+}
diff --git a/js/ui/lumaPermissionOffer.js b/js/ui/lumaPermissionOffer.js
new file mode 100644
index 0000000..6ac846f
--- /dev/null
+++ b/js/ui/lumaPermissionOffer.js
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// A permission offer: the shell's standard notification banner from the app's
+// own source (its name the source line, its icon the tile), with the Settings
+// icon as a badge only the Shell can set (lumaShellBadge), a title, one
+// question, and Allow and Not now of equal weight, neither a default.
+// Dismissing it counts as Not now. The app keeps running: nothing waits on it.
+// On a TV, where the notification lip is hidden, it is the same banner at TV
+// scale (x1.5) at the top right, the remote's focus on Not now so a stray OK
+// never grants anything; it answers the same notification.
+import Clutter from 'gi://Clutter';
+import GObject from 'gi://GObject';
+import Gio from 'gi://Gio';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as MessageTray from './messageTray.js';
+import * as SurfaceMaterials from './lumaSurfaceMaterials.js';
+import {LumaIconMask} from './iconMask.js';
+
+export const SETTINGS_ICON = 'org.gnome.Settings';
+const ICON_RADIUS = 5 / 16;
+
+export function appInfo(appId) {
+    const app = Shell.AppSystem.get_default().lookup_app(`${appId}.desktop`);
+    return {
+        app,
+        name: app?.get_name() ?? appId,
+        gicon: app?.get_icon() ?? new Gio.ThemedIcon({name: 'application-x-executable'}),
+    };
+}
+
+export function posture() {
+    if (Main.presentation?._state?.posture?.effective === 'tv')
+        return 'tv';
+    return Main.presentation?.mode === 'mobile' ? 'phone' : 'desktop';
+}
+
+function maskedIcon(gicon, size, styleClass) {
+    const icon = new St.Icon({gicon, icon_size: size, style_class: styleClass});
+    try {
+        const mask = new LumaIconMask();
+        mask.set_uniform_float(mask.get_uniform_location('radius'), 1, [ICON_RADIUS]);
+        icon.add_effect_with_name('luma-perm-mask', mask);
+    } catch (e) {
+        logError(e, 'Permission offer icon mask unavailable');
+    }
+    return icon;
+}
+
+const TvOfferToast = GObject.registerClass(
+class LumaPermissionTvOfferToast extends St.BoxLayout {
+    _init(appName, gicon, title, body, labels, answer) {
+        super._init({style_class: 'luma-perm-toast-tv', reactive: true,
+            orientation: Clutter.Orientation.HORIZONTAL});
+        const tile = new St.Widget({style_class: 'luma-perm-toast-tile', layout_manager: new Clutter.BinLayout(),
+            y_align: Clutter.ActorAlign.START});
+        tile.add_child(maskedIcon(gicon, 51, 'luma-perm-toast-icon'));
+        // The art sits 1.5 px above the column's top, as the standard banner's (St has no negative margin).
+        tile.translation_x = 0.5;
+        tile.translation_y = -1.5;
+        const badge = maskedIcon(new Gio.ThemedIcon({name: SETTINGS_ICON}), 26, 'luma-perm-toast-badge');
+        badge.set({x_align: Clutter.ActorAlign.END, y_align: Clutter.ActorAlign.END, x_expand: true, y_expand: true});
+        // The standard banner's tile and badge x1.5 (app art fills 15/16 of its icon box): a 48 px
+        // tile at 22.5, the 24 px badge inside its corner as the desktop's x1.5 (measured: 7.5 px
+        // from the tile art's corner to the badge's, where the 51 px box alone gives 4).
+        badge.translation_x = badge.translation_y = -1;
+        tile.add_child(badge);
+        this.add_child(tile);
+        const column = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL, x_expand: true,
+            style_class: 'luma-perm-toast-column'});
+        const top = new St.BoxLayout({style_class: 'luma-perm-toast-top'});
+        top.add_child(new St.Label({style_class: 'luma-perm-toast-source', text: appName.toLocaleUpperCase(), x_expand: true}));
+        top.add_child(new St.Label({style_class: 'luma-perm-toast-time', text: _('now')}));
+        column.add_child(top);
+        column.add_child(new St.Label({style_class: 'luma-perm-toast-title', text: title}));
+        const text = new St.Label({style_class: 'luma-perm-toast-body', text: body});
+        text.clutter_text.line_wrap = true;
+        column.add_child(text);
+        const actions = new St.BoxLayout({style_class: 'luma-perm-toast-actions'});
+        this._buttons = labels.map((label, index) => {
+            const button = new St.Button({style_class: 'luma-perm-toast-button', label, can_focus: true});
+            button.connect('clicked', () => answer(index === 0));
+            actions.add_child(button);
+            return button;
+        });
+        column.add_child(actions);
+        this.add_child(column);
+        SurfaceMaterials.bindSurface(this, {classActors: [this]});
+        this.connect('key-press-event', (_a, event) =>
+            global.focus_manager.navigate_from_event(event) ? Clutter.EVENT_STOP : Clutter.EVENT_PROPAGATE);
+    }
+
+    show() {
+        const monitor = Main.layoutManager.primaryMonitor;
+        Main.layoutManager.addTopChrome(this);
+        super.show();
+        const [, width] = this.get_preferred_width(-1);
+        this.set_position(monitor.x + monitor.width - 72 - width, monitor.y + 72);
+        this._grab = Main.pushModal(this);
+        this._buttons[1].grab_key_focus();
+    }
+
+    dismiss() {
+        if (this._grab)
+            Main.popModal(this._grab);
+        this._grab = null;
+        this.destroy();
+    }
+});
+
+// showOffer({appId, title, body, allow, notNow, decide}): decide(true) on
+// Allow, decide(false) on Not now or dismiss. Returns the notification.
+export function showOffer({appId, title, body, allow = _('Allow'), notNow = _('Not now'), decide}) {
+    const {name, gicon} = appInfo(appId);
+    const source = new MessageTray.Source({
+        title: name,
+        icon: gicon,
+        policy: new MessageTray.NotificationGenericPolicy(),
+    });
+    Main.messageTray.add(source);
+    const notification = new MessageTray.Notification({
+        source,
+        title,
+        body,
+        isTransient: false,
+        urgency: MessageTray.Urgency.HIGH,
+    });
+    notification.lumaShellBadge = new Gio.ThemedIcon({name: SETTINGS_ICON});
+    notification.lumaPosture = posture();
+    let answered = false;
+    const answer = allowed => {
+        if (answered)
+            return;
+        answered = true;
+        decide(allowed);
+    };
+    notification.addAction(allow, () => answer(true));
+    notification.addAction(notNow, () => answer(false));
+    notification.connect('destroy', (_n, reason) => {
+        if (reason === MessageTray.NotificationDestroyedReason.DISMISSED)
+            answer(false);
+    });
+    source.addNotification(notification);
+    if (notification.lumaPosture === 'tv') {
+        const toast = new TvOfferToast(name, gicon, title, body, [allow, notNow], allowed => {
+            toast.dismiss();
+            answer(allowed);
+            notification.destroy(MessageTray.NotificationDestroyedReason.SOURCE_CLOSED);
+        });
+        notification.connect('destroy', () => {
+            if (toast._grab)
+                toast.dismiss();
+        });
+        toast.show();
+    }
+    return notification;
+}
