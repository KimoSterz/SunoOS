From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Suno <engineering@projectSuno.org>
Date: Wed, 25 Nov 2026 12:30:00 -0600
Subject: [PATCH] Lock: an account without a password locks too

ScreenShield.lock() set the session locked only for an account with a
password; without one the shield was up but not locked, so the first user
activity took it down, LockedHint stayed false, and `loginctl lock-sessions`,
`loginctl lock-session` and ScreenSaver.Lock (Super+L) didn't lock at all.
Every lock now locks. For an account without a password the unlock dialog
stays on the curtain (clock) on every form, and lifting it (click, key,
scroll or swipe) deactivates the shield with no authentication prompt;
an account with a password is unchanged.
---
diff --git a/js/ui/screenShield.js b/js/ui/screenShield.js
index dc66d1c..51b7b1f 100644
--- a/js/ui/screenShield.js
+++ b/js/ui/screenShield.js
@@ -1,4 +1,3 @@
-import AccountsService from 'gi://AccountsService';
 import Clutter from 'gi://Clutter';
 import Gio from 'gi://Gio';
 import GLib from 'gi://GLib';
@@ -662,15 +661,12 @@ export class ScreenShield extends Signals.EventEmitter {
         St.Clipboard.get_default().set_text(St.ClipboardType.CLIPBOARD, '');
         St.Clipboard.get_default().set_text(St.ClipboardType.PRIMARY, '');
 
-        const userManager = AccountsService.UserManager.get_default();
-        const user = userManager.get_user(GLib.get_user_name());
-
         this.activate(animate);
 
-        const lock = this._isGreeter
-            ? true
-            : user.password_mode !== AccountsService.UserPasswordMode.NONE;
-        this._setLocked(lock);
+        // Every lock locks, also for an account without a password: the
+        // curtain hides the screen until the person comes back, and lifting
+        // it needs no password (UnlockDialog's passwordless entry).
+        this._setLocked(true);
     }
 
     // If the previous shell crashed, and gnome-session restarted us, then re-lock
diff --git a/js/ui/unlockDialog.js b/js/ui/unlockDialog.js
index c2b67bb..91ca672 100644
--- a/js/ui/unlockDialog.js
+++ b/js/ui/unlockDialog.js
@@ -399,12 +399,12 @@ export const UnlockDialog = GObject.registerClass({
         this._compactLogin = PrairieLogin.compactLogin(
             Main.layoutManager.primaryMonitor.width,
             St.ThemeContext.get_for_stage(global.stage).scaleFactor);
-        if (this._compactLogin) {
+        if (this._compactLogin || this._passwordless()) {
             this._swipeTracker.enabled = true;
             this._showClock();
             // Build the prompt while the clock shows, not when a swipe starts.
             GLib.idle_add(GLib.PRIORITY_LOW, () => {
-                if (!this._authPrompt && this._activePage === this._clock)
+                if (!this._authPrompt && this._activePage === this._clock && !this._passwordless())
                     this._ensureAuthPrompt();
                 return GLib.SOURCE_REMOVE;
             });
@@ -430,7 +430,7 @@ export const UnlockDialog = GObject.registerClass({
         this._showPrompt();
 
         if (GLib.unichar_isgraph(unichar))
-            this._authPrompt.addCharacter(unichar);
+            this._authPrompt?.addCharacter(unichar);
 
         return Clutter.EVENT_PROPAGATE;
     }
@@ -541,7 +541,26 @@ export const UnlockDialog = GObject.registerClass({
         });
     }
 
+    // An account without a password: the lock is the curtain alone.
+    _passwordless() {
+        return Boolean(this._user?.is_loaded) &&
+            this._user.password_mode === AccountsService.UserPasswordMode.NONE;
+    }
+
+    // Lifting the curtain (click, key, scroll or swipe) is the unlock; there
+    // is nothing to authenticate.
+    _enterWithoutPassword() {
+        if (this._entering)
+            return;
+        this._entering = true;
+        Main.screenShield.deactivate(true);
+    }
+
     _showPrompt() {
+        if (this._passwordless()) {
+            this._enterWithoutPassword();
+            return;
+        }
         this._ensureAuthPrompt();
 
         if (this._activePage === this._promptBox)
@@ -620,7 +639,8 @@ export const UnlockDialog = GObject.registerClass({
 
         this._adjustment.remove_transition('value');
 
-        this._ensureAuthPrompt();
+        if (!this._passwordless())
+            this._ensureAuthPrompt();
 
         const progress = this._adjustment.value;
         tracker.confirmSwipe(this._stack.height,
@@ -634,6 +654,10 @@ export const UnlockDialog = GObject.registerClass({
     }
 
     _swipeEnd(tracker, duration, endProgress) {
+        if (endProgress && this._passwordless()) {
+            this._enterWithoutPassword();
+            return;
+        }
         this._activePage = endProgress
             ? this._promptBox
             : this._clock;
