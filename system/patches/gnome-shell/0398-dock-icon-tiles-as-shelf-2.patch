@@ -43,6 +43,9 @@ const DASH_PADDING = 10;
 // so the mask agrees with the artwork instead of cutting into it.
 // The shelf spec draws every 36px dock icon at radius 10.
 const ICON_CORNER_RATIO = 10 / 36;
+// shelf-2's dock icon: a squircle corner at 30% of the tile (--ir, CSS
+// corner-shape: squircle), lit as its data-icon="lit" (iconMask.js).
+const DOCK_ICON_CORNER_RATIO = 0.3;
 const LEGACY_DESKTOP_DOCK_UUID = 'dash-to-dock@micxgx.gmail.com';
 const SHELF_STYLESHEET_URI = 'resource:///org/gnome/shell/theme/luma-shelf.css';
 // Filled controls (ADR-043), loaded after the Shelf's own sheet.
@@ -3181,16 +3184,42 @@ export const Shelf = GObject.registerClass({
             // changes (BaseIcon._createIconTexture), which drops the mask
             // without the dock changing width. Follow the replacement so no
             // icon is ever left square.
+            // An application's icon is clipped at the tile by its icon bin
+            // and drawn so its plate fills the tile (iconMask.js
+            // syncAppIconPlate); the show-apps glyph keeps its own mask.
+            const app = !!delegate.app && !!baseIcon._iconBin;
             if (baseIcon._iconBin && !baseIcon._lumaMaskFollowed) {
                 baseIcon._lumaMaskFollowed = true;
-                baseIcon._iconBin.connectObject('notify::child',
-                    () => this._maskIcon(baseIcon.icon), this);
+                baseIcon._iconBin.connectObject('notify::child', () => (app
+                    ? this._plateIcon(baseIcon) : this._maskIcon(baseIcon.icon)), this);
             }
-            if (!this._maskIcon(baseIcon.icon))
+            if (!(app ? this._plateIcon(baseIcon) : this._maskIcon(baseIcon.icon)))
                 return;
         }
     }
 
+    _plateIcon(baseIcon) {
+        const bin = baseIcon._iconBin;
+        if (!bin.get_effect('luma-icon-mask')) {
+            try {
+                const effect = new LumaIconMask();
+                effect.set_uniform_float(
+                    effect.get_uniform_location('radius'), 1,
+                    [DOCK_ICON_CORNER_RATIO]);
+                effect.squircle = true;
+                effect.lit = true;
+                bin.add_effect_with_name('luma-icon-mask', effect);
+                bin.clip_to_allocation = true;
+            } catch (error) {
+                logError(error, 'Luma Shelf: icon mask unavailable');
+                return false;
+            }
+        }
+        if (baseIcon.icon)
+            syncAppIconPlate(baseIcon.icon, bin, baseIcon.iconSize, true);
+        return true;
+    }
+
     _maskIcon(icon) {
         if (!icon || icon.get_effect('luma-icon-mask'))
             return true;
diff --git a/js/ui/shelfMetrics.js b/js/ui/shelfMetrics.js
index 27d70e1..1be3967 100644
--- a/js/ui/shelfMetrics.js
+++ b/js/ui/shelfMetrics.js
@@ -1,9 +1,11 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 // Native Dash and status geometry share one logical tile size. Display scale
 // multiplies these logical measurements; it is not a second size policy.
-// Studio Desktop uses 40px content, 8px between dock icons, and a 16px inset.
-export const DASH_TILE_SIZE = 45;
-export const DASH_TILE_GAP = 11;
+// Studio Desktop (shelf-2) uses 40px content, 8px between dock icons, and a
+// 16px inset. An app icon's plate fills the 40px tile (iconMask.js
+// syncAppIconPlate), so the tile is the content size itself.
+export const DASH_TILE_SIZE = 40;
+export const DASH_TILE_GAP = 8;
 export const SHELF_INSET = 16;
 // The rule between pinned and running apps, and between status parts.
 export const SHELF_DIVIDER_LENGTH = 24;
