From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Suno <engineering@projectSuno.org>
Date: Thu, 26 Nov 2026 13:00:00 -0600
Subject: [PATCH] Continue: offer asked again when a session arrives

A device that wakes before its network asks Connect Sync for another
device's session and gets only what it already held. Connect Sync now
says when another device's session arrives (ContinueOfferChanged); for a
minute after unlock or resume the offer is asked again then.

This device's own snapshot is read before the question, not after the
answer: a snapshot written while the answer waits for the network no
longer hides the offer.
---
 js/ui/SunoSession.js | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/js/ui/SunoSession.js b/js/ui/SunoSession.js
index befecce..00dcbf6 100644
--- a/js/ui/SunoSession.js
+++ b/js/ui/SunoSession.js
@@ -39,6 +39,7 @@ const LATE_WINDOW_MS = 15 * 60 * 1000;
 const SAVE_TIMEOUT_MS = 500;
 const MORE_WINDOWS_MS = 3000;
 const SLEEP_BUDGET_MS = 2000;
+const OFFER_WATCH_US = 60 * 1000 * 1000;
 const CONTINUE_TTL_S = 72 * 3600;
 const ART_EDGE = 960;           // the artwork's longest side, in pixels
 const ART_MAX = 96 * 1024;       // Connect Sync's limit (sessions.ART_MAX)
@@ -796,6 +797,17 @@ export class SunoSession extends Signals.EventEmitter {
         };
         Main.screenShield?.connectObject('locked-changed', shield, 'active-changed', shield, this);
 
+        // A device that wakes before its network gets only the sessions it
+        // already held; Connect Sync says when another device's session
+        // arrives, and for a minute after unlock or resume the offer is asked
+        // again then.
+        this._offerSignal = Gio.DBus.session.signal_subscribe('org.projectSuno.ConnectSync1',
+            'org.projectSuno.ConnectSync1', 'ContinueOfferChanged', '/org/projectSuno/ConnectSync1', null,
+            Gio.DBusSignalFlags.NONE, () => {
+                if (GLib.get_monotonic_time() < (this._offerWatchUntil ?? 0) && !this._shieldUp)
+                    this._checkOffer({watch: false}).catch(logError);
+            });
+
         const loginManager = LoginManager.getLoginManager();
         this._takeSleepInhibitor();
         loginManager.connectObject('prepare-for-sleep', (_lm, aboutToSuspend) => {
@@ -1407,11 +1419,17 @@ export class SunoSession extends Signals.EventEmitter {
     // The offer (ADR-055 §5.3): after unlock, resume or login, the newest
     // session of another device that is newer than this one's own last
     // use. Nothing opens without Continue, and nothing shows while locked.
-    async _checkOffer() {
+    async _checkOffer({watch = true} = {}) {
         if (Main.sessionMode.isLocked || this._restoring || this._offering)
             return;
         if (!(this._settings?.get_boolean('continue-offer') ?? true))
             return;
+        if (watch)
+            this._offerWatchUntil = GLib.get_monotonic_time() + OFFER_WATCH_US;
+        // This device's own last use as it stood when it was left: a snapshot
+        // written while the answer is on its way (the network coming back
+        // after a wake) must not hide the offer.
+        const own = readJson(GLib.build_filenamev([this._dir, 'current.json']));
         let offer;
         try {
             const [json] = (await Gio.DBus.session.call('org.projectSuno.ConnectSync1',
@@ -1429,7 +1447,6 @@ export class SunoSession extends Signals.EventEmitter {
                 (fromStart, chosen) => this._playOnTv(chosen, fromStart));
             return;
         }
-        const own = readJson(GLib.build_filenamev([this._dir, 'current.json']));
         const continuedHere = offer.continuedFrom?.device === this._device;
         if (!continuedHere && own?.taken && offer.taken <= own.taken)
             return;
