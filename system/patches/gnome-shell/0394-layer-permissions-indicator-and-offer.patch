+    // phone status bar, the TV bar), which a presentation change can
+    // destroy with it; a new one is made the next time it is needed.
+    _makeCell() {
+        const cell = new OverlayCell();
+        cell.connect('activate', () => this._popover.toggle(cell));
+        cell.connect('destroy', () => {
