diff --git a/js/ui/lumaLayerShellIndicatorModel.js b/js/ui/lumaLayerShellIndicatorModel.js
new file mode 100644
index 0000000..d9ca0e1
--- /dev/null
+++ b/js/ui/lumaLayerShellIndicatorModel.js
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// What the overlay status cell, its popover and the offer show, without a
+// Shell. No gi imports, so %check runs it under plain gjs.
+// Design: design-center 858103d, mockups/overlay-perms (perms.js).
+
+import {Capability} from './lumaLayerShellModel.js';
+
+// org.projectluma.LayerShell1.Surfaces rows: (app, namespace, layer,
+// capabilities in use, faded, held, mapped since).
+export const Layer = Object.freeze({BACKGROUND: 0, BOTTOM: 1, TOP: 2, OVERLAY: 3});
+
+// The cell leaves this long after the last overlay goes.
+export const GRACE_MS = 2000;
+
+function rows(surfaces) {
+    return (surfaces ?? []).map(([app, namespace, layer, using, faded, held, since]) =>
+        ({app, namespace, layer, using, faded, held, since: Number(since) || 0}));
+}
+
+// Apps with an overlay surface on screen, least recent first (by when their
+// newest overlay surface mapped), each with its surfaces.
+export function overlayApps(surfaces) {
+    const apps = new Map();
+    for (const row of rows(surfaces)) {
+        if (row.held || row.layer !== Layer.OVERLAY || !row.app)
+            continue;
+        const entry = apps.get(row.app) ?? {app: row.app, since: 0, first: Infinity, namespaces: []};
+        entry.since = Math.max(entry.since, row.since);
+        entry.first = Math.min(entry.first, row.since);
+        entry.namespaces.push(row.namespace);
+        apps.set(row.app, entry);
+    }
+    return [...apps.values()].sort((a, b) => a.since - b.since || a.app.localeCompare(b.app));
+}
+
+// The app holding the keyboard through a layer surface, or null.
+export function keyboardApp(surfaces) {
+    const row = rows(surfaces).find(r => !r.held && r.app && (r.using & Capability.KEYBOARD));
+    return row?.app ?? null;
+}
+
+// The cell: one or two icons stacked, or the most recent icon and "+N".
+// Ordered as listed by overlayApps().
+export function cell(appIds) {
+    if (appIds.length === 0)
+        return {icons: [], more: 0};
+    if (appIds.length <= 2)
+        return {icons: [...appIds], more: 0};
+    return {icons: [appIds[appIds.length - 1]], more: appIds.length - 1};
+}
+
+export function tooltip(names, keyboard = false) {
+    if (keyboard)
+        return `${names[0]} has the keyboard`;
+    return names.length > 1
+        ? `${names.length} apps are displaying over other apps`
+        : `${names[0]} is displaying over other apps`;
+}
+
+// A surface's namespace in the person's words.
+export function what(namespace) {
+    const ns = `${namespace ?? ''}`.toLowerCase();
+    if (/voice/.test(ns))
+        return 'Voice overlay';
+    if (/call|bubble/.test(ns))
+        return 'Call bubble';
+    if (/stat|fps|perf|hud/.test(ns))
+        return 'Game stats';
+    return 'Overlay';
+}
+
+// How long it has been showing: "now", "4 min", "2 h".
+export function since(fromSeconds, nowSeconds) {
+    const minutes = Math.floor(Math.max(0, nowSeconds - fromSeconds) / 60);
+    if (minutes < 1)
+        return 'now';
+    if (minutes < 60)
+        return `${minutes} min`;
+    return `${Math.floor(minutes / 60)} h`;
+}
+
+// One popover row's second line: "Voice overlay · 4 min".
+export function detail(entry, nowSeconds) {
+    return `${what(entry.namespaces[0])} · ${since(entry.first, nowSeconds)}`;
+}
+
+// When the cell should be visible: while any overlay shows, and GRACE_MS
+// after the last one left. Returns {visible, hideAt} for the times given.
+export function presence(count, state, nowMs) {
+    if (count > 0)
+        return {visible: true, hideAt: 0};
+    if (!state.visible)
+        return {visible: false, hideAt: 0};
+    const hideAt = state.hideAt || nowMs + GRACE_MS;
+    return {visible: nowMs < hideAt, hideAt};
+}
+
+// The name tags on faded overlays: one per app, on its largest surface
+// (all of the app's overlays fade together). entries: [{key, app, area}],
+// in the order Mutter lists them; returns the keys to tag.
+export function tagTargets(entries) {
+    const best = new Map();
+    for (const entry of entries) {
+        const chosen = best.get(entry.app);
+        if (!chosen || entry.area > chosen.area)
+            best.set(entry.app, entry);
+    }
+    return [...best.values()].map(entry => entry.key);
+}
+
+// The popover row's app icon, by posture: the TV page is the desktop pop at
+// TV scale (x1.5).
+export const ROW_ICON = Object.freeze({desktop: 32, phone: 32, tv: 48});
+
+// The offer's title: the capability's name, as Settings names it.
+export const OFFER_TITLE = Object.freeze({
+    [Capability.OVERLAY]: 'Display over other apps',
+    [Capability.PANEL]: 'Add a panel',
+    [Capability.BACKGROUND]: 'Desktop background',
+    [Capability.KEYBOARD]: 'Take the keyboard',
+});
+
+export const OFFER_TEXT = Object.freeze({
+    [Capability.OVERLAY]: 'Allow %s to display over games and full-screen apps?',
+    [Capability.PANEL]: 'Allow %s to add a panel to the desktop?',
+    [Capability.BACKGROUND]: 'Allow %s to draw the desktop background?',
+    [Capability.KEYBOARD]: 'Allow %s to take the keyboard?',
+});
+
+// The offer's two answers, equal weight: neither is a default. On TV the
+// remote's focus starts on Not now, so a stray OK never grants anything.
+export function offerFocus(posture) {
+    return posture === 'tv' ? 'not-now' : null;
+}
