+/* ── Layer permissions (design-center 858103d, mockups/overlay-perms) ───── */
+/* Violet is the LumaUI overlay token (config/shared/design-tokens.json,
+ * oklch(0.72 0.14 300) = #b28fef): an app drawing over Luma, nothing else. */
+
+/* The status cell: first column of the status slots, spanning both rows. */
+.luma-ov-cell { padding: 0; border-radius: 9px; }
+.luma-ov-cell:hover { background-color: rgba(255,255,255,.08); }
+.luma-ov-stack { spacing: 0; }
+/* The rings are borders of clear frames: St paints a spread shadow square
+ * and under the icon, and draws borders in whole pixels. */
+.luma-ov-ic-sep { border: 1px solid rgba(0,0,0,.35); border-radius: 8px; }
+.luma-ov-ic { border: 2px solid #b28fef; border-radius: 7px; }
+.luma-ov-more { width: 16px; height: 16px; margin: 3px; border-radius: 5px; background-color: #b28fef;
+  color: #ffffff; font-family: Figtree; font-size: 9px; font-weight: 700; text-align: center; }
+.luma-ov-kbd { color: #ffffff; background-color: #b28fef; border-radius: 3px; }
+.luma-ov-tip { font-family: Figtree; font-size: 12px; font-weight: 600; padding: 5px 10px 6px;
+  border-radius: 9px; color: #ffffff; background-color: rgba(20,21,24,.92); border: none;
+  box-shadow: 0 8px 20px rgba(0,0,0,.4); }
+/* Phone: in the status bar's right-hand group. TV: in the top bar's status group. */
+.luma-ov-cell-phone { margin: 0 6px; }
+.luma-ov-cell-tv { margin: 0 18px 0 0; }
+
+/* The popover (perms.js pop(): .pop.k-qs .q2), the standard shell pop: 312 px. */
+.luma-ov-popover .popup-menu-content.luma-ov-pop,
+.luma-ov-pop.luma-ov-sheet {
+  width: 286px; padding: 14px 16px 12px 10px; spacing: 0; border-radius: 26px; border: none;
+  background-color: rgba(32,33,36,.86); color: #e7e9e8; font-family: Figtree;
+  box-shadow: inset 0 0 0 1px rgba(255,255,255,.16); }
+/* BoxPointer's elevation carrier (luma-popup-shadow) is opaque in Dark and
+ * keeps the menus' 15 px corners; under this 26 px pop it showed past them. */
+.popup-menu.luma-ov-popover .luma-popup-shadow { border-radius: 26px; }
+.luma-ov-pop-title { font-size: 14.5px; font-weight: 650; }
+/* The kit's well: its fill, a 1 px edge line and a soft inset shadow 1 px
+ * down (--well-edge). St draws one shadow, so the line is the border and
+ * the padding gives that pixel back. */
+.luma-ov-list { margin: 18px 0 0 6px; padding: 3px; spacing: 1px; border-radius: 16px; background-color: rgba(0,0,0,.2);
+  border: 1px solid rgba(255,255,255,.035); box-shadow: inset 0 1px 2px rgba(0,0,0,.35); }
+.luma-ov-row { min-height: 34px; padding: 5px 10px 5px 5px; spacing: 10px; border-radius: 12px; }
+.luma-ov-row-icon { icon-size: 32px; }
+.luma-ov-row-words { spacing: 1px; }
+.luma-ov-row-name { font-size: 13px; font-weight: 650; height: 15px; }
+.luma-ov-row-detail { spacing: 6px; height: 14px; }
+.luma-ov-row-what { font-size: 11.5px; color: rgba(231,233,232,.62); }
+.luma-ov-dot { width: 6px; height: 6px; border-radius: 3px; background-color: #b28fef; }
+.luma-ov-stop { height: 28px; padding: 0 12px; border-radius: 9px; font-size: 12px; font-weight: 650;
+  color: #e7e9e8; background-color: rgba(255,255,255,.12); }
+.luma-ov-stop:hover, .luma-ov-stop:focus { background-color: rgba(255,255,255,.17); }
+.luma-ov-more-link { height: 28px; margin: 14px 0 0 4px; padding: 0 8px; border-radius: 8px;
+  font-size: 12px; font-weight: 600; color: #e7e9e8; }
+.luma-ov-more-link:hover, .luma-ov-more-link:focus { background-color: rgba(255,255,255,.08); }
+/* Light surfaces. */
+/* St scores a selector group by the last selector that matches, so the desktop
+ * pop's light rule stands alone to outrank its dark rule. */
+.luma-ov-popover .popup-menu-content.luma-ov-pop.luma-surface-light {
+  background-color: #eceef1; color: #16191d; border-color: rgba(255,255,255,.9);
+  box-shadow: 0 4px 12px rgba(0,0,0,.2); }
+.luma-ov-pop.luma-surface-light, .luma-ov-toast-tv.luma-surface-light {
+  background-color: #eceef1; color: #16191d; border-color: rgba(255,255,255,.9);
+  box-shadow: 0 4px 12px rgba(0,0,0,.2); }
+.luma-surface-light .luma-ov-list { background-color: rgba(25,27,31,.055); border-color: rgba(25,27,31,.04);
+  box-shadow: inset 0 1px 2px rgba(25,27,31,.1); }
+.luma-surface-light .luma-ov-row-what { color: rgba(22,25,29,.76); }
+.luma-surface-light .luma-ov-stop { color: #16191d; background-color: rgba(20,22,26,.09); }
+.luma-surface-light .luma-ov-stop:hover, .luma-surface-light .luma-ov-stop:focus { background-color: rgba(20,22,26,.14); }
+.luma-surface-light .luma-ov-more-link { color: #16191d; }
+.luma-surface-light .luma-ov-more-link:hover { background-color: rgba(25,27,31,.06); }
+/* Phone: a bottom drawer, full width, 28 px top radius, 60 px rows, 40 px Stop. */
+.luma-ov-sheet-shade { background-color: rgba(0,0,0,.32); }
+/* The drawer's 22/30 px padding less the pop header's 4 px lift and the
+ * link's 2 px: the title at 18, the link's foot 28 above the bottom. */
+.luma-ov-sheet.luma-ov-phone { width: auto; border-radius: 28px 28px 0 0; padding: 18px 18px 28px 12px; }
+.luma-ov-sheet.luma-ov-phone .luma-ov-row { min-height: 50px; }
+.luma-ov-sheet.luma-ov-phone .luma-ov-stop { height: 40px; padding: 0 18px; font-size: 14px; }
+/* TV: the quick panel's page at TV scale (x1.5), top right; focus is a white ring. */
+.luma-ov-sheet.luma-ov-tv { width: 801px; margin: 72px 72px 0 0; padding: 21px 24px 18px 15px; spacing: 0;
+  border-radius: 39px; }
+.luma-ov-tv .luma-ov-list { margin: 27px 0 0 9px; }
+.luma-ov-tv .luma-ov-more-link { margin: 21px 0 0 6px; }
+.luma-ov-tv .luma-ov-pop-title { font-size: 21.75px; }
+/* St rounds lengths to whole pixels, so the x1.5 halves (1.5 px between
+ * rows, 7.5 px row padding) are split to keep the list's total height. */
+.luma-ov-tv .luma-ov-list { padding: 5px 5px 4px; spacing: 2px; border-radius: 24px; box-shadow: inset 0 2px 3px rgba(0,0,0,.35); }
+.luma-ov-tv .luma-ov-row { min-height: 51px; padding: 7px 15px 8px 8px; spacing: 15px; border-radius: 18px; }
+.luma-ov-tv .luma-ov-row-name { font-size: 18.75px; height: 23px; }
+.luma-ov-tv .luma-ov-row-what { font-size: 16.5px; }
+.luma-ov-tv .luma-ov-row-detail { height: 21px; }
+.luma-ov-tv .luma-ov-dot { width: 9px; height: 9px; border-radius: 4.5px; }
+.luma-ov-tv .luma-ov-row-detail { spacing: 9px; }
+.luma-ov-tv .luma-ov-stop { height: 42px; padding: 0 18px; border-radius: 13.5px; font-size: 18px; }
+.luma-ov-sheet.luma-ov-tv .luma-ov-row .luma-ov-stop,
+.luma-ov-sheet.luma-ov-tv .luma-ov-row .luma-ov-stop:focus { background-color: #3a3c40; color: #e7e9e8; }
+.luma-ov-sheet.luma-ov-tv .luma-ov-row .luma-ov-stop:focus { box-shadow: 0 0 0 4.5px #ffffff; }
+.luma-ov-tv .luma-ov-more-link { height: 42px; padding: 0 12px; border-radius: 12px; font-size: 18px; }
+
+/* TV: the standard banner at TV scale (x1.5): 588 px, 51 px tile at 21,21
+ * with the 24 px badge 3 px inside its corner,
+ * text from x=90 to 27 px from the right (the time to 24), source / title /
+ * body, content-width actions 45 px tall; 180 px with a one-line body. */
+.luma-ov-toast-tv { width: 543px; padding: 21px 24px 21px 21px; spacing: 18px; border-radius: 30px;
+  background-color: #21252b; color: #eceef1; font-family: Figtree;
+  box-shadow: 0 27px 60px -27px rgba(0,0,0,.35); }
+.luma-ov-toast-tv.luma-surface-light { background-color: #eceef1; color: #1f2328; }
+.luma-ov-toast-tile { width: 51px; height: 51px; }
+.luma-ov-toast-badge { border: 3px solid rgba(10,12,16,.85); border-radius: 10.5px; background-color: rgba(10,12,16,.85); }
+.luma-ov-toast-column { spacing: 0; padding-top: 1px; }
+.luma-ov-toast-top { height: 18px; }
+.luma-ov-toast-source { font-size: 15px; font-weight: 700; letter-spacing: 1.2px; color: rgba(231,233,232,.42); }
+.luma-ov-toast-time { font-size: 16.5px; color: rgba(231,233,232,.42); }
+.luma-surface-light .luma-ov-toast-source, .luma-surface-light .luma-ov-toast-time { color: rgba(31,35,40,.5); }
+.luma-ov-toast-title { margin-top: 5px; height: 24px; font-size: 20.4px; font-weight: 600; }
+.luma-ov-toast-body { margin-top: 4px; margin-right: 3px; font-size: 18.75px; color: rgba(231,233,232,.62); }
+.luma-surface-light .luma-ov-toast-body { color: rgba(31,35,40,.78); }
+.luma-ov-toast-actions { spacing: 9px; padding-top: 15px; }
+/* Content-width actions, the standard banner's (#32363c dark, #dfe1e4 light,
+ * Review 4) at x1.5 (19.5 px each side, split into whole pixels). Opaque fills: St paints the focus ring, a spread
+ * shadow, under a translucent fill. */
+.luma-ov-toast-button { height: 45px; padding: 0 19px 0 20px; border-radius: 15px;
+  font-size: 18px; font-weight: 650; color: #eceef1; background-color: #32363c; }
+.luma-surface-light .luma-ov-toast-button { color: #1f2328; background-color: #dfe1e4; }
+/* The remote's focus is a white ring; the fill and ink stay as they are. */
+.luma-ov-toast-tv .luma-ov-toast-actions .luma-ov-toast-button:focus { box-shadow: 0 0 0 4.5px #ffffff; }
