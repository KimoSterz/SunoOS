+    // appIds: least recent first. keyboard: the app holding the keyboard.
+    set(appIds, keyboard = null) {
+        this._stack.destroy_all_children();
+        const names = appIds.map(id => appInfo(id).name);
+        if (appIds.length === 0 && keyboard) {
+            const icon = ringedIcon(keyboard);
+            const badge = new St.Icon({icon_name: 'lumaui-keyboard-symbolic', icon_size: 10,
+                style_class: 'luma-ov-kbd', x_align: Clutter.ActorAlign.END, y_align: Clutter.ActorAlign.END});
+            const box = new St.Widget({layout_manager: new Clutter.BinLayout()});
