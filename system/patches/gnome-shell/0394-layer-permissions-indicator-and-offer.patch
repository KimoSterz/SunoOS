+import {LumaIconMask, syncAppIconPlate} from './iconMask.js';
+import * as Model from './lumaLayerShellModel.js';
+import * as View from './lumaLayerShellIndicatorModel.js';
+
+const SETTINGS_ICON = 'org.gnome.Settings';
+const ICON_RADIUS = 5 / 16;
+// Rows: 8 px on the 32 px icon (12 on TV's 48).
+const ROW_ICON_RADIUS = 8 / 32;
+
+export function appInfo(appId) {
+    const app = Shell.AppSystem.get_default().lookup_app(`${appId}.desktop`);
+    return {
+        name: app?.get_name() ?? appId,
+        gicon: app?.get_icon() ?? new Gio.ThemedIcon({name: 'application-x-executable'}),
+    };
+}
+
+export function posture() {
+    if (Main.presentation?._state?.posture?.effective === 'tv')
+        return 'tv';
+    return Main.presentation?.mode === 'mobile' ? 'phone' : 'desktop';
+}
+
+// An app icon in a masked clip of size px, its plate filling the clip
+// (iconMask.js syncAppIconPlate): a v4 icon at its plate's scale, any other
+// on a drawn plate.
+export function maskedIcon(gicon, size, styleClass, radius = ICON_RADIUS) {
+    const icon = new St.Icon({gicon, icon_size: size,
+        x_align: Clutter.ActorAlign.CENTER, y_align: Clutter.ActorAlign.CENTER});
+    const clip = new St.Bin({style_class: styleClass, style: `width: ${size}px; height: ${size}px;`,
+        clip_to_allocation: true, child: icon});
+    try {
+        const mask = new LumaIconMask();
+        mask.set_uniform_float(mask.get_uniform_location('radius'), 1, [radius]);
+        clip.add_effect_with_name('luma-ov-mask', mask);
+    } catch (e) {
+        logError(e, 'Overlay icon mask unavailable');
+    }
+    syncAppIconPlate(icon, clip, size);
+    return clip;
+}
+
+// One ringed app icon: 16 px, 5 px radius, a 1.5 px violet ring and a 3 px
+// dark separation ring outside it (perms.css .ov-ic).
+function ringedIcon(appId) {
+    const outer = new St.Bin({style_class: 'luma-ov-ic-sep'});
+    const ring = new St.Bin({style_class: 'luma-ov-ic'});
+    ring.set_child(maskedIcon(appInfo(appId).gicon, 16, 'luma-ov-ic-glyph'));
+    outer.set_child(ring);
+    return outer;
+}
+
+// The status cell.
+export const OverlayCell = GObject.registerClass({
