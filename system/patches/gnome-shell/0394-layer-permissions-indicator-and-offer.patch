+    const named = entries.map(entry => ({entry, ...appInfo(entry.app)}))
+        .sort((a, b) => a.name.localeCompare(b.name));
+    for (const {entry, name, gicon} of named) {
+        const row = new St.BoxLayout({style_class: 'luma-ov-row', x_expand: true});
+        const icon = maskedIcon(gicon, View.ROW_ICON[posture()] ?? 32, 'luma-ov-row-icon', ROW_ICON_RADIUS);
+        icon.y_align = Clutter.ActorAlign.CENTER;
+        row.add_child(icon);
+        const words = new St.BoxLayout({orientation: Clutter.Orientation.VERTICAL,
+            style_class: 'luma-ov-row-words', x_expand: true, y_align: Clutter.ActorAlign.CENTER});
+        words.add_child(new St.Label({style_class: 'luma-ov-row-name', text: name}));
+        const detail = new St.BoxLayout({style_class: 'luma-ov-row-detail'});
+        detail.add_child(new St.Widget({style_class: 'luma-ov-dot', y_align: Clutter.ActorAlign.CENTER}));
+        detail.add_child(new St.Label({style_class: 'luma-ov-row-what', text: View.detail(entry, now),
+            y_align: Clutter.ActorAlign.CENTER}));
+        words.add_child(detail);
+        row.add_child(words);
+        const stop = new St.Button({style_class: 'luma-ov-stop', label: _('Stop'), can_focus: true,
+            y_align: Clutter.ActorAlign.CENTER, accessible_name: _('Stop %s').format(name)});
+        stop.connect('clicked', () => onStop(entry.app));
