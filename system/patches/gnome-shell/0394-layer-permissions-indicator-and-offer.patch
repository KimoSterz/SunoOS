+// SPDX-License-Identifier: GPL-2.0-or-later
+// The overlay status cell, its popover and the offer (design-center 858103d,
+// mockups/overlay-perms: indicator.html, offer.html; perms.css, perms.js).
+//
+// - The cell is the first column of the shelf's status grid and spans both
+//   rows: one or two app icons ringed in the LumaUI overlay violet, or the
+//   most recent icon and "+N". It shows while an overlay surface is on screen
+//   and leaves GRACE_MS after the last one goes. While an app holds the
+//   keyboard through a layer surface it shows that app with a keyboard badge.
+// - Hovering shows the shelf tooltip; a click opens the popover and never
+//   stops anything by itself. Stop unmaps the app's overlays for the session
+//   (org.projectluma.LayerShell1.Stop); the grant stays.
+// - Phone: the cell sits first in the status bar's right-hand group and the
+//   popover is a bottom drawer. TV: the cell sits in the top bar's status
+//   group and the popover is a TV quick-panel page at TV scale, the remote's
+//   focus on the first Stop.
+// - The offer is a notification from the app's own source, its tile the
+//   app's icon with the Settings icon as a badge only the Shell can set.
+import Clutter from 'gi://Clutter';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Gio from 'gi://Gio';
+import Pango from 'gi://Pango';
