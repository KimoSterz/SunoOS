+        column.add_child(top);
+        column.add_child(new St.Label({style_class: 'luma-ov-toast-title', text: title}));
+        const text = new St.Label({style_class: 'luma-ov-toast-body', text: body});
+        // The banner sizes to its content: the question wraps, never ellipsizes.
+        text.clutter_text.set({line_wrap: true, line_wrap_mode: Pango.WrapMode.WORD_CHAR,
+            ellipsize: Pango.EllipsizeMode.NONE});
+        // The banner's 17 px body line at x1.5: 26 px. St has no line-height
+        // and rewrites the label's attribute list from its style, so the
+        // line height is markup (ClutterText keeps markup attributes apart).
+        const lineHeight = 26 * St.ThemeContext.get_for_stage(global.stage).scale_factor * Pango.SCALE;
+        text.clutter_text.set_markup(
+            `<span line_height="${lineHeight}">${GLib.markup_escape_text(body, -1)}</span>`);
+        column.add_child(text);
+        const actions = new St.BoxLayout({style_class: 'luma-ov-toast-actions'});
+        this._buttons = [_('Allow'), _('Not now')].map((label, index) => {
+            const button = new St.Button({style_class: 'luma-ov-toast-button', label, can_focus: true});
+            button.connect('clicked', () => answer(index === 0));
+            actions.add_child(button);
+            return button;
+        });
+        column.add_child(actions);
+        this.add_child(column);
+        SurfaceMaterials.bindSurface(this, {
+            cornerRadii: 30 * St.ThemeContext.get_for_stage(global.stage).scale_factor,
+            classActors: [this],
+        });
+        this.connect('key-press-event', (_a, event) =>
+            global.focus_manager.navigate_from_event(event) ? Clutter.EVENT_STOP : Clutter.EVENT_PROPAGATE);
+    }
+
+    show() {
+        const monitor = Main.layoutManager.primaryMonitor;
+        Main.layoutManager.addTopChrome(this);
+        super.show();
+        // Top chrome is allocated its height for no width, one line of body;
+        // the banner sizes to its content, so ask for the height at its width.
+        const [, width] = this.get_preferred_width(-1);
+        const [, height] = this.get_preferred_height(width);
+        this.set_size(width, height);
+        this.set_position(monitor.x + monitor.width - 72 - width, monitor.y + 72);
+        this._grab = Main.pushModal(this);
+        this._buttons[1].grab_key_focus();
+    }
+
+    dismiss() {
+        if (this._grab)
+            Main.popModal(this._grab);
+        this._grab = null;
+        this.destroy();
+    }
+});
+
+// The offer: the shell's standard notification banner, from the app's own
+// source (its name the source line, its icon the tile), with the Settings
+// icon as a badge only the Shell can set (lumaShellBadge), the capability's
+// name as the title, the question as the body, and Allow and
+// Not now as ordinary actions with neither a default. Dismissing it counts as
+// Not now. On a TV, where the banner is hidden, it is the TV toast.
+export function offer(appId, capability, decide) {
+    const {name, gicon} = appInfo(appId);
+    const source = new MessageTray.Source({
+        title: name,
+        icon: gicon,
+        policy: new MessageTray.NotificationGenericPolicy(),
+    });
+    Main.messageTray.add(source);
+    const notification = new MessageTray.Notification({
+        source,
+        title: View.OFFER_TITLE[capability],
+        body: View.OFFER_TEXT[capability].replace('%s', name),
+        isTransient: false,
+        urgency: MessageTray.Urgency.HIGH,
+    });
+    notification.lumaShellBadge = new Gio.ThemedIcon({name: SETTINGS_ICON});
+    notification.lumaPosture = posture();
+    let answered = false;
+    notification.addAction(_('Allow'), () => {
+        answered = true;
+        decide(true);
+    });
+    notification.addAction(_('Not now'), () => {
+        answered = true;
+        decide(false);
+    });
+    notification.connect('destroy', (_n, reason) => {
+        if (!answered && reason === MessageTray.NotificationDestroyedReason.DISMISSED)
+            decide(false);
+    });
+    source.addNotification(notification);
+    if (notification.lumaPosture === 'tv') {
+        const toast = new TvOfferToast(name, gicon, notification.title, notification.body, allowed => {
+            answered = true;
+            toast.dismiss();
+            decide(allowed);
+            notification.destroy(MessageTray.NotificationDestroyedReason.SOURCE_CLOSED);
+        });
+        notification.connect('destroy', () => {
+            if (!toast._grab)
+                return;
+            toast.dismiss();
+        });
+        toast.show();
+    }
+    return notification;
+}
