+            box.add_child(icon);
+            box.add_child(badge);
+            this._stack.add_child(box);
+            this._text = View.tooltip([appInfo(keyboard).name], true);
+        } else {
+            const {icons, more} = View.cell(appIds);
+            for (const id of icons)
+                this._stack.add_child(ringedIcon(id));
+            if (more) {
+                this._stack.add_child(new St.Label({
+                    style_class: 'luma-ov-more', text: `+${more}`,
+                    x_align: Clutter.ActorAlign.CENTER, y_align: Clutter.ActorAlign.CENTER,
+                }));
+            }
+            this._text = names.length ? View.tooltip(names) : '';
+        }
+        this.accessible_name = this._text ?? '';
