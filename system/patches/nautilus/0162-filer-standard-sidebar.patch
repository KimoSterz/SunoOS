-static void
-refresh_luma_file_sidebar (NautilusSidebar *sidebar)
+/* Tasks' sidebar, the kit's "destinations" variant: 224 px on the frame. */
+#define FILER_SIDEBAR_WIDTH 224
+
+void
+nautilus_sidebar_adapt_to_split (NautilusSidebar *sidebar)
 {
-    /* Mount and bookmark updates replace Nautilus's live row children. The
-     * shared adapter keeps their actions and DnD, but needs to arrange the
-     * newly-created rows again after each rebuild. During construction the
-     * sidebar has not yet been placed in its split view. */
+    /* Mount and bookmark updates replace Nautilus's live row children; the
+     * adapter keeps their actions and DnD. During construction the sidebar
+     * has not yet been placed in its split view. */
     GtkWidget *split = gtk_widget_get_ancestor (GTK_WIDGET (sidebar),
                                                  ADW_TYPE_OVERLAY_SPLIT_VIEW);
-    if (split != NULL)
+    if (split == NULL)
     {
-        luma_navigation_sidebar_adapt_live (ADW_OVERLAY_SPLIT_VIEW (split),
-                                            GTK_WIDGET (sidebar), "rail");
+        return;
     }
+    AdwOverlaySplitView *view = ADW_OVERLAY_SPLIT_VIEW (split);
+    luma_navigation_sidebar_adapt_live (view, GTK_WIDGET (sidebar), "narrow");
+    gtk_widget_set_size_request (adw_overlay_split_view_get_sidebar (view), FILER_SIDEBAR_WIDTH, -1);
+    adw_overlay_split_view_set_min_sidebar_width (view, FILER_SIDEBAR_WIDTH);
+    adw_overlay_split_view_set_max_sidebar_width (view, FILER_SIDEBAR_WIDTH);
+}
+
+static void
+refresh_luma_file_sidebar (NautilusSidebar *sidebar)
+{
+    nautilus_sidebar_adapt_to_split (sidebar);
 }
 
