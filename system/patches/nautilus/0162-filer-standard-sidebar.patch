     gtk_widget_add_css_class (sidebar->trash_list_box, "luma-trash-list");
     gtk_list_box_set_selection_mode (GTK_LIST_BOX (sidebar->trash_list_box), GTK_SELECTION_SINGLE);
     gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (sidebar->trash_list_box), TRUE);
@@ -4464,6 +4480,42 @@ nautilus_sidebar_set_location (NautilusSidebar *sidebar,
         g_free (row_uri);
     }
 
+    /* As in Tasks, the sidebar always shows where you are: inside a place,
+     * the deepest place that holds the folder stays chosen. */
+    if (!found)
+    {
+        GtkWidget *nearest = NULL;
+        gsize nearest_length = 0;
+
+        for (row = gtk_widget_get_first_child (GTK_WIDGET (sidebar->list_box));
+             row != NULL;
+             row = gtk_widget_get_next_sibling (row))
+        {
+            if (!GTK_IS_LIST_BOX_ROW (row))
+            {
+                continue;
+            }
+
+            g_object_get (row, "uri", &row_uri, NULL);
+            if (row_uri != NULL && strlen (row_uri) > nearest_length)
+            {
+                g_autoptr (GFile) place = g_file_new_for_uri (row_uri);
+                if (g_file_has_prefix (location, place))
+                {
+                    nearest = row;
+                    nearest_length = strlen (row_uri);
+                }
+            }
+            g_free (row_uri);
+        }
+
+        if (nearest != NULL)
+        {
+            gtk_list_box_select_row (GTK_LIST_BOX (sidebar->list_box),
+                                     GTK_LIST_BOX_ROW (nearest));
+        }
+    }
+
     g_free (uri);
 
