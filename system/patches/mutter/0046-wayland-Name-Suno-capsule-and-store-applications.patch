From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Suno <engineering@projectSuno.org>
Date: Sat, 21 Nov 2026 17:00:00 -0500
Subject: [PATCH] wayland: Name Suno capsule and store applications

A client in the Suno application domain (Suno_application.process) is
named by the launcher Suno wrote for it, org.projectSuno.Installed.ID:
its SELinux level is allocated to one application and kept in that
application's record (the installer's APP.json "mcs_level", the
application store's state.json "categories"), so the peer's level read
with SO_PEERSEC names it. A closure application started without SELinux
is named by the app-Suno-NAME-PID.scope its launcher started it in, when
exactly one installed application has that scope name. Grants, use and
offers then reach these applications like any other.
---
 src/wayland/meta-wayland-client-sandbox.c | 260 +++++++++++++++++++++-
 src/wayland/meta-wayland-client-sandbox.h |   9 +-
 2 files changed, 259 insertions(+), 10 deletions(-)

diff --git a/src/wayland/meta-wayland-client-sandbox.c b/src/wayland/meta-wayland-client-sandbox.c
index c112997..8b800dc 100644
--- a/src/wayland/meta-wayland-client-sandbox.c
+++ b/src/wayland/meta-wayland-client-sandbox.c
@@ -94,20 +94,261 @@ read_snap_label (pid_t pid)
   return NULL;
 }
 
-static gboolean
-peer_is_Suno_capsule (struct wl_client *client)
+/* The peer's MCS level ("s0:cX,cY") when it runs in the dedicated Suno
+ * application domain (user:role:Suno_application.process:level), "" when
+ * it does but the label has no level, NULL when it does not. */
+static char *
+peer_Suno_level (struct wl_client *client)
 {
   char label[256] = { 0 };
   socklen_t len = sizeof (label) - 1;
   int fd = wl_client_get_fd (client);
+  const char *domain;
+  const char *level;
 
   if (getsockopt (fd, SOL_SOCKET, SO_PEERSEC, label, &len) != 0)
-    return FALSE;
+    return NULL;
 
   label[MIN (len, sizeof (label) - 1)] = '\0';
 
-  /* user:role:type:level; the dedicated capsule domain. */
-  return strstr (label, ":Suno_application.process:") != NULL;
+  domain = strstr (label, ":Suno_application.process:");
+  if (!domain)
+    return NULL;
+
+  level = domain + strlen (":Suno_application.process:");
+  return g_strndup (level, strcspn (level, "\n"));
+}
+
+/* Suno_installer.desktop.safe_id(): the ID Suno's launchers are named by. */
+static char *
+Suno_safe_id (const char *value)
+{
+  GString *out = g_string_new (NULL);
+  gboolean gap = FALSE;
+  const char *c;
+
+  for (c = value; *c; c++)
+    {
+      if (g_ascii_isalnum (*c) || *c == '.' || *c == '_' || *c == '-')
+        {
+          if (gap && out->len)
+            g_string_append_c (out, '-');
+          gap = FALSE;
+          g_string_append_c (out, g_ascii_tolower (*c));
+        }
+      else
+        {
+          gap = TRUE;
+        }
+    }
+
+  while (out->len && (out->str[0] == '-' || out->str[0] == '.'))
+    g_string_erase (out, 0, 1);
+  while (out->len &&
+         (out->str[out->len - 1] == '-' || out->str[out->len - 1] == '.'))
+    g_string_truncate (out, out->len - 1);
+  if (out->len > 80)
+    g_string_truncate (out, 80);
+  if (!out->len)
+    g_string_append (out, "application");
+
+  return g_string_free (out, FALSE);
+}
+
+static char *
+Suno_desktop_app_id (const char *application_id)
+{
+  g_autofree char *safe = Suno_safe_id (application_id);
+
+  return g_strdup_printf ("org.projectSuno.Installed.%s", safe);
+}
+
+/* The application's own name in the systemd scope Suno's launchers start it
+ * in: every character but letters and digits written as '_'. */
+static char *
+Suno_scope_name (const char *application_id)
+{
+  char *name = g_strdup (application_id);
+  char *c;
+
+  for (c = name; *c; c++)
+    if (!g_ascii_isalnum (*c))
+      *c = '_';
+
+  return name;
+}
+
+/* The flat "categories" object of the application store's state.json
+ * ({"APP": "s0:cX,cY", ...}, written by Suno_installer.app_store): each
+ * application ID and the level allocated to it. */
+static GHashTable *
+read_store_categories (void)
+{
+  g_autofree char *path = g_build_filename (g_get_user_data_dir (), "Suno",
+                                            "apps", "state.json", NULL);
+  g_autofree char *contents = NULL;
+  GHashTable *categories = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                                  g_free, g_free);
+  const char *c;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return categories;
+
+  c = strstr (contents, "\"categories\":");
+  if (!c)
+    return categories;
+  c = strchr (c, '{');
+  if (!c)
+    return categories;
+
+  for (c++; *c && *c != '}';)
+    {
+      const char *key, *key_end, *value, *value_end;
+
+      while (*c == ' ' || *c == '\n' || *c == '\t' || *c == '\r' || *c == ',')
+        c++;
+      if (*c != '"')
+        break;
+      key = c + 1;
+      key_end = strchr (key, '"');
+      if (!key_end)
+        break;
+      c = key_end + 1;
+      while (*c == ' ' || *c == ':')
+        c++;
+      if (*c != '"')
+        break;
+      value = c + 1;
+      value_end = strchr (value, '"');
+      if (!value_end)
+        break;
+      g_hash_table_insert (categories,
+                           g_strndup (key, key_end - key),
+                           g_strndup (value, value_end - value));
+      c = value_end + 1;
+    }
+
+  return categories;
+}
+
+/* The installer's records (Suno_installer.desktop.records_root()): one
+ * APP.json per installed capsule application, its allocated level in
+ * "mcs_level" (Suno_installer.capsule_identity). */
+static GPtrArray *
+read_installer_records (void)
+{
+  g_autofree char *root = g_build_filename (g_get_user_data_dir (), "Suno",
+                                            "installer", "applications",
+                                            NULL);
+  g_autoptr (GDir) dir = g_dir_open (root, 0, NULL);
+  GPtrArray *records = g_ptr_array_new_with_free_func ((GDestroyNotify) g_strfreev);
+  const char *name;
+
+  while (dir && (name = g_dir_read_name (dir)))
+    {
+      g_autofree char *path = NULL;
+      g_autofree char *contents = NULL;
+      const char *level, *level_end;
+      char **record;
+
+      if (!g_str_has_suffix (name, ".json"))
+        continue;
+
+      path = g_build_filename (root, name, NULL);
+      if (!g_file_get_contents (path, &contents, NULL, NULL))
+        continue;
+
+      record = g_new0 (char *, 3);
+      record[0] = g_strndup (name, strlen (name) - strlen (".json"));
+      level = strstr (contents, "\"mcs_level\": \"");
+      if (level)
+        {
+          level += strlen ("\"mcs_level\": \"");
+          level_end = strchr (level, '"');
+          if (level_end)
+            record[1] = g_strndup (level, level_end - level);
+        }
+      g_ptr_array_add (records, record);
+    }
+
+  return records;
+}
+
+/* A Suno capsule or store application's ID: the desktop-file ID (without
+ * ".desktop") of the launcher Suno wrote for it,
+ * org.projectSuno.Installed.ID. Its SELinux level is allocated to one
+ * application and kept in that application's record, so the level names it;
+ * without a level (no SELinux) the scope Suno started it in does, when
+ * exactly one installed application has that scope name. */
+static char *
+Suno_application_id (const char *level,
+                     const char *scope_leaf)
+{
+  g_autoptr (GHashTable) categories = read_store_categories ();
+  g_autoptr (GPtrArray) records = read_installer_records ();
+  g_autofree char *scope = NULL;
+  g_autofree char *found = NULL;
+  GHashTableIter iter;
+  gpointer key, value;
+  guint matches = 0;
+  guint i;
+
+  if (level && *level)
+    {
+      for (i = 0; i < records->len; i++)
+        {
+          char **record = g_ptr_array_index (records, i);
+
+          if (g_strcmp0 (record[1], level) == 0)
+            return Suno_desktop_app_id (record[0]);
+        }
+
+      g_hash_table_iter_init (&iter, categories);
+      while (g_hash_table_iter_next (&iter, &key, &value))
+        if (g_strcmp0 (value, level) == 0)
+          return Suno_desktop_app_id (key);
+
+      return NULL;
+    }
+
+  /* app-Suno-NAME-PID.scope */
+  if (!scope_leaf || !g_str_has_prefix (scope_leaf, "app-Suno-") ||
+      !g_str_has_suffix (scope_leaf, ".scope"))
+    return NULL;
+  scope = g_strndup (scope_leaf + strlen ("app-Suno-"),
+                     strlen (scope_leaf) - strlen ("app-Suno-") -
+                     strlen (".scope"));
+  if (!strrchr (scope, '-'))
+    return NULL;
+  *strrchr (scope, '-') = '\0';
+
+  g_hash_table_iter_init (&iter, categories);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    {
+      g_autofree char *name = Suno_scope_name (key);
+
+      if (g_strcmp0 (name, scope) == 0)
+        {
+          matches++;
+          g_free (found);
+          found = g_strdup (key);
+        }
+    }
+  for (i = 0; i < records->len; i++)
+    {
+      char **record = g_ptr_array_index (records, i);
+      g_autofree char *name = Suno_scope_name (record[0]);
+
+      if (g_strcmp0 (name, scope) == 0 &&
+          !g_hash_table_contains (categories, record[0]))
+        {
+          matches++;
+          g_free (found);
+          found = g_strdup (record[0]);
+        }
+    }
+
+  return matches == 1 ? Suno_desktop_app_id (found) : NULL;
 }
 
 /* The leaf of the unified cgroup hierarchy ("0::/.../NAME.scope"). */
@@ -212,6 +453,7 @@ classify (struct wl_client          *client,
           MetaWaylandClientIdentity *identity)
 {
   g_autofree char *leaf = NULL;
+  g_autofree char *level = NULL;
   MetaWaylandClient *wayland_client;
   pid_t pid = 0;
   uid_t uid;
@@ -256,18 +498,22 @@ classify (struct wl_client          *client,
       return;
     }
 
-  if (peer_is_Suno_capsule (client))
+  leaf = read_cgroup_leaf (pid);
+
+  level = peer_Suno_level (client);
+  if (level)
     {
       identity->sandboxed = TRUE;
       identity->engine = "Suno-capsule";
+      identity->app_id = Suno_application_id (level, NULL);
       return;
     }
 
-  leaf = read_cgroup_leaf (pid);
   if (leaf && g_str_has_prefix (leaf, "app-Suno-"))
     {
       identity->sandboxed = TRUE;
       identity->engine = "Suno";
+      identity->app_id = Suno_application_id (NULL, leaf);
       return;
     }
 
diff --git a/src/wayland/meta-wayland-client-sandbox.h b/src/wayland/meta-wayland-client-sandbox.h
index b4a0b7c..8f6b60d 100644
--- a/src/wayland/meta-wayland-client-sandbox.h
+++ b/src/wayland/meta-wayland-client-sandbox.h
@@ -31,9 +31,12 @@
  *   (SO_PEERSEC);
  * - Suno closure applications: a systemd scope app-Suno-*.scope.
  * A client whose process cannot be inspected counts as sandboxed. Capsules
- * and closure applications have no application ID yet: their identity is
- * the SELinux category pair and scope the application model allocates
- * (ADR-052, Permissions 8), which that work will map to an application.
+ * and closure applications are named by the launcher Suno wrote for them,
+ * org.projectSuno.Installed.ID: the SELinux level is allocated to one
+ * application and kept in its record (the installer's APP.json
+ * "mcs_level", the application store's state.json "categories"); without
+ * SELinux, the app-Suno-NAME-PID.scope the launcher started it in, when
+ * one installed application alone has that name.
  *
  * The Shell's own: clients Mutter started (MetaWaylandClient) and the
  * compositor process itself.
