 %find_lang %{name} --all-name --with-gnome
 
+%check
+# Native Settings and its launcher work without a GNOME session identity.
+python3 %{SOURCE1000} %{_vpath_builddir}/shell/gnome-control-center \
+  %{_vpath_builddir}/shell/org.gnome.Settings.desktop
+# Suno: the device-name slug rules (0018) run through upstream's hostname test.
+%meson_test test-hostname
+# Suno's compositor schema is used only on this private package-check backend.
+task_runtime=$(mktemp -d)
+chmod 700 "$task_runtime"
+trap 'rm -rf "$task_runtime"' EXIT
+export XDG_RUNTIME_DIR="$task_runtime"
+mkdir "$task_runtime/schema"
+cp %{SOURCE1001} "$task_runtime/schema/"
+python3 %{SOURCE1003} %{SOURCE1002} "$task_runtime/schema/org.projectSuno.peripherals.gschema.xml"
+glib-compile-schemas --strict "$task_runtime/schema"
+export GSETTINGS_SCHEMA_DIR="$task_runtime/schema"
+# SunoUI Settings model and adapter tests; display-bound tests run below.
+%meson_test Suno-settings-fixture Suno-settings-applications Suno-settings-audio Suno-settings-permissions Suno-settings-power-reads Suno-settings-preferences Suno-settings-properties Suno-settings-scroll-speed Suno-settings-search-locations Suno-settings-live-conn Suno-settings-live-modem Suno-settings-live-gsettings Suno-settings-live-desk Suno-settings-live-you Suno-settings-live-keyboard Suno-settings-display-preview Suno-settings-display-save-view-1180 Suno-settings-display-save-view-320
+# Test the actual native network editor frame and Cancel with accessibility enabled.
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GIO_USE_VFS=local GDK_DEBUG=no-portals meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs Suno-settings-network-editor
+# Native page actions must reach the owned BlueZ/Rfkill service on a private bus.
+xvfb-run -a --server-args="-screen 0 1920x1080x24" env GSK_RENDERER=cairo meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs Suno-settings-live-bluetooth
+# Native pointer clicks must stay in Suno and read back from their actual owner.
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GIO_USE_VFS=local GDK_DEBUG=no-portals meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs Suno-settings-live-pointer
+# Layer-shell switches reach a stand-in Shell's SetCapability and read back its Apps.
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GIO_USE_VFS=local GDK_DEBUG=no-portals meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs Suno-settings-layer-shell
+# Connect Sync (0111): the key sheet's gates and Cancel against a stand-in Suno-connect-syncd.
+xvfb-run -a --server-args="-screen 0 1600x1200x24" env GSK_RENDERER=cairo GIO_USE_VFS=local GDK_DEBUG=no-portals meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs Suno-settings-connect-sync
+# Native Wi-Fi confirmation, failure/readback and scan-refresh input preservation.
+xvfb-run -a --server-args="-screen 0 1920x1080x24" env GSK_RENDERER=cairo GIO_USE_VFS=local meson test -C %{_vpath_builddir} --no-rebuild --print-errorlogs Suno-settings-live-network
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GSETTINGS_BACKEND=memory SUNO_SETTINGS_TEST_FIXTURE=%{SOURCE1004} %{_vpath_builddir}/shell/test-Suno-view --tap -p /settings/view/live-failure-keeps-pane
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GSETTINGS_BACKEND=memory SUNO_SETTINGS_TEST_FIXTURE=%{SOURCE1004} %{_vpath_builddir}/shell/test-Suno-view --tap -p /settings/view/scroll-speed
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GSETTINGS_BACKEND=memory SUNO_SETTINGS_TEST_FIXTURE=%{SOURCE1004} %{_vpath_builddir}/shell/test-Suno-view --tap -p /settings/view/nearby-in-place
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GSETTINGS_BACKEND=memory SUNO_SETTINGS_TEST_FIXTURE=%{SOURCE1004} %{_vpath_builddir}/shell/test-Suno-view --tap -p /settings/view/tv-leave
+xvfb-run -a --server-args="-screen 0 1600x1200x24" dbus-run-session -- env GSK_RENDERER=cairo GSETTINGS_BACKEND=memory GTK_A11Y=none G_DEBUG=fatal-criticals SUNO_SETTINGS_TEST_FIXTURE=%{SOURCE1004} %{_vpath_builddir}/shell/test-Suno-window --tap
+# Suno: the pointing stick page is called TrackPoint and says what it is (0021).
+grep -Fq '>TrackPoint<' %{_vpath_builddir}/panels/mouse/cc-mouse-panel.ui
+grep -Fq 'translatable="yes">The small pointer control in the middle of your keyboard.<' \
+  %{_vpath_builddir}/panels/mouse/cc-mouse-panel.ui
+if grep -Fq 'Pointing Stick' %{_vpath_builddir}/panels/mouse/cc-mouse-panel.ui; then exit 1; fi
+grep -q '^Keywords=.*;TrackPoint;' %{_vpath_builddir}/panels/mouse/gnome-mouse-panel.desktop
+# Suno: Scroll Speed on the Mouse and Touchpad sections (0026), and its
+# slider mapping; every mapping test must report ok.
+test "$(grep -c 'translatable="yes">Scroll _Speed<' %{_vpath_builddir}/panels/mouse/cc-mouse-panel.ui)" -eq 2
+gcc -o test-scroll-speed panels/mouse/test-scroll-speed.c \
+  $(pkg-config --cflags --libs glib-2.0) -lm
+./test-scroll-speed --tap | tee test-scroll-speed.log
+passed=$(grep -c '^ok ' test-scroll-speed.log)
+test "$passed" -eq 3 || { echo "test-scroll-speed: $passed of 3 passed"; exit 1; }
+
 %files -f %{name}.lang
