@@ -552,5 +552,5 @@ apps_stop (gpointer state)
 }
 
 const CcSunoAdapter cc_Suno_adapter_apps = {
-  "apps", (const char * const[]) { "apps", "app:", NULL }, apps_start, apps_write, apps_stop
+  "apps", (const char * const[]) { "apps", "app:", "overlay-apps", NULL }, apps_start, apps_write, apps_stop
 };
diff --git a/shell/cc-Suno-live-layer-shell.c b/shell/cc-Suno-live-layer-shell.c
new file mode 100644
index 0000000..f91889e
--- /dev/null
+++ b/shell/cc-Suno-live-layer-shell.c
@@ -0,0 +1,416 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live layer-shell permissions (gnome-shell 0380): what each app may draw
+ * outside its windows, read from org.projectSuno.LayerShell1 on the Shell's
+ * bus name and published as CFLAYER (cc-Suno-layer-shell.h).
+ *   Apps, Surfaces, OverlayApps  read with GetAll, again on PropertiesChanged,
+ *                                Used and Clamped
+ *   wallpaper / gnome tables     the portal's wallpaper entry and GNOME
+ *                                Shell's shortcuts-inhibitor entry, which the
+ *                                Desktop background and Take the keyboard
+ *                                switches keep in step
+ * The one write, "layerCap" {app, cap, on, portal?, desktop?}, calls
+ * SetCapability (the Shell stores it and hands it to Mutter at once) and
+ * writes the matching store entry. Without the Shell, or a Shell without the
+ * interface, CFLAYER is null and the rows are left out. */
+#include "cc-Suno-live.h"
+#include "cc-Suno-layer-shell.h"
+
+#define ADAPTER "layer"
+#define SHELL_NAME "org.gnome.Shell"
+#define LAYER_PATH "/org/projectSuno/LayerShell"
+#define LAYER_IFACE "org.projectSuno.LayerShell1"
+#define STORE_NAME "org.freedesktop.impl.portal.PermissionStore"
+#define STORE_PATH "/org/freedesktop/impl/portal/PermissionStore"
+#define KEY "layerCap"
+
+typedef struct {
+  CcSunoFixture *model;
+  GCancellable *cancel;
+  GDBusConnection *bus;
+  guint watch, props_signal, used_signal, clamped_signal, store_signal;
+  gboolean present, ready, reading, again;
+  /* Never changed once made: the published CFLAYER shares them. */
+  JsonObject *apps;       /* app → granted, refused, used, lastUsed, asked */
+  JsonObject *live;       /* app → capabilities in use now */
+  JsonObject *wallpaper;  /* portal id → "yes" / "no" */
+  JsonObject *inhibit;    /* desktop id → "GRANTED" / "DENIED" */
+} Layer;
+
+static void read_layer (Layer *s);
+
+static void
+mark_ready (Layer *s)
+{
+  if (s->ready) return;
+  s->ready = TRUE;
+  cc_Suno_live_ready (s->model, ADAPTER);
+}
+
+static void
+publish (Layer *s)
+{
+  if (!s->present || !s->apps)
+    {
+      g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ());
+      cc_Suno_fixture_publish_data (s->model, "CFLAYER", none);
+      return;
+    }
+  g_autoptr (JsonObject) layer = json_object_new ();
+  json_object_set_object_member (layer, "apps", json_object_ref (s->apps));
+  json_object_set_object_member (layer, "live", json_object_ref (s->live));
+  json_object_set_object_member (layer, "wallpaper", json_object_ref (s->wallpaper));
+  json_object_set_object_member (layer, "inhibit", json_object_ref (s->inhibit));
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), layer);
+  cc_Suno_fixture_publish_data (s->model, "CFLAYER", node);
+}
+
+/* a{ut} → {"<cap>": t} */
+static JsonObject *
+stamps (GVariant *dict)
+{
+  JsonObject *out = json_object_new ();
+  GVariantIter iter;
+  guint32 cap;
+  guint64 t;
+  if (!dict || !g_variant_is_of_type (dict, G_VARIANT_TYPE ("a{ut}"))) return out;
+  g_variant_iter_init (&iter, dict);
+  while (g_variant_iter_next (&iter, "{ut}", &cap, &t))
+    {
+      g_autofree char *key = g_strdup_printf ("%u", cap);
+      json_object_set_int_member (out, key, (gint64) t);
+    }
+  return out;
+}
+
+static guint
+mask (GVariant *row, const char *name)
+{
+  guint32 value = 0;
+  g_variant_lookup (row, name, "u", &value);
+  return value;
+}
+
+static void
+take_properties (Layer *s, GVariant *props)
+{
+  g_autoptr (GVariant) apps = g_variant_lookup_value (props, "Apps", G_VARIANT_TYPE ("a{sa{sv}}"));
+  g_autoptr (GVariant) surfaces = g_variant_lookup_value (props, "Surfaces", G_VARIANT_TYPE ("a(ssuubbt)"));
+  g_autoptr (GVariant) overlay = g_variant_lookup_value (props, "OverlayApps", G_VARIANT_TYPE ("as"));
+  JsonObject *rows = json_object_new ();
+  JsonObject *live = json_object_new ();
+  GVariantIter iter;
+  if (apps)
+    {
+      const char *id;
+      GVariant *row;
+      g_variant_iter_init (&iter, apps);
+      while (g_variant_iter_next (&iter, "{&s@a{sv}}", &id, &row))
+        {
+          JsonObject *out = json_object_new ();
+          g_autoptr (GVariant) last = g_variant_lookup_value (row, "last_used", G_VARIANT_TYPE ("a{ut}"));
+          g_autoptr (GVariant) asked = g_variant_lookup_value (row, "asked", G_VARIANT_TYPE ("a{ut}"));
+          json_object_set_int_member (out, "granted", mask (row, "granted"));
+          json_object_set_int_member (out, "refused", mask (row, "refused"));
+          json_object_set_int_member (out, "used", mask (row, "used"));
+          json_object_set_object_member (out, "lastUsed", stamps (last));
+          json_object_set_object_member (out, "asked", stamps (asked));
+          json_object_set_object_member (rows, id, out);
+          g_variant_unref (row);
+        }
+    }
+  if (surfaces)
+    {
+      const char *id;
+      guint32 caps;
+      gboolean held;
+      g_variant_iter_init (&iter, surfaces);
+      /* (app, namespace, layer, capabilities in use, faded, held, mapped since) */
+      while (g_variant_iter_next (&iter, "(&s&suubbt)", &id, NULL, NULL, &caps, NULL, &held, NULL))
+        if (!held) json_object_set_int_member (live, id, json_object_get_int_member_with_default (live, id, 0) | caps);
+    }
+  if (overlay)
+    {
+      const char *id;
+      g_variant_iter_init (&iter, overlay);
+      while (g_variant_iter_next (&iter, "&s", &id))
+        json_object_set_int_member (live, id, json_object_get_int_member_with_default (live, id, 0) | CC_SUNO_LAYER_OVERLAY);
+    }
+  g_clear_pointer (&s->apps, json_object_unref);
+  g_clear_pointer (&s->live, json_object_unref);
+  s->apps = rows;
+  s->live = live;
+}
+
+/* A copy that shares nothing with what was published. */
+static JsonObject *
+deep_copy (JsonObject *o)
+{
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), o);
+  g_autofree char *text = json_to_string (node, FALSE);
+  g_autoptr (JsonNode) copy = json_from_string (text, NULL);
+  return json_object_ref (json_node_get_object (copy));
+}
+
+static void
+got_all (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Layer *s = data;
+  s->reading = FALSE;
+  if (reply)
+    {
+      g_autoptr (GVariant) props = g_variant_get_child_value (reply, 0);
+      take_properties (s, props);
+      s->present = TRUE;
+    }
+  else
+    {
+      /* A Shell without the interface: nothing to show. */
+      g_debug ("Settings live: layer shell: %s", error->message);
+      s->present = FALSE;
+    }
+  publish (s);
+  mark_ready (s);
+  if (s->again)
+    {
+      s->again = FALSE;
+      read_layer (s);
+    }
+}
+
+static void
+read_layer (Layer *s)
+{
+  if (s->reading) { s->again = TRUE; return; }
+  s->reading = TRUE;
+  g_dbus_connection_call (s->bus, SHELL_NAME, LAYER_PATH, "org.freedesktop.DBus.Properties", "GetAll",
+                          g_variant_new ("(s)", LAYER_IFACE), G_VARIANT_TYPE ("(a{sv})"),
+                          G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, s->cancel, got_all, s);
+}
+
+/* The store entries the merged switches keep in step. */
+typedef struct { Layer *s; gboolean wallpaper; } StoreRead;
+
+static void
+store_read (GObject *source, GAsyncResult *result, gpointer data)
+{
+  StoreRead *read = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+      Layer *s = read->s;
+      JsonObject *table = json_object_new ();
+      if (reply)
+        {
+          g_autoptr (GVariant) apps = g_variant_get_child_value (reply, 0);
+          GVariantIter iter;
+          const char *id;
+          g_autofree char **value = NULL;
+          g_variant_iter_init (&iter, apps);
+          while (g_variant_iter_next (&iter, "{&s^a&s}", &id, &value))
+            {
+              if (value && value[0]) json_object_set_string_member (table, id, value[0]);
+              g_clear_pointer (&value, g_free);
+            }
+        }
+      JsonObject **slot = read->wallpaper ? &s->wallpaper : &s->inhibit;
+      json_object_unref (*slot);
+      *slot = table;
+      publish (s);
+    }
+  g_free (read);
+}
+
+static void
+read_store (Layer *s)
+{
+  const struct { const char *table, *entry; gboolean wallpaper; } entries[] = {
+    { "wallpaper", "wallpaper", TRUE }, { "gnome", "shortcuts-inhibitor", FALSE },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (entries); i++)
+    {
+      StoreRead *read = g_new0 (StoreRead, 1);
+      read->s = s;
+      read->wallpaper = entries[i].wallpaper;
+      g_dbus_connection_call (s->bus, STORE_NAME, STORE_PATH, STORE_NAME, "Lookup",
+                              g_variant_new ("(ss)", entries[i].table, entries[i].entry), G_VARIANT_TYPE ("(a{sas}v)"),
+                              G_DBUS_CALL_FLAGS_NONE, 5000, s->cancel, store_read, read);
+    }
+}
+
+static void
+layer_signal (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *signal,
+              GVariant *parameters, gpointer data)
+{
+  read_layer (data);
+}
+
+static void
+store_changed (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *signal,
+               GVariant *parameters, gpointer data)
+{
+  const char *table = NULL;
+  g_variant_get_child (parameters, 0, "&s", &table);
+  if (g_strcmp0 (table, "wallpaper") == 0 || g_strcmp0 (table, "gnome") == 0) read_store (data);
+}
+
+static void
+appeared (GDBusConnection *bus, const char *name, const char *owner, gpointer data)
+{
+  read_layer (data);
+}
+
+static void
+vanished (GDBusConnection *bus, const char *name, gpointer data)
+{
+  Layer *s = data;
+  s->present = FALSE;
+  publish (s);
+  mark_ready (s);
+}
+
+static void
+set_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Layer *s = data;
+  if (!reply)
+    {
+      cc_Suno_fixture_report_write_error (s->model, error);
+      read_layer (s);
+    }
+}
+
+static void
+store_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (!reply && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    g_message ("Settings: layer shell store entry: %s", error->message);
+}
+
+static const char *
+value_string (JsonObject *o, const char *name)
+{
+  JsonNode *n = json_object_get_member (o, name);
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : NULL;
+}
+
+static gboolean
+layer_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Layer *s = state;
+  if (!g_str_equal (key, KEY)) return FALSE;
+  JsonObject *o = value && JSON_NODE_HOLDS_OBJECT (value) ? json_node_get_object (value) : NULL;
+  JsonNode *cap_node = o ? json_object_get_member (o, "cap") : NULL;
+  JsonNode *on_node = o ? json_object_get_member (o, "on") : NULL;
+  const char *id = o ? value_string (o, "app") : NULL;
+  gint64 cap = cap_node && JSON_NODE_HOLDS_VALUE (cap_node) && json_node_get_value_type (cap_node) == G_TYPE_INT64 ? json_node_get_int (cap_node) : 0;
+  if (!id || !*id || (cap != 1 && cap != 2 && cap != 4 && cap != 8) || !on_node || !JSON_NODE_HOLDS_VALUE (on_node) ||
+      json_node_get_value_type (on_node) != G_TYPE_BOOLEAN)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "A layer permission is an app, a capability and on or off");
+      return FALSE;
+    }
+  if (!s->present)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "The desktop is not running");
+      return FALSE;
+    }
+  gboolean on = json_node_get_boolean (on_node);
+  CcSunoLayerApp app = { .id = (char *) id, .portal = (char *) value_string (o, "portal"), .desktop = (char *) value_string (o, "desktop") };
+  g_dbus_connection_call (s->bus, SHELL_NAME, LAYER_PATH, LAYER_IFACE, "SetCapability",
+                          g_variant_new ("(sub)", id, (guint32) cap, on), NULL,
+                          G_DBUS_CALL_FLAGS_NO_AUTO_START, 5000, s->cancel, set_done, s);
+  /* The switch keeps the older entry in step: the wallpaper portal's for a
+   * sandboxed app's background, GNOME Shell's shortcuts inhibitor for the
+   * keyboard (both read by the code that enforces them). */
+  if (cap == CC_SUNO_LAYER_BACKGROUND && app.portal)
+    {
+      const char *v[] = { on ? "yes" : "no", NULL };
+      g_dbus_connection_call (s->bus, STORE_NAME, STORE_PATH, STORE_NAME, "SetPermission",
+                              g_variant_new ("(sbss^as)", "wallpaper", TRUE, "wallpaper", app.portal, v), NULL,
+                              G_DBUS_CALL_FLAGS_NONE, 5000, s->cancel, store_done, NULL);
+    }
+  if (cap == CC_SUNO_LAYER_KEYBOARD && app.desktop)
+    {
+      const char *v[] = { on ? "GRANTED" : "DENIED", NULL };
+      g_dbus_connection_call (s->bus, STORE_NAME, STORE_PATH, STORE_NAME, "SetPermission",
+                              g_variant_new ("(sbss^as)", "gnome", TRUE, "shortcuts-inhibitor", app.desktop, v), NULL,
+                              G_DBUS_CALL_FLAGS_NONE, 5000, s->cancel, store_done, NULL);
+    }
+  /* The switch stays where it was put until the Shell reports. */
+  if (s->apps)
+    {
+      g_autoptr (JsonObject) next = json_object_new ();
+      json_object_set_object_member (next, "apps", deep_copy (s->apps));
+      json_object_set_object_member (next, "wallpaper", deep_copy (s->wallpaper));
+      json_object_set_object_member (next, "inhibit", deep_copy (s->inhibit));
+      cc_Suno_layer_apply (next, &app, cap, on);
+      g_clear_pointer (&s->apps, json_object_unref);
+      g_clear_pointer (&s->wallpaper, json_object_unref);
+      g_clear_pointer (&s->inhibit, json_object_unref);
+      s->apps = json_object_ref (json_object_get_object_member (next, "apps"));
+      s->wallpaper = json_object_ref (json_object_get_object_member (next, "wallpaper"));
+      s->inhibit = json_object_ref (json_object_get_object_member (next, "inhibit"));
+    }
+  publish (s);
+  return TRUE;
+}
+
+static gpointer
+layer_start (CcSunoFixture *model)
+{
+  Layer *s = g_new0 (Layer, 1);
+  s->model = model;
+  s->cancel = g_cancellable_new ();
+  s->wallpaper = json_object_new ();
+  s->inhibit = json_object_new ();
+  s->bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  if (!s->bus)
+    {
+      publish (s);
+      mark_ready (s);
+      return s;
+    }
+  cc_Suno_fixture_own_key (model, KEY);
+  s->props_signal = g_dbus_connection_signal_subscribe (s->bus, SHELL_NAME, "org.freedesktop.DBus.Properties", "PropertiesChanged",
+                                                        LAYER_PATH, LAYER_IFACE, G_DBUS_SIGNAL_FLAGS_NONE, layer_signal, s, NULL);
+  s->used_signal = g_dbus_connection_signal_subscribe (s->bus, SHELL_NAME, LAYER_IFACE, "Used", LAYER_PATH, NULL,
+                                                       G_DBUS_SIGNAL_FLAGS_NONE, layer_signal, s, NULL);
+  s->clamped_signal = g_dbus_connection_signal_subscribe (s->bus, SHELL_NAME, LAYER_IFACE, "Clamped", LAYER_PATH, NULL,
+                                                          G_DBUS_SIGNAL_FLAGS_NONE, layer_signal, s, NULL);
+  s->store_signal = g_dbus_connection_signal_subscribe (s->bus, NULL, STORE_NAME, "Changed", STORE_PATH, NULL,
+                                                        G_DBUS_SIGNAL_FLAGS_NONE, store_changed, s, NULL);
+  read_store (s);
+  s->watch = g_bus_watch_name_on_connection (s->bus, SHELL_NAME, G_BUS_NAME_WATCHER_FLAGS_NONE, appeared, vanished, s, NULL);
+  return s;
+}
+
+static void
+layer_stop (gpointer state)
+{
+  Layer *s = state;
+  g_cancellable_cancel (s->cancel);
+  if (s->watch) g_bus_unwatch_name (s->watch);
+  for (guint *id = (guint[]) { s->props_signal, s->used_signal, s->clamped_signal, s->store_signal, 0 }; *id; id++)
+    g_dbus_connection_signal_unsubscribe (s->bus, *id);
+  g_clear_object (&s->bus);
+  g_clear_pointer (&s->apps, json_object_unref);
+  g_clear_pointer (&s->live, json_object_unref);
+  g_clear_pointer (&s->wallpaper, json_object_unref);
+  g_clear_pointer (&s->inhibit, json_object_unref);
+  /* Replies still in flight hold s: leak the small shell rather than let
+   * a late one touch freed memory (as cc-Suno-live-applications.c). */
+  g_clear_object (&s->cancel);
+}
+
+const CcSunoAdapter cc_Suno_adapter_layer = {
+  ADAPTER, (const char * const[]) { "overlay-apps", NULL }, layer_start, layer_write, layer_stop
+};
