diff --git a/shell/cc-Suno-layer-shell.c b/shell/cc-Suno-layer-shell.c
new file mode 100644
index 0000000..452251b
--- /dev/null
+++ b/shell/cc-Suno-layer-shell.c
@@ -0,0 +1,199 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-Suno-layer-shell.h"
+#include <string.h>
+
+#define DESKTOP_SUFFIX ".desktop"
+
+static JsonObject *
+object_member (JsonObject *o, const char *name)
+{
+  JsonNode *n = o && name ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_OBJECT (n) ? json_node_get_object (n) : NULL;
+}
+
+static const char *
+string_member (JsonObject *o, const char *name)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : NULL;
+}
+
+static gint64
+int_member (JsonObject *o, const char *name)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_INT64 ? json_node_get_int (n) : 0;
+}
+
+void
+cc_Suno_layer_app_clear (CcSunoLayerApp *app)
+{
+  g_clear_pointer (&app->id, g_free);
+  g_clear_pointer (&app->portal, g_free);
+  g_clear_pointer (&app->desktop, g_free);
+}
+
+static char *
+shell_id (const char *portal, const char *desktop)
+{
+  if (portal && *portal) return g_strdup (portal);
+  if (desktop && g_str_has_suffix (desktop, DESKTOP_SUFFIX))
+    return g_strndup (desktop, strlen (desktop) - strlen (DESKTOP_SUFFIX));
+  return desktop && *desktop ? g_strdup (desktop) : NULL;
+}
+
+gboolean
+cc_Suno_layer_app_for (JsonObject *data, const char *settings_app, CcSunoLayerApp *out)
+{
+  JsonObject *entry = object_member (object_member (data, "CFAPPINFO"), settings_app);
+  const char *portal = string_member (entry, "flatpakId"), *desktop = string_member (entry, "desktopId");
+  memset (out, 0, sizeof *out);
+  out->id = shell_id (portal, desktop);
+  if (!out->id) return FALSE;
+  out->portal = portal && *portal ? g_strdup (portal) : NULL;
+  out->desktop = desktop ? g_strdup (desktop) : NULL;
+  return TRUE;
+}
+
+const char *
+cc_Suno_layer_settings_app (JsonObject *data, const char *id)
+{
+  JsonObject *info = object_member (data, "CFAPPINFO");
+  if (!info || !id) return NULL;
+  g_autoptr (GList) members = json_object_get_members (info);
+  for (GList *l = members; l; l = l->next)
+    {
+      JsonObject *entry = object_member (info, l->data);
+      g_autofree char *candidate = shell_id (string_member (entry, "flatpakId"), string_member (entry, "desktopId"));
+      if (g_strcmp0 (candidate, id) == 0) return l->data;
+    }
+  return NULL;
+}
+
+JsonObject *
+cc_Suno_layer_data (JsonObject *data)
+{
+  return object_member (data, "CFLAYER");
+}
+
+gboolean
+cc_Suno_layer_allowed (JsonObject *layer, const CcSunoLayerApp *app, guint cap)
+{
+  JsonObject *row = object_member (object_member (layer, "apps"), app->id);
+  guint granted = int_member (row, "granted"), refused = int_member (row, "refused");
+  /* SunoLayerShellModel.js: host apps have background and panel unless refused. */
+  guint defaults = app->portal ? 0 : CC_SUNO_LAYER_BACKGROUND | CC_SUNO_LAYER_PANEL;
+  if ((granted & cap) || ((defaults & cap) && !(refused & cap))) return TRUE;
+  if (cap == CC_SUNO_LAYER_BACKGROUND && app->portal)
+    return g_strcmp0 (string_member (object_member (layer, "wallpaper"), app->portal), "yes") == 0;
+  if (cap == CC_SUNO_LAYER_KEYBOARD && app->desktop)
+    return g_ascii_strcasecmp (string_member (object_member (layer, "inhibit"), app->desktop) ?: "", "GRANTED") == 0;
+  return FALSE;
+}
+
+gboolean
+cc_Suno_layer_in_use (JsonObject *layer, const char *id, guint cap)
+{
+  return (int_member (object_member (layer, "live"), id) & cap) != 0;
+}
+
+static gint64
+stamp (JsonObject *layer, const char *id, const char *what, guint cap)
+{
+  g_autofree char *key = g_strdup_printf ("%u", cap);
+  return int_member (object_member (object_member (object_member (layer, "apps"), id), what), key);
+}
+
+gint64
+cc_Suno_layer_last_used (JsonObject *layer, const char *id, guint cap)
+{
+  return stamp (layer, id, "lastUsed", cap);
+}
+
+gint64
+cc_Suno_layer_asked (JsonObject *layer, const char *id, guint cap)
+{
+  return stamp (layer, id, "asked", cap);
+}
+
+gint64
+cc_Suno_layer_now (JsonObject *layer)
+{
+  gint64 fixed = int_member (layer, "now");
+  return fixed > 0 ? fixed : g_get_real_time () / G_USEC_PER_SEC;
+}
+
+char *
+cc_Suno_layer_when (const char *verb, gint64 t, gint64 now)
+{
+  g_autoptr (GDateTime) then = g_date_time_new_from_unix_local (t);
+  g_autoptr (GDateTime) today = g_date_time_new_from_unix_local (now);
+  if (!then || !today) return g_strdup_printf ("%s today", verb);
+  g_autoptr (GDate) a = g_date_new_dmy (g_date_time_get_day_of_month (then), g_date_time_get_month (then), g_date_time_get_year (then));
+  g_autoptr (GDate) b = g_date_new_dmy (g_date_time_get_day_of_month (today), g_date_time_get_month (today), g_date_time_get_year (today));
+  int days = g_date_days_between (a, b);
+  if (days <= 0) return g_strdup_printf ("%s today", verb);
+  if (days == 1) return g_strdup_printf ("%s yesterday", verb);
+  if (days <= 30) return g_strdup_printf ("%s %d days ago", verb, days);
+  return g_strdup_printf ("%s over a month ago", verb);
+}
+
+char *
+cc_Suno_layer_usage (JsonObject *layer, const char *id, guint cap, gint64 now)
+{
+  gint64 t = cc_Suno_layer_last_used (layer, id, cap);
+  if (cc_Suno_layer_in_use (layer, id, cap)) return g_strdup ("Used today");
+  return t > 0 ? cc_Suno_layer_when ("Used", t, now) : g_strdup ("Never used");
+}
+
+static GPtrArray *
+overlay_apps (JsonObject *layer, gboolean allowed)
+{
+  GPtrArray *out = g_ptr_array_new_with_free_func (g_free);
+  JsonObject *apps = object_member (layer, "apps");
+  if (!apps) return out;
+  g_autoptr (GList) members = json_object_get_members (apps);
+  for (GList *l = members; l; l = l->next)
+    {
+      JsonObject *row = object_member (apps, l->data);
+      gboolean granted = (int_member (row, "granted") & CC_SUNO_LAYER_OVERLAY) != 0;
+      if (allowed ? granted : !granted && cc_Suno_layer_asked (layer, l->data, CC_SUNO_LAYER_OVERLAY) > 0)
+        g_ptr_array_add (out, g_strdup (l->data));
+    }
+  return out;
+}
+
+GPtrArray *
+cc_Suno_layer_overlay_allowed (JsonObject *layer)
+{
+  return overlay_apps (layer, TRUE);
+}
+
+GPtrArray *
+cc_Suno_layer_overlay_refused (JsonObject *layer)
+{
+  return overlay_apps (layer, FALSE);
+}
+
+static JsonObject *
+ensure_object (JsonObject *o, const char *name)
+{
+  JsonObject *child = object_member (o, name);
+  if (child) return child;
+  child = json_object_new ();
+  json_object_set_object_member (o, name, child);
+  return child;
+}
+
+void
+cc_Suno_layer_apply (JsonObject *layer, const CcSunoLayerApp *app, guint cap, gboolean allowed)
+{
+  JsonObject *row = ensure_object (ensure_object (layer, "apps"), app->id);
+  guint granted = int_member (row, "granted"), refused = int_member (row, "refused");
+  json_object_set_int_member (row, "granted", allowed ? granted | cap : granted & ~cap);
+  json_object_set_int_member (row, "refused", allowed ? refused & ~cap : refused | cap);
+  if (cap == CC_SUNO_LAYER_BACKGROUND && app->portal && object_member (layer, "wallpaper"))
+    json_object_set_string_member (object_member (layer, "wallpaper"), app->portal, allowed ? "yes" : "no");
+  if (cap == CC_SUNO_LAYER_KEYBOARD && app->desktop && object_member (layer, "inhibit"))
+    json_object_set_string_member (object_member (layer, "inhibit"), app->desktop, allowed ? "GRANTED" : "DENIED");
+}
diff --git a/shell/cc-Suno-layer-shell.h b/shell/cc-Suno-layer-shell.h
new file mode 100644
index 0000000..d88e7e6
--- /dev/null
+++ b/shell/cc-Suno-layer-shell.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* What apps may draw outside their windows (layer-shell surfaces), as
+ * Settings shows it: the data the "layer" adapter publishes as CFLAYER
+ * (fixtures carry the same object), read without GTK.
+ *
+ * CFLAYER {
+ *   "apps":      { <app>: { "granted": u, "refused": u, "used": u,
+ *                           "lastUsed": { "<cap>": t }, "asked": { "<cap>": t } } },
+ *   "live":      { <app>: mask }        capabilities in use now
+ *   "wallpaper": { <portal id>: "yes" | "no" }              portal store
+ *   "inhibit":   { <desktop id>: "GRANTED" | "DENIED" }     GNOME Shell's store
+ *   "now":       t                       fixtures only: their clock
+ * }
+ * <app> is the Shell's app ID: the Flatpak ID, else the desktop-file ID
+ * without ".desktop". Times are Unix seconds. */
+#pragma once
+#include <json-glib/json-glib.h>
+
+G_BEGIN_DECLS
+/* org.projectSuno.LayerShell1 capability bits. */
+typedef enum {
+  CC_SUNO_LAYER_BACKGROUND = 1 << 0,
+  CC_SUNO_LAYER_PANEL = 1 << 1,
+  CC_SUNO_LAYER_OVERLAY = 1 << 2,
+  CC_SUNO_LAYER_KEYBOARD = 1 << 3,
+} CcSunoLayerCap;
+
+/* A Settings app as the Shell names it (CFAPPINFO's flatpakId / desktopId). */
+typedef struct {
+  char *id;       /* the Shell's app ID */
+  char *portal;   /* Flatpak ID, NULL for a host app */
+  char *desktop;  /* desktop-file ID with ".desktop", or NULL */
+} CcSunoLayerApp;
+
+void cc_Suno_layer_app_clear (CcSunoLayerApp *app);
+/* FALSE when CFAPPINFO has nothing to name @settings_app by. */
+gboolean cc_Suno_layer_app_for (JsonObject *data, const char *settings_app, CcSunoLayerApp *out);
+/* The Settings app whose Shell ID is @id (CFAPPINFO), or NULL. */
+const char *cc_Suno_layer_settings_app (JsonObject *data, const char *id);
+
+/* CFLAYER, or NULL when no owner reports it (no Shell, an older Shell). */
+JsonObject *cc_Suno_layer_data (JsonObject *data);
+/* Whether @cap is allowed: granted, else the default (background and panel
+ * for host apps) unless refused; or allowed through the store entry the same
+ * switch keeps in step (wallpaper portal, GNOME's shortcuts inhibitor). */
+gboolean cc_Suno_layer_allowed (JsonObject *layer, const CcSunoLayerApp *app, guint cap);
+gboolean cc_Suno_layer_in_use (JsonObject *layer, const char *id, guint cap);
+gint64 cc_Suno_layer_last_used (JsonObject *layer, const char *id, guint cap);
+gint64 cc_Suno_layer_asked (JsonObject *layer, const char *id, guint cap);
+/* The fixture's clock, else now. */
+gint64 cc_Suno_layer_now (JsonObject *layer);
+/* "<verb> today", "<verb> yesterday", "<verb> 3 days ago" (local days). */
+char *cc_Suno_layer_when (const char *verb, gint64 t, gint64 now);
+/* An On screen row's usage: "Used today", "Used 3 days ago", "Never used". */
+char *cc_Suno_layer_usage (JsonObject *layer, const char *id, guint cap, gint64 now);
+
+/* Display over other apps: Shell IDs allowed to draw overlays, and those
+ * that asked and were refused (never-asked apps are not listed). */
+GPtrArray *cc_Suno_layer_overlay_allowed (JsonObject *layer);
+GPtrArray *cc_Suno_layer_overlay_refused (JsonObject *layer);
+
+/* Records a switch: @cap allowed or refused for @app, and the store entry
+ * kept in step with it. Fixtures change this way; the live adapter changes
+ * its copy the same way until the Shell reports. */
+void cc_Suno_layer_apply (JsonObject *layer, const CcSunoLayerApp *app, guint cap, gboolean allowed);
+G_END_DECLS
diff --git a/shell/cc-Suno-live-applications.c b/shell/cc-Suno-live-applications.c
index 28ee3b3..56ce885 100644
--- a/shell/cc-Suno-live-applications.c
