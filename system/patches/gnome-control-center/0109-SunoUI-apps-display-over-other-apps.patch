diff --git a/shell/test-Suno-layer-shell.c b/shell/test-Suno-layer-shell.c
new file mode 100644
index 0000000..21aca46
--- /dev/null
+++ b/shell/test-Suno-layer-shell.c
@@ -0,0 +1,417 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Layer-shell permissions in Settings (0109).
+ * - model: usage words, what the list shows (only apps that asked, when
+ *   refused), defaults and the store entries the merged switches follow;
+ * - live: Settings drawn from a stand-in Shell (org.projectSuno.LayerShell1)
+ *   and permission store on a private bus. A switch calls SetCapability, the
+ *   Shell's Apps comes back and the switch is read again from it; Desktop
+ *   background and Take the keyboard write the older store entries too. */
+#include "cc-Suno-live.h"
+#include "cc-Suno-layer-shell.h"
+#include "cc-Suno-view.h"
+#include <gio/gio.h>
+#include <glib/gstdio.h>
+#include <gtk/gtk.h>
+#include <adwaita.h>
+#include <sys/prctl.h>
+#include <signal.h>
+
+extern const CcSunoAdapter cc_Suno_adapter_layer;
+static gboolean ready;
+void cc_Suno_live_ready (CcSunoFixture *model, const char *adapter) { ready |= g_str_equal (adapter, "layer"); }
+
+#define NOW ((gint64) 1795262400) /* 2026-11-21 12:00 UTC */
+#define DAY ((gint64) 86400)
+
+static JsonObject *
+parse (const char *text)
+{
+  g_autoptr (JsonNode) node = json_from_string (text, NULL);
+  g_assert_nonnull (node);
+  return json_object_ref (json_node_get_object (node));
+}
+
+static void
+test_words (void)
+{
+  g_autofree char *today = cc_Suno_layer_when ("Used", NOW - 3600, NOW);
+  g_autofree char *yesterday = cc_Suno_layer_when ("Asked", NOW - DAY, NOW);
+  g_autofree char *three = cc_Suno_layer_when ("Used", NOW - 3 * DAY, NOW);
+  g_autofree char *old = cc_Suno_layer_when ("Used", NOW - 60 * DAY, NOW);
+  g_assert_cmpstr (today, ==, "Used today");
+  g_assert_cmpstr (yesterday, ==, "Asked yesterday");
+  g_assert_cmpstr (three, ==, "Used 3 days ago");
+  g_assert_cmpstr (old, ==, "Used over a month ago");
+
+  g_autoptr (JsonObject) layer = parse ("{\"now\":1795262400,"
+    "\"apps\":{\"a\":{\"granted\":4,\"refused\":0,\"used\":4,\"lastUsed\":{\"4\":1795003200}}},"
+    "\"live\":{\"b\":4}}");
+  g_autofree char *a = cc_Suno_layer_usage (layer, "a", CC_SUNO_LAYER_OVERLAY, cc_Suno_layer_now (layer));
+  g_autofree char *a_panel = cc_Suno_layer_usage (layer, "a", CC_SUNO_LAYER_PANEL, cc_Suno_layer_now (layer));
+  g_autofree char *b = cc_Suno_layer_usage (layer, "b", CC_SUNO_LAYER_OVERLAY, cc_Suno_layer_now (layer));
+  g_assert_cmpstr (a, ==, "Used 3 days ago");
+  g_assert_cmpstr (a_panel, ==, "Never used");
+  /* In use now and never recorded: it is being used today. */
+  g_assert_cmpstr (b, ==, "Used today");
+  g_assert_true (cc_Suno_layer_in_use (layer, "b", CC_SUNO_LAYER_OVERLAY));
+  g_assert_false (cc_Suno_layer_in_use (layer, "a", CC_SUNO_LAYER_OVERLAY));
+}
+
+static gboolean
+contains (GPtrArray *ids, const char *id)
+{
+  return g_ptr_array_find_with_equal_func (ids, id, g_str_equal, NULL);
+}
+
+static void
+test_list (void)
+{
+  g_autoptr (JsonObject) layer = parse ("{\"apps\":{"
+    "\"allowed\":{\"granted\":4,\"refused\":0,\"asked\":{\"4\":1}},"
+    "\"granted-unasked\":{\"granted\":4,\"refused\":0},"
+    "\"refused-asked\":{\"granted\":0,\"refused\":4,\"asked\":{\"4\":1795176000}},"
+    "\"refused-unasked\":{\"granted\":0,\"refused\":4},"
+    "\"asked-panel\":{\"granted\":0,\"refused\":2,\"asked\":{\"2\":1}},"
+    "\"nothing\":{\"granted\":0,\"refused\":0}}}");
+  g_autoptr (GPtrArray) allowed = cc_Suno_layer_overlay_allowed (layer);
+  g_autoptr (GPtrArray) refused = cc_Suno_layer_overlay_refused (layer);
+  g_assert_cmpuint (allowed->len, ==, 2);
+  g_assert_true (contains (allowed, "allowed") && contains (allowed, "granted-unasked"));
+  /* Only apps that asked and were told Not now; never-asked apps aren't listed. */
+  g_assert_cmpuint (refused->len, ==, 1);
+  g_assert_true (contains (refused, "refused-asked"));
+
+  /* Defaults: host apps have background and panel unless refused; sandboxed apps nothing. */
+  CcSunoLayerApp host = { .id = "nothing", .desktop = "nothing.desktop" };
+  CcSunoLayerApp flatpak = { .id = "org.example.Flat", .portal = "org.example.Flat", .desktop = "org.example.Flat.desktop" };
+  CcSunoLayerApp refused_panel = { .id = "asked-panel", .desktop = "asked-panel.desktop" };
+  g_assert_true (cc_Suno_layer_allowed (layer, &host, CC_SUNO_LAYER_BACKGROUND));
+  g_assert_true (cc_Suno_layer_allowed (layer, &host, CC_SUNO_LAYER_PANEL));
+  g_assert_false (cc_Suno_layer_allowed (layer, &host, CC_SUNO_LAYER_OVERLAY));
+  g_assert_false (cc_Suno_layer_allowed (layer, &flatpak, CC_SUNO_LAYER_BACKGROUND));
+  g_assert_false (cc_Suno_layer_allowed (layer, &refused_panel, CC_SUNO_LAYER_PANEL));
+
+  /* The merged switches follow the older entries too, and keep them in step. */
+  g_autoptr (JsonObject) mirrors = parse ("{\"apps\":{},\"wallpaper\":{\"org.example.Flat\":\"yes\"},"
+                                          "\"inhibit\":{\"org.example.Flat.desktop\":\"GRANTED\"}}");
+  g_assert_true (cc_Suno_layer_allowed (mirrors, &flatpak, CC_SUNO_LAYER_BACKGROUND));
+  g_assert_true (cc_Suno_layer_allowed (mirrors, &flatpak, CC_SUNO_LAYER_KEYBOARD));
+  cc_Suno_layer_apply (mirrors, &flatpak, CC_SUNO_LAYER_BACKGROUND, FALSE);
+  cc_Suno_layer_apply (mirrors, &flatpak, CC_SUNO_LAYER_KEYBOARD, FALSE);
+  g_assert_false (cc_Suno_layer_allowed (mirrors, &flatpak, CC_SUNO_LAYER_BACKGROUND));
+  g_assert_false (cc_Suno_layer_allowed (mirrors, &flatpak, CC_SUNO_LAYER_KEYBOARD));
+  g_assert_cmpstr (json_object_get_string_member (json_object_get_object_member (mirrors, "wallpaper"), "org.example.Flat"), ==, "no");
+  g_assert_cmpstr (json_object_get_string_member (json_object_get_object_member (mirrors, "inhibit"), "org.example.Flat.desktop"), ==, "DENIED");
+}
+
+/* ── A stand-in Shell and permission store ─────────────────────────── */
+static const char xml[] =
+  "<node><interface name='org.projectSuno.LayerShell1'>"
+  "<property name='Surfaces' type='a(ssuubbt)' access='read'/>"
+  "<property name='OverlayApps' type='as' access='read'/>"
+  "<property name='FadedApps' type='as' access='read'/>"
+  "<property name='Apps' type='a{sa{sv}}' access='read'/>"
+  "<method name='SetCapability'><arg name='app_id' type='s' direction='in'/><arg name='capability' type='u' direction='in'/>"
+  "<arg name='allowed' type='b' direction='in'/></method>"
+  "<signal name='Used'><arg type='s'/><arg type='u'/></signal></interface>"
+  "<interface name='org.freedesktop.impl.portal.PermissionStore'>"
+  "<method name='Lookup'><arg type='s' direction='in'/><arg type='s' direction='in'/><arg type='a{sas}' direction='out'/><arg type='v' direction='out'/></method>"
+  "<method name='SetPermission'><arg type='s' direction='in'/><arg type='b' direction='in'/><arg type='s' direction='in'/><arg type='s' direction='in'/><arg type='as' direction='in'/></method>"
+  "</interface></node>";
+
+#define DISKORD "app.diskord.Diskord"
+#define PLAYGROUND "org.projectSuno.Playground"
+
+typedef struct { guint granted, refused; } Row;
+typedef struct {
+  GDBusConnection *bus;
+  GHashTable *rows;    /* app → Row */
+  GPtrArray *calls;    /* "SetCapability app cap b", "SetPermission table entry app value" */
+} Shell;
+
+static GVariant *
+apps_variant (Shell *sh)
+{
+  GVariantBuilder b;
+  GHashTableIter iter;
+  gpointer key, value;
+  g_variant_builder_init (&b, G_VARIANT_TYPE ("a{sa{sv}}"));
+  g_hash_table_iter_init (&iter, sh->rows);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    {
+      Row *r = value;
+      GVariantBuilder row, last, asked;
+      g_variant_builder_init (&row, G_VARIANT_TYPE ("a{sv}"));
+      g_variant_builder_init (&last, G_VARIANT_TYPE ("a{ut}"));
+      g_variant_builder_init (&asked, G_VARIANT_TYPE ("a{ut}"));
+      if (g_str_equal (key, DISKORD)) g_variant_builder_add (&last, "{ut}", 4, (guint64) (g_get_real_time () / G_USEC_PER_SEC));
+      g_variant_builder_add (&asked, "{ut}", 4, (guint64) (g_get_real_time () / G_USEC_PER_SEC - DAY));
+      g_variant_builder_add (&row, "{sv}", "granted", g_variant_new_uint32 (r->granted));
+      g_variant_builder_add (&row, "{sv}", "refused", g_variant_new_uint32 (r->refused));
+      g_variant_builder_add (&row, "{sv}", "used", g_variant_new_uint32 (g_str_equal (key, DISKORD) ? 4 : 0));
+      g_variant_builder_add (&row, "{sv}", "last_used", g_variant_builder_end (&last));
+      g_variant_builder_add (&row, "{sv}", "asked", g_variant_builder_end (&asked));
+      g_variant_builder_add (&b, "{s@a{sv}}", (const char *) key, g_variant_builder_end (&row));
+    }
+  return g_variant_builder_end (&b);
+}
+
+static GVariant *
+get_property (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *name,
+              GError **error, gpointer data)
+{
+  Shell *sh = data;
+  if (g_str_equal (name, "Apps")) return apps_variant (sh);
+  if (g_str_equal (name, "Surfaces"))
+    return g_variant_new_parsed ("[(%s, 'voice', uint32 3, uint32 4, false, false, uint64 1)]", DISKORD);
+  if (g_str_equal (name, "OverlayApps")) return g_variant_new_parsed ("[%s]", DISKORD);
+  return g_variant_new_strv (NULL, 0);
+}
+
+static void
+method (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *name,
+        GVariant *args, GDBusMethodInvocation *call, gpointer data)
+{
+  Shell *sh = data;
+  if (g_str_equal (name, "SetCapability"))
+    {
+      const char *app;
+      guint32 cap;
+      gboolean allowed;
+      g_variant_get (args, "(&sub)", &app, &cap, &allowed);
+      g_ptr_array_add (sh->calls, g_strdup_printf ("SetCapability %s %u %s", app, cap, allowed ? "true" : "false"));
+      Row *r = g_hash_table_lookup (sh->rows, app);
+      if (!r) { r = g_new0 (Row, 1); g_hash_table_insert (sh->rows, g_strdup (app), r); }
+      r->granted = allowed ? r->granted | cap : r->granted & ~cap;
+      r->refused = allowed ? r->refused & ~cap : r->refused | cap;
+      GVariantBuilder changed;
+      g_variant_builder_init (&changed, G_VARIANT_TYPE ("a{sv}"));
+      g_variant_builder_add (&changed, "{sv}", "Apps", apps_variant (sh));
+      g_dbus_connection_emit_signal (bus, NULL, "/org/projectSuno/LayerShell", "org.freedesktop.DBus.Properties", "PropertiesChanged",
+                                     g_variant_new ("(sa{sv}as)", "org.projectSuno.LayerShell1", &changed, NULL), NULL);
+      g_dbus_method_invocation_return_value (call, NULL);
+    }
+  else if (g_str_equal (name, "Lookup"))
+    g_dbus_method_invocation_return_dbus_error (call, "org.freedesktop.portal.Error.NotFound", "No entry");
+  else if (g_str_equal (name, "SetPermission"))
+    {
+      const char *table, *entry, *app;
+      g_autofree const char **value = NULL;
+      g_variant_get (args, "(&sb&s&s^a&s)", &table, NULL, &entry, &app, &value);
+      g_ptr_array_add (sh->calls, g_strdup_printf ("SetPermission %s %s %s %s", table, entry, app, value[0]));
+      g_dbus_method_invocation_return_value (call, NULL);
+    }
+}
+
+static const GDBusInterfaceVTable vtable = { .method_call = method, .get_property = get_property };
+
+static void
+own (GDBusConnection *bus, const char *name)
+{
+  g_autoptr (GVariant) v = g_dbus_connection_call_sync (bus, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
+                                                        "RequestName", g_variant_new ("(su)", name, 0), G_VARIANT_TYPE ("(u)"),
+                                                        G_DBUS_CALL_FLAGS_NONE, 3000, NULL, NULL);
+  g_assert_nonnull (v);
+}
+
+static void
+spin (guint ms)
+{
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  do { while (g_main_context_iteration (NULL, FALSE)); g_usleep (1000); } while (g_get_monotonic_time () < end);
+}
+
+static GtkWidget *
+named (GtkWidget *root, const char *name)
+{
+  if (!g_strcmp0 (gtk_widget_get_name (root), name)) return root;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = named (w, name);
+      if (found) return found;
+    }
+  return NULL;
+}
+
+static gboolean
+has_class_below (GtkWidget *root, const char *cls)
+{
+  if (gtk_widget_has_css_class (root, cls)) return TRUE;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    if (has_class_below (w, cls)) return TRUE;
+  return FALSE;
+}
+
+static gboolean
+has_text (GtkWidget *root, const char *text)
+{
+  if (GTK_IS_LABEL (root) && g_strcmp0 (gtk_label_get_text (GTK_LABEL (root)), text) == 0) return TRUE;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    if (has_text (w, text)) return TRUE;
+  return FALSE;
+}
+
+static gboolean
+switch_on (GtkWidget *view, const char *name)
+{
+  GtkWidget *sw = named (view, name);
+  g_assert_nonnull (sw);
+  g_assert_true (GTK_IS_SWITCH (sw));
+  return gtk_switch_get_active (GTK_SWITCH (sw));
+}
+
+/* Presses the row and waits for the Shell's answer to be drawn. */
+static void
+press (Shell *sh, GtkWidget *view, const char *row, const char *expected_call)
+{
+  guint before = sh->calls->len;
+  GtkWidget *button = named (view, row);
+  g_assert_nonnull (button);
+  g_signal_emit_by_name (button, "clicked");
+  for (guint i = 0; i < 100; i++)
+    {
+      spin (20);
+      for (guint j = before; j < sh->calls->len; j++)
+        if (g_str_equal (sh->calls->pdata[j], expected_call)) { spin (150); return; }
+    }
+  for (guint j = 0; j < sh->calls->len; j++) g_printerr ("call: %s\n", (char *) sh->calls->pdata[j]);
+  g_error ("no %s", expected_call);
+}
+
+static gboolean
+called (Shell *sh, const char *call)
+{
+  return g_ptr_array_find_with_equal_func (sh->calls, call, g_str_equal, NULL);
+}
+
+static gboolean
+writer (CcSunoFixture *model, const char *key, JsonNode *value, gpointer state, GError **error)
+{
+  return cc_Suno_adapter_layer.write (state, key, value, error);
+}
+
+static void bus_child_setup (gpointer data) { prctl (PR_SET_PDEATHSIG, SIGTERM); }
+
+static const char structure[] =
+  "{\"version\":1,\"settings\":{},\"data\":{"
+  "\"CFAPPS\":[\"diskord\",\"huddle\",\"playground\"],"
+  "\"CFAPPINFO\":{\"diskord\":{\"name\":\"Diskord\",\"flatpakId\":\"" DISKORD "\",\"desktopId\":\"" DISKORD ".desktop\"},"
+  "\"huddle\":{\"name\":\"Huddle\",\"desktopId\":\"huddle.desktop\"},"
+  "\"playground\":{\"name\":\"Playground\",\"desktopId\":\"" PLAYGROUND ".desktop\"}},"
+  "\"CFSZ\":{},\"CFPERMS\":{\"diskord\":[\"notif\",\"wall\"]},"
+  "\"CFPERM\":{\"notif\":[\"Notifications\",\"Shows notifications\"],\"wall\":[\"Change wallpaper\",\"Can set the desktop background\"]}},"
+  "\"pages\":[{\"id\":\"apps\",\"title\":\"Apps\",\"parent\":null},{\"id\":\"overlay-apps\",\"title\":\"Display over other apps\",\"parent\":\"apps\"}]}";
+
+static void
+test_live (void)
+{
+  g_autoptr (GSubprocessLauncher) launcher = g_subprocess_launcher_new (G_SUBPROCESS_FLAGS_STDOUT_PIPE);
+  g_subprocess_launcher_set_child_setup (launcher, bus_child_setup, NULL, NULL);
+  g_autoptr (GSubprocess) daemon = g_subprocess_launcher_spawn (launcher, NULL, "dbus-daemon", "--session", "--nofork", "--print-address=1", NULL);
+  g_assert_nonnull (daemon);
+  g_autoptr (GDataInputStream) output = g_data_input_stream_new (g_subprocess_get_stdout_pipe (daemon));
+  g_autofree char *address = g_data_input_stream_read_line (output, NULL, NULL, NULL);
+  g_assert_nonnull (address);
+  g_setenv ("DBUS_SESSION_BUS_ADDRESS", address, TRUE);
+
+  Shell sh = { 0 };
+  sh.rows = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  sh.calls = g_ptr_array_new_with_free_func (g_free);
+  /* Every row in the stand-in was offered overlay a day ago (apps_variant). */
+  Row *diskord = g_new0 (Row, 1), *playground = g_new0 (Row, 1);
+  diskord->granted = 4;
+  playground->refused = 4;
+  g_hash_table_insert (sh.rows, g_strdup (DISKORD), diskord);
+  g_hash_table_insert (sh.rows, g_strdup (PLAYGROUND), playground);
+  sh.bus = g_dbus_connection_new_for_address_sync (address, G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                                   G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, NULL);
+  g_assert_nonnull (sh.bus);
+  g_autoptr (GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (xml, NULL);
+  g_assert_cmpuint (g_dbus_connection_register_object (sh.bus, "/org/projectSuno/LayerShell", info->interfaces[0], &vtable, &sh, NULL, NULL), >, 0);
+  g_assert_cmpuint (g_dbus_connection_register_object (sh.bus, "/org/freedesktop/impl/portal/PermissionStore", info->interfaces[1], &vtable, &sh, NULL, NULL), >, 0);
+  own (sh.bus, "org.gnome.Shell");
+  own (sh.bus, "org.freedesktop.impl.portal.PermissionStore");
+
+  g_autoptr (JsonNode) root = json_from_string (structure, NULL);
+  g_autoptr (CcSunoFixture) model = cc_Suno_fixture_new_live (root);
+  /* App icons, as the apps adapter publishes them. */
+  g_autofree char *icons = g_dir_make_tmp ("Suno-layer-icons-XXXXXX", NULL);
+  g_autofree char *icon = g_build_filename (icons, "app.svg", NULL);
+  g_assert_true (g_file_set_contents (icon, "<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64'>"
+                                      "<rect width='64' height='64' rx='14' fill='#5865f2'/></svg>", -1, NULL));
+  for (const char * const *app = (const char * const[]) { "diskord", "huddle", "playground", NULL }; *app; app++)
+    cc_Suno_fixture_publish_asset (model, *app, icon);
+  gpointer state = cc_Suno_adapter_layer.start (model);
+  cc_Suno_fixture_set_writer (model, writer, state);
+  cc_Suno_fixture_verify_owned_keys (model);
+  for (guint i = 0; i < 100 && !ready; i++) spin (20);
+  g_assert_true (ready);
+  for (guint i = 0; i < 100 && !cc_Suno_layer_data (cc_Suno_fixture_get_data (model)); i++) spin (20);
+  g_assert_nonnull (cc_Suno_layer_data (cc_Suno_fixture_get_data (model)));
+
+  adw_init ();
+  g_autoptr (GError) error = NULL;
+  GtkWidget *view = cc_Suno_view_new (model, "overlay-apps", &error);
+  g_assert_no_error (error);
+  GtkWidget *window = gtk_window_new ();
+  gtk_window_set_default_size (GTK_WINDOW (window), 900, 800);
+  gtk_window_set_child (GTK_WINDOW (window), view);
+  gtk_window_present (GTK_WINDOW (window));
+  spin (300);
+
+  /* The list: Diskord allowed and showing now; Playground asked and was refused. */
+  g_assert_true (has_text (view, "1 app allowed · 1 showing now"));
+  g_assert_true (switch_on (view, "cf-ov-diskord"));
+  g_assert_false (switch_on (view, "cf-ov-playground"));
+  g_assert_null (named (view, "cf-ov-huddle"));
+  g_assert_true (has_text (view, "Asked yesterday"));
+  g_assert_true (has_text (view, " · Showing now"));
+
+  /* Off: SetCapability, the Shell's Apps, the switch read back; the row stays put. */
+  press (&sh, view, "cf-row-ov-diskord", "SetCapability " DISKORD " 4 false");
+  g_assert_false (switch_on (view, "cf-ov-diskord"));
+  g_assert_false (diskord->granted & 4);
+  press (&sh, view, "cf-row-ov-playground", "SetCapability " PLAYGROUND " 4 true");
+  g_assert_true (switch_on (view, "cf-ov-playground"));
+  g_assert_true (playground->granted & 4);
+  press (&sh, view, "cf-row-ov-diskord", "SetCapability " DISKORD " 4 true");
+  g_assert_true (switch_on (view, "cf-ov-diskord"));
+
+  /* The app page: On screen replaces Change wallpaper; the overlay tile is violet while in use. */
+  cc_Suno_view_go (view, "app:diskord");
+  spin (300);
+  g_assert_nonnull (named (view, "cf-layer-overlay"));
+  g_assert_null (named (view, "cf-perm_diskordwall"));
+  g_assert_true (has_class_below (named (view, "cf-row-layer-overlay"), "cf-ov-lit"));
+  g_assert_false (has_class_below (named (view, "cf-row-layer-panel"), "cf-ov-lit"));
+  g_assert_true (has_text (view, " · Used today"));
+  g_assert_true (has_text (view, " · Never used"));
+  g_assert_false (switch_on (view, "cf-layer-background"));
+  press (&sh, view, "cf-row-layer-background", "SetCapability " DISKORD " 1 true");
+  g_assert_true (called (&sh, "SetPermission wallpaper wallpaper " DISKORD " yes"));
+  g_assert_true (switch_on (view, "cf-layer-background"));
+  press (&sh, view, "cf-row-layer-keyboard", "SetCapability " DISKORD " 8 true");
+  g_assert_true (called (&sh, "SetPermission gnome shortcuts-inhibitor " DISKORD ".desktop GRANTED"));
+  g_assert_true (switch_on (view, "cf-layer-keyboard"));
+  press (&sh, view, "cf-row-layer-keyboard", "SetCapability " DISKORD " 8 false");
+  g_assert_true (called (&sh, "SetPermission gnome shortcuts-inhibitor " DISKORD ".desktop DENIED"));
+  g_assert_false (switch_on (view, "cf-layer-keyboard"));
+
+  gtk_window_destroy (GTK_WINDOW (window));
+  spin (100);
+  cc_Suno_adapter_layer.stop (state);
+  g_unlink (icon);
+  g_rmdir (icons);
+  g_hash_table_unref (sh.rows);
+  g_ptr_array_unref (sh.calls);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/settings/layer-shell/words", test_words);
+  g_test_add_func ("/settings/layer-shell/list", test_list);
+  g_test_add_func ("/settings/layer-shell/live", test_live);
+  return g_test_run ();
+}
