+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* What apps may draw outside their windows (design-center 858103d,
+ * mockups/overlay-perms/settings.html): an app page's On screen group and
+ * Apps › Display over other apps. Read from CFLAYER (cc-Suno-layer-shell.h);
+ * a switch writes "layerCap", which the live adapter hands to the Shell's
+ * SetCapability. Violet (SunoUI token "overlay") marks what is in use now. */
+#include "cc-Suno-rows.h"
+#include "cc-Suno-layer-shell.h"
+
+static const struct { guint cap; const char *name, *title, *subtitle, *icon; } caps[] = {
+  { CC_SUNO_LAYER_OVERLAY, "overlay", "Display over other apps", "Above games and full-screen apps", "layers-2" },
+  { CC_SUNO_LAYER_PANEL, "panel", "Add a panel", "A bar on one edge of the screen", "panel-top" },
+  { CC_SUNO_LAYER_BACKGROUND, "background", "Desktop background", "Draws or sets your wallpaper", "image" },
+  { CC_SUNO_LAYER_KEYBOARD, "keyboard", "Take the keyboard", "Gets every key, even system shortcuts", "keyboard" },
+};
+
+#define APP_NOTE "Apps can never cover more than 40% of the screen, or draw over the lock screen, passwords and Suno’s own panels."
+#define LIST_NOTE "These apps can draw above games and full-screen apps. They never cover more than 40% of the screen while you use another app."
+
+static void
+switched (GtkSwitch *visual, GParamSpec *pspec, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || v->rendering) return;
+  CcSunoLayerApp app = {
+    .id = g_object_get_data (G_OBJECT (visual), "cf-layer-id"),
+    .portal = g_object_get_data (G_OBJECT (visual), "cf-layer-portal"),
+    .desktop = g_object_get_data (G_OBJECT (visual), "cf-layer-desktop"),
+  };
+  guint cap = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (visual), "cf-layer-cap"));
+  gboolean on = gtk_switch_get_active (visual);
+  GtkWidget *button = gtk_widget_get_ancestor (GTK_WIDGET (visual), GTK_TYPE_BUTTON);
+  if (button)
+    gtk_accessible_update_state (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_STATE_CHECKED,
+                                 on ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+  JsonObject *layer = cc_Suno_layer_data (cc_Suno_fixture_get_data (v->model));
+  if (!app.id || !layer) return;
+  if (!cc_Suno_fixture_is_live (v->model))
+    {
+      /* Fixtures keep their own copy, as the live adapter does until the Shell reports. */
+      cc_Suno_layer_apply (layer, &app, cap, on);
+      cc_Suno_view_queue_refresh (v);
+      return;
+    }
+  g_autoptr (JsonObject) change = json_object_new ();
+  json_object_set_string_member (change, "app", app.id);
+  json_object_set_int_member (change, "cap", cap);
+  json_object_set_boolean_member (change, "on", on);
+  if (app.portal) json_object_set_string_member (change, "portal", app.portal);
+  if (app.desktop) json_object_set_string_member (change, "desktop", app.desktop);
+  g_autoptr (JsonNode) value = json_node_init_object (json_node_alloc (), change);
+  g_autoptr (GError) error = NULL;
+  if (!cc_Suno_fixture_write (v->model, "layerCap", value, &error))
+    {
+      cc_Suno_view_report_error (v, error);
+      cc_Suno_view_queue_refresh (v);
+    }
+}
+
+static void
+flip (GtkButton *button, GtkSwitch *visual)
+{
+  gtk_switch_set_active (visual, !gtk_switch_get_active (visual));
+}
+
+/* The words under a row's title: what it is, then its usage, violet while
+ * in use now (v70 .cft em with mockup .ov-use). On a phone or a TV one
+ * wrapping line, the usage violet within it while in use. */
+static GtkWidget *
+subtitle (View *v, const char *words, const char *use, gboolean lit)
+{
+  if (v->phone || Suno_ui_tv_posture ())
+    {
+      g_autofree char *escaped = words ? g_markup_escape_text (words, -1) : g_strdup ("");
+      g_autofree char *usage = g_markup_escape_text (use, -1);
+      /* SunoUI token "overlay" (config/shared/design-tokens.json): #b28fef. */
+      g_autofree char *markup = lit ? g_strdup_printf ("%s%s<span foreground=\"#b28fef\">%s</span>", escaped, *escaped ? " · " : "", usage)
+                                    : g_strdup_printf ("%s%s%s", escaped, *escaped ? " · " : "", usage);
+      GtkWidget *label = cf_text (NULL, "cf-sub");
+      gtk_label_set_markup (GTK_LABEL (label), markup);
+      gtk_label_set_wrap (GTK_LABEL (label), TRUE);
+      gtk_label_set_wrap_mode (GTK_LABEL (label), PANGO_WRAP_WORD);
+      Suno_ui_apply_type_full (label, "row-subtitle", TRUE);
+      return label;
+    }
+  GtkWidget *line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (line, "cf-sub");
+  gtk_widget_add_css_class (line, "cf-ov-line");
+  if (words)
+    {
+      GtkWidget *what = cf_text (words, NULL);
+      Suno_ui_apply_type_full (what, "row-subtitle", TRUE);
+      gtk_label_set_ellipsize (GTK_LABEL (what), PANGO_ELLIPSIZE_END);
+      gtk_box_append (GTK_BOX (line), what);
+    }
+  g_autofree char *text = words ? g_strconcat (" · ", use, NULL) : g_strdup (use);
+  GtkWidget *usage = cf_text (text, words ? "cf-ov-use" : NULL);
+  Suno_ui_apply_type_full (usage, "row-subtitle", TRUE);
+  if (lit) gtk_widget_add_css_class (usage, "on");
+  gtk_box_append (GTK_BOX (line), usage);
+  return line;
+}
+
+/* A switch row (v70 rSw) whose words carry the usage. */
+static GtkWidget *
+switch_row (View *v, GtkBox *card, GtkWidget *lead, const char *title, GtkWidget *words,
+            const CcSunoLayerApp *app, guint cap, gboolean on, const char *name)
+{
+  GtkWidget *visual = Suno_switch_new (FALSE);
+  GtkWidget *button = g_object_new (GTK_TYPE_BUTTON, "accessible-role", GTK_ACCESSIBLE_ROLE_SWITCH, NULL);
+  gtk_switch_set_active (GTK_SWITCH (visual), on);
+  gtk_widget_set_valign (visual, GTK_ALIGN_CENTER);
+  gtk_widget_set_can_target (visual, FALSE);
+  gtk_widget_set_can_focus (visual, FALSE);
+  gtk_widget_set_name (visual, name);
+  g_object_set_data_full (G_OBJECT (visual), "cf-layer-id", g_strdup (app->id), g_free);
+  g_object_set_data_full (G_OBJECT (visual), "cf-layer-portal", g_strdup (app->portal), g_free);
+  g_object_set_data_full (G_OBJECT (visual), "cf-layer-desktop", g_strdup (app->desktop), g_free);
+  g_object_set_data (G_OBJECT (visual), "cf-layer-cap", GUINT_TO_POINTER (cap));
+  g_signal_connect_object (visual, "notify::active", G_CALLBACK (switched), v->root, 0);
+  gtk_widget_add_css_class (button, "cf-row");
+  gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  gtk_accessible_update_state (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_STATE_CHECKED,
+                               on ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+  g_object_set_data (G_OBJECT (button), "cf-switch", visual);
+  g_signal_connect (button, "clicked", G_CALLBACK (flip), visual);
+  g_autofree char *row_name = g_strconcat ("cf-row-", name + 3, NULL);
+  gtk_widget_set_name (button, row_name);
+  GtkWidget *inner = cf_row (NULL, lead, title, NULL, visual, FALSE);
+  gtk_widget_remove_css_class (inner, "cf-row");
+  for (GtkWidget *c = gtk_widget_get_first_child (inner); c; c = gtk_widget_get_next_sibling (c))
+    if (gtk_widget_has_css_class (c, "cf-t")) gtk_box_append (GTK_BOX (c), words);
+  gtk_button_set_child (GTK_BUTTON (button), inner);
+  gtk_box_append (card, button);
+  return button;
+}
+
+static void
+note (GtkBox *card, const char *text)
+{
+  GtkWidget *label = cf_text (text, "cf-ov-note");
+  /* Muted ink: SunoUI's secondary note ink, which a TV draws in its own. */
+  gtk_widget_add_css_class (label, "SunoUI-t-muted");
+  gtk_label_set_wrap (GTK_LABEL (label), TRUE);
+  gtk_label_set_wrap_mode (GTK_LABEL (label), PANGO_WRAP_WORD);
+  gtk_box_append (GTK_BOX (gtk_widget_get_parent (GTK_WIDGET (card))), label);
+}
+
+gboolean
+cc_Suno_view_on_screen_render (View *v, const char *settings_app)
+{
+  JsonObject *data = cc_Suno_fixture_get_data (v->model);
+  JsonObject *layer = cc_Suno_layer_data (data);
+  CcSunoLayerApp app;
+  if (!layer || !cc_Suno_layer_app_for (data, settings_app, &app)) return FALSE;
+  gint64 now = cc_Suno_layer_now (layer);
+  GtkBox *card = cf_group (v, "On screen", NULL);
+  for (guint i = 0; i < G_N_ELEMENTS (caps); i++)
+    {
+      gboolean lit = cc_Suno_layer_in_use (layer, app.id, caps[i].cap);
+      g_autofree char *use = cc_Suno_layer_usage (layer, app.id, caps[i].cap, now);
+      g_autofree char *name = g_strconcat ("cf-layer-", caps[i].name, NULL);
+      GtkWidget *tile = cf_lead_icon (caps[i].icon);
+      if (lit) gtk_widget_add_css_class (tile, "cf-ov-lit");
+      switch_row (v, card, tile, caps[i].title, subtitle (v, caps[i].subtitle, use, lit), &app, caps[i].cap,
+                  cc_Suno_layer_allowed (layer, &app, caps[i].cap), name);
+    }
+  note (card, APP_NOTE);
+  cc_Suno_layer_app_clear (&app);
+  return TRUE;
+}
+
+gboolean
+cc_Suno_view_overlay_apps_row (View *v, GtkBox *card)
+{
+  if (!cc_Suno_layer_data (cc_Suno_fixture_get_data (v->model))) return FALSE;
+  cf_nv (v, card, "overlay-apps", "Display over other apps", "Apps that can draw above everything", NULL, cf_lead_icon ("layers-2"));
+  return TRUE;
+}
+
+/* ── Apps › Display over other apps ─────────────────────────────────── */
+typedef struct { char *id, *settings, *name; } Listed;
+
+static void
+listed_free (Listed *l)
+{
+  g_free (l->id); g_free (l->settings); g_free (l->name);
+  g_free (l);
+}
+
+static int
+by_name (gconstpointer a, gconstpointer b)
+{
+  const Listed *x = *(Listed * const *) a, *y = *(Listed * const *) b;
+  int order = g_utf8_collate (x->name, y->name);
+  return order ? order : g_strcmp0 (x->id, y->id);
+}
+
+/* Where each app was listed when the page opened: a switch moves no row
+ * while the page is shown. */
+static GHashTable *placed;
+
+static GPtrArray *
+listed (View *v, GPtrArray *ids)
+{
+  JsonObject *data = cc_Suno_fixture_get_data (v->model);
+  GPtrArray *out = g_ptr_array_new_with_free_func ((GDestroyNotify) listed_free);
+  for (guint i = 0; i < ids->len; i++)
+    {
+      Listed *l = g_new0 (Listed, 1);
+      const char *settings = cc_Suno_layer_settings_app (data, ids->pdata[i]);
+      const char *name = settings ? cc_Suno_fixture_app_name (v->model, settings) : NULL;
+      l->id = g_strdup (ids->pdata[i]);
+      l->settings = g_strdup (settings);
+      l->name = g_strdup (name ? name : l->id);
+      g_ptr_array_add (out, l);
+    }
+  g_ptr_array_sort (out, by_name);
+  return out;
+}
+
+static void
+overlay_rows (View *v, GtkBox *card, JsonObject *layer, GPtrArray *apps, gboolean allowed, gint64 now)
+{
+  JsonObject *data = cc_Suno_fixture_get_data (v->model);
+  for (guint i = 0; i < apps->len; i++)
+    {
+      Listed *l = apps->pdata[i];
+      CcSunoLayerApp app = { 0 };
+      if (!l->settings || !cc_Suno_layer_app_for (data, l->settings, &app) || g_strcmp0 (app.id, l->id) != 0)
+        {
+          cc_Suno_layer_app_clear (&app);
+          app.id = g_strdup (l->id);
+        }
+      gboolean live = cc_Suno_layer_in_use (layer, l->id, CC_SUNO_LAYER_OVERLAY);
+      gint64 used = cc_Suno_layer_last_used (layer, l->id, CC_SUNO_LAYER_OVERLAY);
+      gint64 asked = cc_Suno_layer_asked (layer, l->id, CC_SUNO_LAYER_OVERLAY);
+      g_autofree char *when = allowed ? (live ? g_strdup ("Used today") : used > 0 ? cc_Suno_layer_when ("Used", used, now) : g_strdup ("Never used"))
+                                      : asked > 0 ? cc_Suno_layer_when ("Asked", asked, now) : g_strdup ("Not allowed");
+      GtkWidget *words;
+      if (live && allowed)
+        words = subtitle (v, when, "Showing now", TRUE);
+      else
+        {
+          words = cf_text (when, "cf-sub");
+          Suno_ui_apply_type_full (words, "row-subtitle", TRUE);
+        }
+      GtkWidget *lead = l->settings ? cf_lead_image (v, l->settings) : cf_lead_icon ("app-window");
+      g_autofree char *name = g_strconcat ("cf-ov-", l->settings ? l->settings : l->id, NULL);
+      switch_row (v, card, lead, l->name, words, &app, CC_SUNO_LAYER_OVERLAY,
+                  (cc_Suno_layer_allowed (layer, &app, CC_SUNO_LAYER_OVERLAY)), name);
+      cc_Suno_layer_app_clear (&app);
+    }
+}
+
+void
+cc_Suno_view_overlay_apps_render (View *v)
+{
+  JsonObject *layer = cc_Suno_layer_data (cc_Suno_fixture_get_data (v->model));
+  g_autoptr (GPtrArray) allowed_ids = layer ? cc_Suno_layer_overlay_allowed (layer) : g_ptr_array_new_with_free_func (g_free);
+  g_autoptr (GPtrArray) refused_ids = layer ? cc_Suno_layer_overlay_refused (layer) : g_ptr_array_new_with_free_func (g_free);
+  guint showing = 0, count = allowed_ids->len;
+  for (guint i = 0; layer && i < allowed_ids->len; i++)
+    showing += cc_Suno_layer_in_use (layer, allowed_ids->pdata[i], CC_SUNO_LAYER_OVERLAY);
+  /* A page opened afresh places every app by its state now; a redraw keeps
+   * each listed app where it was. */
+  if (!placed) placed = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  if (g_strcmp0 (v->drawn_page, v->page) != 0) g_hash_table_remove_all (placed);
+  g_autoptr (GPtrArray) in = g_ptr_array_new_with_free_func (g_free), out = g_ptr_array_new_with_free_func (g_free);
+  for (guint pass = 0; pass < 2; pass++)
+    {
+      GPtrArray *ids = pass ? refused_ids : allowed_ids;
+      for (guint i = 0; i < ids->len; i++)
+        {
+          gpointer was = g_hash_table_lookup (placed, ids->pdata[i]);
+          gboolean allowed = was ? GPOINTER_TO_INT (was) == 1 : pass == 0;
+          g_ptr_array_add (allowed ? in : out, g_strdup (ids->pdata[i]));
+        }
+    }
+  /* An app listed already and neither allowed nor asked now (switched off
+   * here before it ever asked) keeps its row until the page is left. */
+  GHashTableIter iter;
+  gpointer key, value;
+  g_hash_table_iter_init (&iter, placed);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    if (!g_ptr_array_find_with_equal_func (in, key, g_str_equal, NULL) && !g_ptr_array_find_with_equal_func (out, key, g_str_equal, NULL))
+      g_ptr_array_add (GPOINTER_TO_INT (value) == 1 ? in : out, g_strdup (key));
+  for (guint i = 0; i < in->len; i++) g_hash_table_replace (placed, g_strdup (in->pdata[i]), GINT_TO_POINTER (1));
+  for (guint i = 0; i < out->len; i++) g_hash_table_replace (placed, g_strdup (out->pdata[i]), GINT_TO_POINTER (2));
+
+  g_autofree char *meta = count == 0 ? g_strdup ("No apps allowed")
+    : showing ? g_strdup_printf ("%u %s allowed · %u showing now", count, count == 1 ? "app" : "apps", showing)
+    : g_strdup_printf ("%u %s allowed", count, count == 1 ? "app" : "apps");
+  cf_header (v, "Display over other apps", meta, NULL);
+  if (!layer) return;
+  gint64 now = cc_Suno_layer_now (layer);
+  g_autoptr (GPtrArray) allowed = listed (v, in), refused = listed (v, out);
+  GtkBox *card = NULL;
+  if (allowed->len)
+    {
+      card = cf_group (v, "Allowed", NULL);
+      /* mockup .ov-dot: the group's heading leads with a violet dot. */
+      GtkWidget *h6 = gtk_widget_get_first_child (gtk_widget_get_parent (GTK_WIDGET (card)));
+      if (Suno_ui_tv_posture ())
+        {
+          /* TV indents the heading's words (its own margin): the dot goes in with them. */
+          GtkWidget *words = gtk_widget_get_first_child (h6);
+          if (GTK_IS_LABEL (words))
+            gtk_label_set_markup (GTK_LABEL (words), "<span foreground=\"#b28fef\">●</span>  Allowed");
+        }
+      else
+        {
+          GtkWidget *dot = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+          gtk_widget_add_css_class (dot, "cf-ov-dot");
+          gtk_widget_set_valign (dot, GTK_ALIGN_CENTER);
+          gtk_box_prepend (GTK_BOX (h6), dot);
+        }
+      overlay_rows (v, card, layer, allowed, TRUE, now);
+    }
+  if (refused->len)
+    {
+      card = cf_group (v, "Not allowed", NULL);
+      overlay_rows (v, card, layer, refused, FALSE, now);
+    }
+  if (card) note (card, LIST_NOTE);
+  else
+    {
+      GtkWidget *label = cf_text (LIST_NOTE, "cf-ov-note");
+      gtk_widget_add_css_class (label, "SunoUI-t-muted");
+      gtk_label_set_wrap (GTK_LABEL (label), TRUE);
+      gtk_box_append (v->body, label);
+    }
+}
