+/* ── Changes ────────────────────────────────────────────────────────── */
+static void
+fixture_set (View *v, const char *where, const char *key, gboolean on)
+{
+  JsonObject *sync = sync_of (v);
+  JsonObject *target = g_str_equal (where, "categories") ? obj (cc_Suno_sync_state (sync), "categories") : NULL;
+  if (target) json_object_set_boolean_member (target, key, on);
+  if (g_str_equal (where, "apps"))
+    {
+      JsonArray *apps = arr (sync, "apps");
+      for (guint i = 0; apps && i < json_array_get_length (apps); i++)
+        if (g_strcmp0 (str (json_array_get_object_element (apps, i), "app"), key) == 0)
+          json_object_set_boolean_member (json_array_get_object_element (apps, i), "enabled", on);
+    }
+  if (g_str_equal (where, "enabled") && cc_Suno_sync_state (sync))
+    json_object_set_boolean_member (cc_Suno_sync_state (sync), "enabled", on);
+  cc_Suno_view_queue_refresh (v);
+}
+
+static void
+flip_category (View *v, GtkWidget *row, gboolean on)
+{
+  const char *category = g_object_get_data (G_OBJECT (row), "cs-key");
+  /* A row whose words depend on the switch (Same wallpaper everywhere) follows it at once. */
+  GtkWidget *sub = g_object_get_data (G_OBJECT (row), "cs-sub");
+  const char *line = g_object_get_data (G_OBJECT (row), on ? "cs-line-on" : "cs-line-off");
+  if (sub && line) gtk_label_set_text (GTK_LABEL (sub), line);
+  if (!live (v)) { fixture_set (v, "categories", category, on); return; }
+  g_autoptr (JsonObject) change = json_object_new ();
+  json_object_set_string_member (change, "category", category);
+  json_object_set_boolean_member (change, "on", on);
+  g_autoptr (JsonNode) value = json_node_init_object (json_node_alloc (), change);
+  write_key (v, "syncCat", value);
+}
+
+static void
+flip_app (View *v, GtkWidget *row, gboolean on)
+{
+  const char *app = g_object_get_data (G_OBJECT (row), "cs-key");
+  if (!live (v)) { fixture_set (v, "apps", app, on); return; }
+  g_autoptr (JsonObject) change = json_object_new ();
+  json_object_set_string_member (change, "app", app);
+  json_object_set_boolean_member (change, "on", on);
+  g_autoptr (JsonNode) value = json_node_init_object (json_node_alloc (), change);
+  write_key (v, "syncApp", value);
+}
+
+/* Words and codes go only to the real service (ADR-054 wire format 2): the bus name's owner must run in
+ * Suno-connect-syncd.service, so another process that took the name gets nothing. */
+static gboolean
+owner_is_service (GDBusConnection *bus)
+{
+  if (g_getenv ("SUNO_SETTINGS_SYNC_ANY_OWNER")) return TRUE; /* the test's stand-in service */
+  g_autoptr (GVariant) owner = g_dbus_connection_call_sync (bus, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
+                                                            "GetConnectionUnixProcessID", g_variant_new ("(s)", CC_SUNO_SYNC_BUS),
+                                                            G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, 5000, NULL, NULL);
+  if (!owner) return FALSE;
+  guint32 pid = 0;
+  g_variant_get (owner, "(u)", &pid);
+  g_autofree char *path = g_strdup_printf ("/proc/%u/cgroup", pid);
+  g_autofree char *cgroup = NULL;
+  if (!g_file_get_contents (path, &cgroup, NULL, NULL)) return FALSE;
+  return strstr (cgroup, "/Suno-connect-syncd.service") != NULL;
+}
+
+static const char * const guarded[] = { "BeginSetup", "FinishSetup", "RequestJoin", "GetJoin", "ConfirmJoin", "JoinWithRecoveryKey", "RevealRecoveryKey",
+                                        "AcknowledgeRecoveryKey", "ProbeAccount", NULL };
+
+/* A call to Suno-connect-syncd whose answer the page or a sheet waits for. */
+static void
+sync_call (const char *method, GVariant *args, const char *reply, GCancellable *cancel, GAsyncReadyCallback done, gpointer data)
+{
+  g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  if (bus && g_strv_contains (guarded, method) && !owner_is_service (bus))
+    {
+      g_warning ("Settings: %s refused: %s isn't owned by Suno-connect-syncd.service", method, CC_SUNO_SYNC_BUS);
+      g_clear_object (&bus);
+    }
+  if (!bus)
+    {
+      if (args) g_variant_unref (g_variant_ref_sink (args));
+      if (done)
+        {
+          g_autoptr (GTask) task = g_task_new (NULL, cancel, done, data);
+          g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Suno Connect Sync isn’t running as itself.");
+        }
+      return;
+    }
+  g_dbus_connection_call (bus, CC_SUNO_SYNC_BUS, CC_SUNO_SYNC_PATH, CC_SUNO_SYNC_IFACE, method, args,
+                          reply ? G_VARIANT_TYPE (reply) : NULL, G_DBUS_CALL_FLAGS_ALLOW_INTERACTIVE_AUTHORIZATION,
+                          G_MAXINT, cancel, done, data);
+}
+
+static GVariant *
+finish (GObject *source, GAsyncResult *result, GError **error)
+{
+  if (G_IS_TASK (result)) return g_task_propagate_pointer (G_TASK (result), error);  /* refused before the call */
+  GVariant *reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, error);
+  if (!reply && error && *error) g_dbus_error_strip_remote_error (*error);
+  return reply;
+}
+
+/* A plain answer: report a refusal, then read the page again. */
+static void
+answered (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  GtkWidget *root = data;
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!reply && v && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) cc_Suno_view_report_error (v, error);
+  if (v) cc_Suno_view_queue_refresh (v);
+  g_object_unref (root);
+}
+
+/* ── Sheets ─────────────────────────────────────────────────────────── */
+typedef enum { SHEET_KEY, SHEET_CHECK, SHEET_JOIN, SHEET_ENTER, SHEET_SHOW, SHEET_NEWKEY } Step;
+
+typedef struct {
+  GtkWidget *root;          /* the window (strong) */
+  GtkWidget *card;
+  SunoModalHandle *handle;  /* weak through "closed" */
+  GCancellable *cancel;
+  Step step;
+  char **words;             /* the 24 words (setup, show) */
+  int check[3];             /* 1-based positions to type back */
+  gboolean ticked, setup, finished, capture;
+  char *typed[3];
+  char *name;               /* this device's name */
+  /* join */
+  char *join, *code, *join_state, *entered, *error;
+  JsonArray *approvers;
+  guint join_signal;
+  GtkWidget *cont, *turn_on, *join_button, *count, *error_label, *fields[3], *code_box;
+} Sheet;
+
+static void sheet_draw (Sheet *s);
+
+static void
+sheet_free (Sheet *s)
+{
+  g_cancellable_cancel (s->cancel);
+  g_clear_object (&s->cancel);
+  if (s->words) for (char **w = s->words; *w; w++) memset (*w, 0, strlen (*w));
+  g_strfreev (s->words);
+  for (guint i = 0; i < 3; i++) g_free (s->typed[i]);
+  if (s->entered) memset (s->entered, 0, strlen (s->entered));
+  g_free (s->entered);
+  g_free (s->name); g_free (s->join); g_free (s->code); g_free (s->join_state); g_free (s->error);
+  g_clear_pointer (&s->approvers, json_array_unref);
+  if (s->join_signal)
+    {
+      g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+      if (bus) g_dbus_connection_signal_unsubscribe (bus, s->join_signal);
+    }
+  g_clear_object (&s->root);
+  g_free (s);
+}
+
+static void
+sheet_close (Sheet *s)
+{
+  s->finished = TRUE;
+  if (s->handle) Suno_modal_handle_close (s->handle);
+}
+
+static void
+refresh_root (Sheet *s)
+{
+  View *v = s->root ? g_object_get_data (G_OBJECT (s->root), "cf-view") : NULL;
+  if (v) cc_Suno_view_queue_refresh (v);
+}
+
+/* Closed any way but finishing (Cancel, Esc, the scrim): nothing is turned on. */
+static void
+sheet_cancelled (SunoModalHandle *handle, Sheet *s)
+{
+  if (s->finished || s->capture) return;
+  if (s->setup) sync_call ("CancelSetup", NULL, NULL, NULL, NULL, NULL);
+  if (s->step == SHEET_JOIN || s->step == SHEET_ENTER) sync_call ("CancelJoin", NULL, NULL, NULL, NULL, NULL);
+  refresh_root (s);
+}
+
+static void
+cancel_clicked (GtkButton *b, Sheet *s)
+{
+  if (s->handle) Suno_modal_handle_cancel (s->handle);
+}
+
+static GtkWidget *
+sheet_button (const char *text, const char *style, const char *cls, GCallback cb, Sheet *s)
+{
+  GtkWidget *b = Suno_text_button_new (text, NULL, style);
+  if (cls) gtk_widget_add_css_class (b, cls);
+  if (cb) g_signal_connect (b, "clicked", cb, s);
+  return b;
+}
+
+static GtkWidget *
+icon_tile (const char *icon)
+{
+  GtkWidget *tile = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (tile, "cs-ico");
+  gtk_widget_set_halign (tile, GTK_ALIGN_START);
+  GtkWidget *g = glyph (icon, NULL);
+  gtk_widget_set_size_request (tile, 44, 44);
+  gtk_box_set_homogeneous (GTK_BOX (tile), TRUE);
+  gtk_widget_set_halign (g, GTK_ALIGN_CENTER);
+  gtk_box_append (GTK_BOX (tile), g);
+  return tile;
+}
+
+static void
+heading (Sheet *s, const char *step, const char *icon, const char *title, const char *body)
+{
+  if (step) gtk_box_append (GTK_BOX (s->card), label (step, "cs-step"));
+  if (icon) gtk_box_append (GTK_BOX (s->card), icon_tile (icon));
+  GtkWidget *h2 = wrap (label (title, "cs-h2"));
+  gtk_accessible_update_property (GTK_ACCESSIBLE (h2), GTK_ACCESSIBLE_PROPERTY_LEVEL, 2, -1);
+  gtk_box_append (GTK_BOX (s->card), h2);
+  if (body) gtk_box_append (GTK_BOX (s->card), wrap (label (body, "cs-p")));
+}
+
+static GtkWidget *
+actions (Sheet *s)
+{
+  GtkWidget *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, Suno_ui_tv_posture () ? 12 : 8);
+  gtk_widget_add_css_class (row, "cs-acts");
+  gtk_box_append (GTK_BOX (s->card), row);
+  return row;
+}
+
+/* The left action (Cancel, Back to the key, Approve on a device instead) takes the room before the rest. */
+static void
+act_left (GtkWidget *row, GtkWidget *b)
+{
+  gtk_widget_add_css_class (b, "cs-left");
+  gtk_widget_set_hexpand (b, TRUE);
+  gtk_widget_set_halign (b, GTK_ALIGN_START);
+  gtk_box_append (GTK_BOX (row), b);
+}
+
+/* The 24 words, numbered, in a well: 4 columns, 3 on a phone. Not selectable. */
+static GtkWidget *
+words_grid (char **words, gboolean phone)
+{
+  GtkWidget *grid = gtk_grid_new ();
+  int columns = phone ? 3 : 4, gap = Suno_ui_tv_posture () ? 9 : 6;
+  gtk_widget_add_css_class (grid, "cs-words");
+  gtk_grid_set_column_homogeneous (GTK_GRID (grid), TRUE);
+  gtk_grid_set_row_spacing (GTK_GRID (grid), gap);
+  gtk_grid_set_column_spacing (GTK_GRID (grid), gap);
+  for (guint i = 0; words && words[i]; i++)
+    {
+      GtkWidget *cell = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, TVPX (7));
+      g_autofree char *n = g_strdup_printf ("%u", i + 1);
+      GtkWidget *index = label (n, "cs-n");
+      gtk_label_set_xalign (GTK_LABEL (index), 1);
+      gtk_widget_set_valign (index, GTK_ALIGN_BASELINE_CENTER);
+      GtkWidget *word = label (words[i], "cs-w");
+      gtk_widget_set_valign (word, GTK_ALIGN_BASELINE_CENTER);
+      gtk_widget_add_css_class (cell, "cs-cell");
+      gtk_box_append (GTK_BOX (cell), index);
+      gtk_box_append (GTK_BOX (cell), word);
+      gtk_grid_attach (GTK_GRID (grid), cell, i % columns, i / columns, 1, 1);
+    }
+  gtk_accessible_update_property (GTK_ACCESSIBLE (grid), GTK_ACCESSIBLE_PROPERTY_LABEL, "Recovery key, 24 words", -1);
+  return grid;
+}
+
+static char *
+words_text (char **words)
+{
+  GString *out = g_string_new ("Suno Connect recovery key\n\n");
+  for (guint i = 0; words && words[i]; i++)
+    g_string_append_printf (out, "%2u  %-10s%s", i + 1, words[i], (i + 1) % 4 == 0 ? "\n" : "  ");
+  g_string_append (out, "\nIf you ever lose all your devices, these 24 words are the only way to get your synced things back.\n");
+  return g_string_free (out, FALSE);
+}
+
+static void
+saved (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Sheet *s = data;
+  g_autoptr (GFile) file = gtk_file_dialog_save_finish (GTK_FILE_DIALOG (source), result, NULL);
+  if (file && s->words)
+    {
+      g_autofree char *text = words_text (s->words);
+      g_autoptr (GError) error = NULL;
+      if (!g_file_replace_contents (file, text, strlen (text), NULL, FALSE, G_FILE_CREATE_PRIVATE, NULL, NULL, &error))
+        g_warning ("Settings: recovery key file: %s", error->message);
+      memset (text, 0, strlen (text));
+    }
+  if (s->root) g_object_unref (s->root);
+}
+
+static void
+save_clicked (GtkButton *b, Sheet *s)
+{
+  g_autoptr (GtkFileDialog) dialog = gtk_file_dialog_new ();
+  gtk_file_dialog_set_title (dialog, "Save your recovery key");
+  gtk_file_dialog_set_initial_name (dialog, "Suno recovery key.txt");
+  g_object_ref (s->root);
+  gtk_file_dialog_save (dialog, window_of (s->card), s->cancel, saved, s);
+}
+
+static void
+draw_page (GtkPrintOperation *op, GtkPrintContext *context, int page, Sheet *s)
+{
+  cairo_t *cr = gtk_print_context_get_cairo_context (context);
+  g_autoptr (PangoLayout) layout = gtk_print_context_create_pango_layout (context);
+  g_autofree char *text = words_text (s->words);
+  g_autoptr (PangoFontDescription) font = pango_font_description_from_string ("Monospace 12");
+  pango_layout_set_font_description (layout, font);
+  pango_layout_set_width (layout, (int) (gtk_print_context_get_width (context) * PANGO_SCALE));
+  pango_layout_set_text (layout, text, -1);
+  cairo_move_to (cr, 0, 0);
+  pango_cairo_show_layout (cr, layout);
+  memset (text, 0, strlen (text));
+}
+
+static void
+print_clicked (GtkButton *b, Sheet *s)
+{
+  g_autoptr (GtkPrintOperation) op = gtk_print_operation_new ();
+  gtk_print_operation_set_n_pages (op, 1);
+  gtk_print_operation_set_job_name (op, "Suno recovery key");
+  g_signal_connect (op, "draw-page", G_CALLBACK (draw_page), s);
+  gtk_print_operation_run (op, GTK_PRINT_OPERATION_ACTION_PRINT_DIALOG, window_of (s->card), NULL);
+}
+
+static void
+tick_toggled (GtkToggleButton *check, Sheet *s)
+{
+  s->ticked = gtk_toggle_button_get_active (check);
+  if (s->cont) gtk_widget_set_sensitive (s->cont, s->ticked);
+}
+
+static void refresh_root (Sheet *s);
+static void sheet_close (Sheet *s);
+
+static void
+new_key_acknowledged (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Sheet *s = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (!reply)
+    {
+      View *v = s->root ? g_object_get_data (G_OBJECT (s->root), "cf-view") : NULL;
+      if (v) cc_Suno_view_report_error (v, error);
+      return;
+    }
+  refresh_root (s);
+  sheet_close (s);
+}
+
+/* Done: AcknowledgeRecoveryKey clears the notice everywhere (hero, row, island). */
+static void
+new_key_done_clicked (GtkButton *b, Sheet *s)
+{
+  if (!s->ticked) return;
+  if (s->capture) { sheet_close (s); return; }
+  gtk_widget_set_sensitive (GTK_WIDGET (b), FALSE);
+  sync_call ("AcknowledgeRecoveryKey", NULL, NULL, s->cancel, new_key_acknowledged, s);
+}
+
+static void
+continue_clicked (GtkButton *b, Sheet *s)
+{
+  if (!s->ticked) return;
+  s->step = SHEET_CHECK;
+  sheet_draw (s);
+}
+
+static void
+back_clicked (GtkButton *b, Sheet *s)
+{
+  s->step = SHEET_KEY;
+  sheet_draw (s);
+}
+
+static gboolean
+word_matches (Sheet *s, guint i, const char *typed)
+{
+  if (!s->words || s->check[i] < 1 || s->check[i] > (int) g_strv_length (s->words)) return FALSE;
+  g_autofree char *clean = g_utf8_strdown (typed ? typed : "", -1);
+  g_strstrip (clean);
+  return g_str_equal (clean, s->words[s->check[i] - 1]);
+}
+
+static void
+typed_changed (GtkEditable *entry, Sheet *s)
+{
+  guint i = GPOINTER_TO_UINT (g_object_get_data (G_OBJECT (entry), "cs-i"));
+  g_free (s->typed[i]);
+  s->typed[i] = g_strdup (gtk_editable_get_text (entry));
+  gboolean all = TRUE;
+  for (guint k = 0; k < 3; k++)
+    {
+      gboolean ok = word_matches (s, k, s->typed[k]);
+      /* Green when it matches; a typo is never marked red while typing. */
+      if (s->fields[k])
+        {
+          if (ok) gtk_widget_add_css_class (s->fields[k], "ok");
+          else gtk_widget_remove_css_class (s->fields[k], "ok");
+        }
+      all = all && ok;
+    }
+  if (s->turn_on) gtk_widget_set_sensitive (s->turn_on, all);
+}
+
+static void
+setup_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Sheet *s = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  View *v = s->root ? g_object_get_data (G_OBJECT (s->root), "cf-view") : NULL;
+  if (!reply)
+    {
+      if (v) cc_Suno_view_report_error (v, error);
+      if (s->turn_on) gtk_widget_set_sensitive (s->turn_on, TRUE);
+      return;
+    }
+  s->setup = FALSE;
+  sync_call ("SetEnabled", g_variant_new ("(b)", TRUE), NULL, NULL, answered, g_object_ref (s->root));
+  sheet_close (s);
+}
+
+static void
+turn_on_clicked (GtkButton *b, Sheet *s)
+{
+  for (guint i = 0; i < 3; i++) if (!word_matches (s, i, s->typed[i])) return;
+  gtk_widget_set_sensitive (GTK_WIDGET (b), FALSE);
+  if (s->capture) return;
+  GVariantBuilder answers;
+  g_variant_builder_init (&answers, G_VARIANT_TYPE ("a{is}"));
+  for (guint i = 0; i < 3; i++) g_variant_builder_add (&answers, "{is}", s->check[i], s->typed[i]);
+  sync_call ("FinishSetup", g_variant_new ("(a{is})", &answers), NULL, s->cancel, setup_done, s);
+}
+
+/* Step 1 (and the read-only key): the words, Save as a file… and Print…, never Copy. */
+static void
+draw_key (Sheet *s, gboolean phone)
+{
+  gboolean show = s->step == SHEET_SHOW, fresh = s->step == SHEET_NEWKEY;
+  if (fresh)
+    heading (s, NULL, "key-round", "Your new recovery key", KEY_WORDS_NEW);
+  else
+    heading (s, show ? NULL : "STEP 1 OF 2", "key-round", show ? "Your recovery key" : "Save your recovery key", show ? KEY_WORDS_SHOW : KEY_WORDS);
+  gtk_box_append (GTK_BOX (s->card), words_grid (s->words, phone));
+  GtkWidget *tools = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, TVPX (6));
+  gtk_widget_add_css_class (tools, "cs-tools");
+  GtkWidget *save = Suno_text_button_new ("Save as a file…", "download", "fill");
+  Suno_text_button_set_small (GTK_BUTTON (save), TRUE);
+  g_signal_connect (save, "clicked", G_CALLBACK (save_clicked), s);
+  GtkWidget *print = Suno_text_button_new ("Print…", "printer", "fill");
+  Suno_text_button_set_small (GTK_BUTTON (print), TRUE);
+  g_signal_connect (print, "clicked", G_CALLBACK (print_clicked), s);
+  gtk_box_append (GTK_BOX (tools), save);
+  gtk_box_append (GTK_BOX (tools), print);
+  gtk_box_append (GTK_BOX (s->card), tools);
+  GtkWidget *row = NULL;
+  if (show)
+    {
+      row = actions (s);
+      GtkWidget *done = sheet_button ("Done", "key", NULL, G_CALLBACK (cancel_clicked), s);
+      gtk_widget_set_hexpand (done, TRUE);
+      gtk_widget_set_halign (done, GTK_ALIGN_END);
+      gtk_box_append (GTK_BOX (row), done);
+      return;
+    }
+  /* cs.css .cs-check: an 18 px box and the words, the whole line toggles. */
+  GtkWidget *check = g_object_new (GTK_TYPE_TOGGLE_BUTTON, "accessible-role", GTK_ACCESSIBLE_ROLE_CHECKBOX, NULL);
+  GtkWidget *line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, TVPX (10));
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (box, "cs-box");
+  gtk_widget_set_valign (box, GTK_ALIGN_CENTER);
+  gtk_box_set_homogeneous (GTK_BOX (box), TRUE);
+  gtk_box_append (GTK_BOX (box), glyph ("check", NULL));
+  gtk_box_append (GTK_BOX (line), box);
+  const char *tick = fresh ? "I’ve saved my new recovery key and thrown away the old one" : "I’ve saved my recovery key somewhere safe";
+  /* the new key's longer words wrap inside a phone's sheet (sheet.html ?posture=phone: two lines) */
+  GtkWidget *tick_label = label (tick, NULL);
+  gtk_label_set_wrap (GTK_LABEL (tick_label), TRUE);
+  gtk_label_set_wrap_mode (GTK_LABEL (tick_label), PANGO_WRAP_WORD_CHAR);
+  /* a wrapping label's natural width is GTK's pleasant-shape guess; ask for the whole line so it wraps only at the sheet's edge */
+  gtk_label_set_max_width_chars (GTK_LABEL (tick_label), 120);
+  /* On a phone the line fills the sheet's column instead of taking a guessed natural width, so the words wrap at
+   * the sheet's edge as sheet.html ?posture=phone draws them. */
+  if (phone) gtk_widget_set_hexpand (tick_label, TRUE);
+  gtk_box_append (GTK_BOX (line), tick_label);
+  gtk_button_set_child (GTK_BUTTON (check), line);
+  gtk_widget_add_css_class (check, "cs-check");
+  gtk_widget_set_halign (check, phone ? GTK_ALIGN_FILL : GTK_ALIGN_START);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (check), GTK_ACCESSIBLE_PROPERTY_LABEL, tick, -1);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (check), s->ticked);
+  g_signal_connect (check, "toggled", G_CALLBACK (tick_toggled), s);
+  gtk_box_append (GTK_BOX (s->card), check);
+  row = actions (s);
+  if (fresh)
+    {
+      /* S1: Later keeps the notice; Done (after the tick) tells the service the new words are kept. */
+      act_left (row, sheet_button ("Later", "plain", "cs-cancel", G_CALLBACK (cancel_clicked), s));
+      s->cont = sheet_button ("Done", "key", NULL, G_CALLBACK (new_key_done_clicked), s);
+      gtk_widget_set_sensitive (s->cont, s->ticked);
+      gtk_box_append (GTK_BOX (row), s->cont);
+      return;
+    }
+  act_left (row, sheet_button ("Cancel", "plain", "cs-cancel", G_CALLBACK (cancel_clicked), s));
+  s->cont = sheet_button ("Continue", "key", NULL, G_CALLBACK (continue_clicked), s);
+  gtk_widget_set_sensitive (s->cont, s->ticked);
+  gtk_box_append (GTK_BOX (row), s->cont);
+}
+
+/* Step 2: three words picked at random, typed back. */
+static void
+draw_check (Sheet *s, gboolean phone)
+{
+  heading (s, "STEP 2 OF 2", NULL, "Check your recovery key", "Type these three words from your key, so we know it’s saved right.");
+  GtkWidget *ask = gtk_grid_new ();
+  gtk_widget_add_css_class (ask, "cs-ask");
+  gtk_grid_set_column_homogeneous (GTK_GRID (ask), TRUE);
+  gtk_grid_set_column_spacing (GTK_GRID (ask), TVPX (10));
+  /* sheet.html ?posture=phone stacks the fields 70 px apart, 21 px from caption to field. */
+  gtk_grid_set_row_spacing (GTK_GRID (ask), phone ? 9 : TVPX (10));
+  for (guint i = 0; i < 3; i++)
+    {
+      GtkWidget *field = gtk_box_new (GTK_ORIENTATION_VERTICAL, phone ? 7 : TVPX (6));
+      g_autofree char *caption = g_strdup_printf ("Word %d", s->check[i]);
+      gtk_box_append (GTK_BOX (field), label (caption, "cs-lab"));
+      GtkWidget *entry = gtk_entry_new ();
+      gtk_widget_add_css_class (entry, "cs-in");
+      gtk_entry_set_input_hints (GTK_ENTRY (entry), GTK_INPUT_HINT_NO_SPELLCHECK | GTK_INPUT_HINT_LOWERCASE | GTK_INPUT_HINT_NO_EMOJI);
+      gtk_accessible_update_property (GTK_ACCESSIBLE (entry), GTK_ACCESSIBLE_PROPERTY_LABEL, caption, -1);
+      if (s->typed[i]) gtk_editable_set_text (GTK_EDITABLE (entry), s->typed[i]);
+      g_object_set_data (G_OBJECT (entry), "cs-i", GUINT_TO_POINTER (i));
+      g_signal_connect (entry, "changed", G_CALLBACK (typed_changed), s);
+      s->fields[i] = entry;
+      gtk_box_append (GTK_BOX (field), entry);
+      gtk_grid_attach (GTK_GRID (ask), field, phone ? 0 : (int) i, phone ? (int) i : 0, 1, 1);
+    }
+  gtk_box_append (GTK_BOX (s->card), ask);
+  GtkWidget *row = actions (s);
+  act_left (row, sheet_button ("Back to the key", "plain", NULL, G_CALLBACK (back_clicked), s));
+  s->turn_on = sheet_button ("Turn on Sync", "key", NULL, G_CALLBACK (turn_on_clicked), s);
+  gtk_box_append (GTK_BOX (row), s->turn_on);
+  typed_changed (GTK_EDITABLE (s->fields[0]), s);
+}
+
+/* ── Joining: this device's code, or the recovery key ─────────────── */
+static void
+recovery_clicked (GtkButton *b, Sheet *s)
+{
+  s->step = SHEET_ENTER;
+  sheet_draw (s);
+}
+
+static void
+device_instead_clicked (GtkButton *b, Sheet *s)
+{
+  s->step = SHEET_JOIN;
+  sheet_draw (s);
+}
+
+static void
+take_join (Sheet *s, const char *json)
+{
+  g_autoptr (JsonNode) node = json_from_string (json, NULL);
+  JsonObject *o = node && JSON_NODE_HOLDS_OBJECT (node) ? json_node_get_object (node) : NULL;
+  if (!o) return;
+  g_free (s->join_state); s->join_state = g_strdup (str (o, "state"));
+  g_free (s->code); s->code = g_strdup (str (o, "code"));
+  if (str (o, "join")) { g_free (s->join); s->join = g_strdup (str (o, "join")); }
+  JsonArray *approvers = arr (o, "approvers");
+  if (approvers) { g_clear_pointer (&s->approvers, json_array_unref); s->approvers = json_array_ref (approvers); }
+  if (g_strcmp0 (s->join_state, "approved") == 0)
+    {
+      sheet_close (s);
+      refresh_root (s);
+      return;
+    }
+  if (s->step == SHEET_JOIN) sheet_draw (s);
+}
+
+static void
+join_changed (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *signal,
+              GVariant *parameters, gpointer data)
+{
+  const char *json = NULL;
+  g_variant_get (parameters, "(&s)", &json);
+  take_join (data, json);
+}
+
+static void
+join_read (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Sheet *s = data;
+  if (!reply)
+    {
+      View *v = s->root ? g_object_get_data (G_OBJECT (s->root), "cf-view") : NULL;
+      if (v) cc_Suno_view_report_error (v, error);
+      return;
+    }
+  const char *json = NULL;
+  g_variant_get (reply, "(&s)", &json);
+  take_join (s, json);
+}
+
+/* The code arrives once one of the other devices has answered; until then the wells wait empty. */
+static gboolean
+poll_join (gpointer data)
+{
+  Sheet *s = data;
+  if (s->finished || s->step != SHEET_JOIN) return G_SOURCE_CONTINUE;
+  sync_call ("GetJoin", NULL, "(s)", s->cancel, join_read, s);
+  return G_SOURCE_CONTINUE;
+}
+
+static GtkWidget *
+code_wells (const char *code, const char *cls)
+{
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, TVPX (10));
+  gtk_widget_add_css_class (box, "cs-code");
+  if (cls) gtk_widget_add_css_class (box, cls);
+  for (guint i = 0; i < 2; i++)
+    {
+      g_autofree char *half = code && strlen (code) == 6 ? g_strndup (code + 3 * i, 3) : g_strdup ("   ");
+      GtkWidget *well = label (half, "cs-well");
+      gtk_label_set_xalign (GTK_LABEL (well), 0.5);
+      if (!code) gtk_widget_add_css_class (well, "empty");
+      gtk_box_append (GTK_BOX (box), well);
+    }
+  if (code) gtk_accessible_update_property (GTK_ACCESSIBLE (box), GTK_ACCESSIBLE_PROPERTY_LABEL, code, -1);
+  return box;
+}
+
+static void join_begun (GObject *source, GAsyncResult *result, gpointer data);
+
+/* Not approved (or no device answered in time): ask again for a new code. */
+static void
+ask_again_clicked (GtkButton *b, Sheet *s)
+{
+  gtk_widget_set_sensitive (GTK_WIDGET (b), FALSE);
+  g_free (s->join_state); s->join_state = g_strdup ("waiting");
+  g_clear_pointer (&s->code, g_free);
+  if (s->capture) return;
+  sync_call ("RequestJoin", NULL, "(s)", s->cancel, join_begun, s);
+}
+
+/* The heading's tile wears a state: cs-bad (red shield-x), cs-spin (the waiting loader). */
+static void
+mark_tile (Sheet *s, const char *cls)
+{
+  for (GtkWidget *w = gtk_widget_get_first_child (s->card); w; w = gtk_widget_get_next_sibling (w))
+    if (gtk_widget_has_css_class (w, "cs-ico")) { gtk_widget_add_css_class (w, cls); return; }
+}
+
+static void
+confirm_answered (GObject *source, GAsyncResult *result, gpointer data)
+{
+  join_read (source, result, data);
+}
+
+/* Same code / It doesn't match: ConfirmJoin(true) lets the other device's approval count; false ends the join (tampered). */
+static void
+confirm_join (Sheet *s, gboolean matched)
+{
+  if (s->capture)
+    {
+      g_free (s->join_state); s->join_state = g_strdup (matched ? "confirmed" : "tampered");
+      sheet_draw (s);
+      return;
+    }
+  sync_call ("ConfirmJoin", g_variant_new ("(b)", matched), "(s)", s->cancel, confirm_answered, s);
+}
+
+static void same_code_clicked (GtkButton *b, Sheet *s) { gtk_widget_set_sensitive (GTK_WIDGET (b), FALSE); confirm_join (s, TRUE); }
+static void no_match_clicked (GtkButton *b, Sheet *s) { gtk_widget_set_sensitive (GTK_WIDGET (b), FALSE); confirm_join (s, FALSE); }
+
+/* Change password…: the Suno Connect account page, where the password is changed. */
+static void
+change_password_clicked (GtkButton *b, Sheet *s)
+{
+  g_autoptr (GDesktopAppInfo) app = g_desktop_app_info_new ("org.projectSuno.Connect.desktop");
+  if (app) g_app_info_launch (G_APP_INFO (app), NULL, NULL, NULL);
+}
+
+static void
+draw_join (Sheet *s)
+{
+  gboolean denied = g_strcmp0 (s->join_state, "denied") == 0;
+  gboolean expired = g_strcmp0 (s->join_state, "expired") == 0;
+  if (denied || expired)
+    {
+      /* review 1 (sheet.html?step=denied): a shield-x tile, the words, the recovery key or ask again. */
+      g_autofree char *words = denied ? g_strdup_printf ("One of your devices chose Not me, so this %s wasn’t added.", s->name)
+                                      : g_strdup_printf ("None of your devices answered, so this %s wasn’t added.", s->name);
+      heading (s, NULL, "shield-x", "Not approved", words);
+      GtkWidget *row = actions (s);
+      act_left (row, sheet_button ("Use recovery key instead", "plain", NULL, G_CALLBACK (recovery_clicked), s));
+      gtk_box_append (GTK_BOX (row), sheet_button ("Ask again", "key", NULL, G_CALLBACK (ask_again_clicked), s));
+      return;
+    }
+  if (g_strcmp0 (s->join_state, "tampered") == 0)
+    {
+      /* B3 (sheet.html?step=tampered): It doesn't match ended the join; nothing was shared. */
+      g_autofree char *words = g_strdup_printf ("Someone may be trying to join your devices. This %s wasn’t added and nothing was shared. "
+                                                "If you didn’t start this, change your Suno password.", s->name);
+      heading (s, NULL, "shield-x", "Stopped: the codes didn’t match", words);
+      mark_tile (s, "cs-bad");
+      GtkWidget *row = actions (s);
+      act_left (row, sheet_button ("Change password…", "plain", NULL, G_CALLBACK (change_password_clicked), s));
+      gtk_box_append (GTK_BOX (row), sheet_button ("Start again", "key", NULL, G_CALLBACK (ask_again_clicked), s));
+      return;
+    }
+  if (g_strcmp0 (s->join_state, "confirmed") == 0)
+    {
+      /* B3 (?step=wait): Same code was chosen; the approval on the other device finishes it. */
+      g_autofree char *words = g_strdup_printf ("This %s joins as soon as you approve it there. Keep this open.", s->name);
+      heading (s, NULL, "loader-circle", "Choose Approve on your other device", words);
+      mark_tile (s, "cs-spin");
+      s->code_box = code_wells (s->code, "cs-dim");
+      gtk_widget_set_halign (s->code_box, GTK_ALIGN_CENTER);
+      gtk_box_append (GTK_BOX (s->card), s->code_box);
+      GtkWidget *row = actions (s);
+      act_left (row, sheet_button ("Use recovery key instead", "plain", NULL, G_CALLBACK (recovery_clicked), s));
+      gtk_box_append (GTK_BOX (row), sheet_button ("Cancel", "fill", NULL, G_CALLBACK (cancel_clicked), s));
+      return;
+    }
+  g_autofree char *title = g_strdup_printf ("Approve this %s", s->name);
+  heading (s, NULL, "refresh-cw", title, "Open Suno Connect on one of your other devices. It shows a code there too.");
+  s->code_box = code_wells (s->code, NULL);
+  gtk_widget_set_halign (s->code_box, GTK_ALIGN_CENTER);
+  gtk_box_append (GTK_BOX (s->card), s->code_box);
+  GtkWidget *devs = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, TVPX (8));
+  gtk_widget_add_css_class (devs, "cs-devs");
+  gtk_widget_set_halign (devs, GTK_ALIGN_CENTER);
+  for (guint i = 0; s->approvers && i < json_array_get_length (s->approvers); i++)
+    {
+      JsonObject *a = json_array_get_object_element (s->approvers, i);
+      GtkWidget *chip = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+      gtk_widget_add_css_class (chip, "cs-dev");
+      gtk_box_append (GTK_BOX (chip), glyph (class_icon (str (a, "class")), NULL));
+      gtk_box_append (GTK_BOX (chip), label (str (a, "name"), NULL));
+      gtk_box_append (GTK_BOX (devs), chip);
+    }
+  gtk_box_append (GTK_BOX (s->card), devs);
+  /* B3: the person compares the codes; an approval is only taken after Same code (ConfirmJoin). */
+  GtkWidget *q = wrap (label ("Does your other device show the same code?", "cs-q"));
+  gtk_label_set_xalign (GTK_LABEL (q), 0.5);
+  gtk_label_set_justify (GTK_LABEL (q), GTK_JUSTIFY_CENTER);
+  gtk_box_append (GTK_BOX (s->card), q);
+  GtkWidget *row = actions (s);
+  gtk_widget_add_css_class (row, "cs-eq");
+  gtk_box_set_homogeneous (GTK_BOX (row), TRUE);
+  GtkWidget *no = sheet_button ("It doesn’t match", "fill", NULL, G_CALLBACK (no_match_clicked), s);
+  GtkWidget *yes = sheet_button ("Same code", "key", NULL, G_CALLBACK (same_code_clicked), s);
+  for (GtkWidget *b = no; b; b = b == no ? yes : NULL)
+    {
+      gtk_widget_set_hexpand (b, TRUE);
+      gtk_widget_set_halign (b, GTK_ALIGN_FILL);
+      gtk_widget_set_sensitive (b, s->code != NULL || s->capture);
+      gtk_box_append (GTK_BOX (row), b);
+    }
+  GtkWidget *link = gtk_button_new_with_label ("Use recovery key instead");
+  gtk_widget_add_css_class (link, "cs-link");
+  gtk_widget_set_halign (link, GTK_ALIGN_CENTER);
+  g_signal_connect (link, "clicked", G_CALLBACK (recovery_clicked), s);
+  gtk_box_append (GTK_BOX (s->card), link);
+}
+
+static void
+recovered (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Sheet *s = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  if (!reply)
+    {
+      g_free (s->error);
+      s->error = g_strdup (error->message);
+      if (s->error_label)
+        {
+          gtk_label_set_text (GTK_LABEL (s->error_label), s->error);
+          gtk_widget_set_visible (s->error_label, TRUE);
+        }
+      if (s->join_button) gtk_widget_set_sensitive (s->join_button, TRUE);
+      return;
+    }
+  sheet_close (s);
+  refresh_root (s);
+}
+
+static void
+join_clicked (GtkButton *b, Sheet *s)
+{
+  if (cc_Suno_sync_count_words (s->entered) != 24) return;
+  gtk_widget_set_sensitive (GTK_WIDGET (b), FALSE);
+  if (s->capture) return;
+  sync_call ("JoinWithRecoveryKey", g_variant_new ("(s)", s->entered), NULL, s->cancel, recovered, s);
+}
+
+static void
+entered_changed (GtkTextBuffer *buffer, Sheet *s)
+{
+  GtkTextIter a, z;
+  gtk_text_buffer_get_bounds (buffer, &a, &z);
+  if (s->entered) memset (s->entered, 0, strlen (s->entered));
+  g_free (s->entered);
+  s->entered = gtk_text_buffer_get_text (buffer, &a, &z, FALSE);
+  guint n = cc_Suno_sync_count_words (s->entered);
+  g_autofree char *count = g_strdup_printf ("%u of 24 words", n);
+  if (s->count) gtk_label_set_text (GTK_LABEL (s->count), count);
+  if (s->join_button) gtk_widget_set_sensitive (s->join_button, n == 24);
+  if (s->error_label) gtk_widget_set_visible (s->error_label, FALSE);
+}
+
+static void
+draw_enter (Sheet *s)
+{
+  heading (s, NULL, "key-round", "Use your recovery key", "Type or paste the 24 words. Spaces and capitals don’t matter.");
+  GtkWidget *paste = gtk_text_view_new ();
+  gtk_widget_add_css_class (paste, "cs-paste");
+  gtk_text_view_set_wrap_mode (GTK_TEXT_VIEW (paste), GTK_WRAP_WORD);
+  gtk_text_view_set_input_hints (GTK_TEXT_VIEW (paste), GTK_INPUT_HINT_NO_SPELLCHECK | GTK_INPUT_HINT_LOWERCASE | GTK_INPUT_HINT_NO_EMOJI);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (paste), GTK_ACCESSIBLE_PROPERTY_LABEL, "Recovery key", -1);
+  GtkTextBuffer *buffer = gtk_text_view_get_buffer (GTK_TEXT_VIEW (paste));
+  if (s->entered) gtk_text_buffer_set_text (buffer, s->entered, -1);
+  g_signal_connect (buffer, "changed", G_CALLBACK (entered_changed), s);
+  /* The well (cs.css .cs-paste) is a box around a bare text view: GTK paints a text view's ground on its text node. */
+  GtkWidget *well = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_add_css_class (well, "cs-paste");
+  gtk_widget_set_hexpand (paste, TRUE);
+  gtk_widget_set_vexpand (paste, TRUE);
+  gtk_widget_remove_css_class (paste, "cs-paste");
+  gtk_widget_add_css_class (paste, "cs-paste-text");
+  gtk_box_append (GTK_BOX (well), paste);
+  gtk_box_append (GTK_BOX (s->card), well);
+  s->error_label = label (s->error ? s->error : "", "cs-err");
+  gtk_widget_set_visible (s->error_label, s->error != NULL);
+  gtk_box_append (GTK_BOX (s->card), s->error_label);
+  s->count = label ("0 of 24 words", "cs-count");
+  gtk_box_append (GTK_BOX (s->card), s->count);
+  GtkWidget *row = actions (s);
+  act_left (row, sheet_button ("Approve on a device instead", "plain", NULL, G_CALLBACK (device_instead_clicked), s));
+  s->join_button = sheet_button ("Join", "key", NULL, G_CALLBACK (join_clicked), s);
+  gtk_box_append (GTK_BOX (row), s->join_button);
+  entered_changed (buffer, s);
+  g_object_set_data (G_OBJECT (s->card), "cs-focus", paste);
+}
+
+static void
+tv_ring_enter (GtkEventControllerFocus *fc, gpointer b)
+{
+  gtk_widget_add_css_class (GTK_WIDGET (b), "cs-ring");
+}
+
+static void
+tv_ring_leave (GtkEventControllerFocus *fc, gpointer b)
+{
+  gtk_widget_remove_css_class (GTK_WIDGET (b), "cs-ring");
+}
+
+static void
+tv_field_enter (GtkEventControllerFocus *fc, gpointer data)
+{
+  Sheet *s = data;
+  GtkWidget *now = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (fc));
+  /* The layer host focuses the first field as it presents the sheet: that isn't the person moving. */
+  if (!g_object_get_data (G_OBJECT (s->card), "cs-settled")) return;
+  for (guint i = 0; i < 3; i++)
+    if (s->fields[i] && s->fields[i] != now) gtk_widget_remove_css_class (s->fields[i], "cs-cur");
+}
+
+static gboolean
+tv_focus_idle (gpointer w)
+{
+  if (gtk_widget_get_root (w)) gtk_widget_grab_focus (w);
+  for (GtkWidget *a = w; a; a = gtk_widget_get_parent (a))
+    if (gtk_widget_has_css_class (a, "cs-sheet")) { g_object_set_data (G_OBJECT (a), "cs-settled", GINT_TO_POINTER (1)); break; }
+  return G_SOURCE_REMOVE;
+}
+
+static void
+sheet_draw (Sheet *s)
+{
+  View *v = s->root ? g_object_get_data (G_OBJECT (s->root), "cf-view") : NULL;
+  gboolean phone = v ? v->phone : Suno_ui_mobile_form_factor ();
+  GtkWidget *c;
+  while ((c = gtk_widget_get_first_child (s->card))) gtk_box_remove (GTK_BOX (s->card), c);
+  s->cont = s->turn_on = s->join_button = s->count = s->error_label = s->code_box = NULL;
+  memset (s->fields, 0, sizeof s->fields);
+  if (phone) gtk_widget_add_css_class (s->card, "phone"); else gtk_widget_remove_css_class (s->card, "phone");
+  if (Suno_ui_tv_posture ()) gtk_widget_add_css_class (s->card, "tv");
+  switch (s->step)
+    {
+    case SHEET_KEY: case SHEET_SHOW: case SHEET_NEWKEY: draw_key (s, phone); break;
+    case SHEET_CHECK: draw_check (s, phone); break;
+    case SHEET_JOIN: draw_join (s); break;
+    case SHEET_ENTER: draw_enter (s); break;
+    }
+  /* A phone stacks the actions full width, the primary on top (cs.css column-reverse). */
+  for (GtkWidget *w = gtk_widget_get_first_child (s->card); phone && w; w = gtk_widget_get_next_sibling (w))
+    if (gtk_widget_has_css_class (w, "cs-acts"))
+      {
+        gtk_orientable_set_orientation (GTK_ORIENTABLE (w), GTK_ORIENTATION_VERTICAL);
+        g_autoptr (GPtrArray) kids = g_ptr_array_new ();
+        for (GtkWidget *b = gtk_widget_get_first_child (w); b; b = gtk_widget_get_next_sibling (b)) g_ptr_array_add (kids, b);
+        GtkWidget *after = NULL;
+        for (guint i = kids->len; i > 0; i--)
+          {
+            gtk_box_reorder_child_after (GTK_BOX (w), kids->pdata[i - 1], after);
+            after = kids->pdata[i - 1];
+          }
+        for (GtkWidget *b = gtk_widget_get_first_child (w); b; b = gtk_widget_get_next_sibling (b))
+          {
+            gtk_widget_set_halign (b, GTK_ALIGN_FILL);
+            gtk_widget_set_hexpand (b, TRUE);
+            /* the reference's stacked buttons keep their words at the start; a pair of equal answers centres them */
+            for (GtkWidget *l = gtk_widget_get_first_child (b); l && !gtk_widget_has_css_class (w, "cs-eq"); l = gtk_widget_get_next_sibling (l))
+              if (GTK_IS_LABEL (l)) { gtk_widget_set_halign (l, GTK_ALIGN_START); gtk_label_set_xalign (GTK_LABEL (l), 0); }
+          }
+      }
+  /* A TV's remote starts on the way out, never on Continue. */
+  GtkWidget *cancel = NULL;
+  for (GtkWidget *w = gtk_widget_get_last_child (s->card); w && !cancel; w = gtk_widget_get_prev_sibling (w))
+    if (gtk_widget_has_css_class (w, "cs-acts"))
+      for (GtkWidget *b = gtk_widget_get_first_child (w); b && !cancel; b = gtk_widget_get_next_sibling (b))
+        if (gtk_widget_has_css_class (b, "cs-left")) cancel = b;
+  GtkWidget *focus = g_object_get_data (G_OBJECT (s->card), "cs-focus");
+  /* Step 2: the first word not typed right yet. */
+  for (guint i = 0; s->step == SHEET_CHECK && !focus && i < 3; i++)
+    if (s->fields[i] && !word_matches (s, i, s->typed[i])) focus = s->fields[i];
+  if (s->step == SHEET_CHECK && !focus && s->fields[0]) focus = s->fields[0];
+  /* The next word to type wears the field's ring until a field takes the focus (on a TV the
+   * remote rests on the way out; elsewhere the ring shows before the window is active). */
+  if (s->step == SHEET_CHECK && focus)
+    {
+      gtk_widget_add_css_class (focus, "cs-cur");
+      for (guint i = 0; i < 3; i++)
+        if (s->fields[i])
+          {
+            GtkEventController *fc = gtk_event_controller_focus_new ();
+            g_signal_connect (fc, "enter", G_CALLBACK (tv_field_enter), s);
+            gtk_widget_add_controller (s->fields[i], fc);
+          }
+    }
+  if (Suno_ui_tv_posture ())
+    {
+      if (cancel) focus = cancel;
+      for (GtkWidget *w = gtk_widget_get_first_child (s->card); w; w = gtk_widget_get_next_sibling (w))
+        if (gtk_widget_has_css_class (w, "cs-acts"))
+          for (GtkWidget *b = gtk_widget_get_first_child (w); b; b = gtk_widget_get_next_sibling (b))
+            {
+              GtkEventController *fc = gtk_event_controller_focus_new ();
+              g_signal_connect (fc, "enter", G_CALLBACK (tv_ring_enter), b);
+              g_signal_connect (fc, "leave", G_CALLBACK (tv_ring_leave), b);
+              gtk_widget_add_controller (b, fc);
+            }
+      /* The ring is a class: the sheet is not in a window yet. */
+      if (focus) gtk_widget_add_css_class (focus, "cs-ring");
+    }
+  /* The focus lands on idle, after the layer host has presented the sheet (it focuses the first field). */
+  if (focus)
+    {
+      gtk_widget_grab_focus (focus);
+      g_idle_add_full (G_PRIORITY_DEFAULT_IDLE, tv_focus_idle, g_object_ref (focus), g_object_unref);
+    }
+  g_object_set_data (G_OBJECT (s->card), "cs-focus", NULL);
+}
+
+static void
+sheet_closed (gpointer data, GObject *gone)
+{
+  Sheet *s = data;
+  s->handle = NULL;
+  sheet_free (s);
+}
+
+static Sheet *
+sheet_new (GtkWidget *root, Step step, const char *name)
+{
+  Sheet *s = g_new0 (Sheet, 1);
+  s->root = root ? g_object_ref (root) : NULL;
+  s->cancel = g_cancellable_new ();
+  s->step = step;
+  s->name = g_strdup (name);
+  s->card = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_add_css_class (s->card, "SunoUI-dialog");
+  gtk_widget_add_css_class (s->card, "cs-sheet");
+  gtk_widget_set_name (s->card, "cs-sheet");
+  return s;
+}
+
+static void
+sheet_present (Sheet *s)
+{
+  sheet_draw (s);
+  GtkWidget *focus = NULL;
+  for (GtkWidget *w = gtk_widget_get_last_child (s->card); w && !focus; w = gtk_widget_get_prev_sibling (w))
+    if (gtk_widget_has_css_class (w, "cs-acts") && Suno_ui_tv_posture ()) focus = gtk_widget_get_first_child (w);
+  SunoLayerHost *host = Suno_layer_host_window_host (s->root);
+  s->handle = Suno_layer_host_present_modal (host, s->card, focus, SUNO_DRAWER_MODE_AUTO);
+  g_signal_connect (s->handle, "cancelled", G_CALLBACK (sheet_cancelled), s);
+  g_object_weak_ref (G_OBJECT (s->handle), sheet_closed, s);
+}
+
+/* ── Turning Sync on: setup on the first device, joining on the next ── */
+static void
+setup_begun (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Sheet *s = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  View *v = s->root ? g_object_get_data (G_OBJECT (s->root), "cf-view") : NULL;
+  if (!reply)
+    {
+      if (v && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) cc_Suno_view_report_error (v, error);
+      sheet_free (s);
+      return;
+    }
+  g_autoptr (GVariant) words = NULL, check = NULL;
+  g_variant_get (reply, "(@as@ai)", &words, &check);
+  s->words = g_variant_dup_strv (words, NULL);
+  gsize n = 0;
+  const gint32 *positions = g_variant_get_fixed_array (check, &n, sizeof (gint32));
+  for (guint i = 0; i < 3 && i < n; i++) s->check[i] = positions[i];
+  s->setup = TRUE;
+  sheet_present (s);
+}
+
+static void
+join_begun (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Sheet *s = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  if (!reply)
+    {
+      View *v = s->root ? g_object_get_data (G_OBJECT (s->root), "cf-view") : NULL;
+      if (v && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) cc_Suno_view_report_error (v, error);
+      if (!s->handle) sheet_free (s);
+      else sheet_draw (s);
+      return;
+    }
+  const char *json = NULL;
+  g_variant_get (reply, "(&s)", &json);
+  if (s->handle)
+    {
+      /* Ask again: the same sheet, a new code. */
+      take_join (s, json);
+      sheet_draw (s);
+      return;
+    }
+  g_autoptr (GDBusConnection) bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  if (bus)
+    s->join_signal = g_dbus_connection_signal_subscribe (bus, CC_SUNO_SYNC_BUS, CC_SUNO_SYNC_IFACE, "JoinChanged", CC_SUNO_SYNC_PATH,
+                                                         NULL, G_DBUS_SIGNAL_FLAGS_NONE, join_changed, s, NULL);
+  sheet_present (s);
+  take_join (s, json);
+  /* JoinChanged answers most changes; a slow look covers the rest (the Hub only reports them when asked). */
+  g_object_set_data_full (G_OBJECT (s->card), "cs-poll", GUINT_TO_POINTER (g_timeout_add_seconds (5, poll_join, s)),
+                          (GDestroyNotify) g_source_remove);
+}
+
+/* The account has Sync: turning it on joins (a removed device joins again). */
+static gboolean
+set_up (JsonObject *st)
+{
+  return flag (st, "set_up", TRUE) || g_strcmp0 (str (obj (st, "attention"), "reason"), "revoked") == 0;
+}
+/* This device is in the account's Sync now (a removed device is not, whatever it last read). */
+static gboolean
+member (JsonObject *st)
+{
+  if (g_strcmp0 (str (obj (st, "attention"), "reason"), "revoked") == 0) return FALSE;
+  return flag (st, "member", g_strcmp0 (str (st, "state"), "off") != 0);
+}
+
+/* A fixture sheet, drawn from CFSYNC's words, check and join. */
+static Sheet *
+fixture_sheet (JsonObject *sync, GtkWidget *root, Step step)
+{
+  Sheet *s = sheet_new (root, step, device_name (sync));
+  JsonArray *words = arr (sync, step == SHEET_NEWKEY && arr (sync, "words_new") ? "words_new" : "words"), *check = arr (sync, "check");
+  s->words = g_new0 (char *, (words ? json_array_get_length (words) : 0) + 1);
+  for (guint i = 0; words && i < json_array_get_length (words); i++) s->words[i] = g_strdup (json_array_get_string_element (words, i));
+  for (guint i = 0; check && i < 3 && i < json_array_get_length (check); i++) s->check[i] = json_array_get_int_element (check, i);
+  JsonObject *join = obj (sync, "join");
+  s->code = g_strdup (str (join, "code"));
+  s->join_state = g_strdup (str (join, "state"));
+  if (arr (join, "approvers")) s->approvers = json_array_ref (arr (join, "approvers"));
+  s->capture = TRUE;
+  return s;
+}
+
+/* ProbeAccount's answer: {"set_up": bool, "member": bool}. */
+static void
+account_probed (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Sheet *s = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  if (!reply)
+    {
+      View *v = s->root ? g_object_get_data (G_OBJECT (s->root), "cf-view") : NULL;
+      if (v && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) cc_Suno_view_report_error (v, error);
+      sheet_free (s);
+      return;
+    }
+  const char *json = NULL;
+  g_variant_get (reply, "(&s)", &json);
+  g_autoptr (JsonNode) node = json_from_string (json, NULL);
+  JsonObject *answer = node && JSON_NODE_HOLDS_OBJECT (node) ? json_node_get_object (node) : NULL;
+  if (answer && flag (answer, "set_up", FALSE))
+    {
+      s->step = SHEET_JOIN;
+      sync_call ("RequestJoin", NULL, "(s)", s->cancel, join_begun, s);
+    }
+  else
+    sync_call ("BeginSetup", NULL, "(asai)", s->cancel, setup_begun, s);
+}
+
+static void
+turn_on (View *v)
+{
+  JsonObject *sync = sync_of (v), *st = cc_Suno_sync_state (sync);
+  if (!live (v))
+    {
+      Sheet *s = fixture_sheet (sync, v->root, set_up (st) ? SHEET_JOIN : SHEET_KEY);
+      s->capture = FALSE;
+      sheet_present (s);
+      return;
+    }
+  if (set_up (st) && member (st))
+    {
+      g_autoptr (JsonNode) on = json_node_init_boolean (json_node_alloc (), TRUE);
+      write_key (v, "syncOn", on);
+      return;
+    }
+  /* The service doesn't talk to the Hub until Sync is turned on here, so it can't yet say whether the
+   * account has Sync. Turning it on is the person's go-ahead: one look (ProbeAccount), then the join sheet
+   * or the recovery key. */
+  Sheet *s = sheet_new (v->root, SHEET_KEY, device_name (sync));
+  if (member (st) || g_strcmp0 (str (obj (st, "attention"), "reason"), "revoked") == 0)
+    {
+      s->step = SHEET_JOIN;
+      sync_call ("RequestJoin", NULL, "(s)", s->cancel, join_begun, s);
+      return;
+    }
+  sync_call ("ProbeAccount", NULL, "(s)", s->cancel, account_probed, s);
+}
+
+static void
+stop_confirmed (SunoDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  if (!live (v)) { fixture_set (v, "enabled", NULL, FALSE); return; }
+  g_autoptr (JsonNode) off = json_node_init_boolean (json_node_alloc (), FALSE);
+  write_key (v, "syncOn", off);
+}
+
+static void
+main_switch_clicked (GtkButton *button, gpointer data)
+{
+  View *v = view_of (GTK_WIDGET (button));
+  if (!v || v->rendering) return;
+  JsonObject *sync = sync_of (v), *st = cc_Suno_sync_state (sync);
+  GtkWidget *visual = g_object_get_data (G_OBJECT (button), "cf-switch");
+  if (!gtk_switch_get_active (GTK_SWITCH (visual)))
+    {
+      turn_on (v);
+      return;
+    }
+  g_autofree char *title = g_strdup_printf ("Stop syncing this %s?", device_name (sync));
+  SunoDestructiveDialog *dialog = Suno_destructive_dialog_ask (v->root, title,
+    "Everything on it stays. Your other devices keep syncing.", "Stop syncing", "cloud-off", NULL);
+  g_signal_connect_object (dialog, "confirmed", G_CALLBACK (stop_confirmed), v->root, 0);
+  (void) st;
+}
+
+/* ── The page ───────────────────────────────────────────────────────── */
+typedef struct { const char *icon, *cls, *title; char *line; } Look;
+
+/* The state the hero (and the Suno account row) shows. */
+/* S1: the recovery key was replaced when the device that kept it was removed; shown until the new words are kept. */
+static gboolean
+new_key (JsonObject *st)
+{
+  return g_strcmp0 (str (obj (st, "attention"), "reason"), "new_recovery_key") == 0;
+}
+
+static Look
+look_for (JsonObject *sync, gint64 now)
+{
+  JsonObject *st = cc_Suno_sync_state (sync), *attention = obj (st, "attention");
+  const char *state = str (st, "state"), *detail = str (st, "detail");
+  const char *reason = str (attention, "reason");
+  Look look = { "cloud", "", NULL, NULL };
+  if (g_strcmp0 (reason, "revoked") == 0)
+    {
+      /* review 1: "On Dell XPS 14 · today. Sign in again to rejoin." (who removed it and when, when known) */
+      const char *who = str (attention, "from_name") ? str (attention, "from_name") : str (attention, "from");
+      gint64 at = num (attention, "at", 0);
+      g_autofree char *when = at > 0 ? cc_Suno_sync_day (at, now) : NULL;
+      look.icon = "cloud-off"; look.cls = "cs-bad"; look.title = "Removed from Sync";
+      look.line = who && when ? g_strdup_printf ("On %s · %s. Sign in again to rejoin.", who, when)
+                : who ? g_strdup_printf ("On %s. Sign in again to rejoin.", who)
+                : when ? g_strdup_printf ("Removed %s%s. Sign in again to rejoin.", g_ascii_isdigit (*when) ? "on " : "", when)
+                : g_strdup ("Sign in again to rejoin.");
+      return look;
+    }
+  if (new_key (st))
+    {
+      look.icon = "key-round"; look.cls = "cs-warn"; look.title = "New recovery key";
+      look.line = g_strdup ("A device was removed, so your old words stopped working");
+      return look;
+    }
+  if (g_strcmp0 (state, "joining") == 0 && !member (st))
+    {
+      look.icon = "refresh-cw"; look.cls = "cs-dim"; look.title = "Waiting for approval";
+      look.line = g_strdup ("Choose Approve on one of your other devices");
+      return look;
+    }
+  if (!st || !flag (st, "enabled", TRUE) || g_strcmp0 (state, "off") == 0 || !member (st))
+    {
+      look.icon = "cloud-off"; look.cls = "cs-dim"; look.title = "Off";
+      look.line = g_strdup ("This device doesn’t sync");
+      return look;
+    }
+  if (g_strcmp0 (reason, "quota") == 0)
+    {
+      g_autofree char *used = cc_Suno_sync_size (num (attention, "used", num (obj (st, "storage"), "used", 0)));
+      g_autofree char *quota = cc_Suno_sync_size (num (attention, "quota", num (obj (st, "storage"), "quota", 0)));
+      look.icon = "cloud-alert"; look.cls = "cs-warn"; look.title = "Storage full";
+      look.line = g_strdup_printf ("%s of %s", used, quota);
+      return look;
+    }
+  if (g_strcmp0 (reason, "conflict") == 0)
+    {
+      look.icon = "cloud-alert"; look.cls = "cs-warn";
+      look.title = str (attention, "detail") ? str (attention, "detail") : "Changed on two devices";
+      look.line = g_strdup ("Kept both · today");
+      return look;
+    }
+  if (g_strcmp0 (state, "syncing") == 0)
+    {
+      look.icon = "refresh-cw"; look.title = "Syncing";
+      look.line = g_strdup (detail && *detail ? detail : "Bringing your devices up to date");
+      return look;
+    }
+  if (g_strcmp0 (state, "paused") == 0)
+    {
+      look.icon = "cloud-off"; look.title = "Paused";
+      look.line = g_strdup (detail && *detail ? detail : "Waiting for a connection");
+      return look;
+    }
+  look.cls = "cs-ok"; look.title = "Up to date";
+  gint64 last = num (st, "last_sync", 0);
+  look.line = last > 0 ? cc_Suno_sync_when (last, now, FALSE) : g_strdup ("Synced just now");
+  return look;
+}
+
+static gint64
+apps_bytes (JsonObject *sync)
+{
+  gint64 total = 0;
+  JsonArray *apps = arr (sync, "apps");
+  for (guint i = 0; apps && i < json_array_get_length (apps); i++)
+    total += num (json_array_get_object_element (apps, i), "size", 0);
+  return total;
+}
+
+/* What the apps take in Sync's storage: the Hub's count by kind when there is one, else their folders here. */
+static gint64
+apps_storage (JsonObject *sync)
+{
+  JsonArray *kinds = arr (obj (cc_Suno_sync_state (sync), "storage"), "kinds");
+  for (guint i = 0; kinds && i < json_array_get_length (kinds); i++)
+    {
+      JsonArray *k = json_array_get_array_element (kinds, i);
+      if (k && g_strcmp0 (json_array_get_string_element (k, 0), "Apps") == 0) return json_array_get_int_element (k, 1);
+    }
+  return apps_bytes (sync);
+}
+
+static gboolean
+removed (JsonObject *st)
+{
+  return g_strcmp0 (str (obj (st, "attention"), "reason"), "revoked") == 0;
+}
+
+/* Sign in again…: Suno Connect's own sign-in; once this device is signed in again, the join sheet. */
+static void
+sign_in_clicked (GtkButton *button, View *v)
+{
+  g_autoptr (GDesktopAppInfo) app = g_desktop_app_info_new ("org.projectSuno.Connect.desktop");
+  g_autoptr (GError) error = NULL;
+  if (!app || !g_app_info_launch (G_APP_INFO (app), NULL, NULL, &error))
+    {
+      Suno_toast_show (v->root, "Suno Connect isn’t installed", "error");
+      return;
+    }
+  g_object_set_data (G_OBJECT (v->root), "cs-after-sign-in", GINT_TO_POINTER (1));
+}
