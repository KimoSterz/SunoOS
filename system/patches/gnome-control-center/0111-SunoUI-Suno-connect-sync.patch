+    "It keeps what it has but won’t get anything new. Your other devices get new keys.", "Remove",
+    g_object_get_data (G_OBJECT (button), "cs-icon"), NULL);
+  g_object_set_data_full (G_OBJECT (dialog), "cs-device", g_strdup (g_object_get_data (G_OBJECT (button), "cs-device")), g_free);
+  g_signal_connect_object (dialog, "confirmed", G_CALLBACK (remove_confirmed), v->root, 0);
+}
+
+static void
+revealed (GObject *source, GAsyncResult *result, gpointer data)
+{
+  GtkWidget *root = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!reply)
+    {
+      if (v && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) cc_Suno_view_report_error (v, error);
+      g_object_unref (root);
+      return;
+    }
+  Sheet *s = sheet_new (root, SHEET_SHOW, NULL);
+  g_variant_get (reply, "(^as)", &s->words);
+  sheet_present (s);
+  g_object_unref (root);
+}
+
+static void
+show_key_clicked (GtkButton *button, View *v)
+{
+  if (!live (v))
+    {
+      Sheet *s = fixture_sheet (sync_of (v), v->root, SHEET_SHOW);
+      s->capture = FALSE;
+      sheet_present (s);
+      return;
+    }
+  /* RevealRecoveryKey asks for the password (polkit) first. */
+  sync_call ("RevealRecoveryKey", NULL, "(as)", NULL, revealed, g_object_ref (v->root));
+}
+
+static void
+revealed_new (GObject *source, GAsyncResult *result, gpointer data)
+{
+  GtkWidget *root = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!reply)
+    {
+      if (v && !g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) cc_Suno_view_report_error (v, error);
+      g_object_unref (root);
+      return;
+    }
+  Sheet *s = sheet_new (root, SHEET_NEWKEY, NULL);
+  g_variant_get (reply, "(^as)", &s->words);
+  sheet_present (s);
+  g_object_unref (root);
+}
+
+/* S1: Show new key… asks for the password (polkit, RevealRecoveryKey), then the new words with their tick and Done. */
+static void
+show_new_key_clicked (GtkButton *button, View *v)
+{
+  if (!live (v))
+    {
+      Sheet *s = fixture_sheet (sync_of (v), v->root, SHEET_NEWKEY);
