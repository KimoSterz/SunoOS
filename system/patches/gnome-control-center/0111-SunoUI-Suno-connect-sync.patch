+static void
+app_row (View *v, GtkBox *card, JsonObject *app, gint64 now)
+{
+  const char *id = str (app, "app");
+  g_autofree char *name = app_name (v, app);
+  gboolean api = flag (app, "uses_api", FALSE);
+  g_autofree char *line = cc_Suno_sync_app_line (app, now);
+  GtkWidget *words;
+  if (api)
+    {
+      /* "3 MB · its own sync · Delete synced data", the last a red text action. */
+      words = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+      gtk_widget_add_css_class (words, "cs-subline");
+      g_autofree char *lead = g_strconcat (line, " · ", NULL);
+      GtkWidget *l = sub_label (lead);
+      gtk_label_set_wrap (GTK_LABEL (l), FALSE);
+      gtk_box_append (GTK_BOX (words), l);
+      GtkWidget *rm = gtk_button_new_with_label ("Delete synced data");
+      gtk_widget_add_css_class (rm, "cs-rm");
+      /* The subtitle's own type, so the line is no taller than its neighbours'. */
+      Suno_ui_apply_type_full (gtk_button_get_child (GTK_BUTTON (rm)), "row-subtitle", FALSE);
+      g_object_set_data_full (G_OBJECT (rm), "cs-app", g_strdup (id), g_free);
+      g_object_set_data_full (G_OBJECT (rm), "cs-name", g_strdup (name), g_free);
+      g_signal_connect (rm, "clicked", G_CALLBACK (delete_clicked), NULL);
+      gtk_box_append (GTK_BOX (words), rm);
+    }
+  else
+    words = sub_label (line);
+  g_autofree char *row_name = g_strconcat ("cs-app-", id, NULL);
+  GtkWidget *button = switch_button (name, flag (app, "enabled", TRUE), flip_app, row_name);
+  g_object_set_data_full (G_OBJECT (button), "cs-key", g_strdup (id), g_free);
+  custom_row (card, app_lead (v, app, 30), title_line (name, api ? "Uses Suno Connect" : NULL, "cs-api"), words,
+              g_object_get_data (G_OBJECT (button), "cf-switch"), button);
+}
+
+static int
+by_size (gconstpointer a, gconstpointer b)
+{
+  gint64 x = num (*(JsonObject * const *) a, "size", 0), y = num (*(JsonObject * const *) b, "size", 0);
+  return x < y ? 1 : x > y ? -1 : 0;
+}
+
+/* The apps that keep data, biggest first; @limit 0 is all. */
+static GPtrArray *
+apps_sorted (JsonObject *sync)
+{
+  GPtrArray *out = g_ptr_array_new ();
+  JsonArray *apps = arr (sync, "apps");
+  for (guint i = 0; apps && i < json_array_get_length (apps); i++)
+    {
+      JsonObject *a = json_array_get_object_element (apps, i);
+      if (!flag (a, "denied", FALSE)) g_ptr_array_add (out, a);
+    }
+  g_ptr_array_sort (out, by_size);
+  return out;
+}
+
+static void
+remove_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  GtkWidget *root = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!reply && v) cc_Suno_view_report_error (v, error);
+  if (reply)
+    {
+      /* The removed device held the key: a new one replaces it; show it once. */
+      g_autofree char **words = NULL;
+      g_variant_get (reply, "(^a&s)", &words);
+      if (words && words[0])
+        {
+          Sheet *s = sheet_new (root, SHEET_SHOW, NULL);
+          s->words = g_strdupv ((char **) words);
+          sheet_present (s);
+        }
+    }
+  if (v) cc_Suno_view_queue_refresh (v);
+  g_object_unref (root);
+}
+
+static void
+remove_confirmed (SunoDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  const char *device = g_object_get_data (G_OBJECT (dialog), "cs-device");
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v || !device || !live (v)) return;
+  sync_call ("RemoveDevice", g_variant_new ("(sb)", device, FALSE), "(as)", NULL, remove_done, g_object_ref (root));
+}
