+static GtkWidget *
+glyph (const char *icon, const char *cls)
+{
+  GtkWidget *i = Suno_ui_icon_new (icon);
+  if (cls) gtk_widget_add_css_class (i, cls);
+  return i;
+}
+
+/* A change the person made: the live model's key, or the fixture's own copy. */
+static void
+write_key (View *v, const char *key, JsonNode *value)
+{
+  g_autoptr (GError) error = NULL;
+  if (!cc_Suno_fixture_write (v->model, key, value, &error))
+    {
+      cc_Suno_view_report_error (v, error);
+      cc_Suno_view_queue_refresh (v);
+    }
+}
