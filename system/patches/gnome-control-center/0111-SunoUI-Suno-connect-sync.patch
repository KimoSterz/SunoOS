+/* What the person calls an app: the service's name, else its launcher's. */
+static char *
+app_name (View *v, JsonObject *app)
+{
+  const char *id = str (app, "app"), *name = str (app, "name");
+  if (name && *name && g_strcmp0 (name, id) != 0) return g_strdup (name);
+  if (live (v) && id)
+    {
+      g_autofree char *desktop = g_strconcat (id, ".desktop", NULL);
+      g_autoptr (GDesktopAppInfo) info = g_desktop_app_info_new (desktop);
+      if (info) return g_strdup (g_app_info_get_display_name (G_APP_INFO (info)));
+    }
+  return g_strdup (name ? name : id);
+}
