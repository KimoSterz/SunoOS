diff --git a/shell/Suno-settings-system.css b/shell/Suno-settings-system.css
index 6480a22..0905807 100644
--- a/shell/Suno-settings-system.css
+++ b/shell/Suno-settings-system.css
@@ -33,3 +33,151 @@
 
 /* Phone: the field keeps v70's intrinsic 170 px (padding included). */
 entry.cf-tx.cf-phone { min-width: 150px; }
+
+/* Suno Connect Sync (0111): Suno account › Sync and its sheets (design-center
+ * 38858a5, mockups/connect-sync/cs.css). v70 ink-2 = @Suno_ink_secondary,
+ * ink-3 = @Suno_muted, fill-1 = @Suno_hover, hair = @Suno_menu_border. */
+@define-color cs_ok oklch(0.74 0.13 150);
+@define-color cs_warn oklch(0.8 0.14 75);
+@define-color cs_bad oklch(0.7 0.17 25);
+@define-color cs_link oklch(0.72 0.12 250);
+.cs-ok, image.cs-ok { color: @cs_ok; }
+.cs-warn, image.cs-warn { color: @cs_warn; }
+.cs-bad, image.cs-bad { color: @cs_bad; }
+.cs-st { min-width: 44px; min-height: 44px; border-radius: 12px; background: @Suno_hover; }
+.cs-st image { -gtk-icon-size: 22px; color: @Suno_ink_secondary; }
+.cs-st image.cs-ok { color: @cs_ok; } .cs-st image.cs-warn { color: @cs_warn; } .cs-st image.cs-bad { color: @cs_bad; }
+label.cs-state { font-size: 16px; font-weight: 650; letter-spacing: -0.16px; line-height: 22px; }
+label.cs-line { font-size: 12.5px; color: @Suno_muted; line-height: 18px; }
+button.cs-switch { min-height: 0; min-width: 0; padding: 0; background: none; box-shadow: none; }
+.cs-quota { margin-top: 15px; }
+.cs-quota .SunoUI-progress { min-height: 6px; border-radius: 3px; }
+.cs-quota .SunoUI-progress-fill { border-radius: 3px; }
+.cs-qwords { margin-top: 7px; font-size: 12px; color: @Suno_muted; }
+.cs-lock { margin: 12px 4px 0; font-size: 12px; color: @Suno_muted; }
+.cs-lock image { -gtk-icon-size: 14px; color: @cs_ok; }
+.cs-dev .cf-ri image { -gtk-icon-size: 17px; }
+box.cs-me, box.cs-api { margin-left: 6px; padding: 1px 6px; border-radius: 5px; font-size: 10.5px; font-weight: 650; color: @Suno_ink_secondary; }
+box.cs-me { background: @Suno_hover; }
+box.cs-me label, box.cs-api label { line-height: 13px; }
+box.cs-api { box-shadow: inset 0 0 0 1px @Suno_menu_border; }
+button.cs-rm { min-height: 0; min-width: 0; padding: 0; margin: 0; background: none; box-shadow: none; color: @cs_bad; font-size: 12px; font-weight: 400; }
+button.cs-rm label, window.Suno-app-window button.cs-rm label { font-weight: 400; color: @cs_bad; }
+button.cs-rm:hover { text-decoration: underline; }
+.cs-vlic.cf-ri { background: linear-gradient(in oklab 160deg, oklch(0.78 0.14 140), oklch(0.55 0.15 160)); }
+.cs-vlic.cf-ri { border-radius: 8px; box-shadow: inset 0 1px 0 rgba(255,255,255,.3), inset 0 0 0 .5px rgba(255,255,255,.2), 0 1px 1px rgba(0,0,0,.2), 0 8px 18px -8px rgba(0,0,0,.5); }
+.cs-vlic.cf-ri image { color: white; -gtk-icon-size: 14px; }
+image.cs-appicon { min-width: 30px; min-height: 30px; }
+
+/* The sheet over Settings (cs-sheet): 560 wide; a bottom drawer on a phone. */
+box.SunoUI-dialog.cs-sheet { min-width: 500px; padding: 28px 30px 24px; border-radius: 22px; }
+.cs-sheet label.cs-step { margin-bottom: 12px; font-size: 11.5px; font-weight: 650; letter-spacing: 0.23px; color: @Suno_muted; }
+.cs-sheet .cs-ico { min-width: 44px; min-height: 44px; margin-bottom: 14px; border-radius: 13px; background: @Suno_hover; }
+.cs-sheet .cs-ico image { -gtk-icon-size: 22px; color: @Suno_ink_secondary; }
+.cs-sheet label.cs-h2 { margin-top: 2px; font-size: 21px; font-weight: 700; letter-spacing: -0.42px; }
+.cs-sheet label.cs-p { margin-top: 8px; font-size: 13px; line-height: 20px; color: @Suno_ink_secondary; }
+.cs-sheet .cs-words { margin-top: 18px; padding: 13px 14px 15px; border-radius: 14px; background: @Suno_well;
+  box-shadow: inset 0 0 0 1px @Suno_well_ring, inset 0 1px 2px @Suno_well_shade, 0 1px 0 @Suno_well_lip; }
+.cs-sheet .cs-cell { padding: 5px 7px; }
+.cs-sheet label.cs-w { font-family: "IBM Plex Mono", monospace; font-size: 13px; font-weight: 500; }
+.cs-sheet label.cs-n { min-width: 16px; font-family: "IBM Plex Mono", monospace; font-size: 10.5px; font-weight: 500; color: @Suno_muted; }
+.cs-sheet .cs-tools { margin-top: 12px; }
+.cs-sheet .cs-tools button image { -gtk-icon-size: 16px; }
+.cs-sheet checkbutton.cs-check { margin-top: 18px; font-size: 13px; }
+.cs-sheet checkbutton.cs-check check { min-width: 18px; min-height: 18px; border-radius: 5px; }
+.cs-sheet .cs-acts { margin-top: 22px; }
+.cs-sheet .cs-ask { margin-top: 21px; }
+.cs-sheet label.cs-lab { font-size: 11.5px; font-weight: 600; color: @Suno_muted; }
+.cs-sheet entry.cs-in { min-height: 38px; padding: 0 12px; border-radius: 11px; font-family: "IBM Plex Mono", monospace; font-size: 13.5px; font-weight: 500; background: @Suno_well;
+  box-shadow: inset 0 1px 2px @Suno_well_shade; }
+.cs-sheet entry.cs-in:focus-within, .cs-sheet entry.cs-in.cs-cur { box-shadow: inset 0 1px 2px @Suno_well_shade, 0 0 0 2px oklch(0.6 0.13 250); }
+.cs-sheet entry.cs-in, .cs-sheet entry.cs-in:focus-within { border: 1px solid @Suno_well_ring; outline: none; }
+.cs-sheet entry.cs-in.ok { box-shadow: inset 0 0 0 1.5px @cs_ok; }
+.cs-sheet .cs-code { margin: 22px 0 6px; }
+.cs-sheet label.cs-well { padding: 14px 16px; border-radius: 14px; font-family: "IBM Plex Mono", monospace; font-size: 40px; font-weight: 600; line-height: 40px; letter-spacing: 2.4px; background: @Suno_well;
+  box-shadow: inset 0 0 0 1px @Suno_well_ring, inset 0 1px 2px @Suno_well_shade, 0 1px 0 @Suno_well_lip; }
+.cs-sheet .cs-devs { margin-top: 11px; font-size: 12.5px; color: @Suno_ink_secondary; }
+.cs-sheet .cs-dev { padding: 6px 10px; border-radius: 9px; background: @Suno_hover; }
+.cs-sheet .cs-dev image { -gtk-icon-size: 14px; }
+.cs-sheet button.cs-link label { font-size: 12.5px; font-weight: 600; }
+.cs-sheet button.cs-link { margin-top: 18px; padding: 0; min-height: 0; background: none; box-shadow: none; font-size: 12.5px; font-weight: 600; color: @cs_link; }
+.cs-sheet box.cs-paste { min-height: 88px; margin-top: 18px; padding: 12px 14px; border-radius: 14px; background: @Suno_well;
+  box-shadow: inset 0 0 0 1px @Suno_well_ring, inset 0 1px 2px @Suno_well_shade, 0 0 0 2px oklch(0.6 0.13 250); }
+.cs-sheet textview.cs-paste-text, .cs-sheet textview.cs-paste-text text { background: none; color: @Suno_ink; font-family: "IBM Plex Mono", monospace; font-size: 13.5px; font-weight: 500; }
+.cs-sheet label.cs-count { margin-top: 8px; font-size: 12px; color: @Suno_muted; }
+.cs-sheet label.cs-err { margin-top: 8px; font-size: 12px; color: @cs_bad; }
+box.SunoUI-dialog.cs-sheet.phone { min-width: 0; padding: 24px 20px 30px; border-radius: 28px 28px 0 0; }
+.cs-sheet.phone .cs-acts button { min-height: 44px; }
+/* sheet.html ?posture=phone: the words and fields sit a little higher than on the desktop. */
+.cs-sheet.phone .cs-words { margin-top: 16px; }
