+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Suno account › Sync (ADR-054; design-center 38858a5, mockups/connect-sync:
+ * settings.html, sheet.html, cs.css, cs.js). The hero with the main switch
+ * and storage, What syncs, App data, Devices and Recovery key; the sheet that
+ * turns Sync on (the 24 words, then three of them typed back), the sheet a
+ * new device waits in (its code, or the recovery key) and the read-only key.
+ * Read from CFSYNC (cc-Suno-sync.h). */
+#include "cc-Suno-rows.h"
+#include "cc-Suno-sync.h"
+#include <math.h>
+#include <gio/gdesktopappinfo.h>
+
+/* TV posture draws the sheet at 1.5 times (sheet.html ?posture=tv). */
+#define TVPX(n) ((int) ((n) * (Suno_ui_tv_posture () ? 1.5 : 1)))
+#define LOCK_LINE "Only your devices can read what syncs. Suno can’t."
+#define KEEP_NOTE "Wi-Fi networks, passwords and Viola’s browsing don’t sync yet. Documents, Downloads and the desktop stay on each device."
+#define KEY_WORDS_SHOW "If you ever lose all your devices, these 24 words are the only way to get your synced things back. Keep them somewhere safe."
+#define KEY_WORDS_NEW "A device was removed from Sync, so your old words no longer work. Save these instead. Suno never sees them and can’t reset them."
+#define KEY_WORDS "If you ever lose all your devices, these 24 words are the only way to get your synced things back. Suno never sees them and can’t reset them."
+
+/* ── Small readers ─────────────────────────────────────────────────── */
+static const char *
+str (JsonObject *o, const char *name)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : NULL;
+}
+
+static gint64
+num (JsonObject *o, const char *name, gint64 otherwise)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  if (!n || !JSON_NODE_HOLDS_VALUE (n)) return otherwise;
+  GType t = json_node_get_value_type (n);
+  if (t == G_TYPE_INT64) return json_node_get_int (n);
+  if (t == G_TYPE_DOUBLE) return (gint64) json_node_get_double (n);
+  return otherwise;
+}
+
+static gboolean
+flag (JsonObject *o, const char *name, gboolean otherwise)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_BOOLEAN ? json_node_get_boolean (n) : otherwise;
+}
+
+static JsonObject *
+obj (JsonObject *o, const char *name)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_OBJECT (n) ? json_node_get_object (n) : NULL;
+}
+
+static JsonArray *
+arr (JsonObject *o, const char *name)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_ARRAY (n) ? json_node_get_array (n) : NULL;
+}
+
+JsonObject *
+cc_Suno_sync_data (JsonObject *data)
+{
+  return obj (data, "CFSYNC");
+}
+
+JsonObject *
+cc_Suno_sync_state (JsonObject *sync)
+{
+  return obj (sync, "state");
+}
+
+char *
+cc_Suno_sync_size (gint64 bytes)
+{
+  /* The Hub counts quotas in binary units (5 GB = 5 GiB); sizes are shown the same way. */
+  const double mb = 1024.0 * 1024.0, gb = mb * 1024.0;
+  if (bytes < 0) bytes = 0;
+  if (bytes >= gb)
+    {
+      double v = round (bytes / gb * 10.0) / 10.0;
+      return v == floor (v) ? g_strdup_printf ("%.0f GB", v) : g_strdup_printf ("%.1f GB", v);
+    }
+  return g_strdup_printf ("%" G_GINT64_FORMAT " MB", MAX ((gint64) 1, (gint64) round (bytes / mb)));
+}
+
+char *
+cc_Suno_sync_when (gint64 when, gint64 now, gboolean row)
+{
+  gint64 ago = MAX ((gint64) 0, now - when);
+  const char *lead = row ? "synced" : "Synced";
+  if (ago < 60) return g_strdup_printf ("%s just now", lead);
+  if (ago < 3600)
+    {
+      gint64 m = ago / 60;
+      if (row) return g_strdup_printf ("%s %" G_GINT64_FORMAT " min ago", lead, m);
+      return g_strdup_printf ("%s %" G_GINT64_FORMAT " %s ago", lead, m, m == 1 ? "minute" : "minutes");
+    }
+  g_autoptr (GDateTime) then = g_date_time_new_from_unix_local (when);
+  g_autoptr (GDateTime) today = g_date_time_new_from_unix_local (now);
+  int days = g_date_time_get_day_of_year (today) - g_date_time_get_day_of_year (then) +
+             365 * (g_date_time_get_year (today) - g_date_time_get_year (then));
+  if (days <= 0)
+    {
+      gint64 h = ago / 3600;
+      return g_strdup_printf ("%s %" G_GINT64_FORMAT " %s ago", lead, h, h == 1 ? "hour" : "hours");
+    }
+  if (days == 1) return g_strdup_printf ("%s yesterday", lead);
+  g_autofree char *day = g_date_time_format (then, "%-d %b");
+  return g_strdup_printf ("%s %s", lead, day);
+}
+
+/* "today", "yesterday", "21 Nov" */
+char *
+cc_Suno_sync_day (gint64 when, gint64 now)
+{
+  g_autoptr (GDateTime) then = g_date_time_new_from_unix_local (when);
+  g_autoptr (GDateTime) today = g_date_time_new_from_unix_local (now);
+  int days = g_date_time_get_day_of_year (today) - g_date_time_get_day_of_year (then) +
+             365 * (g_date_time_get_year (today) - g_date_time_get_year (then));
+  if (days <= 0) return g_strdup ("today");
+  if (days == 1) return g_strdup ("yesterday");
+  return g_date_time_format (then, "%-d %b");
+}
+
+static gint64
+now_for (JsonObject *sync)
+{
+  gint64 fixed = num (sync, "now", 0);
+  return fixed > 0 ? fixed : g_get_real_time () / G_USEC_PER_SEC;
+}
+
+char *
+cc_Suno_sync_app_line (JsonObject *app, gint64 now)
+{
+  g_autofree char *size = cc_Suno_sync_size (num (app, "size", 0));
+  const char *state = str (app, "state");
+  gint64 last = num (app, "last_synced", 0);
+  if (flag (app, "uses_api", FALSE)) return g_strdup_printf ("%s · its own sync", size);
+  if (!flag (app, "enabled", TRUE)) return g_strdup_printf ("%s · not syncing", size);
+  if (g_strcmp0 (state, "restoring") == 0) return g_strdup_printf ("%s · bringing over its data", size);
+  if (g_strcmp0 (state, "synced") == 0 && last > 0)
+    {
+      g_autofree char *when = cc_Suno_sync_when (last, now, TRUE);
+      return g_strdup_printf ("%s · %s", size, when);
+    }
+  return g_strdup_printf ("%s · syncs when closed", size);
+}
+
+guint
+cc_Suno_sync_count_words (const char *text)
+{
+  guint count = 0;
+  gboolean in = FALSE;
+  for (const char *p = text ? text : ""; *p; p = g_utf8_next_char (p))
+    {
+      gunichar c = g_utf8_get_char (p);
+      gboolean letter = g_unichar_isalpha (c);
+      if (letter && !in) count++;
+      in = letter;
+    }
+  return count;
+}
+
+static JsonObject *
+sync_of (View *v)
+{
+  return cc_Suno_sync_data (cc_Suno_fixture_get_data (v->model));
+}
+
+static gboolean
+live (View *v)
+{
+  return cc_Suno_fixture_is_live (v->model);
+}
+
+static JsonObject *
+this_device (JsonObject *sync)
+{
+  JsonArray *devices = arr (sync, "devices");
+  for (guint i = 0; devices && i < json_array_get_length (devices); i++)
+    {
+      JsonObject *d = json_array_get_object_element (devices, i);
+      if (flag (d, "this_device", FALSE)) return d;
+    }
+  return NULL;
+}
+
+/* "ThinkPad": what this device is called in Sync. */
+static const char *
+device_name (JsonObject *sync)
+{
+  const char *name = str (this_device (sync), "name");
+  if (name && *name) return name;
+  name = str (cc_Suno_sync_state (sync), "device_name");
+  return name && *name ? name : "device";
+}
