+wrap (GtkWidget *l)
+{
+  gtk_label_set_wrap (GTK_LABEL (l), TRUE);
+  gtk_label_set_wrap_mode (GTK_LABEL (l), PANGO_WRAP_WORD_CHAR);
+  gtk_label_set_max_width_chars (GTK_LABEL (l), 1);
+  gtk_widget_set_hexpand (l, TRUE);
+  return l;
+}
