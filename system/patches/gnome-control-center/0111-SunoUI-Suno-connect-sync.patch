+/* The page's view: on its root box (v->root), an ancestor of every row. */
+static View *
+view_of (GtkWidget *w)
+{
+  for (; w; w = gtk_widget_get_parent (w))
+    {
+      View *v = g_object_get_data (G_OBJECT (w), "cf-view");
+      if (v) return v;
+    }
+  return NULL;
+}
+
+static GtkWindow *
+window_of (GtkWidget *w)
+{
+  GtkRoot *root = w ? gtk_widget_get_root (w) : NULL;
+  return GTK_IS_WINDOW (root) ? GTK_WINDOW (root) : NULL;
+}
+
+/* ── A whole-row switch (v70 rSw) whose words are widgets ──────────── */
+typedef void (*Flip) (View *v, GtkWidget *row, gboolean on);
+
+static void
+row_clicked (GtkButton *button, gpointer data)
+{
+  View *v = view_of (GTK_WIDGET (button));
+  GtkWidget *visual = g_object_get_data (G_OBJECT (button), "cf-switch");
+  Flip flip = (Flip) g_object_get_data (G_OBJECT (button), "cs-flip");
+  if (!v || !visual || !flip || v->rendering) return;
+  gboolean on = !gtk_switch_get_active (GTK_SWITCH (visual));
+  gtk_switch_set_active (GTK_SWITCH (visual), on);
+  gtk_accessible_update_state (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_STATE_CHECKED,
+                               on ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+  flip (v, GTK_WIDGET (button), on);
+}
+
+static GtkWidget *
+switch_button (const char *title, gboolean on, Flip flip, const char *name)
+{
+  GtkWidget *visual = Suno_switch_new (FALSE);
+  GtkWidget *button = g_object_new (GTK_TYPE_BUTTON, "accessible-role", GTK_ACCESSIBLE_ROLE_SWITCH, NULL);
+  gtk_switch_set_active (GTK_SWITCH (visual), on);
+  gtk_widget_set_valign (visual, GTK_ALIGN_CENTER);
+  gtk_widget_set_can_target (visual, FALSE);
+  gtk_widget_set_can_focus (visual, FALSE);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  gtk_accessible_update_state (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_STATE_CHECKED,
+                               on ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+  g_object_set_data (G_OBJECT (button), "cf-switch", visual);
+  g_object_set_data (G_OBJECT (button), "cs-flip", (gpointer) flip);
+  g_signal_connect (button, "clicked", G_CALLBACK (row_clicked), NULL);
+  if (name) gtk_widget_set_name (button, name);
+  return button;
+}
