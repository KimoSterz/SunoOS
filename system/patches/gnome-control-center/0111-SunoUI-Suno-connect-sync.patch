+static GtkWidget *
+label (const char *text, const char *cls)
+{
+  GtkWidget *l = gtk_label_new (text);
+  gtk_label_set_xalign (GTK_LABEL (l), 0);
+  if (cls) gtk_widget_add_css_class (l, cls);
+  return l;
+}
