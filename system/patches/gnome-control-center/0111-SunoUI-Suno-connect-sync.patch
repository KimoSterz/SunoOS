+static void show_new_key_clicked (GtkButton *button, View *v);
+
+static GtkWidget *
+hero (View *v, JsonObject *sync)
+{
+  JsonObject *st = cc_Suno_sync_state (sync), *storage = obj (st, "storage");
+  Look look = look_for (sync, now_for (sync));
+  GtkWidget *grid = gtk_grid_new ();
+  gtk_widget_add_css_class (grid, "cs-hero");
+  gtk_grid_set_column_spacing (GTK_GRID (grid), 14);
+  gtk_grid_set_row_spacing (GTK_GRID (grid), 4);
+  GtkWidget *tile = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  gtk_widget_add_css_class (tile, "cs-st");
+  gtk_widget_set_valign (tile, GTK_ALIGN_CENTER);
+  GtkWidget *g = glyph (look.icon, *look.cls ? look.cls : NULL);
+  gtk_widget_set_halign (tile, GTK_ALIGN_START);
+  gtk_widget_set_hexpand (tile, FALSE);
+  gtk_widget_set_size_request (tile, 44, 44);
+  gtk_widget_set_halign (g, GTK_ALIGN_CENTER);
+  gtk_widget_set_valign (g, GTK_ALIGN_CENTER);
+  gtk_box_set_homogeneous (GTK_BOX (tile), TRUE);
+  gtk_box_append (GTK_BOX (tile), g);
+  gtk_grid_attach (GTK_GRID (grid), tile, 0, 0, 1, 2);
+  GtkWidget *title = label (look.title, "cs-state");
+  gtk_widget_set_valign (title, GTK_ALIGN_END);
+  gtk_widget_set_hexpand (title, TRUE);
+  gtk_grid_attach (GTK_GRID (grid), title, 1, 0, 1, 1);
+  GtkWidget *line = label (look.line, "cs-line");
+  gtk_widget_set_valign (line, GTK_ALIGN_START);
+  gtk_label_set_ellipsize (GTK_LABEL (line), PANGO_ELLIPSIZE_END);
+  gtk_grid_attach (GTK_GRID (grid), line, 1, 1, 1, 1);
+  g_free (look.line);
+  gboolean on = st && flag (st, "enabled", TRUE) && member (st) && g_strcmp0 (str (st, "state"), "off") != 0;
+  if (new_key (st))
+    {
+      /* S1: Show new key… (polkit, RevealRecoveryKey) opens the new words; the switch waits until they're kept. */
+      GtkWidget *show = Suno_text_button_new ("Show new key…", "key-round", "fill");
+      Suno_text_button_set_small (GTK_BUTTON (show), TRUE);
+      gtk_widget_set_name (show, "cs-show-new-key");
+      gtk_widget_set_valign (show, GTK_ALIGN_CENTER);
+      cc_Suno_view_bind_command (v, show, G_CALLBACK (show_new_key_clicked));
+      gtk_grid_attach (GTK_GRID (grid), show, 2, 0, 1, 2);
+    }
+  else if (removed (st))
+    {
+      /* review 1: a removed device signs in to Suno Connect again, then joins; no switch. */
+      GtkWidget *again = Suno_text_button_new ("Sign in again…", "log-in", "fill");
+      Suno_text_button_set_small (GTK_BUTTON (again), TRUE);
+      gtk_widget_set_name (again, "cs-sign-in");
+      gtk_widget_set_valign (again, GTK_ALIGN_CENTER);
+      cc_Suno_view_bind_command (v, again, G_CALLBACK (sign_in_clicked));
+      gtk_grid_attach (GTK_GRID (grid), again, 2, 0, 1, 2);
+    }
+  else
+    {
+      GtkWidget *sw = switch_button ("Sync", on, NULL, "cs-main");
+      g_signal_handlers_disconnect_by_func (sw, row_clicked, NULL);
+      g_signal_connect (sw, "clicked", G_CALLBACK (main_switch_clicked), NULL);
+      gtk_button_set_child (GTK_BUTTON (sw), g_object_get_data (G_OBJECT (sw), "cf-switch"));
+      gtk_widget_add_css_class (sw, "cs-switch");
+      gtk_widget_set_valign (sw, GTK_ALIGN_CENTER);
+      gtk_grid_attach (GTK_GRID (grid), sw, 2, 0, 1, 2);
+    }
+  gint64 used = num (storage, "used", 0), quota = num (storage, "quota", 0);
+  if (on && quota > 0 && !new_key (st))
+    {
+      GtkWidget *quota_box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+      gtk_widget_add_css_class (quota_box, "cs-quota");
+      GtkWidget *bar = Suno_progress_line_new (CLAMP ((double) used / quota, 0, 1), "well", NULL);
+      Suno_progress_line_set_label (SUNO_PROGRESS_LINE (bar), "Sync storage");
+      gtk_box_append (GTK_BOX (quota_box), bar);
+      GtkWidget *words = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+      gtk_widget_add_css_class (words, "cs-qwords");
+      g_autofree char *u = cc_Suno_sync_size (used), *q = cc_Suno_sync_size (quota);
+      g_autofree char *of = g_strdup_printf ("%s of %s", u, q);
+      GtkWidget *left = label (of, NULL);
+      gtk_widget_set_hexpand (left, TRUE);
+      gtk_box_append (GTK_BOX (words), left);
+      /* By kind (CFSYNC.state.storage.kinds [[name, bytes]...]); without it, what the apps hold. Not on a phone. */
+      if (!v->phone)
+        {
+          GString *kinds = g_string_new (NULL);
+          JsonArray *list = arr (storage, "kinds");
+          for (guint i = 0; list && i < json_array_get_length (list); i++)
+            {
+              JsonArray *k = json_array_get_array_element (list, i);
+              g_autofree char *size = cc_Suno_sync_size (json_array_get_int_element (k, 1));
+              g_string_append_printf (kinds, "%s%s %s", i ? " · " : "", json_array_get_string_element (k, 0), size);
+            }
+          if (!list && apps_bytes (sync) > 0)
+            {
+              g_autofree char *size = cc_Suno_sync_size (apps_bytes (sync));
+              g_string_append_printf (kinds, "Apps %s", size);
+            }
+          GtkWidget *right = label (kinds->str, NULL);
+          gtk_label_set_xalign (GTK_LABEL (right), 1);
+          gtk_label_set_ellipsize (GTK_LABEL (right), PANGO_ELLIPSIZE_START);
+          gtk_box_append (GTK_BOX (words), right);
+          g_string_free (kinds, TRUE);
+        }
+      gtk_box_append (GTK_BOX (quota_box), words);
+      gtk_grid_attach (GTK_GRID (grid), quota_box, 0, 2, 3, 1);
+    }
+  return grid;
+}
