diff --git a/shell/cc-Suno-live-sync.c b/shell/cc-Suno-live-sync.c
new file mode 100644
index 0000000..f7051d3
--- /dev/null
+++ b/shell/cc-Suno-live-sync.c
@@ -0,0 +1,238 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live Suno Connect Sync (ADR-054): org.projectSuno.ConnectSync1 on the
+ * session bus (Suno-connect-syncd) published as CFSYNC (cc-Suno-sync.h).
+ *   GetState, ListApps, ListDevices,
+ *   ListConflicts                     read at start, again on StateChanged
+ *                                     and AppsChanged; an unchanged reading draws nothing
+ * Writes: "syncOn" SetEnabled, "syncCat" SetCategory, "syncApp" SetAppEnabled.
+ * Without the service CFSYNC.state is null and the page says so. */
+#include "cc-Suno-live.h"
+#include "cc-Suno-sync.h"
+
+#define ADAPTER "sync"
+
+typedef struct {
+  CcSunoFixture *model;
+  GCancellable *cancel;
+  GDBusConnection *bus;
+  guint state_signal, apps_signal;
+  gboolean ready, reading, again;
+  guint pending;
+  /* Never changed once published: CFSYNC shares them. */
+  JsonNode *state, *apps, *devices, *conflicts;
+  char *error;
+  char *published;  /* what was published last: the same reading again redraws nothing */
+} Sync;
+
+static void read_all (Sync *s);
+
+static void
+publish (Sync *s)
+{
+  g_autoptr (JsonObject) sync = json_object_new ();
+  json_object_set_member (sync, "state", s->state ? json_node_ref (s->state) : json_node_init_null (json_node_alloc ()));
+  json_object_set_member (sync, "apps", s->apps ? json_node_ref (s->apps) : json_node_init_array (json_node_alloc (), json_array_new ()));
+  json_object_set_member (sync, "devices", s->devices ? json_node_ref (s->devices) : json_node_init_array (json_node_alloc (), json_array_new ()));
+  if (s->conflicts) json_object_set_member (sync, "conflicts", json_node_ref (s->conflicts));
+  if (s->error) json_object_set_string_member (sync, "error", s->error);
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), sync);
+  g_autofree char *text = json_to_string (node, FALSE);
+  if (s->ready && g_strcmp0 (text, s->published) == 0) return;
+  g_free (s->published);
+  s->published = g_steal_pointer (&text);
+  cc_Suno_fixture_publish_data (s->model, "CFSYNC", node);
+  if (!s->ready)
+    {
+      s->ready = TRUE;
+      cc_Suno_live_ready (s->model, ADAPTER);
+    }
+}
+
+typedef struct { Sync *s; JsonNode **slot; JsonNodeType want; } Read;
+
+static void
+got (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Read *read = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) { g_free (read); return; }
+  Sync *s = read->s;
+  JsonNode *node = NULL;
+  if (reply)
+    {
+      const char *text = NULL;
+      g_variant_get (reply, "(&s)", &text);
+      node = json_from_string (text, NULL);
+      if (node && JSON_NODE_TYPE (node) != read->want) g_clear_pointer (&node, json_node_unref);
+    }
+  if (read->slot == &s->state)
+    {
+      g_clear_pointer (&s->error, g_free);
+      if (!reply)
+        {
+          g_autofree char *remote = g_dbus_error_get_remote_error (error);
+          g_dbus_error_strip_remote_error (error);
+          s->error = g_strdup (remote && g_str_has_suffix (remote, ".ServiceUnknown") ? "unavailable" : error->message);
+        }
+    }
+  if (node || read->slot == &s->state)
+    {
+      g_clear_pointer (read->slot, json_node_unref);
+      *read->slot = node;
+    }
+  g_free (read);
+  if (--s->pending) return;
+  s->reading = FALSE;
+  publish (s);
+  if (s->again)
+    {
+      s->again = FALSE;
+      read_all (s);
+    }
+}
+
+static void
+ask (Sync *s, const char *method, JsonNode **slot, JsonNodeType want)
+{
+  Read *read = g_new0 (Read, 1);
+  read->s = s;
+  read->slot = slot;
+  read->want = want;
+  s->pending++;
+  /* ListDevices asks the Hub: give it longer than the local answers. */
+  g_dbus_connection_call (s->bus, CC_SUNO_SYNC_BUS, CC_SUNO_SYNC_PATH, CC_SUNO_SYNC_IFACE, method, NULL,
+                          G_VARIANT_TYPE ("(s)"), G_DBUS_CALL_FLAGS_NONE, 30000, s->cancel, got, read);
+}
+
+static void
+read_all (Sync *s)
+{
+  if (s->reading) { s->again = TRUE; return; }
+  s->reading = TRUE;
+  ask (s, "GetState", &s->state, JSON_NODE_OBJECT);
+  ask (s, "ListApps", &s->apps, JSON_NODE_ARRAY);
+  ask (s, "ListDevices", &s->devices, JSON_NODE_ARRAY);
+  ask (s, "ListConflicts", &s->conflicts, JSON_NODE_OBJECT);
+}
+
+static void
+changed (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *signal,
+         GVariant *parameters, gpointer data)
+{
+  read_all (data);
+}
+
+static void
+call_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Sync *s = data;
+  if (!reply)
+    {
+      g_dbus_error_strip_remote_error (error);
+      cc_Suno_fixture_report_write_error (s->model, error);
+    }
+  read_all (s);
+}
+
+static gboolean
+member_bool (JsonObject *o, const char *name, gboolean *out)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  if (!n || !JSON_NODE_HOLDS_VALUE (n) || json_node_get_value_type (n) != G_TYPE_BOOLEAN) return FALSE;
+  *out = json_node_get_boolean (n);
+  return TRUE;
+}
+
+static gboolean
+sync_write (gpointer state, const char *key, JsonNode *value, GError **error)
+{
+  Sync *s = state;
+  JsonObject *o = value && JSON_NODE_HOLDS_OBJECT (value) ? json_node_get_object (value) : NULL;
+  gboolean on = FALSE;
+  const char *method;
+  GVariant *args;
+  if (g_str_equal (key, "syncOn"))
+    {
+      if (!value || !JSON_NODE_HOLDS_VALUE (value) || json_node_get_value_type (value) != G_TYPE_BOOLEAN) goto bad;
+      method = "SetEnabled";
+      on = json_node_get_boolean (value);
+      args = g_variant_new ("(b)", on);
+    }
+  else if (g_str_equal (key, "syncCat") || g_str_equal (key, "syncApp"))
+    {
+      gboolean cat = g_str_equal (key, "syncCat");
+      const char *what = o ? json_object_get_string_member_with_default (o, cat ? "category" : "app", NULL) : NULL;
+      if (!what || !*what || !member_bool (o, "on", &on)) goto bad;
+      method = cat ? "SetCategory" : "SetAppEnabled";
+      args = g_variant_new ("(sb)", what, on);
+    }
+  else
+    return FALSE;
+  if (!s->bus)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "Sync isn’t running");
+      return FALSE;
+    }
+  /* SetEnabled(false) asks for the password (polkit): no timeout while it does. */
+  g_dbus_connection_call (s->bus, CC_SUNO_SYNC_BUS, CC_SUNO_SYNC_PATH, CC_SUNO_SYNC_IFACE, method, args, NULL,
+                          G_DBUS_CALL_FLAGS_ALLOW_INTERACTIVE_AUTHORIZATION, G_MAXINT, s->cancel, call_done, s);
+  return TRUE;
+bad:
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "%s: not a Sync change", key);
+  return FALSE;
+}
+
+static gpointer
+sync_start (CcSunoFixture *model)
+{
+  Sync *s = g_new0 (Sync, 1);
+  s->model = model;
+  s->cancel = g_cancellable_new ();
+  s->bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  if (!s->bus)
+    {
+      s->error = g_strdup ("unavailable");
+      publish (s);
+      return s;
+    }
+  cc_Suno_fixture_own_key (model, "syncOn");
+  cc_Suno_fixture_own_key (model, "syncCat");
+  cc_Suno_fixture_own_key (model, "syncApp");
+  /* JoinChanged belongs to the join sheet (and comes with every GetJoin): the page reads again on these two. */
+  for (guint i = 0; i < 2; i++)
+    {
+      const char *names[] = { "StateChanged", "AppsChanged" };
+      guint *slots[] = { &s->state_signal, &s->apps_signal };
+      *slots[i] = g_dbus_connection_signal_subscribe (s->bus, CC_SUNO_SYNC_BUS, CC_SUNO_SYNC_IFACE, names[i], CC_SUNO_SYNC_PATH,
+                                                      NULL, G_DBUS_SIGNAL_FLAGS_NONE, changed, s, NULL);
+    }
+  read_all (s);
+  return s;
+}
+
+static void
+sync_stop (gpointer state)
+{
+  Sync *s = state;
+  g_cancellable_cancel (s->cancel);
+  if (s->bus)
+    for (guint *id = (guint[]) { s->state_signal, s->apps_signal, 0 }; *id; id++)
+      g_dbus_connection_signal_unsubscribe (s->bus, *id);
+  g_clear_object (&s->bus);
+  g_clear_pointer (&s->state, json_node_unref);
+  g_clear_pointer (&s->apps, json_node_unref);
+  g_clear_pointer (&s->devices, json_node_unref);
+  g_clear_pointer (&s->conflicts, json_node_unref);
+  g_clear_pointer (&s->error, g_free);
+  g_clear_pointer (&s->published, g_free);
+  /* Replies in flight hold s (as cc-Suno-live-applications.c): leak the shell. */
+  g_clear_object (&s->cancel);
+}
+
+const CcSunoAdapter cc_Suno_adapter_sync = {
+  ADAPTER, (const char * const[]) { "sync", "sync-apps", "sync-versions", NULL }, sync_start, sync_write, sync_stop
+};
