+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Suno Connect Sync (ADR-054) in Settings: Suno account › Sync.
+ *
+ * CFSYNC, published by the live adapter "sync" (cc-Suno-live-sync.c) from
+ * org.projectSuno.ConnectSync1 on the session bus, or written in a fixture:
+ *   { "state":   GetState's object, or null (no service / not signed in),
+ *     "error":   why state is null, when it is,
+ *     "apps":    ListApps,
+ *     "devices": ListDevices,
+ *     "now":     fixtures only: the time relative times are measured from,
+ *     "words", "check", "join", "approvers": fixtures only: what the sheets show }
+ * Keys the adapter owns: "syncOn" (bool), "syncCat" {category, on},
+ * "syncApp" {app, on}. Everything that answers with words or needs a sheet
+ * (BeginSetup, FinishSetup, RequestJoin, RevealRecoveryKey, RemoveDevice,
+ * DeleteAppData, ...) is called by the page itself (cc-Suno-view-sync.c). */
+#pragma once
+#include <gio/gio.h>
+#include <json-glib/json-glib.h>
+
+G_BEGIN_DECLS
+
+#define CC_SUNO_SYNC_BUS "org.projectSuno.ConnectSync1"
+#define CC_SUNO_SYNC_PATH "/org/projectSuno/ConnectSync1"
+#define CC_SUNO_SYNC_IFACE "org.projectSuno.ConnectSync1"
+
+/* CFSYNC from a fixture's or the live model's data; NULL when absent. */
+JsonObject *cc_Suno_sync_data (JsonObject *data);
+/* CFSYNC.state, or NULL. */
+JsonObject *cc_Suno_sync_state (JsonObject *sync);
+
+/* "410 MB", "1.8 GB", "5 GB" */
+char *cc_Suno_sync_size (gint64 bytes);
+/* "synced 2 min ago" (@lower, short) or "Synced 2 minutes ago"; @when and @now in seconds. */
+char *cc_Suno_sync_when (gint64 when, gint64 now, gboolean row);
+/* "today", "yesterday", "21 Nov" */
+char *cc_Suno_sync_day (gint64 when, gint64 now);
+/* The words under an app's row: "410 MB · synced 2 min ago". */
+char *cc_Suno_sync_app_line (JsonObject *app, gint64 now);
+/* The words a recovery key's paste field counts ("18 of 24 words"). */
+guint cc_Suno_sync_count_words (const char *text);
+
+G_END_DECLS
