+/* The title line: the name and an optional tag ("This device", "Uses Suno Connect"). */
+static GtkWidget *
+title_line (const char *title, const char *tag, const char *tag_class)
+{
+  GtkWidget *line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+  GtkWidget *t = cf_text (title, "cf-title");
+  Suno_ui_apply_type (t, "row-title");
+  gtk_box_append (GTK_BOX (line), t);
+  if (tag)
+    {
+      GtkWidget *chip = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+      gtk_widget_add_css_class (chip, tag_class);
+      gtk_widget_set_valign (chip, GTK_ALIGN_CENTER);
