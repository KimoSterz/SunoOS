+static GtkWidget *
+sub_label (const char *text)
+{
+  GtkWidget *sub = cf_text (text, "cf-sub");
+  Suno_ui_apply_type_full (sub, "row-subtitle", TRUE);
+  gtk_label_set_wrap (GTK_LABEL (sub), TRUE);
+  return sub;
