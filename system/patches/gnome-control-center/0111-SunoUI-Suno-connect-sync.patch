+
+static GtkWidget *
+app_lead (View *v, JsonObject *app, int size)
+{
+  const char *id = str (app, "app"), *asset = str (app, "asset");
+  if (!live (v) && asset) return cf_lead_image (v, asset);
+  if (!live (v))
+    {
+      /* A fixture app without artwork: its glyph on a tile (cs.js vlic). */
+      GtkWidget *tile = cf_lead_icon (str (app, "glyph") ? str (app, "glyph") : "app-window");
+      gtk_widget_add_css_class (tile, "cs-vlic");
+      if (str (app, "tint")) gtk_widget_add_css_class (tile, str (app, "tint"));
+      return tile;
+    }
+  g_autofree char *desktop = g_strconcat (id, ".desktop", NULL);
+  g_autoptr (GDesktopAppInfo) info = id ? g_desktop_app_info_new (desktop) : NULL;
+  GIcon *icon = info ? g_app_info_get_icon (G_APP_INFO (info)) : NULL;
+  if (!icon) return cf_lead_icon ("app-window");
+  GtkWidget *image = gtk_image_new_from_gicon (icon);
+  gtk_image_set_pixel_size (GTK_IMAGE (image), size);
+  gtk_widget_add_css_class (image, "cs-appicon");
+  gtk_widget_set_valign (image, GTK_ALIGN_CENTER);
+  return image;
+}
