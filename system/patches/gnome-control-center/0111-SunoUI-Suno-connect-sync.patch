+  gtk_box_append (GTK_BOX (trail), sw);
+  gtk_box_append (GTK_BOX (trail), cf_chevron ());
+  GtkWidget *row = cf_row (card, cf_lead_icon ("app-window"), "App data", line, trail, TRUE);
+  gtk_widget_set_name (row, "cf-go-sync-apps");
+  cc_Suno_view_bind_navigation (v, row, "sync-apps");
+}
+
+/* Fixture capture of the hero states (SUNO_SETTINGS_SYNC_STATE=on|off|waiting|removed|newkey, SUNO_SETTINGS_SYNC_HELD=N):
+ * the fixture's own CFSYNC, changed once. */
+static void
+fixture_state (View *v, JsonObject *sync)
+{
+  const char *want = g_getenv ("SUNO_SETTINGS_SYNC_STATE");
+  JsonObject *st = cc_Suno_sync_state (sync);
+  if (live (v) || !want || !st || json_object_has_member (sync, "cs-variant")) return;
+  json_object_set_boolean_member (sync, "cs-variant", TRUE);
+  const char *held = g_getenv ("SUNO_SETTINGS_SYNC_HELD");
+  if (held) json_object_set_int_member (st, "join_requests_held", g_ascii_strtoll (held, NULL, 10));
+  if (g_str_equal (want, "on")) return;
+  if (g_str_equal (want, "newkey"))
+    {
+      JsonObject *attention = json_object_new ();
+      json_object_set_string_member (attention, "reason", "new_recovery_key");
+      json_object_set_int_member (attention, "at", now_for (sync) - 3600);
+      json_object_set_string_member (st, "state", "attention");
+      json_object_set_object_member (st, "attention", attention);
+      return;
+    }
+  json_object_set_int_member (st, "devices", 2);
+  JsonObject *me = this_device (sync);
+  if (me) json_object_set_string_member (me, "state", "pending");
+  json_object_set_boolean_member (st, "member", FALSE);
+  json_object_set_string_member (st, "state", g_str_equal (want, "waiting") ? "joining" : g_str_equal (want, "off") ? "off" : "attention");
+  if (g_str_equal (want, "removed"))
+    {
+      JsonObject *attention = json_object_new ();
+      json_object_set_string_member (attention, "reason", "revoked");
+      json_object_set_string_member (attention, "from_name", "Dell XPS 14");
+      json_object_set_int_member (attention, "at", now_for (sync) - 3600);
+      json_object_set_object_member (st, "attention", attention);
+    }
+}
+
+static gboolean capture_scroll (gpointer data);
+
+void
+cc_Suno_view_sync_render (View *v)
+{
+  JsonObject *sync = sync_of (v);
+  fixture_state (v, sync);
+  JsonObject *st = cc_Suno_sync_state (sync);
+  gint64 now = now_for (sync);
+  JsonArray *devices = arr (sync, "devices");
+  guint members = 0;
+  for (guint i = 0; devices && i < json_array_get_length (devices); i++)
+    members += g_strcmp0 (str (json_array_get_object_element (devices, i), "state"), "member") == 0 ||
+               !str (json_array_get_object_element (devices, i), "state");
+  members = MAX (members, (guint) num (st, "devices", 0));
+  g_autofree char *meta = members && !removed (st) ? g_strdup_printf ("%u %s · end-to-end encrypted", members, members == 1 ? "device" : "devices")
+                                                   : g_strdup ("End-to-end encrypted");
+  cf_header (v, "Sync", meta, NULL);
+  if (!st)
+    {
+      gboolean missing = g_strcmp0 (str (sync, "error"), "unavailable") == 0;
+      cf_off_hero (v, "cloud-off", missing ? "Sync isn’t available" : "Sign in to Suno Connect",
+                   missing ? "Suno Connect Sync isn’t installed on this device" : "Sync keeps your devices in step once you’re signed in", NULL, NULL);
+      return;
+    }
+  GtkWidget *top = cf_hero (v, hero (v, sync), "cs-hero");
+  lock_line (v);
+  JsonObject *cats = obj (st, "categories");
+  GtkBox *card = cf_group (v, "What syncs", NULL);
+  GtkWidget *keep = wrap (label (KEEP_NOTE, "cs-note"));
+  gtk_box_append (GTK_BOX (gtk_widget_get_parent (GTK_WIDGET (card))), keep);
+  for (guint i = 0; i < G_N_ELEMENTS (categories); i++)
+    {
+      if (g_str_equal (categories[i].key, "app_data")) app_data_row (v, card, sync, cats);
+      else category_row (card, cats, i);
+    }
+  g_autoptr (GPtrArray) apps = apps_sorted (sync);
+  if (apps->len)
+    {
+      card = cf_group (v, "App data", NULL);
+      for (guint i = 0; i < apps->len && i < 4; i++) app_row (v, card, apps->pdata[i], now);
+      g_autofree char *all = g_strdup_printf ("All %u apps", apps->len);
+      cf_nv (v, card, "sync-apps", all, NULL, NULL, NULL);
+    }
+  if (member (st) && devices && json_array_get_length (devices))
+    {
+      card = cf_group (v, "Devices", NULL);
+      gtk_widget_add_css_class (gtk_widget_get_parent (GTK_WIDGET (card)), "cs-dev");
+      for (guint i = 0; i < json_array_get_length (devices); i++)
+        {
+          JsonObject *d = json_array_get_object_element (devices, i);
+          const char *klass = str (d, "class"), *name = str (d, "name") ? str (d, "name") : "Device";
+          gboolean me = flag (d, "this_device", FALSE);
+          gint64 last = num (d, "last_sync", 0);
+          g_autofree char *when = last > 0 ? cc_Suno_sync_when (last, now, TRUE) : g_strdup ("not synced yet");
+          g_autofree char *line = g_strdup_printf ("%s · %s", class_word (klass), when);
+          GtkWidget *control = NULL;
+          if (!me)
+            {
+              control = cf_button ("Remove…", "fill", TRUE);
+              g_object_set_data_full (G_OBJECT (control), "cs-device", g_strdup (str (d, "device")), g_free);
+              g_object_set_data_full (G_OBJECT (control), "cs-name", g_strdup (name), g_free);
+              g_object_set_data (G_OBJECT (control), "cs-icon", (gpointer) class_icon (klass));
+              cc_Suno_view_bind_command (v, control, G_CALLBACK (remove_clicked));
+            }
+          GtkWidget *row = custom_row (card, cf_lead_icon (class_icon (klass)), title_line (name, me ? "This device" : NULL, "cs-me"),
+                                       sub_label (line), control, NULL);
+          g_autofree char *row_name = g_strconcat ("cs-device-", str (d, "device") ? str (d, "device") : "", NULL);
+          gtk_widget_set_name (row, row_name);
+        }
+      /* B2: join requests past the cap wait their turn, without a code or a card; one quiet line says so. */
+      gint64 held = num (st, "join_requests_held", 0);
+      if (held > 0)
+        {
+          g_autofree char *words = g_strdup_printf ("%" G_GINT64_FORMAT " more request%s to join %s waiting. Each gets its code after you answer the one before.",
+                                                    held, held == 1 ? "" : "s", held == 1 ? "is" : "are");
+          GtkWidget *note = wrap (label (words, "cs-note"));
+          gtk_widget_add_css_class (note, "cs-held");
+          gtk_box_append (GTK_BOX (gtk_widget_get_parent (GTK_WIDGET (card))), note);
+        }
+    }
+  if (member (st))
+    {
+      card = cf_group (v, "Recovery key", NULL);
+      gint64 saved_at = num (obj (st, "recovery"), "saved_at", 0);
+      g_autofree char *line = NULL;
+      if (saved_at > 0)
+        {
+          g_autoptr (GDateTime) t = g_date_time_new_from_unix_local (saved_at);
+          g_autofree char *day = g_date_time_format (t, "%-d %b");
+          line = g_strdup_printf ("Saved %s · the only way back if you lose every device", day);
+        }
+      if (new_key (st))
+        {
+          gint64 at = num (obj (st, "attention"), "at", 0);
+          g_autofree char *day = at > 0 ? cc_Suno_sync_day (at, now) : NULL;
+          g_free (line);
+          line = day ? g_strdup_printf ("Replaced %s%s · not saved yet", g_ascii_isdigit (*day) ? "on " : "", day)
+                     : g_strdup ("Replaced · not saved yet");
+        }
+      GtkWidget *show = cf_button (new_key (st) ? "Show new key…" : "Show…", "fill", TRUE);
+      gtk_widget_set_name (show, new_key (st) ? "cs-show-new-key-row" : "cs-show-key");
+      cc_Suno_view_bind_command (v, show, new_key (st) ? G_CALLBACK (show_new_key_clicked) : G_CALLBACK (show_key_clicked));
+      cf_row (card, cf_lead_icon ("key-round"), "Recovery key", line ? line : "The only way back if you lose every device", show, FALSE);
+    }
+  if (!live (v) && g_getenv ("SUNO_SETTINGS_SCROLL"))
+    for (guint ms = 400; ms <= 1600; ms += 600)
+      g_timeout_add (ms, capture_scroll, g_object_ref (v->body));
+  /* review 1: a removed device's page under the hero is there to read, dimmed and inert. */
+  for (GtkWidget *w = removed (st) ? gtk_widget_get_next_sibling (top) : NULL; w; w = gtk_widget_get_next_sibling (w))
+    {
+      gtk_widget_add_css_class (w, "cs-inert");
+      gtk_widget_set_opacity (w, 0.45);
+      gtk_widget_set_can_target (w, FALSE);
+      gtk_widget_set_can_focus (w, FALSE);
+    }
+  /* Signed in to Suno Connect again after Sign in again…: straight on to joining. */
+  if (live (v) && g_object_get_data (G_OBJECT (v->root), "cs-after-sign-in") && !removed (st) && !member (st) && set_up (st))
+    {
+      g_object_set_data (G_OBJECT (v->root), "cs-after-sign-in", NULL);
+      turn_on (v);
+    }
+  /* Asked for by the Shell (Join again) or a fixture: open the sheet once. */
+  const char *want = g_object_get_data (G_OBJECT (v->root), "cs-open");
+  if (want)
+    {
+      g_autofree char *what = g_strdup (want);
+      g_object_set_data (G_OBJECT (v->root), "cs-open", NULL);
+      if (g_str_has_prefix (what, "remove:"))
+        {
+          /* The recovery-key banner's Remove…: the Devices row's own confirm. */
+          for (guint i = 0; devices && i < json_array_get_length (devices); i++)
+            {
+              JsonObject *d = json_array_get_object_element (devices, i);
+              if (g_strcmp0 (str (d, "device"), what + 7) != 0 || flag (d, "this_device", FALSE)) continue;
+              GtkWidget *b = cf_button ("Remove…", "fill", TRUE);
+              g_object_set_data_full (G_OBJECT (b), "cs-device", g_strdup (str (d, "device")), g_free);
+              g_object_set_data_full (G_OBJECT (b), "cs-name", g_strdup (str (d, "name")), g_free);
+              g_object_set_data (G_OBJECT (b), "cs-icon", (gpointer) class_icon (str (d, "class")));
+              remove_clicked (GTK_BUTTON (g_object_ref_sink (b)), v);
+              g_object_unref (b);
+            }
+        }
+      else if (g_str_equal (what, "newkey"))
+        {
+          /* The island's Show new key…: the password, then the new words. */
+          if (new_key (st)) show_new_key_clicked (NULL, v);
+        }
+      else if (!member (st) || !live (v)) turn_on (v);
+    }
+}
+
+/* Fixture capture: the page scrolled by SUNO_SETTINGS_SCROLL pixels once laid out. */
+static gboolean
+capture_scroll (gpointer data)
+{
+  GtkWidget *body = data;
+  GtkWidget *sw = gtk_widget_get_ancestor (body, GTK_TYPE_SCROLLED_WINDOW);
+  if (sw)
+    {
+      GtkAdjustment *adj = gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (sw));
+      gtk_adjustment_set_value (adj, g_ascii_strtod (g_getenv ("SUNO_SETTINGS_SCROLL"), NULL));
+    }
+  g_object_unref (body);
+  return G_SOURCE_REMOVE;
+}
+
+/* ── Settings › Suno Connect › Sync › {App}: the two copies after a conflict (review 1, ?page=versions) ── */
+static JsonObject *
+app_of (JsonObject *sync, const char *id)
+{
+  JsonArray *apps = arr (sync, "apps");
+  for (guint i = 0; apps && id && i < json_array_get_length (apps); i++)
+    if (g_strcmp0 (str (json_array_get_object_element (apps, i), "app"), id) == 0) return json_array_get_object_element (apps, i);
+  return NULL;
+}
+
+/* "Changed today at 9:41" */
+static char *
+changed (gint64 at, gint64 now)
+{
+  g_autoptr (GDateTime) t = g_date_time_new_from_unix_local (at);
+  g_autofree char *day = cc_Suno_sync_day (at, now);
+  g_autofree char *time = g_date_time_format (t, "%-H:%M");
+  return g_strdup_printf ("Changed %s at %s", day, time);
+}
+
+static void
+use_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  GtkWidget *root = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = finish (source, result, &error);
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (v && !reply) cc_Suno_view_report_error (v, error);
+  else if (v) Suno_toast_show (v->root, "Using the other copy", "success");
+  if (v) cc_Suno_view_queue_refresh (v);
+  g_object_unref (root);
+}
+
+static void
+use_confirmed (SunoDestructiveDialog *dialog, gboolean checked, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  const char *app = g_object_get_data (G_OBJECT (dialog), "cs-app"), *version = g_object_get_data (G_OBJECT (dialog), "cs-label");
+  if (!v || !live (v) || !app || !version) return;
+  sync_call ("UseVersion", g_variant_new ("(ss)", app, version), NULL, NULL, use_done, g_object_ref (root));
+}
+
+static void
+use_clicked (GtkButton *button, View *v)
+{
+  const char *who = g_object_get_data (G_OBJECT (button), "cs-who");
+  g_autofree char *title = g_strcmp0 (who, device_name (sync_of (v))) == 0
+    ? g_strdup ("Use the earlier copy?") : g_strdup_printf ("Use the copy from %s?", who);
+  g_autofree char *body = g_strdup_printf ("This %s’s copy stays here for 30 days.", device_name (sync_of (v)));
+  SunoDestructiveDialog *dialog = Suno_destructive_dialog_ask (v->root, title, body, "Use this one", "history", NULL);
+  g_object_set_data_full (G_OBJECT (dialog), "cs-app", g_strdup (g_object_get_data (G_OBJECT (button), "cs-app")), g_free);
+  g_object_set_data_full (G_OBJECT (dialog), "cs-label", g_strdup (g_object_get_data (G_OBJECT (button), "cs-label")), g_free);
+  g_signal_connect_object (dialog, "confirmed", G_CALLBACK (use_confirmed), v->root, 0);
+}
+
+void
+cc_Suno_view_sync_versions_render (View *v)
+{
+  JsonObject *sync = sync_of (v);
+  const char *id = g_object_get_data (G_OBJECT (v->root), "cs-versions-app");
+  if (!id) id = g_getenv ("SUNO_SETTINGS_SYNC_APP");
+  JsonObject *app = app_of (sync, id);
+  gint64 now = now_for (sync);
+  g_autofree char *name = app ? app_name (v, app) : g_strdup (id ? id : "App");
+  g_autofree char *line = app ? cc_Suno_sync_app_line (app, now) : NULL;
+  cf_header (v, name, line, NULL);
+  JsonArray *kept = arr (obj (obj (sync, "conflicts"), "kept"), id ? id : "");
+  JsonArray *recent = arr (obj (sync, "conflicts"), "recent");
+  gint64 mine = 0;
+  for (guint i = 0; recent && i < json_array_get_length (recent); i++)
+    {
+      JsonObject *c = json_array_get_object_element (recent, i);
+      if (g_strcmp0 (str (c, "app"), id) == 0) mine = MAX (mine, num (c, "at", 0));
+    }
+  if (!mine) mine = num (app, "last_synced", 0);
+  GtkBox *card = cf_group (v, "Versions", NULL);
+  JsonObject *me = this_device (sync);
+  g_autofree char *this_one = g_strdup_printf ("This %s", device_name (sync));
+  g_autofree char *mine_line = mine > 0 ? changed (mine, now) : g_strdup ("In use on this device");
+  custom_row (card, cf_lead_icon (class_icon (str (me, "class"))), title_line (this_one, "In use", "cs-me"), sub_label (mine_line), NULL, NULL);
+  for (guint i = 0; kept && i < json_array_get_length (kept); i++)
+    {
+      JsonObject *k = json_array_get_object_element (kept, i);
+      const char *who = str (k, "device") && *str (k, "device") ? str (k, "device") : "another device";
+      /* Using a copy keeps the one it replaces under this device's own name. */
+      gboolean own = g_strcmp0 (who, device_name (sync)) == 0;
+      g_autofree char *from = own ? g_strdup_printf ("Earlier on this %s", who) : g_strdup_printf ("From %s", who);
+      g_autofree char *when = changed (num (k, "at", 0), now);
+      g_autoptr (GDateTime) until = g_date_time_new_from_unix_local (num (k, "kept_until", 0));
+      g_autofree char *until_day = g_date_time_format (until, "%-d %b");
+      g_autofree char *words = g_strdup_printf ("%s · kept until %s", when, until_day);
+      GtkWidget *use = cf_button ("Use this one…", "fill", TRUE);
+      g_object_set_data_full (G_OBJECT (use), "cs-app", g_strdup (id), g_free);
+      g_object_set_data_full (G_OBJECT (use), "cs-label", g_strdup (str (k, "label")), g_free);
+      g_object_set_data_full (G_OBJECT (use), "cs-who", g_strdup (who), g_free);
+      gtk_widget_set_name (use, "cs-use-version");
+      cc_Suno_view_bind_command (v, use, G_CALLBACK (use_clicked));
+      custom_row (card, cf_lead_icon ("laptop"), title_line (from, NULL, NULL), sub_label (words), use, NULL);
+    }
+  g_autofree char *note = g_strdup_printf ("%s changed on two devices before they synced, so both copies are kept. "
+                                           "Using the other one keeps this one here for 30 days.", name);
+  GtkWidget *keep = wrap (label (note, "cs-note"));
+  gtk_box_append (GTK_BOX (gtk_widget_get_parent (GTK_WIDGET (card))), keep);
+  if (app)
+    {
+      card = cf_group (v, NULL, NULL);
+      g_autofree char *title = g_strdup_printf ("Sync %s’s data", name);
+      GtkWidget *button = switch_button (title, flag (app, "enabled", TRUE), flip_app, "cs-app-switch");
+      g_object_set_data_full (G_OBJECT (button), "cs-key", g_strdup (id), g_free);
+      GtkWidget *t = cf_text (title, "cf-title");
+      Suno_ui_apply_type (t, "row-title");
+      custom_row (card, app_lead (v, app, 30), t, NULL, g_object_get_data (G_OBJECT (button), "cf-switch"), button);
+    }
+}
+
+/* Suno account › Sync › App data: every app, biggest first. */
+void
+cc_Suno_view_sync_apps_render (View *v)
+{
+  JsonObject *sync = sync_of (v);
+  g_autoptr (GPtrArray) apps = apps_sorted (sync);
+  g_autofree char *size = cc_Suno_sync_size (apps_storage (sync));
+  g_autofree char *meta = g_strdup_printf ("%u %s · %s", apps->len, apps->len == 1 ? "app" : "apps", size);
+  cf_header (v, "App data", meta, NULL);
+  if (!apps->len) return;
+  GtkBox *card = cf_group (v, NULL, "Turning an app off stops syncing it. What’s on this device stays.");
+  for (guint i = 0; i < apps->len; i++) app_row (v, card, apps->pdata[i], now_for (sync));
+}
+
+/* Suno account: the row to Sync, with its state. */
+gboolean
+cc_Suno_view_sync_row (View *v)
+{
+  JsonObject *sync = sync_of (v);
+  if (!sync) return FALSE;
+  Look look = look_for (sync, now_for (sync));
+  GtkBox *card = cf_group (v, "Suno Connect", NULL);
+  cf_nv (v, card, "sync", "Sync", look.title, NULL, cf_lead_icon ("cloud"));
+  g_free (look.line);
+  return TRUE;
+}
+
+/* The Shell's "Join again" (and a fixture) asks for the sheet with the page. */
+void
+cc_Suno_view_sync_request (GtkWidget *root, const char *what)
+{
+  if (!root || !what) return;
+  if (g_str_has_prefix (what, "versions:"))
+    {
+      g_object_set_data_full (G_OBJECT (root), "cs-versions-app", g_strdup (what + 9), g_free);
+      View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+      if (v) cc_Suno_view_navigate (v, "sync-versions");
+      return;
+    }
+  g_object_set_data_full (G_OBJECT (root), "cs-open", g_strdup (what), g_free);
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (v) cc_Suno_view_queue_refresh (v);
+}
+
+/* Conform capture (fixture only): the sheet alone as the window,
+ * SUNO_SETTINGS_SYNC_SHEET=show|ticked|confirm|join|wait|tampered|enter|key|denied|newkey|newkey-ticked. */
+GtkWidget *
+cc_Suno_view_sync_capture (GtkApplication *app, CcSunoFixture *model, const char *step)
+{
+  JsonObject *sync = cc_Suno_sync_data (cc_Suno_fixture_get_data (model));
+  if (!sync) return NULL;
+  gboolean joining = g_str_equal (step, "join") || g_str_equal (step, "denied") || g_str_equal (step, "wait") || g_str_equal (step, "tampered");
+  Step which = g_str_equal (step, "confirm") ? SHEET_CHECK : joining ? SHEET_JOIN
+             : g_str_equal (step, "enter") ? SHEET_ENTER : g_str_equal (step, "key") ? SHEET_SHOW
+             : g_str_has_prefix (step, "newkey") ? SHEET_NEWKEY : SHEET_KEY;
+  GtkWidget *window = gtk_application_window_new (app);
+  gtk_widget_add_css_class (window, "cs-capture");
+  gtk_window_set_decorated (GTK_WINDOW (window), FALSE);
+  Sheet *s = fixture_sheet (sync, NULL, which);
+  s->ticked = g_str_equal (step, "ticked") || g_str_equal (step, "newkey-ticked");
+  const char *join_state = g_str_equal (step, "denied") ? "denied" : g_str_equal (step, "wait") ? "confirmed"
+                         : g_str_equal (step, "tampered") ? "tampered" : NULL;
+  if (join_state) { g_free (s->join_state); s->join_state = g_strdup (join_state); }
+  JsonArray *typed = arr (sync, "typed");
+  for (guint i = 0; typed && i < 3 && i < json_array_get_length (typed); i++) s->typed[i] = g_strdup (json_array_get_string_element (typed, i));
+  if (which == SHEET_ENTER && str (sync, "entered")) s->entered = g_strdup (str (sync, "entered"));
+  sheet_draw (s);
+  gtk_window_set_child (GTK_WINDOW (window), s->card);
+  g_object_weak_ref (G_OBJECT (window), (GWeakNotify) sheet_free, s);
+  return window;
+}
