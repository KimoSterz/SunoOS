+
+/* A row (cf_row) whose cf-t holds @words instead of a plain title and subtitle. */
+static GtkWidget *
+custom_row (GtkBox *card, GtkWidget *lead, GtkWidget *title, GtkWidget *words, GtkWidget *control, GtkWidget *as_button)
+{
+  GtkWidget *inner = cf_row (NULL, lead, NULL, NULL, control, FALSE);
+  for (GtkWidget *c = gtk_widget_get_first_child (inner); c; c = gtk_widget_get_next_sibling (c))
+    if (gtk_widget_has_css_class (c, "cf-t"))
+      {
+        gtk_box_append (GTK_BOX (c), title);
+        if (words) gtk_box_append (GTK_BOX (c), words);
+      }
+  if (!as_button)
+    {
+      if (card) gtk_box_append (card, inner);
+      return inner;
+    }
+  gtk_widget_remove_css_class (inner, "cf-row");
+  gtk_widget_add_css_class (as_button, "cf-row");
+  gtk_button_set_child (GTK_BUTTON (as_button), inner);
+  if (card) gtk_box_append (card, as_button);
+  return as_button;
+}
