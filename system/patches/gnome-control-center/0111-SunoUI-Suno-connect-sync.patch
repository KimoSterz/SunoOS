diff --git a/shell/test-Suno-connect-sync.c b/shell/test-Suno-connect-sync.c
new file mode 100644
index 0000000..dff3dd9
--- /dev/null
+++ b/shell/test-Suno-connect-sync.c
@@ -0,0 +1,400 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Suno account › Sync (0111).
+ * - words: sizes, relative times, an app's line, the paste field's count;
+ * - live: Settings drawn from a stand-in Suno-connect-syncd
+ *   (org.projectSuno.ConnectSync1) on a private bus. Turning Sync on shows the
+ *   key; Continue waits for the tick; Cancel calls CancelSetup and leaves Sync
+ *   off; three typed words gate Turn on Sync, which calls FinishSetup and
+ *   SetEnabled; a category switch calls SetCategory. */
+#include "cc-Suno-live.h"
+#include "cc-Suno-sync.h"
+#include "cc-Suno-view.h"
+#include <gio/gio.h>
+#include <gtk/gtk.h>
+#include <adwaita.h>
+#include <sys/prctl.h>
+#include <signal.h>
+
+extern const CcSunoAdapter cc_Suno_adapter_sync;
+static gboolean ready;
+void cc_Suno_live_ready (CcSunoFixture *model, const char *adapter) { ready |= g_str_equal (adapter, "sync"); }
+
+#define NOW ((gint64) 1795292580) /* 2026-11-21 20:23 UTC */
+#define MIB ((gint64) 1048576)
+#define GIB (1024 * MIB)
+
+static void
+spin (guint ms)
+{
+  gint64 end = g_get_monotonic_time () + ms * 1000;
+  while (g_get_monotonic_time () < end) g_main_context_iteration (NULL, FALSE);
+}
+
+static void
+test_words (void)
+{
+  g_autofree char *a = cc_Suno_sync_size (410 * MIB), *b = cc_Suno_sync_size ((gint64) (1.8 * GIB)), *c = cc_Suno_sync_size (5 * GIB);
+  g_assert_cmpstr (a, ==, "410 MB");
+  g_assert_cmpstr (b, ==, "1.8 GB");
+  g_assert_cmpstr (c, ==, "5 GB");
+  g_autofree char *two = cc_Suno_sync_when (NOW - 120, NOW, FALSE), *row = cc_Suno_sync_when (NOW - 300, NOW, TRUE);
+  g_autofree char *yesterday = cc_Suno_sync_when (NOW - 86400, NOW, TRUE);
+  g_assert_cmpstr (two, ==, "Synced 2 minutes ago");
+  g_assert_cmpstr (row, ==, "synced 5 min ago");
+  g_assert_cmpstr (yesterday, ==, "synced yesterday");
+  g_autoptr (JsonNode) node = json_from_string ("[{\"size\":429916160,\"state\":\"synced\",\"last_synced\":1795292460,\"enabled\":true},"
+                                                 "{\"size\":90177536,\"state\":\"waiting\",\"enabled\":true},"
+                                                 "{\"size\":3145728,\"uses_api\":true}]", NULL);
+  JsonArray *apps = json_node_get_array (node);
+  g_autofree char *kiln = cc_Suno_sync_app_line (json_array_get_object_element (apps, 0), NOW);
+  g_autofree char *diskord = cc_Suno_sync_app_line (json_array_get_object_element (apps, 1), NOW);
+  g_autofree char *recipe = cc_Suno_sync_app_line (json_array_get_object_element (apps, 2), NOW);
+  g_assert_cmpstr (kiln, ==, "410 MB · synced 2 min ago");
+  g_assert_cmpstr (diskord, ==, "86 MB · syncs when closed");
+  g_assert_cmpstr (recipe, ==, "3 MB · its own sync");
+  g_assert_cmpuint (cc_Suno_sync_count_words ("  Orbit lantern\n cactus  "), ==, 3);
+  g_assert_cmpuint (cc_Suno_sync_count_words (""), ==, 0);
+}
+
+/* ── A stand-in Suno-connect-syncd ─────────────────────────────────── */
+static const char xml[] =
+  "<node><interface name='org.projectSuno.ConnectSync1'>"
+  "<method name='GetState'><arg type='s' direction='out'/></method>"
+  "<method name='ListApps'><arg type='s' direction='out'/></method>"
+  "<method name='ListDevices'><arg type='s' direction='out'/></method>"
+  "<method name='SetEnabled'><arg type='b' direction='in'/></method>"
+  "<method name='SetCategory'><arg type='s' direction='in'/><arg type='b' direction='in'/></method>"
+  "<method name='ProbeAccount'><arg type='s' direction='out'/></method>"
+  "<method name='BeginSetup'><arg type='as' direction='out'/><arg type='ai' direction='out'/></method>"
+  "<method name='FinishSetup'><arg type='a{is}' direction='in'/></method>"
+  "<method name='CancelSetup'/>"
+  "<method name='RequestJoin'><arg type='s' direction='out'/></method>"
+  "<method name='GetJoin'><arg type='s' direction='out'/></method>"
+  "<method name='ConfirmJoin'><arg type='b' direction='in'/><arg type='s' direction='out'/></method>"
+  "<method name='CancelJoin'/>"
+  "<signal name='StateChanged'/>"
+  "</interface></node>";
+
+static const char *words[] = { "orbit", "lantern", "cactus", "velvet", "harbor", "magnet", "pencil", "timber", "ripple", "saddle",
+                               "quartz", "meadow", "ember", "falcon", "basket", "gentle", "cobalt", "walnut", "summit", "tunnel",
+                               "violin", "anchor", "prism", "juniper", NULL };
+
+typedef struct {
+  GDBusConnection *bus;
+  GPtrArray *calls;
+  gboolean enabled, set_up, wallpaper, member_off;
+  guint joins;
+} Service;
+
+static void
+call (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *method,
+      GVariant *parameters, GDBusMethodInvocation *invocation, gpointer data)
+{
+  Service *s = data;
+  if (g_str_equal (method, "GetState"))
+    {
+      g_autofree char *json = g_strdup_printf ("{\"state\":\"%s\",\"enabled\":%s,\"set_up\":%s,\"member\":%s,"
+        "\"categories\":{\"apps\":true,\"app_data\":true,\"wallpaper\":%s},\"storage\":{\"used\":0,\"quota\":5000000000},\"devices\":1}",
+        s->enabled ? "up_to_date" : "off", s->enabled ? "true" : "false", s->set_up ? "true" : "false", s->set_up && !s->member_off ? "true" : "false",
+        s->wallpaper ? "true" : "false");
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(s)", json));
+      return;
+    }
+  if (g_str_equal (method, "ListApps") || g_str_equal (method, "ListDevices"))
+    {
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(s)", "[]"));
+      return;
+    }
+  g_autofree char *args = g_variant_print (parameters, FALSE);
+  g_ptr_array_add (s->calls, g_strdup_printf ("%s %s", method, args));
+  if (g_str_equal (method, "ProbeAccount"))
+    {
+      /* The one Hub look Settings asks for when the person turns Sync on (the service is inert before). */
+      g_autofree char *json = g_strdup_printf ("{\"set_up\":%s,\"member\":%s}", s->set_up ? "true" : "false",
+                                               s->set_up && !s->member_off ? "true" : "false");
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(s)", json));
+      return;
+    }
+  if (g_str_equal (method, "BeginSetup"))
+    {
+      gint32 check[] = { 4, 13, 22 };
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(^as@ai)", words,
+                                             g_variant_new_fixed_array (G_VARIANT_TYPE_INT32, check, 3, sizeof (gint32))));
+      return;
+    }
+  /* The first join is turned down; the next one gets its code (B3: compared, then ConfirmJoin). */
+  if (g_str_equal (method, "RequestJoin")) s->joins++;
+  if (g_str_equal (method, "RequestJoin") || g_str_equal (method, "GetJoin"))
+    {
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(s)", s->joins < 2
+        ? "{\"state\":\"denied\",\"code\":\"\",\"join\":\"j1\",\"approvers\":[]}"
+        : "{\"state\":\"code\",\"code\":\"418207\",\"join\":\"j2\",\"approvers\":[]}"));
+      return;
+    }
+  if (g_str_equal (method, "ConfirmJoin"))
+    {
+      gboolean matched;
+      g_variant_get (parameters, "(b)", &matched);
+      g_dbus_method_invocation_return_value (invocation, g_variant_new ("(s)", matched
+        ? "{\"state\":\"confirmed\",\"code\":\"418207\",\"join\":\"j2\",\"approvers\":[]}"
+        : "{\"state\":\"tampered\",\"code\":\"\",\"join\":\"j2\",\"approvers\":[]}"));
+      return;
+    }
+  if (g_str_equal (method, "FinishSetup")) s->set_up = TRUE;
+  if (g_str_equal (method, "SetEnabled")) g_variant_get (parameters, "(b)", &s->enabled);
+  if (g_str_equal (method, "SetCategory"))
+    {
+      const char *what;
+      gboolean on;
+      g_variant_get (parameters, "(&sb)", &what, &on);
+      if (g_str_equal (what, "wallpaper")) s->wallpaper = on;
+    }
+  g_dbus_method_invocation_return_value (invocation, NULL);
+  g_dbus_connection_emit_signal (bus, NULL, path, iface, "StateChanged", NULL, NULL);
+}
+
+static const GDBusInterfaceVTable vtable = { .method_call = call };
+
+static gboolean
+called (Service *s, const char *prefix)
+{
+  for (guint i = 0; i < s->calls->len; i++)
+    if (g_str_has_prefix (s->calls->pdata[i], prefix)) return TRUE;
+  return FALSE;
+}
+
+static void
+wait_call (Service *s, const char *prefix)
+{
+  for (guint i = 0; i < 150 && !called (s, prefix); i++) spin (20);
+  if (!called (s, prefix))
+    {
+      for (guint j = 0; j < s->calls->len; j++) g_printerr ("call: %s\n", (char *) s->calls->pdata[j]);
+      g_error ("no %s", prefix);
+    }
+  spin (200);
+}
+
+static GtkWidget *
+named (GtkWidget *root, const char *name)
+{
+  if (g_strcmp0 (gtk_widget_get_name (root), name) == 0) return root;
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = named (w, name);
+      if (found) return found;
+    }
+  return NULL;
+}
+
+/* A button by the words on it (a check button too). */
+static GtkWidget *
+button (GtkWidget *root, const char *text)
+{
+  if ((GTK_IS_BUTTON (root) || GTK_IS_CHECK_BUTTON (root)))
+    {
+      const char *l = GTK_IS_BUTTON (root) ? gtk_button_get_label (GTK_BUTTON (root)) : gtk_check_button_get_label (GTK_CHECK_BUTTON (root));
+      if (g_strcmp0 (l, text) == 0) return root;
+      for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+        if (GTK_IS_LABEL (w) && g_strcmp0 (gtk_label_get_text (GTK_LABEL (w)), text) == 0) return root;
+      for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+        for (GtkWidget *x = gtk_widget_get_first_child (w); x; x = gtk_widget_get_next_sibling (x))
+          if (GTK_IS_LABEL (x) && g_strcmp0 (gtk_label_get_text (GTK_LABEL (x)), text) == 0) return root;
+    }
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w))
+    {
+      GtkWidget *found = button (w, text);
+      if (found) return found;
+    }
+  return NULL;
+}
+
+static void
+entries (GtkWidget *root, GPtrArray *out)
+{
+  if (GTK_IS_ENTRY (root)) g_ptr_array_add (out, root);
+  for (GtkWidget *w = gtk_widget_get_first_child (root); w; w = gtk_widget_get_next_sibling (w)) entries (w, out);
+}
+
+static gboolean
+main_on (GtkWidget *view)
+{
+  GtkWidget *b = named (view, "cs-main");
+  g_assert_nonnull (b);
+  return gtk_switch_get_active (GTK_SWITCH (g_object_get_data (G_OBJECT (b), "cf-switch")));
+}
+
+static GtkWidget *
+sheet (GtkWidget *window)
+{
+  for (guint i = 0; i < 100 && !named (window, "cs-sheet"); i++) spin (20);
+  spin (100);
+  return named (window, "cs-sheet");
+}
+
+static void
+click (GtkWidget *b)
+{
+  g_assert_nonnull (b);
+  g_assert_true (gtk_widget_get_sensitive (b));
+  if (GTK_IS_TOGGLE_BUTTON (b)) gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (b), !gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (b)));
+  else g_signal_emit_by_name (b, "clicked");
+  spin (150);
+}
+
+static gboolean
+writer (CcSunoFixture *model, const char *key, JsonNode *value, gpointer state, GError **error)
+{
+  return cc_Suno_adapter_sync.write (state, key, value, error);
+}
+
+static void bus_child_setup (gpointer data) { prctl (PR_SET_PDEATHSIG, SIGTERM); }
+
+static const char structure[] =
+  "{\"version\":1,\"settings\":{},\"data\":{},"
+  "\"pages\":[{\"id\":\"me\",\"title\":\"Suno account\",\"parent\":null},{\"id\":\"sync\",\"title\":\"Sync\",\"parent\":\"me\"},"
+  "{\"id\":\"sync-apps\",\"title\":\"App data\",\"parent\":\"sync\"}]}";
+
+static void
+test_live (void)
+{
+  g_autoptr (GSubprocessLauncher) launcher = g_subprocess_launcher_new (G_SUBPROCESS_FLAGS_STDOUT_PIPE);
+  g_subprocess_launcher_set_child_setup (launcher, bus_child_setup, NULL, NULL);
+  g_autoptr (GSubprocess) daemon = g_subprocess_launcher_spawn (launcher, NULL, "dbus-daemon", "--session", "--nofork", "--print-address=1", NULL);
+  g_assert_nonnull (daemon);
+  g_autoptr (GDataInputStream) output = g_data_input_stream_new (g_subprocess_get_stdout_pipe (daemon));
+  g_autofree char *address = g_data_input_stream_read_line (output, NULL, NULL, NULL);
+  g_assert_nonnull (address);
+  g_setenv ("DBUS_SESSION_BUS_ADDRESS", address, TRUE);
+
+  Service s = { 0 };
+  s.calls = g_ptr_array_new_with_free_func (g_free);
+  s.bus = g_dbus_connection_new_for_address_sync (address, G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                                  G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, NULL);
+  g_assert_nonnull (s.bus);
+  g_autoptr (GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (xml, NULL);
+  g_assert_cmpuint (g_dbus_connection_register_object (s.bus, CC_SUNO_SYNC_PATH, info->interfaces[0], &vtable, &s, NULL, NULL), >, 0);
+  g_autoptr (GVariant) owned = g_dbus_connection_call_sync (s.bus, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
+                                                            "RequestName", g_variant_new ("(su)", CC_SUNO_SYNC_BUS, 4), NULL,
+                                                            G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL);
+  g_assert_nonnull (owned);
+
+  g_autoptr (JsonNode) root = json_from_string (structure, NULL);
+  g_autoptr (CcSunoFixture) model = cc_Suno_fixture_new_live (root);
+  gpointer state = cc_Suno_adapter_sync.start (model);
+  cc_Suno_fixture_set_writer (model, writer, state);
+  cc_Suno_fixture_verify_owned_keys (model);
+  for (guint i = 0; i < 150 && !ready; i++) spin (20);
+  g_assert_true (ready);
+
+  adw_init ();
+  g_autoptr (GError) error = NULL;
+  GtkWidget *view = cc_Suno_view_new (model, "sync", &error);
+  g_assert_no_error (error);
+  GtkWidget *window = gtk_window_new ();
+  gtk_window_set_default_size (GTK_WINDOW (window), 1000, 900);
+  gtk_window_set_child (GTK_WINDOW (window), view);
+  gtk_window_present (GTK_WINDOW (window));
+  spin (300);
+  g_assert_false (main_on (view));
+
+  /* Turning on asks the service for its one look at the account (ProbeAccount), then shows the key;
+   * Continue waits for the tick. */
+  click (named (view, "cs-main"));
+  wait_call (&s, "ProbeAccount");
+  wait_call (&s, "BeginSetup");
+  GtkWidget *card = sheet (window);
+  g_assert_nonnull (card);
+  GtkWidget *cont = button (card, "Continue");
+  g_assert_nonnull (cont);
+  g_assert_false (gtk_widget_get_sensitive (cont));
+  g_assert_null (button (card, "Copy"));
+  click (button (card, "I’ve saved my recovery key somewhere safe"));
+  g_assert_true (gtk_widget_get_sensitive (cont));
+  click (button (card, "I’ve saved my recovery key somewhere safe"));
+  g_assert_false (gtk_widget_get_sensitive (cont));
+
+  /* Cancel: CancelSetup, nothing turned on. */
+  click (button (card, "Cancel"));
+  wait_call (&s, "CancelSetup");
+  spin (400);
+  g_assert_null (named (window, "cs-sheet"));
+  g_assert_false (called (&s, "SetEnabled"));
+  g_assert_false (called (&s, "FinishSetup"));
+  g_assert_false (main_on (view));
+
+  /* Again: tick, Continue, three words; Turn on Sync waits for all three. */
+  g_ptr_array_set_size (s.calls, 0);
+  click (named (view, "cs-main"));
+  wait_call (&s, "BeginSetup");
+  card = sheet (window);
+  click (button (card, "I’ve saved my recovery key somewhere safe"));
+  click (button (card, "Continue"));
+  GtkWidget *turn_on = button (card, "Turn on Sync");
+  g_assert_nonnull (turn_on);
+  g_assert_false (gtk_widget_get_sensitive (turn_on));
+  g_autoptr (GPtrArray) fields = g_ptr_array_new ();
+  entries (card, fields);
+  g_assert_cmpuint (fields->len, ==, 3);
+  gtk_editable_set_text (fields->pdata[0], "velvet");
+  gtk_editable_set_text (fields->pdata[1], "Ember ");
+  gtk_editable_set_text (fields->pdata[2], "anc");
+  g_assert_true (gtk_widget_has_css_class (fields->pdata[0], "ok"));
+  g_assert_true (gtk_widget_has_css_class (fields->pdata[1], "ok"));
+  g_assert_false (gtk_widget_has_css_class (fields->pdata[2], "ok"));
+  g_assert_false (gtk_widget_get_sensitive (turn_on));
+  gtk_editable_set_text (fields->pdata[2], "anchor");
+  g_assert_true (gtk_widget_get_sensitive (turn_on));
+  click (turn_on);
+  wait_call (&s, "FinishSetup");
+  g_assert_true (called (&s, "FinishSetup ({4: 'velvet', 13: 'Ember ', 22: 'anchor'},)"));
+  wait_call (&s, "SetEnabled (true,)");
+  spin (400);
+  g_assert_null (named (window, "cs-sheet"));
+  g_assert_true (main_on (view));
+
+  /* A category: SetCategory, read back. */
+  click (named (view, "cs-cat-wallpaper"));
+  wait_call (&s, "SetCategory ('wallpaper', true)");
+  g_assert_true (s.wallpaper);
+
+  /* A device joining an account that has Sync: Not approved, then Ask again asks again. */
+  s.enabled = FALSE;
+  s.member_off = TRUE;
+  g_dbus_connection_emit_signal (s.bus, NULL, CC_SUNO_SYNC_PATH, CC_SUNO_SYNC_IFACE, "StateChanged", NULL, NULL);
+  spin (600);
+  g_ptr_array_set_size (s.calls, 0);
+  click (named (view, "cs-main"));
+  wait_call (&s, "ProbeAccount");
+  wait_call (&s, "RequestJoin");
+  card = sheet (window);
+  g_assert_nonnull (card);
+  g_assert_nonnull (button (card, "Ask again"));
+  g_assert_nonnull (button (card, "Use recovery key instead"));
+  g_ptr_array_set_size (s.calls, 0);
+  click (button (card, "Ask again"));
+  wait_call (&s, "RequestJoin");
+  /* The code came: Same code tells the service the codes match (ConfirmJoin), and the sheet waits for the approval. */
+  spin (300);
+  g_assert_nonnull (button (card, "It doesn’t match"));
+  g_ptr_array_set_size (s.calls, 0);
+  click (button (card, "Same code"));
+  wait_call (&s, "ConfirmJoin (true,)");
+  spin (300);
+  g_assert_nonnull (button (card, "Cancel"));
+  g_assert_null (button (card, "Same code"));
+
+  gtk_window_destroy (GTK_WINDOW (window));
+  spin (100);
+  cc_Suno_adapter_sync.stop (state);
+  g_ptr_array_unref (s.calls);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/settings/connect-sync/words", test_words);
+  g_test_add_func ("/settings/connect-sync/live", test_live);
+  return g_test_run ();
+}
