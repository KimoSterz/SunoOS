diff --git a/shell/cc-Suno-view-app-windows.c b/shell/cc-Suno-view-app-windows.c
new file mode 100644
index 0000000..0353ad1
--- /dev/null
+++ b/shell/cc-Suno-view-app-windows.c
@@ -0,0 +1,146 @@
+/* The app page's Windows group (ADR-055): "Reopen with your windows", the
+ * app's exclusion from both restore after restart and Continue. Off adds the
+ * app to org.projectSuno.session excluded-apps; an app that excludes itself
+ * (X-Suno-Continue=false in its desktop entry) shows the row off and
+ * disabled. The fixture keeps its own copy in the app's permission entry:
+ * "reopen" (default true) and "reopen_self" (default true). */
+#include "cc-Suno-view-private.h"
+#include "cc-Suno-rows.h"
+#include "cc-Suno-app-permissions.h"
+#include <gio/gdesktopappinfo.h>
+#include <string.h>
+
+#define SESSION_SCHEMA "org.projectSuno.session"
+
+static char *
+desktop_id (const char *app)
+{
+  return g_str_has_suffix (app, ".desktop") ? g_strdup (app) : g_strconcat (app, ".desktop", NULL);
+}
+
+static GSettings *
+session_settings (void)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = source ? g_settings_schema_source_lookup (source, SESSION_SCHEMA, TRUE) : NULL;
+  return schema ? g_settings_new (SESSION_SCHEMA) : NULL;
+}
+
+/* A Flatpak's exported entry may lose X- keys: read its deployed file too. */
+static gboolean
+excludes_itself (const char *id)
+{
+  g_autoptr (GDesktopAppInfo) info = g_desktop_app_info_new (id);
+  if (info && g_desktop_app_info_has_key (info, "X-Suno-Continue"))
+    return !g_desktop_app_info_get_boolean (info, "X-Suno-Continue");
+  g_autofree char *flatpak = info ? g_desktop_app_info_get_string (info, "X-Flatpak") : NULL;
+  if (!flatpak || !*flatpak || strchr (flatpak, '/') || g_str_has_prefix (flatpak, "."))
+    return FALSE;
+  g_autofree char *user = g_build_filename (g_get_home_dir (), ".local/share/flatpak/app", NULL);
+  const char *roots[] = { "/var/lib/flatpak/app", user };
+  for (guint i = 0; i < G_N_ELEMENTS (roots); i++)
+    {
+      g_autofree char *path = g_build_filename (roots[i], flatpak, "current/active/export/share/applications", id, NULL);
+      g_autoptr (GKeyFile) file = g_key_file_new ();
+      if (!g_key_file_load_from_file (file, path, G_KEY_FILE_NONE, NULL)) continue;
+      g_autoptr (GError) error = NULL;
+      gboolean on = g_key_file_get_boolean (file, G_KEY_FILE_DESKTOP_GROUP, "X-Suno-Continue", &error);
+      return error ? FALSE : !on;
+    }
+  return FALSE;
+}
+
+static gboolean
+excluded (const char *id)
+{
+  g_autoptr (GSettings) settings = session_settings ();
+  g_auto (GStrv) list = settings ? g_settings_get_strv (settings, "excluded-apps") : NULL;
+  return list && g_strv_contains ((const char * const *) list, id);
+}
+
+static void
+set_excluded (const char *id, gboolean off)
+{
+  g_autoptr (GSettings) settings = session_settings ();
+  if (!settings) return;
+  g_auto (GStrv) list = g_settings_get_strv (settings, "excluded-apps");
+  g_autoptr (GStrvBuilder) next = g_strv_builder_new ();
+  for (guint i = 0; list && list[i]; i++)
+    if (g_strcmp0 (list[i], id) != 0) g_strv_builder_add (next, list[i]);
+  if (off) g_strv_builder_add (next, id);
+  g_auto (GStrv) out = g_strv_builder_end (next);
+  g_settings_set_strv (settings, "excluded-apps", (const char * const *) out);
+}
+
+static JsonObject *
+fixture_entry (View *v, const char *app)
+{
+  JsonObject *data = cc_Suno_fixture_get_data (v->model);
+  JsonObject *perm = cc_Suno_app_perm_data (data);
+  return cc_Suno_app_perm_entry (perm, "apps", cc_Suno_app_perm_key_for (data, app));
+}
+
+static void
+reopen_clicked (GtkButton *button, gpointer user_data)
+{
+  View *v = g_object_get_data (G_OBJECT (button), "aw-view");
+  const char *app = g_object_get_data (G_OBJECT (button), "aw-app");
+  GtkWidget *visual = g_object_get_data (G_OBJECT (button), "cf-switch");
+  gboolean on = !gtk_switch_get_active (GTK_SWITCH (visual));
+  gtk_switch_set_active (GTK_SWITCH (visual), on);
+  gtk_accessible_update_state (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_STATE_CHECKED,
+                               on ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+  if (cc_Suno_fixture_is_live (v->model))
+    {
+      g_autofree char *id = desktop_id (app);
+      set_excluded (id, !on);
+    }
+  else
+    {
+      JsonObject *entry = fixture_entry (v, app);
+      if (entry) json_object_set_boolean_member (entry, "reopen", on);
+    }
+}
+
+void
+cc_Suno_view_app_windows_render (View *v, const char *app)
+{
+  g_autofree char *id = desktop_id (app);
+  gboolean self_out, on;
+  if (cc_Suno_fixture_is_live (v->model))
+    {
+      self_out = excludes_itself (id);
+      on = !self_out && !excluded (id);
+    }
+  else
+    {
+      JsonObject *entry = fixture_entry (v, app);
+      self_out = entry && !json_object_get_boolean_member_with_default (entry, "reopen_self", TRUE);
+      on = !self_out && (!entry || json_object_get_boolean_member_with_default (entry, "reopen", TRUE));
+    }
+  GtkBox *card = cf_group (v, "Windows", NULL);
+  gtk_widget_set_name (gtk_widget_get_parent (GTK_WIDGET (card)), "ap-windows");
+  const char *title = "Reopen with your windows";
+  const char *line = self_out ? "This app doesn’t reopen its windows"
+                              : "After a restart, and when you continue on another device";
+  GtkWidget *visual = Suno_switch_new (FALSE);
+  gtk_switch_set_active (GTK_SWITCH (visual), on);
+  gtk_widget_set_valign (visual, GTK_ALIGN_CENTER);
+  gtk_widget_set_can_target (visual, FALSE);
+  gtk_widget_set_can_focus (visual, FALSE);
+  GtkWidget *button = g_object_new (GTK_TYPE_BUTTON, "accessible-role", GTK_ACCESSIBLE_ROLE_SWITCH, NULL);
+  gtk_widget_add_css_class (button, "cf-row");
+  gtk_accessible_update_property (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  gtk_accessible_update_state (GTK_ACCESSIBLE (button), GTK_ACCESSIBLE_STATE_CHECKED,
+                               on ? GTK_ACCESSIBLE_TRISTATE_TRUE : GTK_ACCESSIBLE_TRISTATE_FALSE, -1);
+  GtkWidget *inner = cf_row (NULL, cf_lead_icon ("rotate-ccw"), title, line, visual, FALSE);
+  gtk_widget_remove_css_class (inner, "cf-row");
+  gtk_button_set_child (GTK_BUTTON (button), inner);
+  gtk_widget_set_name (button, "ap-reopen");
+  g_object_set_data (G_OBJECT (button), "cf-switch", visual);
+  g_object_set_data (G_OBJECT (button), "aw-view", v);
+  g_object_set_data_full (G_OBJECT (button), "aw-app", g_strdup (app), g_free);
+  gtk_widget_set_sensitive (button, !self_out);
+  g_signal_connect (button, "clicked", G_CALLBACK (reopen_clicked), NULL);
+  gtk_box_append (card, button);
+}
