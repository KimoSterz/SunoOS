diff --git a/shell/cc-luma-app-permissions.c b/shell/cc-luma-app-permissions.c
new file mode 100644
index 0000000..4f58318
--- /dev/null
+++ b/shell/cc-luma-app-permissions.c
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cc-luma-app-permissions.h"
+#include <string.h>
+
+/* A key as a settings name: letters and digits kept, anything else as _XX
+ * (its hex), so two app keys never share a name and none holds a '.'. */
+char *
+cc_luma_app_perm_munge (const char *key)
+{
+  GString *m = g_string_new (NULL);
+  for (const char *c = key ? key : ""; *c; c++)
+    {
+      if (g_ascii_isalnum (*c)) g_string_append_c (m, *c);
+      else g_string_append_printf (m, "_%02x", (guchar) *c);
+    }
+  return g_string_free (m, FALSE);
+}
+
+char *
+cc_luma_app_perm_key_name (const char *field, const char *key)
+{
+  g_autofree char *m = cc_luma_app_perm_munge (key);
+  return g_strconcat ("apperm_", field, "_", m, NULL);
+}
+
+JsonObject *
+cc_luma_app_perm_data (JsonObject *data)
+{
+  JsonNode *node = data ? json_object_get_member (data, CC_LUMA_APP_PERM_DATA) : NULL;
+  return node && JSON_NODE_HOLDS_OBJECT (node) ? json_node_get_object (node) : NULL;
+}
+
+JsonObject *
+cc_luma_app_perm_entry (JsonObject *perm, const char *member, const char *key)
+{
+  JsonNode *table = perm && key ? json_object_get_member (perm, member) : NULL;
+  JsonNode *entry = table && JSON_NODE_HOLDS_OBJECT (table) ? json_object_get_member (json_node_get_object (table), key) : NULL;
+  return entry && JSON_NODE_HOLDS_OBJECT (entry) ? json_node_get_object (entry) : NULL;
+}
+
+static JsonObject *
+info_of (JsonObject *data, const char *settings_app)
+{
+  JsonNode *all = data ? json_object_get_member (data, "CFAPPINFO") : NULL;
+  JsonNode *entry = all && JSON_NODE_HOLDS_OBJECT (all) && settings_app ? json_object_get_member (json_node_get_object (all), settings_app) : NULL;
+  return entry && JSON_NODE_HOLDS_OBJECT (entry) ? json_node_get_object (entry) : NULL;
+}
+
+/* The service names a store or capsule app by its launcher's ID (Mutter
+ * 0041's org.projectluma.Installed.ID) and a Flatpak by its Flatpak ID. */
+const char *
+cc_luma_app_perm_key_for (JsonObject *data, const char *settings_app)
+{
+  JsonObject *perm = cc_luma_app_perm_data (data), *info = info_of (data, settings_app);
+  if (!perm || !info) return NULL;
+  const char *candidates[] = {
+    json_object_get_string_member_with_default (info, "permKey", NULL),
+    json_object_get_string_member_with_default (info, "flatpakId", NULL),
+    NULL, NULL,
+  };
+  g_autofree char *desktop = NULL;
+  const char *desktop_id = json_object_get_string_member_with_default (info, "desktopId", NULL);
+  if (desktop_id && g_str_has_suffix (desktop_id, ".desktop"))
+    desktop = g_strndup (desktop_id, strlen (desktop_id) - strlen (".desktop"));
+  candidates[2] = desktop;
+  for (guint i = 0; i < G_N_ELEMENTS (candidates); i++)
+    {
+      if (!candidates[i]) continue;
+      JsonNode *apps = json_object_get_member (perm, "apps");
+      if (apps && JSON_NODE_HOLDS_OBJECT (apps))
+        {
+          /* Return the table's own string, which outlives this call. */
+          GList *members = json_object_get_members (json_node_get_object (apps));
+          for (GList *m = members; m; m = m->next)
+            if (g_str_equal (m->data, candidates[i]))
+              {
+                const char *found = m->data;
+                g_list_free (members);
+                return found;
+              }
+          g_list_free (members);
+        }
+    }
+  return NULL;
+}
+
+const char *
+cc_luma_app_perm_settings_app (JsonObject *data, const char *key)
+{
+  JsonNode *all = data ? json_object_get_member (data, "CFAPPINFO") : NULL;
+  if (!all || !JSON_NODE_HOLDS_OBJECT (all) || !key) return NULL;
+  GList *members = json_object_get_members (json_node_get_object (all));
+  const char *found = NULL;
+  for (GList *m = members; m && !found; m = m->next)
+    {
+      const char *mapped = cc_luma_app_perm_key_for (data, m->data);
+      if (mapped && g_str_equal (mapped, key)) found = m->data;
+    }
+  g_list_free (members);
+  return found;
+}
diff --git a/shell/cc-luma-app-permissions.h b/shell/cc-luma-app-permissions.h
new file mode 100644
index 0000000..8b7ef9d
--- /dev/null
+++ b/shell/cc-luma-app-permissions.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* App permissions for every format (ADR-052 step 3): what the live adapter
+ * (cc-luma-live-app-permissions.c) reads from org.projectluma.AppPermissions1
+ * and publishes as CFAPPPERM, and the keys an app's page binds to.
+ *   CFAPPPERM.apps[key]    the service's Apps entry: name, format, origin,
+ *                          level, folders, suggested_level, network,
+ *                          background, autostart, uses, reason, application_id
+ *   CFAPPPERM.detail[key]  GetApp, read when the app's page is shown
+ *   CFAPPPERM.all          AllFilesApps
+ * key is the service's app key: a Flatpak ID or org.projectluma.Installed.ID.
+ * Bound keys (settings, one per app and field, the key munged):
+ *   apperm_level_<m>  "chooser" | "folders" | "all"
+ *   apperm_net_<m>, apperm_bg_<m>, apperm_auto_<m>, apperm_files_<m> (all files on)
+ *   apperm_dev_<kind>_<m>
+ * "appPerm" takes one change as an object {op, app, ...}: folder (folder, on),
+ * detail, restart, remove (keep, move). */
+#pragma once
+#include "cc-luma-fixture.h"
+
+G_BEGIN_DECLS
+#define CC_LUMA_APP_PERM_DATA "CFAPPPERM"
+#define CC_LUMA_APP_PERM_WRITE "appPerm"
+
+/* "org.projectluma.Installed.x" → "org_2eprojectluma_2eInstalled_2ex": injective, no dots. */
+char *cc_luma_app_perm_munge (const char *key);
+char *cc_luma_app_perm_key_name (const char *field, const char *key);
+/* CFAPPPERM, or NULL when no service reports it. */
+JsonObject *cc_luma_app_perm_data (JsonObject *data);
+/* The service's key for a Settings app (CFAPPINFO permKey, flatpakId or desktopId), or NULL. */
+const char *cc_luma_app_perm_key_for (JsonObject *data, const char *settings_app);
+/* The Settings app for a service key, or NULL. */
+const char *cc_luma_app_perm_settings_app (JsonObject *data, const char *key);
+JsonObject *cc_luma_app_perm_entry (JsonObject *perm, const char *member, const char *key);
+G_END_DECLS
diff --git a/shell/cc-luma-live-app-permissions.c b/shell/cc-luma-live-app-permissions.c
new file mode 100644
index 0000000..76fd4f0
--- /dev/null
+++ b/shell/cc-luma-live-app-permissions.c
@@ -0,0 +1,544 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Live app permissions (ADR-052 step 3): org.projectluma.AppPermissions1 on
+ * the session bus (luma-application-installer, D-Bus activated), published as
+ * CFAPPPERM (cc-luma-app-permissions.h).
+ *   Apps, AllFilesApps   read with GetAll, again on PropertiesChanged, Changed
+ *                        and Used
+ *   GetApp               an app's detail, when its page asks ("appPerm" detail)
+ * Writes: the bound per-app keys call SetFileLevel, SetNetwork, SetBackground,
+ * SetAutostart and SetDevice; "appPerm" adds or removes a folder (SetFolder),
+ * reads a detail, or removes the app (MoveStrayDocuments, then luma-appctl
+ * remove or flatpak uninstall). Without the service CFAPPPERM is null and an
+ * app's page keeps its older rows. */
+#include "cc-luma-live.h"
+#include "cc-luma-app-permissions.h"
+#include <string.h>
+
+#define ADAPTER "appperm"
+#define NAME "org.projectluma.AppPermissions1"
+#define PATH "/org/projectluma/AppPermissions"
+#define IFACE NAME
+
+/* Kinds a device row stands for: one USB row for the udev kinds that are USB. */
+static const struct { const char *row; const char *kinds[4]; } device_rows[] = {
+  { "camera", { "camera", NULL } }, { "microphone", { "microphone", NULL } },
+  { "location", { "location", NULL } }, { "screen", { "screen", NULL } },
+  { "usb", { "usb", "hid", "lighting", NULL } }, { "controller", { "controller", NULL } },
+  { "serial", { "serial", NULL } },
+};
+
+typedef struct {
+  CcLumaFixture *model;
+  GCancellable *cancel;
+  GDBusConnection *bus;
+  guint watch, props_signal, changed_signal, used_signal;
+  gboolean present, ready, reading, again;
+  JsonObject *apps;      /* key → Apps entry */
+  JsonObject *detail;    /* key → GetApp */
+  JsonArray *all;
+  GHashTable *by_munged; /* munged → key */
+  GHashTable *wanted;    /* keys whose detail a page asked for */
+} Perm;
+
+static void read_apps (Perm *s);
+static void read_detail (Perm *s, const char *key);
+
+static void
+mark_ready (Perm *s)
+{
+  if (s->ready) return;
+  s->ready = TRUE;
+  cc_luma_live_ready (s->model, ADAPTER);
+}
+
+static gboolean
+member_bool (JsonObject *o, const char *name, gboolean fallback)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_BOOLEAN ? json_node_get_boolean (n) : fallback;
+}
+
+static void
+own (Perm *s, const char *field, const char *key)
+{
+  g_autofree char *name = cc_luma_app_perm_key_name (field, key);
+  cc_luma_fixture_own_key (s->model, name);
+  /* Proven in the VM with each control clicked (handoffs app-permissions-20261121/vm, run apui-settings). */
+  cc_luma_fixture_verify_key (s->model, name);
+}
+
+static void
+publish_keys (Perm *s, const char *key, JsonObject *entry)
+{
+  g_autofree char *munged = cc_luma_app_perm_munge (key);
+  g_hash_table_replace (s->by_munged, g_strdup (munged), g_strdup (key));
+  const char *level = json_object_get_string_member_with_default (entry, "level", "chooser");
+  struct { const char *field; gboolean on; } flags[] = {
+    { "net", member_bool (entry, "network", TRUE) }, { "bg", member_bool (entry, "background", FALSE) },
+    { "auto", member_bool (entry, "autostart", FALSE) }, { "files", g_strcmp0 (level, "all") == 0 },
+  };
+  g_autofree char *level_key = cc_luma_app_perm_key_name ("level", key);
+  own (s, "level", key);
+  cc_luma_fixture_publish_string (s->model, level_key, level);
+  for (guint i = 0; i < G_N_ELEMENTS (flags); i++)
+    {
+      g_autofree char *name = cc_luma_app_perm_key_name (flags[i].field, key);
+      own (s, flags[i].field, key);
+      cc_luma_fixture_publish_boolean (s->model, name, flags[i].on);
+    }
+  JsonObject *detail = s->detail && json_object_has_member (s->detail, key) ? json_object_get_object_member (s->detail, key) : NULL;
+  JsonArray *devices = detail && json_object_has_member (detail, "devices") ? json_object_get_array_member (detail, "devices") : NULL;
+  for (guint r = 0; r < G_N_ELEMENTS (device_rows); r++)
+    {
+      gboolean granted = FALSE;
+      for (guint i = 0; devices && i < json_array_get_length (devices); i++)
+        {
+          JsonObject *d = json_array_get_object_element (devices, i);
+          const char *kind = json_object_get_string_member_with_default (d, "kind", "");
+          for (guint k = 0; device_rows[r].kinds[k]; k++)
+            if (g_str_equal (kind, device_rows[r].kinds[k]) && member_bool (d, "granted", FALSE)) granted = TRUE;
+        }
+      g_autofree char *field = g_strconcat ("dev_", device_rows[r].row, NULL);
+      g_autofree char *name = cc_luma_app_perm_key_name (field, key);
+      own (s, field, key);
+      cc_luma_fixture_publish_boolean (s->model, name, granted);
+    }
+}
+
+static void
+publish (Perm *s)
+{
+  if (!s->present || !s->apps)
+    {
+      g_autoptr (JsonNode) none = json_node_init_null (json_node_alloc ());
+      cc_luma_fixture_publish_data (s->model, CC_LUMA_APP_PERM_DATA, none);
+      return;
+    }
+  GList *keys = json_object_get_members (s->apps);
+  for (GList *k = keys; k; k = k->next)
+    publish_keys (s, k->data, json_object_get_object_member (s->apps, k->data));
+  g_list_free (keys);
+  g_autoptr (JsonObject) perm = json_object_new ();
+  json_object_set_object_member (perm, "apps", json_object_ref (s->apps));
+  json_object_set_object_member (perm, "detail", json_object_ref (s->detail));
+  json_object_set_array_member (perm, "all", json_array_ref (s->all));
+  json_object_set_boolean_member (perm, "live", TRUE);
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), perm);
+  cc_luma_fixture_publish_data (s->model, CC_LUMA_APP_PERM_DATA, node);
+}
+
+/* A copy that shares nothing with what was published. */
+static JsonObject *
+deep_copy (JsonObject *o)
+{
+  g_autoptr (JsonNode) node = json_node_init_object (json_node_alloc (), o);
+  g_autofree char *text = json_to_string (node, FALSE);
+  g_autoptr (JsonNode) copy = json_from_string (text, NULL);
+  return json_object_ref (json_node_get_object (copy));
+}
+
+static JsonObject *
+object_of (GVariant *value)
+{
+  g_autoptr (JsonNode) node = json_gvariant_serialize (value);
+  return node && JSON_NODE_HOLDS_OBJECT (node) ? json_object_ref (json_node_get_object (node)) : json_object_new ();
+}
+
+static void
+got_all (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Perm *s = data;
+  s->reading = FALSE;
+  if (reply)
+    {
+      g_autoptr (GVariant) props = g_variant_get_child_value (reply, 0);
+      g_autoptr (GVariant) apps = g_variant_lookup_value (props, "Apps", G_VARIANT_TYPE ("a{sa{sv}}"));
+      g_autoptr (GVariant) all = g_variant_lookup_value (props, "AllFilesApps", G_VARIANT_TYPE ("as"));
+      g_clear_pointer (&s->apps, json_object_unref);
+      g_clear_pointer (&s->all, json_array_unref);
+      s->apps = apps ? object_of (apps) : json_object_new ();
+      s->all = json_array_new ();
+      for (guint i = 0; all && i < g_variant_n_children (all); i++)
+        {
+          g_autoptr (GVariant) id = g_variant_get_child_value (all, i);
+          json_array_add_string_element (s->all, g_variant_get_string (id, NULL));
+        }
+      s->present = TRUE;
+    }
+  else
+    {
+      g_debug ("Settings live: app permissions: %s", error->message);
+      s->present = FALSE;
+    }
+  publish (s);
+  mark_ready (s);
+  if (s->again)
+    {
+      s->again = FALSE;
+      read_apps (s);
+    }
+}
+
+static void
+read_apps (Perm *s)
+{
+  if (s->reading) { s->again = TRUE; return; }
+  s->reading = TRUE;
+  /* The service is D-Bus activated: reading it starts it. */
+  g_dbus_connection_call (s->bus, NAME, PATH, "org.freedesktop.DBus.Properties", "GetAll",
+                          g_variant_new ("(s)", IFACE), G_VARIANT_TYPE ("(a{sv})"),
+                          G_DBUS_CALL_FLAGS_NONE, 20000, s->cancel, got_all, s);
+}
+
+typedef struct { Perm *s; char *key; } DetailRead;
+
+static void
+got_detail (GObject *source, GAsyncResult *result, gpointer data)
+{
+  DetailRead *read = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    {
+      Perm *s = read->s;
+      if (reply)
+        {
+          g_autoptr (GVariant) detail = g_variant_get_child_value (reply, 0);
+          /* Never changed once published: a new table each time. */
+          JsonObject *next = deep_copy (s->detail);
+          json_object_set_object_member (next, read->key, object_of (detail));
+          json_object_unref (s->detail);
+          s->detail = next;
+          publish (s);
+        }
+      else
+        {
+          g_message ("Settings: app permissions for %s: %s", read->key, error->message);
+          g_hash_table_remove (s->wanted, read->key);  /* the next draw asks again */
+        }
+    }
+  g_free (read->key);
+  g_free (read);
+}
+
+static void
+read_detail (Perm *s, const char *key)
+{
+  DetailRead *read = g_new0 (DetailRead, 1);
+  read->s = s;
+  read->key = g_strdup (key);
+  g_dbus_connection_call (s->bus, NAME, PATH, IFACE, "GetApp", g_variant_new ("(s)", key), G_VARIANT_TYPE ("(a{sv})"),
+                          G_DBUS_CALL_FLAGS_NONE, 20000, s->cancel, got_detail, read);
+}
+
+static void
+service_signal (GDBusConnection *bus, const char *sender, const char *path, const char *iface, const char *signal,
+                GVariant *parameters, gpointer data)
+{
+  Perm *s = data;
+  read_apps (s);
+  const char *app = NULL;
+  if (g_variant_is_of_type (parameters, G_VARIANT_TYPE ("(s)")) || g_variant_is_of_type (parameters, G_VARIANT_TYPE ("(ss)")))
+    g_variant_get_child (parameters, 0, "&s", &app);
+  if (app && g_hash_table_contains (s->wanted, app)) read_detail (s, app);
+}
+
+static void
+appeared (GDBusConnection *bus, const char *name, const char *owner, gpointer data)
+{
+  read_apps (data);
+}
+
+static void
+vanished (GDBusConnection *bus, const char *name, gpointer data)
+{
+  /* Activated on demand and leaves when idle: what it said stays shown. */
+  mark_ready (data);
+}
+
+static void
+call_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Perm *s = data;
+  if (!reply)
+    {
+      cc_luma_fixture_report_write_error (s->model, error);
+      read_apps (s);
+    }
+}
+
+static void
+call (Perm *s, const char *method, GVariant *args)
+{
+  g_dbus_connection_call (s->bus, NAME, PATH, IFACE, method, args, NULL, G_DBUS_CALL_FLAGS_NONE, 20000, s->cancel, call_done, s);
+}
+
+typedef struct { Perm *s; char *key, *application_id, *format, *installation; gboolean keep; } Removal;
+
+static void
+removal_free (Removal *r)
+{
+  g_free (r->key); g_free (r->application_id); g_free (r->format); g_free (r->installation);
+  g_free (r);
+}
+
+static void
+removed (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr (GError) error = NULL;
+  if (g_subprocess_wait_check_finish (G_SUBPROCESS (source), result, &error)) return;
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) return;
+  Perm *s = data;
+  cc_luma_fixture_report_write_error (s->model, error);
+  read_apps (s);
+}
+
+static void
+uninstall (Removal *r)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GPtrArray) argv = g_ptr_array_new ();
+  if (g_strcmp0 (r->format, "flatpak") == 0 && (!r->application_id || !*r->application_id))
+    {
+      g_ptr_array_add (argv, "flatpak");
+      g_ptr_array_add (argv, "uninstall");
+      g_ptr_array_add (argv, "--noninteractive");
+      g_ptr_array_add (argv, g_strcmp0 (r->installation, "user") == 0 ? "--user" : "--system");
+      if (!r->keep) g_ptr_array_add (argv, "--delete-data");
+      g_ptr_array_add (argv, r->key);
+    }
+  else
+    {
+      g_ptr_array_add (argv, "luma-appctl");
+      g_ptr_array_add (argv, "remove");
+      g_ptr_array_add (argv, r->application_id && *r->application_id ? r->application_id : r->key);
+      if (!r->keep) g_ptr_array_add (argv, "--delete-data");
+    }
+  g_ptr_array_add (argv, NULL);
+  g_autoptr (GSubprocess) process = g_subprocess_newv ((const char * const *) argv->pdata, G_SUBPROCESS_FLAGS_NONE, &error);
+  if (!process) { cc_luma_fixture_report_write_error (r->s->model, error); return; }
+  g_subprocess_wait_check_async (process, r->s->cancel, removed, r->s);
+}
+
+static void
+moved (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Removal *r = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) { removal_free (r); return; }
+  /* Documents that could not be moved stay where they were: the app is kept too. */
+  if (!reply) cc_luma_fixture_report_write_error (r->s->model, error);
+  else uninstall (r);
+  removal_free (r);
+}
+
+static const char *
+string_member (JsonObject *o, const char *name)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_STRING ? json_node_get_string (n) : NULL;
+}
+
+static gboolean
+change (Perm *s, JsonObject *o, GError **error)
+{
+  const char *op = string_member (o, "op"), *key = string_member (o, "app");
+  if (!op || !key || !*key || !s->apps || !json_object_has_member (s->apps, key))
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "An app permission change names a known app");
+      return FALSE;
+    }
+  if (g_str_equal (op, "detail"))
+    {
+      /* Asked for again on every draw until it arrives: read once, then on Changed and Used. */
+      if (!g_hash_table_contains (s->wanted, key))
+        {
+          g_hash_table_add (s->wanted, g_strdup (key));
+          read_detail (s, key);
+        }
+      return TRUE;
+    }
+  if (g_str_equal (op, "folder"))
+    {
+      const char *folder = string_member (o, "folder");
+      if (!folder || !*folder || strchr (folder, '/') || folder[0] == '.')
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "A folder is one of the folders in your home folder");
+          return FALSE;
+        }
+      call (s, "SetFolder", g_variant_new ("(ssb)", key, folder, member_bool (o, "on", TRUE)));
+      return TRUE;
+    }
+  if (g_str_equal (op, "restart"))
+    {
+      /* The shell asks the app to quit the normal way and opens it again (RestartRequested). */
+      call (s, "RestartApp", g_variant_new ("(s)", key));
+      return TRUE;
+    }
+  if (g_str_equal (op, "remove"))
+    {
+      JsonObject *entry = json_object_get_object_member (s->apps, key);
+      Removal *r = g_new0 (Removal, 1);
+      r->s = s;
+      r->key = g_strdup (key);
+      r->keep = member_bool (o, "keep", TRUE);
+      r->application_id = g_strdup (string_member (entry, "application_id"));
+      r->format = g_strdup (string_member (entry, "format"));
+      r->installation = g_strdup (string_member (entry, "installation"));
+      if (member_bool (o, "move", FALSE))
+        g_dbus_connection_call (s->bus, NAME, PATH, IFACE, "MoveStrayDocuments", g_variant_new ("(s)", key),
+                                G_VARIANT_TYPE ("(as)"), G_DBUS_CALL_FLAGS_NONE, 60000, s->cancel, moved, r);
+      else
+        {
+          uninstall (r);
+          removal_free (r);
+        }
+      return TRUE;
+    }
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "Unknown app permission change: %s", op);
+  return FALSE;
+}
+
+static gboolean
+perm_write (gpointer state, const char *name, JsonNode *value, GError **error)
+{
+  Perm *s = state;
+  if (!g_str_equal (name, CC_LUMA_APP_PERM_WRITE) && !g_str_has_prefix (name, "apperm_")) return FALSE;
+  if (!s->present)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "App permissions are not available");
+      return FALSE;
+    }
+  if (g_str_equal (name, CC_LUMA_APP_PERM_WRITE))
+    {
+      JsonObject *o = value && JSON_NODE_HOLDS_OBJECT (value) ? json_node_get_object (value) : NULL;
+      if (!o)
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "An app permission change is an object");
+          return FALSE;
+        }
+      return change (s, o, error);
+    }
+  /* apperm_<field>_<munged>, field one of level, net, bg, auto, files or dev_<row>. */
+  const char *rest = name + strlen ("apperm_");
+  const char *key = NULL;
+  g_autofree char *field = NULL;
+  const char *fields[] = { "level", "net", "bg", "auto", "files" };
+  for (guint i = 0; !field && i < G_N_ELEMENTS (fields); i++)
+    if (g_str_has_prefix (rest, fields[i]) && rest[strlen (fields[i])] == '_')
+      field = g_strdup (fields[i]);
+  for (guint r = 0; !field && r < G_N_ELEMENTS (device_rows); r++)
+    {
+      g_autofree char *f = g_strconcat ("dev_", device_rows[r].row, NULL);
+      if (g_str_has_prefix (rest, f) && rest[strlen (f)] == '_') field = g_steal_pointer (&f);
+    }
+  if (field) key = g_hash_table_lookup (s->by_munged, rest + strlen (field) + 1);
+  if (!key)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "No such app: %s", name);
+      return FALSE;
+    }
+  gboolean flag = value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_BOOLEAN && json_node_get_boolean (value);
+  if (g_str_equal (field, "level"))
+    {
+      const char *level = value && JSON_NODE_HOLDS_VALUE (value) && json_node_get_value_type (value) == G_TYPE_STRING ? json_node_get_string (value) : NULL;
+      if (g_strcmp0 (level, "chooser") && g_strcmp0 (level, "folders") && g_strcmp0 (level, "all"))
+        {
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "A file level is chooser, folders or all");
+          return FALSE;
+        }
+      call (s, "SetFileLevel", g_variant_new ("(ss)", key, level));
+    }
+  else if (g_str_equal (field, "files"))
+    call (s, "SetFileLevel", g_variant_new ("(ss)", key, flag ? "all" : "chooser"));
+  else if (g_str_equal (field, "net"))
+    call (s, "SetNetwork", g_variant_new ("(sb)", key, flag));
+  else if (g_str_equal (field, "bg"))
+    call (s, "SetBackground", g_variant_new ("(sb)", key, flag));
+  else if (g_str_equal (field, "auto"))
+    call (s, "SetAutostart", g_variant_new ("(sb)", key, flag));
+  else if (g_str_has_prefix (field, "dev_"))
+    {
+      /* One row may stand for several kinds (USB: usb, hid, lighting): only those the app has. */
+      JsonObject *detail = s->detail && json_object_has_member (s->detail, key) ? json_object_get_object_member (s->detail, key) : NULL;
+      JsonArray *devices = detail && json_object_has_member (detail, "devices") ? json_object_get_array_member (detail, "devices") : NULL;
+      for (guint r = 0; r < G_N_ELEMENTS (device_rows); r++)
+        {
+          if (!g_str_equal (field + 4, device_rows[r].row)) continue;
+          gboolean sent = FALSE;
+          for (guint i = 0; device_rows[r].kinds[i]; i++)
+            for (guint d = 0; devices && d < json_array_get_length (devices); d++)
+              if (!g_strcmp0 (json_object_get_string_member_with_default (json_array_get_object_element (devices, d), "kind", ""),
+                              device_rows[r].kinds[i]))
+                {
+                  call (s, "SetDevice", g_variant_new ("(ssb)", key, device_rows[r].kinds[i], flag));
+                  sent = TRUE;
+                  break;
+                }
+          if (!sent)
+            call (s, "SetDevice", g_variant_new ("(ssb)", key, device_rows[r].kinds[0], flag));
+        }
+    }
+  else
+    return FALSE;
+  return TRUE;
+}
+
+static gpointer
+perm_start (CcLumaFixture *model)
+{
+  Perm *s = g_new0 (Perm, 1);
+  s->model = model;
+  s->cancel = g_cancellable_new ();
+  s->detail = json_object_new ();
+  s->all = json_array_new ();
+  s->by_munged = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  s->wanted = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  s->bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  if (!s->bus)
+    {
+      publish (s);
+      mark_ready (s);
+      return s;
+    }
+  cc_luma_fixture_own_key (model, CC_LUMA_APP_PERM_WRITE);
+  cc_luma_fixture_verify_key (model, CC_LUMA_APP_PERM_WRITE);
+  s->props_signal = g_dbus_connection_signal_subscribe (s->bus, NAME, "org.freedesktop.DBus.Properties", "PropertiesChanged",
+                                                        PATH, IFACE, G_DBUS_SIGNAL_FLAGS_NONE, service_signal, s, NULL);
+  s->changed_signal = g_dbus_connection_signal_subscribe (s->bus, NAME, IFACE, "Changed", PATH, NULL,
+                                                          G_DBUS_SIGNAL_FLAGS_NONE, service_signal, s, NULL);
+  s->used_signal = g_dbus_connection_signal_subscribe (s->bus, NAME, IFACE, "Used", PATH, NULL,
+                                                       G_DBUS_SIGNAL_FLAGS_NONE, service_signal, s, NULL);
+  s->watch = g_bus_watch_name_on_connection (s->bus, NAME, G_BUS_NAME_WATCHER_FLAGS_NONE, appeared, vanished, s, NULL);
+  read_apps (s);
+  return s;
+}
+
+static void
+perm_stop (gpointer state)
+{
+  Perm *s = state;
+  g_cancellable_cancel (s->cancel);
+  if (s->watch) g_bus_unwatch_name (s->watch);
+  for (guint *id = (guint[]) { s->props_signal, s->changed_signal, s->used_signal, 0 }; *id; id++)
+    g_dbus_connection_signal_unsubscribe (s->bus, *id);
+  g_clear_object (&s->bus);
+  g_clear_pointer (&s->apps, json_object_unref);
+  g_clear_pointer (&s->detail, json_object_unref);
+  g_clear_pointer (&s->all, json_array_unref);
+  g_clear_pointer (&s->by_munged, g_hash_table_unref);
+  g_clear_pointer (&s->wanted, g_hash_table_unref);
+  /* Replies in flight hold s: leak the small shell rather than let a late one touch freed memory. */
+  g_clear_object (&s->cancel);
+}
+
+const CcLumaAdapter cc_luma_adapter_app_permissions = {
+  ADAPTER, (const char * const[]) { "all-files", "app:", NULL }, perm_start, perm_write, perm_stop
+};
