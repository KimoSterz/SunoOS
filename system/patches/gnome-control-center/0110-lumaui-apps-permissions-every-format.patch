+static void
+app_open (GtkButton *button, View *v)
+{
+  JsonNode *all = json_object_get_member (cc_luma_fixture_get_data (v->model), "CFAPPINFO");
+  JsonNode *entry = all && JSON_NODE_HOLDS_OBJECT (all) ? json_object_get_member (json_node_get_object (all), v->page + 4) : NULL;
+  const char *id = entry && JSON_NODE_HOLDS_OBJECT (entry) ? json_object_get_string_member_with_default (json_node_get_object (entry), "desktopId", NULL) : NULL;
+  g_autoptr (GDesktopAppInfo) info = id && cc_luma_fixture_is_live (v->model) ? g_desktop_app_info_new (id) : NULL;
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_fixture_is_live (v->model)) return;
+  if (!info) error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "This app is no longer installed");
+  else
+    {
+      g_autoptr (GdkAppLaunchContext) context = gdk_display_get_app_launch_context (gtk_widget_get_display (v->root));
+      g_app_info_launch (G_APP_INFO (info), NULL, G_APP_LAUNCH_CONTEXT (context), &error);
+    }
+  if (error) cc_luma_view_report_error (v, error);
+}
