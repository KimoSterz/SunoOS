+static char *
+doc_size (gint64 bytes)
+{
+  return bytes >= 1000 * 1000 ? g_strdup_printf ("%.1f MB", bytes / 1e6)
+       : bytes >= 1000 ? g_strdup_printf ("%" G_GINT64_FORMAT " KB", bytes / 1000)
+       : g_strdup_printf ("%" G_GINT64_FORMAT " bytes", bytes);
+}
