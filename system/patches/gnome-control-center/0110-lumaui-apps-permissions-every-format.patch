diff --git a/shell/cc-luma-view-app-permissions.c b/shell/cc-luma-view-app-permissions.c
new file mode 100644
index 0000000..be49100
--- /dev/null
+++ b/shell/cc-luma-view-app-permissions.c
@@ -0,0 +1,978 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* App permissions for every format (ADR-052 step 3; design-center 8bd4ccf,
+ * mockups/app-perms/settings.html): one page per app, whatever its format,
+ * and Apps › Apps that can use all your files. Read from CFAPPPERM
+ * (cc-luma-app-permissions.h); controls write the bound per-app keys and
+ * "appPerm", which the live adapter hands to org.projectluma.AppPermissions1.
+ * Top to bottom: header, hero, Files, Devices, Network and background,
+ * On screen, Used recently, Remove. */
+#include "cc-luma-rows.h"
+#include "cc-luma-app-permissions.h"
+#include <gio/gdesktopappinfo.h>
+#include <string.h>
+
+/* On screen (layer permissions, gnome-control-center 0109): drawn here when
+ * that patch is in the build, which defines it; until then the slot is empty. */
+gboolean cc_luma_view_on_screen_render (View *v, const char *settings_app) __attribute__ ((weak));
+
+#define NEVER_KEYS "Everything in your home folder, never keys or passwords"
+#define ALL_NOTE "They can open anything in your home folder. They can never reach your keys, passwords, browser profiles, other apps’ data, or what runs when you sign in. Turn one off to give it only the file picker."
+
+static const struct { const char *row, *title, *icon; } devices[] = {
+  { "camera", "Camera", "camera" }, { "microphone", "Microphone", "mic" }, { "location", "Location", "map-pin" },
+  { "screen", "Screen", "monitor" }, { "usb", "USB", "usb" }, { "controller", "Controllers", "gamepad-2" },
+  { "serial", "Serial", "cable" },
+};
+/* "Other devices": the rest, by the words the reference lists them in. */
+static const char *other_words[] = { "camera", "microphone", "location", "screen", "USB", "controllers", "serial ports" };
+
+static const char *
+row_of_kind (const char *kind)
+{
+  if (!g_strcmp0 (kind, "hid") || !g_strcmp0 (kind, "lighting")) return "usb";
+  return kind;
+}
+
+static gint64
+now_seconds (JsonObject *perm)
+{
+  /* Fixtures pin the clock so their "2 min ago" stays put. */
+  JsonNode *pinned = perm ? json_object_get_member (perm, "now") : NULL;
+  return pinned && JSON_NODE_HOLDS_VALUE (pinned) ? json_node_get_int (pinned) : g_get_real_time () / G_USEC_PER_SEC;
+}
+
+/* "Now", "2 min ago", "Today", "Yesterday", "3 days ago". */
+static char *
+when_text (gint64 when, gint64 now)
+{
+  if (when <= 0) return g_strdup ("");
+  gint64 ago = MAX (0, now - when);
+  if (ago < 60) return g_strdup ("Now");
+  if (ago < 3600) return g_strdup_printf ("%" G_GINT64_FORMAT " min ago", ago / 60);
+  g_autoptr (GDateTime) then = g_date_time_new_from_unix_local (when), today = g_date_time_new_from_unix_local (now);
+  int days = g_date_time_get_day_of_year (today) - g_date_time_get_day_of_year (then) +
+             365 * (g_date_time_get_year (today) - g_date_time_get_year (then));
+  if (days <= 0) return g_strdup ("Today");
+  if (days == 1) return g_strdup ("Yesterday");
+  return g_strdup_printf ("%d days ago", days);
+}
+
+static char *
+lower_first (const char *text)
+{
+  if (!text || !*text) return g_strdup ("");
+  g_autofree char *head = g_utf8_strdown (text, g_utf8_next_char (text) - text);
+  return g_strconcat (head, g_utf8_next_char (text), NULL);
+}
+
+static const char *
+format_word (const char *format)
+{
+  static const struct { const char *format, *word; } words[] = {
+    { "flatpak", "Flatpak" }, { "deb", "Debian package" }, { "rpm", "Fedora package" }, { "appimage", "AppImage" },
+    { "archive", "App archive" }, { "android", "Android app" }, { "windows", "Windows app" }, { "snap", "Snap" },
+  };
+  for (guint i = 0; i < G_N_ELEMENTS (words); i++)
+    if (!g_strcmp0 (format, words[i].format)) return words[i].word;
+  return format && *format ? format : "App";
+}
+
+/* "Flatpak · from Flathub", "Debian package · from Debian 12", "Built in", "Depot". */
+static char *
+origin_line (JsonObject *entry)
+{
+  const char *format = json_object_get_string_member_with_default (entry, "format", "");
+  const char *origin = json_object_get_string_member_with_default (entry, "origin", "");
+  if (!g_strcmp0 (origin, "Built in") || !g_strcmp0 (origin, "Depot")) return g_strdup (origin);
+  if (!*origin) return g_strdup (format_word (format));
+  return g_strdup_printf ("%s · from %s", format_word (format), origin);
+}
+
+static gboolean
+bool_member (JsonObject *o, const char *name, gboolean fallback)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && json_node_get_value_type (n) == G_TYPE_BOOLEAN ? json_node_get_boolean (n) : fallback;
+}
+
+static gint64
+int_member (JsonObject *o, const char *name)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_VALUE (n) && (json_node_get_value_type (n) == G_TYPE_INT64 || json_node_get_value_type (n) == G_TYPE_DOUBLE)
+    ? json_node_get_int (n) : 0;
+}
+
+static JsonArray *
+array_member (JsonObject *o, const char *name)
+{
+  JsonNode *n = o ? json_object_get_member (o, name) : NULL;
+  return n && JSON_NODE_HOLDS_ARRAY (n) ? json_node_get_array (n) : NULL;
+}
+
+static gboolean
+in_array (JsonArray *a, const char *value)
+{
+  for (guint i = 0; a && i < json_array_get_length (a); i++)
+    if (!g_strcmp0 (json_array_get_string_element (a, i), value)) return TRUE;
+  return FALSE;
+}
+
+/* A write the live adapter carries out; a fixture keeps its own copy. */
+static void
+send (View *v, JsonObject *change)
+{
+  g_autoptr (JsonNode) value = json_node_init_object (json_node_alloc (), json_object_ref (change));
+  g_autoptr (GError) error = NULL;
+  if (!cc_luma_fixture_write (v->model, CC_LUMA_APP_PERM_WRITE, value, &error))
+    {
+      cc_luma_view_report_error (v, error);
+      cc_luma_view_queue_refresh (v);
+    }
+}
+
+/* ── the Files group ───────────────────────────────────────────────── */
+
+static void
+folder_change (View *v, const char *key, const char *folder, gboolean on)
+{
+  JsonObject *perm = cc_luma_app_perm_data (cc_luma_fixture_get_data (v->model));
+  if (!cc_luma_fixture_is_live (v->model))
+    {
+      JsonObject *entry = cc_luma_app_perm_entry (perm, "apps", key);
+      JsonArray *folders = array_member (entry, "folders");
+      if (!folders) return;
+      if (on && !in_array (folders, folder)) json_array_add_string_element (folders, folder);
+      for (guint i = 0; !on && i < json_array_get_length (folders); i++)
+        if (!g_strcmp0 (json_array_get_string_element (folders, i), folder)) { json_array_remove_element (folders, i); break; }
+      cc_luma_view_queue_refresh (v);
+      return;
+    }
+  g_autoptr (JsonObject) change = json_object_new ();
+  json_object_set_string_member (change, "op", "folder");
+  json_object_set_string_member (change, "app", key);
+  json_object_set_string_member (change, "folder", folder);
+  json_object_set_boolean_member (change, "on", on);
+  send (v, change);
+}
+
+static void
+folder_removed (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (v) folder_change (v, g_object_get_data (G_OBJECT (button), "ap-key"), g_object_get_data (G_OBJECT (button), "ap-folder"), FALSE);
+}
+
+typedef struct { GtkWidget *root; char *key; } Pick;
+
+static void
+folder_picked (GObject *source, GAsyncResult *result, gpointer data)
+{
+  Pick *pick = data;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GFile) folder = gtk_file_dialog_select_folder_finish (GTK_FILE_DIALOG (source), result, &error);
+  View *v = pick->root ? g_object_get_data (G_OBJECT (pick->root), "cf-view") : NULL;
+  if (folder && v)
+    {
+      g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+      g_autoptr (GFile) parent = g_file_get_parent (folder);
+      g_autofree char *name = g_file_get_basename (folder);
+      if (parent && g_file_equal (parent, home) && name && name[0] != '.')
+        folder_change (v, pick->key, name, TRUE);
+      else
+        {
+          g_autoptr (GError) why = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                                                       "Choose one of the folders in your home folder");
+          cc_luma_view_report_error (v, why);
+        }
+    }
+  g_clear_object (&pick->root);
+  g_free (pick->key);
+  g_free (pick);
+}
+
+static void
+folder_add (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  g_autoptr (GtkFileDialog) dialog = gtk_file_dialog_new ();
+  g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+  gtk_file_dialog_set_title (dialog, "Add a folder");
+  gtk_file_dialog_set_initial_folder (dialog, home);
+  Pick *pick = g_new0 (Pick, 1);
+  pick->root = g_object_ref (root);
+  pick->key = g_strdup (g_object_get_data (G_OBJECT (button), "ap-key"));
+  gtk_file_dialog_select_folder (dialog, GTK_WINDOW (gtk_widget_get_root (GTK_WIDGET (button))), NULL, folder_picked, pick);
+}
+
+static GtkWidget *
+folder_chip (View *v, const char *key, const char *folder)
+{
+  GtkWidget *chip = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  GtkWidget *glyph = luma_ui_icon_new ("folder"), *name = gtk_label_new (folder);
+  GtkWidget *x = gtk_button_new ();
+  gtk_widget_add_css_class (chip, "ap-fld");
+  gtk_widget_add_css_class (glyph, "ap-fld-glyph");
+  gtk_button_set_child (GTK_BUTTON (x), luma_ui_icon_new ("x"));
+  gtk_widget_add_css_class (x, "ap-fld-x");
+  g_autofree char *spoken = g_strdup_printf ("Remove %s", folder);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (x), GTK_ACCESSIBLE_PROPERTY_LABEL, spoken, -1);
+  gtk_widget_set_tooltip_text (x, spoken);
+  g_object_set_data_full (G_OBJECT (x), "ap-key", g_strdup (key), g_free);
+  g_object_set_data_full (G_OBJECT (x), "ap-folder", g_strdup (folder), g_free);
+  g_signal_connect_object (x, "clicked", G_CALLBACK (folder_removed), v->root, 0);
+  g_autofree char *name_id = g_strconcat ("ap-fld-", folder, NULL);
+  gtk_widget_set_name (chip, name_id);
+  gtk_box_append (GTK_BOX (chip), glyph);
+  gtk_box_append (GTK_BOX (chip), name);
+  gtk_box_append (GTK_BOX (chip), x);
+  return chip;
+}
+
+static void
+folders_row (View *v, GtkBox *card, const char *key, JsonArray *folders, gboolean editable)
+{
+  GtkWidget *flow = adw_wrap_box_new ();
+  adw_wrap_box_set_child_spacing (ADW_WRAP_BOX (flow), 6);
+  adw_wrap_box_set_line_spacing (ADW_WRAP_BOX (flow), 6);
+  gtk_widget_add_css_class (flow, "ap-flds");
+  gtk_widget_set_name (flow, "ap-folders");
+  for (guint i = 0; folders && i < json_array_get_length (folders); i++)
+    adw_wrap_box_append (ADW_WRAP_BOX (flow), folder_chip (v, key, json_array_get_string_element (folders, i)));
+  GtkWidget *add = gtk_button_new ();
+  GtkWidget *line = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  gtk_box_append (GTK_BOX (line), luma_ui_icon_new ("plus"));
+  gtk_box_append (GTK_BOX (line), gtk_label_new ("Add folder"));
+  gtk_button_set_child (GTK_BUTTON (add), line);
+  gtk_widget_add_css_class (add, "ap-fld");
+  gtk_widget_add_css_class (add, "add");
+  gtk_widget_set_name (add, "ap-fld-add");
+  gtk_widget_set_sensitive (add, editable);
+  g_object_set_data_full (G_OBJECT (add), "ap-key", g_strdup (key), g_free);
+  g_signal_connect_object (add, "clicked", G_CALLBACK (folder_add), v->root, 0);
+  adw_wrap_box_append (ADW_WRAP_BOX (flow), add);
+  gtk_box_append (card, flow);
+}
