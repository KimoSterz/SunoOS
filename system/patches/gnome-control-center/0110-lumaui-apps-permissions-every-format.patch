+/* ── Devices ───────────────────────────────────────────────────────── */
+
+/* The words under a row: its own, then its usage; green while in use now. */
+static GtkWidget *
+usage_words (const char *words, const char *use, gboolean now)
+{
+  g_autofree char *text = words && *words && use && *use ? g_strconcat (words, " · ", use, NULL)
+                                                         : g_strdup (words && *words ? words : use);
+  GtkWidget *label = cf_text (text, "cf-sub");
+  luma_ui_apply_type_full (label, "row-subtitle", TRUE);
+  gtk_label_set_wrap (GTK_LABEL (label), TRUE);
+  gtk_label_set_wrap_mode (GTK_LABEL (label), PANGO_WRAP_WORD);
+  gtk_label_set_xalign (GTK_LABEL (label), 0);
+  if (now) gtk_widget_add_css_class (label, "ap-now");
+  return label;
+}
+
+/* A switch row bound to key, with words under the title (v70 rSw with a usage line). */
+static GtkWidget *
+switch_row (View *v, GtkBox *card, const char *key, const char *icon, const char *title, GtkWidget *words)
+{
+  GtkWidget *row = cf_sw (v, card, key, title, NULL, cf_lead_icon (icon));
+  GtkWidget *line = gtk_button_get_child (GTK_BUTTON (row));
+  for (GtkWidget *c = line ? gtk_widget_get_first_child (line) : NULL; c; c = gtk_widget_get_next_sibling (c))
+    if (gtk_widget_has_css_class (c, "cf-t")) gtk_box_append (GTK_BOX (c), words);
+  return row;
+}
