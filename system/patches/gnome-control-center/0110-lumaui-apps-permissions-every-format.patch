+/* The reference's check sits beside the first line of its words (.ap-ck: flex, start). */
+static GtkWidget *
+remove_check (GtkWidget *sheet, GtkWidget *inner, const char *title, const char *line, const char *name, const char *key)
+{
+  GtkWidget *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+  gtk_widget_add_css_class (row, "ap-ck");
+  GtkWidget *check = gtk_check_button_new ();
+  gtk_widget_set_valign (check, GTK_ALIGN_START);
+  gtk_check_button_set_active (GTK_CHECK_BUTTON (check), TRUE);
+  gtk_widget_set_name (check, name);
+  gtk_accessible_update_property (GTK_ACCESSIBLE (check), GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+  gtk_box_append (GTK_BOX (row), check);
+  GtkWidget *words = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_set_hexpand (words, TRUE);
+  GtkWidget *t = gtk_label_new (title);
+  gtk_label_set_xalign (GTK_LABEL (t), 0);
+  gtk_widget_add_css_class (t, "ap-ck-title");
+  gtk_box_append (GTK_BOX (words), t);
+  if (line)
+    {
+      GtkWidget *l = gtk_label_new (line);
+      gtk_label_set_xalign (GTK_LABEL (l), 0);
+      gtk_label_set_wrap (GTK_LABEL (l), TRUE);
+      gtk_label_set_max_width_chars (GTK_LABEL (l), 1);
+      gtk_widget_add_css_class (l, "ap-ck-line");
+      gtk_box_append (GTK_BOX (words), l);
+    }
+  GtkGesture *click = gtk_gesture_click_new ();
+  g_signal_connect (click, "pressed", G_CALLBACK (check_words_pressed), check);
+  gtk_widget_add_controller (words, GTK_EVENT_CONTROLLER (click));
+  gtk_box_append (GTK_BOX (row), words);
+  gtk_box_append (GTK_BOX (inner), row);
+  g_object_set_data (G_OBJECT (sheet), key, check);
+  return check;
+}
