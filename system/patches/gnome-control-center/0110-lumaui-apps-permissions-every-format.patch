+static void
+remove_group (View *v, const char *key, const char *name)
+{
+  GtkBox *card = cf_group (v, NULL, NULL);
+  gtk_widget_set_name (gtk_widget_get_parent (GTK_WIDGET (card)), "ap-remove");
+  g_autofree char *title = g_strdup_printf ("Remove %s", name);
+  GtkWidget *row = cf_bt (v, card, title, "You choose whether to keep its data", "Remove…", TRUE, G_CALLBACK (remove_clicked));
+  GtkWidget *c = gtk_widget_get_last_child (row);
+  GtkWidget *button = c ? gtk_widget_get_first_child (c) : NULL;
+  if (button)
+    {
+      gtk_widget_set_name (button, "ap-remove-button");
+      g_object_set_data_full (G_OBJECT (button), "ap-key", g_strdup (key), g_free);
+      g_object_set_data_full (G_OBJECT (button), "ap-name", g_strdup (name), g_free);
+    }
+}
