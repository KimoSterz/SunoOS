+static GtkWidget *
+hero_icon (View *v, const char *app, int size)
+{
+  GtkWidget *fixed = gtk_fixed_new ();
+  GtkWidget *picture = cc_luma_view_image (v, app, size, size);
+  gtk_widget_set_size_request (picture, size, size);
+  gtk_widget_add_css_class (picture, "cf-img");
+  gtk_fixed_put (GTK_FIXED (fixed), picture, 0, 0);
+  gtk_widget_set_size_request (fixed, size, size);
+  gtk_widget_set_valign (fixed, GTK_ALIGN_CENTER);
+  return fixed;
+}
