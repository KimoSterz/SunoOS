+static void
+remove_clicked (GtkButton *button, View *v)
+{
+  const char *key = g_object_get_data (G_OBJECT (button), "ap-key");
+  const char *name = g_object_get_data (G_OBJECT (button), "ap-name");
+  JsonObject *perm = cc_luma_app_perm_data (cc_luma_fixture_get_data (v->model));
+  JsonObject *detail = cc_luma_app_perm_entry (perm, "detail", key);
+  JsonArray *docs = array_member (detail, "stray_documents");
+  JsonArray *sizes = array_member (detail, "stray_sizes");
+  guint count = docs ? json_array_get_length (docs) : 0;
+  gboolean phone = luma_ui_mobile_form_factor () || luma_ui_is_phone_width (v->root);
+  /* The window's own TV frame says whether it is on a TV (its type is already x1.5 there). */
+  GtkRoot *window = gtk_widget_get_root (v->root);
+  gboolean tv = !phone && GTK_IS_WINDOW (window) && luma_window_get_tv_active (GTK_WINDOW (window));
+
+  GtkWidget *sheet = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_set_name (sheet, "ap-remove-sheet");
+  gtk_widget_add_css_class (sheet, "lumaui-dialog");
+  gtk_widget_add_css_class (sheet, "ap-rm");
+  if (phone) gtk_widget_add_css_class (sheet, "phone");
+  if (tv)
+    {
+      remove_tv_style (sheet);
+      gtk_widget_add_css_class (sheet, "tv");
+    }
+  /* The sheet's surface and its documents' well are drawn per appearance (settings.html ?mode=light). */
+  if (!adw_style_manager_get_dark (adw_style_manager_get_default ())) gtk_widget_add_css_class (sheet, "light");
+  /* The sheet's column is as wide as the design's (392, x1.5 on a TV): its words wrap to it
+   * rather than widening the sheet. */
+  GtkWidget *inner = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  GtkWidget *clamp = adw_clamp_new ();
+  adw_clamp_set_maximum_size (ADW_CLAMP (clamp), tv ? 588 : 392);
+  adw_clamp_set_tightening_threshold (ADW_CLAMP (clamp), tv ? 588 : 392);
+  adw_clamp_set_child (ADW_CLAMP (clamp), inner);
+  gtk_box_append (GTK_BOX (sheet), clamp);
+  g_autofree char *title = g_strdup_printf ("Remove %s?", name);
+  GtkWidget *heading = gtk_label_new (title);
+  gtk_label_set_xalign (GTK_LABEL (heading), 0);
+  gtk_label_set_wrap (GTK_LABEL (heading), TRUE);
+  gtk_widget_add_css_class (heading, "ap-rm-title");
+  gtk_box_append (GTK_BOX (inner), heading);
+  /* ADR §2.4: documents it kept in its own data folder are named, with their sizes. */
+  g_autofree char *said = count ? g_strdup_printf ("These documents are in %s’s own data:", name)
+                                : g_strdup_printf ("%s leaves this computer. You can install it again.", name);
+  GtkWidget *body = gtk_label_new (said);
+  gtk_label_set_xalign (GTK_LABEL (body), 0);
+  gtk_label_set_wrap (GTK_LABEL (body), TRUE);
+  gtk_label_set_max_width_chars (GTK_LABEL (body), 1);
+  gtk_widget_add_css_class (body, "ap-rm-body");
+  gtk_box_append (GTK_BOX (inner), body);
+  if (count)
+    {
+      GtkWidget *well = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+      gtk_widget_add_css_class (well, "ap-docs");
+      for (guint i = 0; i < MIN (count, 6); i++)
+        {
+          GtkWidget *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+          gtk_widget_add_css_class (row, "ap-doc");
+          gtk_box_append (GTK_BOX (row), luma_ui_icon_new ("file-text"));
+          g_autofree char *base = g_path_get_basename (json_array_get_string_element (docs, i));
+          GtkWidget *what = gtk_label_new (base);
+          gtk_label_set_xalign (GTK_LABEL (what), 0);
+          gtk_label_set_ellipsize (GTK_LABEL (what), PANGO_ELLIPSIZE_MIDDLE);
+          gtk_widget_set_hexpand (what, TRUE);
+          gtk_box_append (GTK_BOX (row), what);
+          if (sizes && i < json_array_get_length (sizes))
+            {
+              g_autofree char *size = doc_size (json_array_get_int_element (sizes, i));
+              GtkWidget *how = gtk_label_new (size);
+              gtk_widget_add_css_class (how, "ap-doc-size");
+              gtk_box_append (GTK_BOX (row), how);
+            }
+          gtk_box_append (GTK_BOX (well), row);
+        }
+      if (count > 6)
+        {
+          g_autofree char *more = g_strdup_printf ("and %u more", count - 6);
+          GtkWidget *row = gtk_label_new (more);
+          gtk_label_set_xalign (GTK_LABEL (row), 0);
+          gtk_widget_add_css_class (row, "ap-doc");
+          gtk_widget_add_css_class (row, "more");
+          gtk_box_append (GTK_BOX (well), row);
+        }
+      gtk_box_append (GTK_BOX (inner), well);
+      remove_check (sheet, inner, "Move them to Documents", NULL, "ap-remove-move", "ap-move");
+    }
+  g_autofree char *stays = g_strdup_printf ("Its settings and history stay, so %s picks up where it left off if you install it again.", name);
+  remove_check (sheet, inner, "Keep its data", stays, "ap-remove-keep", "ap-keep");
+
+  GtkWidget *actions = gtk_box_new (phone ? GTK_ORIENTATION_VERTICAL : GTK_ORIENTATION_HORIZONTAL, 8);
+  gtk_widget_add_css_class (actions, "ap-rma");
+  if (!phone) gtk_widget_set_halign (actions, GTK_ALIGN_END);
+  GtkWidget *cancel = luma_text_button_new ("Cancel", NULL, NULL);
+  GtkWidget *go = luma_text_button_new ("Remove", NULL, "fill");
+  gtk_widget_set_name (cancel, "ap-remove-cancel");
+  gtk_widget_set_name (go, "ap-remove-confirm");
+  gtk_widget_add_css_class (go, "ap-danger");
+  /* A phone stacks them, the action on top (the reference's column-reverse). */
+  gtk_box_append (GTK_BOX (actions), phone ? go : cancel);
+  gtk_box_append (GTK_BOX (actions), phone ? cancel : go);
+  gtk_box_append (GTK_BOX (inner), actions);
+  g_signal_connect (cancel, "clicked", G_CALLBACK (remove_cancel), sheet);
+  g_signal_connect (go, "clicked", G_CALLBACK (remove_go), sheet);
+
+  g_object_set_data_full (G_OBJECT (sheet), "ap-key", g_strdup (key), g_free);
+  g_object_set_data (G_OBJECT (sheet), "ap-root", v->root);
+  LumaLayerHost *host = luma_layer_host_window_host (v->root);
+  if (!host)
+    {
+      g_object_ref_sink (sheet);
+      g_object_unref (sheet);
+      return;
+    }
+  LumaModalHandle *handle = luma_layer_host_present_modal (host, sheet, cancel,
+                                                           phone ? LUMA_DRAWER_MODE_ALWAYS : LUMA_DRAWER_MODE_NEVER);
+  g_object_set_data (G_OBJECT (sheet), "ap-handle", handle);
+  if (tv) gtk_widget_grab_focus (cancel);
+}
