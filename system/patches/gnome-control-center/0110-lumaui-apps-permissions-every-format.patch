+/* A running app that takes the change only at its next start (a Flatpak): the last row of
+ * Files says so, with Restart beside it (settings.html?pending). */
+static void
+pending_row (View *v, GtkBox *card, const char *key, const char *name)
+{
+  g_autofree char *title = g_strdup_printf ("%s is open", name);
+  g_autofree char *label = g_strdup_printf ("Restart %s", name);
+  GtkWidget *row = cf_bt (v, card, title, "This change applies the next time it opens", label, FALSE,
+                          G_CALLBACK (restart_clicked));
+  gtk_widget_set_name (row, "ap-pending");
+  gtk_widget_add_css_class (row, "ap-pend");
+  GtkWidget *line = GTK_IS_BUTTON (row) ? gtk_button_get_child (GTK_BUTTON (row)) : row;
+  GtkWidget *lead = cf_lead_icon ("refresh-cw");
+  if (GTK_IS_BOX (line)) gtk_box_prepend (GTK_BOX (line), lead);
+  GtkWidget *c = gtk_widget_get_last_child (row);
+  GtkWidget *button = c ? gtk_widget_get_first_child (c) : NULL;
+  if (button)
+    {
+      gtk_widget_set_name (button, "ap-restart");
+      g_object_set_data_full (G_OBJECT (button), "ap-key", g_strdup (key), g_free);
+    }
+}
+
+static void
+files_group (View *v, const char *key, JsonObject *entry, JsonObject *detail, const char *name)
+{
+  g_autofree char *bound = cc_luma_app_perm_key_name ("level", key);
+  const char *level = cc_luma_view_text (v, bound);
+  const char *declared = detail ? json_object_get_string_member_with_default (detail, "declared_level", "") : "";
+  const char *order[] = { "chooser", "folders", "all" };
+  guint floor = 0;
+  for (guint i = 0; i < G_N_ELEMENTS (order); i++)
+    if (!g_strcmp0 (declared, order[i])) floor = i;
+  GtkBox *card = cf_group (v, "Files", NULL);
+  gtk_widget_set_name (gtk_widget_get_parent (GTK_WIDGET (card)), "ap-files");
+  level_row (v, card, bound, "chooser", "file-search", "File picker only", "Only files you choose", floor <= 0);
+  level_row (v, card, bound, "folders", "folder", "These folders", "Folders you pick", floor <= 1);
+  if (!g_strcmp0 (level, "folders"))
+    folders_row (v, card, key, array_member (entry, "folders"), TRUE);
+  level_row (v, card, bound, "all", "hard-drive", "All your files", NEVER_KEYS, TRUE);
+  if (detail && json_object_get_boolean_member_with_default (detail, "pending_restart", FALSE))
+    pending_row (v, card, key, name);
+}
