+static GtkWidget *
+level_row (View *v, GtkBox *card, const char *bound, const char *value, const char *icon, const char *title,
+           const char *subtitle, gboolean allowed)
+{
+  GtkWidget *row = cf_rd (v, card, bound, value, title, subtitle);
+  /* The reference's radio rows lead with their glyph (cf_rd draws none). */
+  GtkWidget *line = gtk_button_get_child (GTK_BUTTON (row));
+  if (GTK_IS_BOX (line)) gtk_box_prepend (GTK_BOX (line), cf_lead_icon (icon));
+  g_autofree char *name = g_strconcat ("ap-level-", value, NULL);
+  gtk_widget_set_name (row, name);
+  if (!allowed)
+    {
+      /* A Flatpak can't be given less than its package declares (it would lose its files). */
+      gtk_widget_set_sensitive (row, FALSE);
+      gtk_widget_set_tooltip_text (row, "This app needs more to keep its files");
+    }
+  return row;
+}
