+
+gboolean
+cc_luma_view_app_permissions_render (View *v, const char *app, gint64 app_megabytes)
+{
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  JsonObject *perm = cc_luma_app_perm_data (data);
+  const char *key = cc_luma_app_perm_key_for (data, app);
+  JsonObject *entry = cc_luma_app_perm_entry (perm, "apps", key);
+  if (!entry) return FALSE;
+  JsonObject *detail = cc_luma_app_perm_entry (perm, "detail", key);
+  own_glyphs (v->root);
+  if (!detail && cc_luma_fixture_is_live (v->model))
+    {
+      /* Ask once when the page opens; the adapter publishes it and the page draws again. */
+      g_autoptr (JsonObject) change = json_object_new ();
+      json_object_set_string_member (change, "op", "detail");
+      json_object_set_string_member (change, "app", key);
+      send (v, change);
+    }
+  gint64 now = now_seconds (perm);
+  const char *name = cc_luma_fixture_app_name (v->model, app);
+  const char *version = detail ? json_object_get_string_member_with_default (detail, "version", "") : "";
+  gint64 data_mb = detail ? int_member (detail, "data_bytes") / (1000 * 1000) : 0;
+  gint64 total = app_megabytes >= 0 ? app_megabytes : data_mb;
+  g_autofree char *size = total > 0 || detail ? cc_luma_fixture_format_size (total) : NULL;
+  g_autofree char *meta = *version && size ? g_strdup_printf ("Version %s · %s with its data", version, size)
+                          : size ? g_strdup_printf ("%s with its data", size) : g_strdup ("");
+  if (!g_object_get_data (G_OBJECT (v->root), "ap-others-page") || g_strcmp0 (v->drawn_page, v->page))
+    {
+      g_object_set_data (G_OBJECT (v->root), "ap-others-open", NULL);
+      g_object_set_data_full (G_OBJECT (v->root), "ap-others-page", g_strdup (v->page), g_free);
+    }
+  cf_header (v, name, meta, NULL);
+  /* Hero: icon, name, origin with the package glyph, Open. */
+  GtkWidget *identity = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 16);
+  GtkWidget *words = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_add_css_class (identity, "cf-id");
+  gtk_box_append (GTK_BOX (identity), hero_icon (v, app, 56));
+  gtk_widget_set_hexpand (words, TRUE);
+  gtk_widget_set_valign (words, GTK_ALIGN_CENTER);
+  GtkWidget *title = cf_text (name, "cf-now-title");
+  luma_ui_apply_type (title, "hero-title");
+  gtk_box_append (GTK_BOX (words), title);
+  GtkWidget *origin = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+  gtk_widget_add_css_class (origin, "ap-orig");
+  gtk_widget_add_css_class (origin, "cf-now-sub");
+  gtk_widget_set_name (origin, "ap-origin");
+  g_autofree char *line = origin_line (entry);
+  GtkWidget *glyph = luma_ui_icon_new ("package");
+  gtk_widget_add_css_class (glyph, "ap-orig-glyph");
+  GtkWidget *where = cf_text (line, NULL);
+  luma_ui_apply_type_full (where, "meta", TRUE);
+  /* A phone is narrower than the line: it ellipsizes instead of widening the page. */
+  gtk_label_set_ellipsize (GTK_LABEL (where), PANGO_ELLIPSIZE_END);
+  gtk_label_set_ellipsize (GTK_LABEL (title), PANGO_ELLIPSIZE_END);
+  gtk_box_append (GTK_BOX (origin), glyph);
+  gtk_box_append (GTK_BOX (origin), where);
+  gtk_box_append (GTK_BOX (words), origin);
+  gtk_box_append (GTK_BOX (identity), words);
+  GtkWidget *open = cc_luma_view_command_style (v, "Open", G_CALLBACK (app_open), "fill");
+  luma_text_button_set_hero (GTK_BUTTON (open), TRUE);
+  gtk_widget_set_name (open, "cf-app-open");
+  gtk_widget_set_valign (open, GTK_ALIGN_CENTER);
+  gtk_box_append (GTK_BOX (identity), open);
+  cf_hero (v, identity, "cf-app-hero");
+
+  files_group (v, key, entry, detail, name);
+  devices_group (v, key, entry, detail, now);
+  network_group (v, key, detail, now);
+  /* On screen: the four rows exactly as the layer-permissions page draws them. */
+  if (cc_luma_view_on_screen_render)
+    cc_luma_view_on_screen_render (v, app);
+  recent_group (v, detail, now);
+  /* Built-in apps come with Luma and update with it: nothing to remove here. */
+  if (g_strcmp0 (json_object_get_string_member_with_default (entry, "origin", ""), "Built in") != 0)
+    remove_group (v, key, name);
+  return TRUE;
+}
