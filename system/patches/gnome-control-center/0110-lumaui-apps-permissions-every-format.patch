+static const char *
+reason_words (const char *reason)
+{
+  if (!g_strcmp0 (reason, "file-manager")) return "a file manager";
+  if (!g_strcmp0 (reason, "sync")) return "syncs your folders";
+  return "asked for it at install";
+}
+
+/* Where each app was listed when the page opened: a switch moves no row while the page is shown. */
+static GPtrArray *listed;
+
+void
+cc_luma_view_all_files_render (View *v)
+{
+  JsonObject *data = cc_luma_fixture_get_data (v->model);
+  JsonObject *perm = cc_luma_app_perm_data (data);
+  JsonArray *all = array_member (perm, "all");
+  if (!listed) listed = g_ptr_array_new_with_free_func (g_free);
+  if (g_strcmp0 (v->drawn_page, v->page) != 0) g_ptr_array_set_size (listed, 0);
+  for (guint i = 0; all && i < json_array_get_length (all); i++)
+    if (!g_ptr_array_find_with_equal_func (listed, json_array_get_string_element (all, i), g_str_equal, NULL))
+      g_ptr_array_add (listed, g_strdup (json_array_get_string_element (all, i)));
+  g_autofree char *meta = g_strdup_printf ("%u %s", listed->len, listed->len == 1 ? "app" : "apps");
+  cf_header (v, "Apps that can use all your files", meta, NULL);
+  GtkBox *card = cf_group (v, NULL, NULL);
+  gtk_widget_set_name (gtk_widget_get_parent (GTK_WIDGET (card)), "ap-all");
+  for (guint i = 0; i < listed->len; i++)
+    {
+      const char *key = listed->pdata[i];
+      JsonObject *entry = cc_luma_app_perm_entry (perm, "apps", key);
+      const char *settings_app = cc_luma_app_perm_settings_app (data, key);
+      const char *name = entry ? json_object_get_string_member_with_default (entry, "name", key) : key;
+      g_autofree char *where = entry ? origin_line (entry) : g_strdup ("");
+      /* The list says Built in, or the format alone, then why. */
+      const char *format = entry ? json_object_get_string_member_with_default (entry, "format", "") : "";
+      const char *origin = entry ? json_object_get_string_member_with_default (entry, "origin", "") : "";
+      g_autofree char *words = g_strdup_printf ("%s · %s", !g_strcmp0 (origin, "Built in") ? "Built in" : format_word (format),
+                                                reason_words (entry ? json_object_get_string_member_with_default (entry, "reason", "") : ""));
+      g_autofree char *bound = cc_luma_app_perm_key_name ("files", key);
+      GtkWidget *lead = settings_app ? cf_lead_image (v, settings_app) : cf_lead_icon ("hard-drive");
+      GtkWidget *row = cf_sw (v, card, bound, name, words, lead);
+      g_autofree char *row_name = g_strconcat ("ap-all-", settings_app ? settings_app : key, NULL);
+      gtk_widget_set_name (row, row_name);
+      (void) where;
+    }
+  GtkWidget *note = cf_text (ALL_NOTE, "ap-note");
+  gtk_widget_add_css_class (note, "lumaui-t-muted");
+  gtk_label_set_wrap (GTK_LABEL (note), TRUE);
+  gtk_label_set_wrap_mode (GTK_LABEL (note), PANGO_WRAP_WORD);
+  gtk_label_set_xalign (GTK_LABEL (note), 0);
+  gtk_widget_set_name (note, "ap-all-note");
+  gtk_box_append (GTK_BOX (gtk_widget_get_parent (GTK_WIDGET (card))), note);
+}
