+static void
+others_toggled (GtkButton *button, GtkWidget *root)
+{
+  View *v = g_object_get_data (G_OBJECT (root), "cf-view");
+  if (!v) return;
+  gboolean open = !GPOINTER_TO_INT (g_object_get_data (G_OBJECT (v->root), "ap-others-open"));
+  g_object_set_data (G_OBJECT (v->root), "ap-others-open", GINT_TO_POINTER (open));
+  cc_luma_view_queue_refresh (v);
+}
+
+static char *
+device_state (JsonObject *d, gint64 now)
+{
+  if (!d) return g_strdup ("Never asked");
+  const char *state = json_object_get_string_member_with_default (d, "state", "never");
+  gint64 when = int_member (d, "when");
+  g_autofree char *at = when > 0 ? when_text (when, now) : NULL;
+  g_autofree char *at_lower = at ? lower_first (at) : NULL;
+  if (!g_strcmp0 (state, "used"))
+    return at ? (g_str_equal (at, "Now") ? g_strdup ("Using it now") : g_str_equal (at, "Today") ? g_strdup ("Used today")
+                 : g_strdup_printf ("Used %s", at_lower)) : g_strdup ("Used");
+  if (!g_strcmp0 (state, "asked"))
+    {
+      gboolean granted = bool_member (d, "granted", FALSE);
+      g_autofree char *asked = at ? (g_str_equal (at, "Now") || g_str_equal (at, "Today") ? g_strdup ("Asked today") : g_strdup_printf ("Asked %s", at_lower))
+                                  : g_strdup ("Asked");
+      return granted ? g_steal_pointer (&asked) : g_strdup_printf ("%s · not allowed", asked);
+    }
+  return g_strdup ("Never asked");
+}
+
+static void
+devices_group (View *v, const char *key, JsonObject *entry, JsonObject *detail, gint64 now)
+{
+  JsonArray *rows = array_member (detail, "devices"), *uses = array_member (entry, "uses");
+  GtkBox *card = cf_group (v, "Devices", NULL);
+  gtk_widget_set_name (gtk_widget_get_parent (GTK_WIDGET (card)), "ap-devices");
+  gboolean shown[G_N_ELEMENTS (devices)] = { FALSE };
+  /* Rows only for devices it asked for (its package declares them, or it asked) or used. */
+  for (guint r = 0; r < G_N_ELEMENTS (devices); r++)
+    {
+      JsonObject *found = NULL;
+      for (guint i = 0; rows && i < json_array_get_length (rows); i++)
+        {
+          JsonObject *d = json_array_get_object_element (rows, i);
+          if (!g_strcmp0 (row_of_kind (json_object_get_string_member_with_default (d, "kind", "")), devices[r].row)) found = d;
+        }
+      if (!found && !in_array (uses, devices[r].row)) continue;
+      shown[r] = TRUE;
+      g_autofree char *bound = g_strconcat ("dev_", devices[r].row, NULL);
+      g_autofree char *bound_key = cc_luma_app_perm_key_name (bound, key);
+      g_autofree char *state = device_state (found, now);
+      GtkWidget *row = switch_row (v, card, bound_key, devices[r].icon, devices[r].title, usage_words (NULL, state, FALSE));
+      g_autofree char *name = g_strconcat ("ap-dev-", devices[r].row, NULL);
+      gtk_widget_set_name (row, name);
+    }
+  /* The rest: one row naming them, opening in place. */
+  GString *names = g_string_new (NULL);
+  guint rest = 0;
+  for (guint r = 0; r < G_N_ELEMENTS (devices); r++)
+    if (!shown[r]) rest++;
+  for (guint r = 0, n = 0; r < G_N_ELEMENTS (devices); r++)
+    {
+      if (shown[r]) continue;
+      const char *word = other_words[r];
+      if (n == 0) { g_autofree char *cap = g_strdup (word); cap[0] = g_ascii_toupper (cap[0]); g_string_append (names, cap); }
+      else g_string_append_printf (names, "%s%s", n == rest - 1 ? " and " : ", ", word);
+      n++;
+    }
+  if (!rest) { g_string_free (names, TRUE); return; }
+  g_string_append (names, " · never asked");
+  gboolean open = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (v->root), "ap-others-open"));
+  GtkWidget *chevron = luma_ui_icon_new (open ? "chevron-down" : "chevron-right");
+  GtkWidget *row = cf_row (card, cf_lead_icon ("usb"), "Other devices", names->str, chevron, TRUE);
+  gtk_widget_set_name (row, "ap-dev-others");
+  g_signal_connect_object (row, "clicked", G_CALLBACK (others_toggled), v->root, 0);
+  g_string_free (names, TRUE);
+  for (guint r = 0; open && r < G_N_ELEMENTS (devices); r++)
+    {
+      if (shown[r]) continue;
+      g_autofree char *bound = g_strconcat ("dev_", devices[r].row, NULL);
+      g_autofree char *bound_key = cc_luma_app_perm_key_name (bound, key);
+      switch_row (v, card, bound_key, devices[r].icon, devices[r].title, usage_words (NULL, "Never asked", FALSE));
+    }
+}
+
+/* ── Network and background ────────────────────────────────────────── */
+
+static char *
+used_text (JsonObject *detail, const char *what, gint64 now, gboolean *live)
+{
+  JsonArray *recent = array_member (detail, "recent");
+  *live = FALSE;
+  for (guint i = 0; recent && i < json_array_get_length (recent); i++)
+    {
+      JsonObject *r = json_array_get_object_element (recent, i);
+      if (g_strcmp0 (json_object_get_string_member_with_default (r, "what", ""), what)) continue;
+      gint64 when = int_member (r, "when");
+      g_autofree char *at = when_text (when, now);
+      if (now - when < 120) { *live = TRUE; return g_strdup ("Using it now"); }
+      if (g_str_equal (at, "Today") || g_str_has_suffix (at, "min ago")) return g_strdup ("Used today");
+      g_autofree char *lower = lower_first (at);
+      return g_strdup_printf ("Used %s", lower);
+    }
+  return g_strdup ("Never used");
+}
+
+static void
+network_group (View *v, const char *key, JsonObject *detail, gint64 now)
+{
+  GtkBox *card = cf_group (v, "Network and background", NULL);
+  gtk_widget_set_name (gtk_widget_get_parent (GTK_WIDGET (card)), "ap-network");
+  gboolean live = FALSE;
+  g_autofree char *net = used_text (detail, "network", now, &live);
+  g_autofree char *net_key = cc_luma_app_perm_key_name ("net", key);
+  /* Network shows only its usage: green while traffic is live. */
+  gtk_widget_set_name (switch_row (v, card, net_key, "globe", "Network", usage_words (NULL, live ? net : "", live)), "ap-net");
+  g_autofree char *bg = used_text (detail, "background", now, &live);
+  g_autofree char *bg_key = cc_luma_app_perm_key_name ("bg", key);
+  gtk_widget_set_name (switch_row (v, card, bg_key, "refresh-cw", "Run in background",
+                                   usage_words ("Keeps working when its window is closed", bg, FALSE)), "ap-bg");
+  g_autofree char *auto_key = cc_luma_app_perm_key_name ("auto", key);
+  gtk_widget_set_name (switch_row (v, card, auto_key, "power", "Start at sign-in", usage_words ("Opens when you sign in", NULL, FALSE)),
+                       "ap-auto");
+}
+
+/* ── Used recently ─────────────────────────────────────────────────── */
+
+static void
+recent_group (View *v, JsonObject *detail, gint64 now)
+{
+  JsonArray *recent = array_member (detail, "recent");
+  if (!recent || !json_array_get_length (recent)) return;
+  GtkBox *card = cf_group (v, "Used recently", NULL);
+  GtkWidget *group = gtk_widget_get_parent (GTK_WIDGET (card));
+  gtk_widget_set_name (group, "ap-recent");
+  gtk_widget_add_css_class (group, "ap-log");
+  for (guint i = 0; i < MIN (5, json_array_get_length (recent)); i++)
+    {
+      JsonObject *r = json_array_get_object_element (recent, i);
+      const char *what = json_object_get_string_member_with_default (r, "what", "");
+      const char *kind = json_object_get_string_member_with_default (r, "kind", "");
+      const char *note = json_object_get_string_member_with_default (r, "note", "");
+      gboolean folder = !g_strcmp0 (kind, "folder");
+      const char *icon = folder ? "folder" : "usb";
+      const char *title_word = what;
+      for (guint d = 0; !folder && d < G_N_ELEMENTS (devices); d++)
+        if (!g_strcmp0 (row_of_kind (what), devices[d].row)) { icon = devices[d].icon; title_word = devices[d].title; }
+      if (!g_strcmp0 (what, "network")) { icon = "globe"; title_word = "Network"; }
+      if (!g_strcmp0 (what, "background")) { icon = "refresh-cw"; title_word = "Run in background"; }
+      g_autofree char *title = folder ? g_strdup_printf ("%s folder", what) : g_strdup (title_word);
+      /* The service says "refused, offered once"; the page says "Refused · offered once". */
+      g_autofree char *words = NULL;
+      if (*note)
+        {
+          g_auto (GStrv) parts = g_strsplit (note, ", ", 2);
+          g_autofree char *first = g_strdup (parts[0]);
+          first[0] = g_ascii_toupper (first[0]);
+          words = parts[1] ? g_strdup_printf ("%s · %s", first, parts[1]) : g_steal_pointer (&first);
+        }
+      g_autofree char *at = when_text (int_member (r, "when"), now);
+      GtkWidget *value = cf_value (at, FALSE);
+      GtkWidget *row = cf_row (card, cf_lead_icon (icon), title, words, value, FALSE);
+      g_autofree char *name = g_strdup_printf ("ap-recent-%u", i);
+      gtk_widget_set_name (row, name);
+    }
+}
+
+/* ── Remove ────────────────────────────────────────────────────────── */
+
+/* Remove…: Settings' standard sheet (settings.html?page=remove). The documents the app
+ * kept in its own data are named in a well; "Move them to Documents" and "Keep its data"
+ * are checked; Cancel, then Remove in danger text. A drawer on a phone, its actions
+ * stacked full width; remote focus starts on Cancel. */
+static void
+remove_answered (GtkWidget *sheet, gboolean remove)
+{
+  LumaModalHandle *handle = g_object_get_data (G_OBJECT (sheet), "ap-handle");
+  GtkWidget *root = g_object_get_data (G_OBJECT (sheet), "ap-root");
+  View *v = root ? g_object_get_data (G_OBJECT (root), "cf-view") : NULL;
+  const char *key = g_object_get_data (G_OBJECT (sheet), "ap-key");
+  GtkWidget *move = g_object_get_data (G_OBJECT (sheet), "ap-move");
+  GtkWidget *keep = g_object_get_data (G_OBJECT (sheet), "ap-keep");
+  gboolean moving = move && gtk_check_button_get_active (GTK_CHECK_BUTTON (move));
+  gboolean keeping = keep && gtk_check_button_get_active (GTK_CHECK_BUTTON (keep));
+  g_autofree char *app = g_strdup (key);
+  if (handle) luma_modal_handle_close (handle);
+  if (!remove || !v || !app) return;
+  if (!cc_luma_fixture_is_live (v->model))
+    {
+      cc_luma_view_navigate (v, "apps");
+      return;
+    }
+  g_autoptr (JsonObject) change = json_object_new ();
+  json_object_set_string_member (change, "op", "remove");
+  json_object_set_string_member (change, "app", app);
+  json_object_set_boolean_member (change, "keep", keeping);
+  json_object_set_boolean_member (change, "move", moving);
+  send (v, change);
+  cc_luma_view_navigate (v, "apps");
+}
