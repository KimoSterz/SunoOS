--- a/shell/cc-Suno-view-sync.c
+++ b/shell/cc-Suno-view-sync.c
@@ -2054,6 +2054,147 @@ app_data_row (View *v, GtkBox *card, JsonObject *sync, JsonObject *cats)
   cc_Suno_view_bind_navigation (v, row, "sync-apps");
