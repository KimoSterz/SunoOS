diff --git a/tests/templates/lumasync.py b/tests/templates/lumasync.py
new file mode 100644
index 0000000..c026d21
--- /dev/null
+++ b/tests/templates/lumasync.py
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# This file is formatted with Python Black
+# mypy: disable-error-code="misc"
+#
+# A stand-in for luma-connect-syncd's org.projectluma.impl.portal.Sync: it
+# answers with what the frontend passed it, so tests can check the forwarding.
+
+from tests.templates.xdp_utils import init_logger
+
+import dbus
+import dbus.service
+import os
+import tempfile
+import time
+
+
+BUS_NAME = "org.projectluma.ConnectSync1"
+MAIN_OBJ = "/org/projectluma/ConnectSync1/Apps"
+SYSTEM_BUS = False
+MAIN_IFACE = "org.projectluma.impl.portal.Sync"
+
+logger = init_logger(__name__)
+
+
+def load(mock, parameters={}):
+    logger.debug(f"Loading parameters: {parameters}")
+
+
+def _caller(caller):
+    pidfd_ok = False
+    if "pidfd" in caller:
+        fd = caller["pidfd"].take()
+        try:
+            with open(f"/proc/self/fdinfo/{fd}") as f:
+                pidfd_ok = any(line.startswith("Pid:") and int(line.split()[1]) > 0 for line in f)
+        finally:
+            os.close(fd)
+    return {
+        "app_id": dbus.String(caller["app_id"]),
+        "kind": dbus.String(caller["kind"]),
+        "sender": dbus.String(caller["sender"]),
+        "pidfd_ok": dbus.Boolean(pidfd_ok),
+    }
+
+
+def _record(name, value=b""):
+    return dbus.Dictionary(
+        {
+            "name": dbus.String(name),
+            "version": dbus.String("0" * 32),
+            "value": dbus.ByteArray(value),
+            "flags": dbus.UInt32(0),
+        },
+        signature="sv",
+    )
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="a{sv}", out_signature="a{sv}")
+def GetStatus(self, caller):
+    time.sleep(0.2)     # slow enough that concurrent calls pile up in the frontend (its per-app cap is tested)
+    return dbus.Dictionary({"status": dbus.String("available"), **_caller(caller)}, signature="sv")
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="a{sv}as", out_signature="")
+def Subscribe(self, caller, zones):
+    pass
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="a{sv}sa(says)a{sv}", out_signature="aa{sv}")
+def Save(self, caller, zone, records, options):
+    seen = _caller(caller)
+    return [
+        dbus.Dictionary(
+            {
+                "name": dbus.String(name),
+                "outcome": dbus.String("saved"),
+                "record": _record(name, bytes(value)),
+                "zone": dbus.String(zone),
+                "app_id": seen["app_id"],
+            },
+            signature="sv",
+        )
+        for name, value, _base in records
+    ]
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="a{sv}sa(ss)a{sv}", out_signature="aa{sv}")
+def Delete(self, caller, zone, records, options):
+    raise dbus.exceptions.DBusException(
+        "quota: record_bytes: full", name="org.projectluma.portal.Sync.Error.Quota"
+    )
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="a{sv}ssu", out_signature="aa{sv}s")
+def List(self, caller, zone, after, limit):
+    raise dbus.exceptions.DBusException("internal detail", name="org.example.Internal")
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="a{sv}ssa{sv}", out_signature="aa{sv}")
+def FetchChanges(self, caller, zone, token, options):
+    # The wrong answer type: the frontend must not pass it on.
+    return []
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="a{sv}ssshsa{sv}", out_signature="a{sv}")
+def PutAsset(self, caller, zone, record, name, fd, base, options):
+    fd = fd.take()
+    try:
+        data = os.pread(fd, 1 << 20, 0)
+    finally:
+        os.close(fd)
+    return dbus.Dictionary(
+        {"name": dbus.String(record), "outcome": dbus.String("saved"), "record": _record(record, data)},
+        signature="sv",
+    )
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="a{sv}ssss", out_signature="sa{sv}")
+def OpenAsset(self, caller, zone, record, name, version):
+    with tempfile.TemporaryFile() as f:
+        f.write(b"asset-bytes:" + name.encode())
+        f.flush()
+        fd = os.dup(f.fileno())
+    return (
+        dbus.String("here"),
+        dbus.Dictionary({"fd": dbus.types.UnixFd(fd), "size": dbus.Int64(12 + len(name))}, signature="sv"),
+    )
diff --git a/tests/test_luma_sync.py b/tests/test_luma_sync.py
new file mode 100644
index 0000000..06e5c16
--- /dev/null
+++ b/tests/test_luma_sync.py
@@ -0,0 +1,187 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# This file is formatted with Python Black
+#
+# org.projectluma.portal.Sync (Project Luma ADR-057 §3.1): a forwarder to
+# luma-connect-syncd that names the caller and sends signals to its app only.
+
+import tests.xdp_utils as xdp
+
+import dbus
+import os
+import pytest
+import time
+from gi.repository import GLib
+
+IFACE = "org.projectluma.portal.Sync"
+ERROR = "org.projectluma.portal.Sync.Error"
+
+
+@pytest.fixture
+def required_templates():
+    return {"lumasync": {}}
+
+
+@pytest.fixture
+def xdp_overwrite_env():
+    # The stand-in implementation doesn't run in luma-connect-syncd.service; the tests that use it say so.
+    return {"LUMA_SYNC_TEST_TRUST_ANY_IMPL": "1"}
+
+
+def sync_iface(dbus_con):
+    obj = dbus_con.get_object("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop")
+    return dbus.Interface(obj, IFACE)
+
+
+def host(xdp_app_info):
+    return isinstance(xdp_app_info, xdp.AppInfoHost)
+
+
+class TestLumaSync:
+    def test_version(self, portals, dbus_con):
+        obj = dbus_con.get_object("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop")
+        props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
+        assert props.Get(IFACE, "version") == 1
+
+    def test_caller_is_named_by_the_portal(self, portals, dbus_con, xdp_app_info):
+        intf = sync_iface(dbus_con)
+        if host(xdp_app_info):
+            with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+                intf.GetStatus()
+            assert excinfo.value.get_dbus_name() == f"{ERROR}.Refused"
+            return
+        status = intf.GetStatus()
+        assert status["app_id"] == xdp_app_info.app_id
+        assert status["kind"] == "flatpak"
+        assert status["sender"] == dbus_con.get_unique_name()
+
+    def test_arguments_pass_through(self, portals, dbus_con, xdp_app_info):
+        if host(xdp_app_info):
+            pytest.skip("host callers are refused")
+        intf = sync_iface(dbus_con)
+        results = intf.Save(
+            "saves",
+            [("slot1", dbus.ByteArray(b"level 3"), ""), ("slot2", dbus.ByteArray(b""), "f" * 32)],
+            {"on_conflict": "fail"},
+        )
+        assert [str(r["name"]) for r in results] == ["slot1", "slot2"]
+        assert bytes(results[0]["record"]["value"]) == b"level 3"
+        assert results[0]["zone"] == "saves"
+        assert results[0]["app_id"] == xdp_app_info.app_id
+
+    def test_malformed_calls_never_reach_the_implementation(self, portals, dbus_con, xdp_app_info):
+        obj = dbus_con.get_object("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop")
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            obj.Save("saves", ["not a record"], {}, dbus_interface=IFACE, signature="sasa{sv}")
+        assert "InvalidArgs" in excinfo.value.get_dbus_name()
+
+    def test_descriptors_go_both_ways(self, portals, dbus_con, xdp_app_info):
+        if host(xdp_app_info):
+            pytest.skip("host callers are refused")
+        intf = sync_iface(dbus_con)
+        fd = os.memfd_create("asset")
+        os.write(fd, b"save state")
+        try:
+            result = intf.PutAsset("saves", "slot1", "state", dbus.types.UnixFd(fd), "", {})
+        finally:
+            os.close(fd)
+        assert bytes(result["record"]["value"]) == b"save state"
+        state, info = intf.OpenAsset("saves", "slot1", "thumb", "")
+        assert state == "here"
+        out = info["fd"].take()
+        try:
+            assert os.pread(out, 100, 0) == b"asset-bytes:thumb"
+        finally:
+            os.close(out)
+
+    def test_errors(self, portals, dbus_con, xdp_app_info):
+        if host(xdp_app_info):
+            pytest.skip("host callers are refused")
+        intf = sync_iface(dbus_con)
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            intf.Delete("saves", [("slot1", "")], {})
+        assert excinfo.value.get_dbus_name() == f"{ERROR}.Quota"
+        assert "record_bytes" in excinfo.value.get_dbus_message()
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            intf.List("saves", "", 10)
+        assert excinfo.value.get_dbus_name() == f"{ERROR}.Failed"
+        assert "internal detail" not in excinfo.value.get_dbus_message()
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            intf.FetchChanges("saves", "", {})
+        assert excinfo.value.get_dbus_name() == f"{ERROR}.Failed"
+
+    def test_signals_reach_only_their_app(self, portals, dbus_con, xdp_app_info):
+        if host(xdp_app_info):
+            pytest.skip("host callers are refused")
+        mock = dbus.Interface(
+            dbus_con.get_object("org.projectluma.ConnectSync1", "/org/projectluma/ConnectSync1/Apps"),
+            "org.freedesktop.DBus.Mock",
+        )
+        received = []
+        dbus_con.add_signal_receiver(
+            lambda zone, details: received.append(str(zone)),
+            signal_name="Changed",
+            dbus_interface=IFACE,
+        )
+        impl = "org.projectluma.impl.portal.Sync"
+        mock.EmitSignal(impl, "Changed", "ssa{sv}", [":1.9999", "not-for-us", dbus.Dictionary({}, signature="sv")])
+        mock.EmitSignal(impl, "Changed", "ssa{sv}", [dbus_con.get_unique_name(), "saves", dbus.Dictionary({}, signature="sv")])
+        mock.EmitSignal(impl, "Changed", "ssa{sv}", ["org.not.unique", "named", dbus.Dictionary({}, signature="sv")])
+        xdp.wait_for(lambda: "saves" in received)
+        context = GLib.MainContext.default()
+        end = time.monotonic() + 0.5
+        while time.monotonic() < end:
+            context.iteration(False)
+        assert received == ["saves"]
+
+    @pytest.mark.parametrize("xdp_overwrite_env", [{}])
+    def test_an_impl_outside_its_service_gets_nothing(self, portals, dbus_con, xdp_app_info):
+        """Whoever owns org.projectluma.ConnectSync1 without running in luma-connect-syncd.service gets no call."""
+        if host(xdp_app_info):
+            pytest.skip("host callers are refused")
+        intf = sync_iface(dbus_con)
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            intf.Save("saves", [("slot1", dbus.ByteArray(b"secret"), "")], {})
+        assert excinfo.value.get_dbus_name() == f"{ERROR}.Failed"
+        mock = dbus.Interface(
+            dbus_con.get_object("org.projectluma.ConnectSync1", "/org/projectluma/ConnectSync1/Apps"),
+            "org.freedesktop.DBus.Mock",
+        )
+        assert not mock.GetMethodCalls("Save")
+
+    def test_one_app_cannot_hold_the_portal(self, portals, dbus_con, xdp_app_info):
+        """Calls are forwarded asynchronously with a cap per app connection: the 9th concurrent call is refused."""
+        if host(xdp_app_info):
+            pytest.skip("host callers are refused")
+        intf = sync_iface(dbus_con)
+        replies, errors = [], []
+        for _ in range(12):
+            intf.GetStatus(reply_handler=replies.append, error_handler=errors.append)
+        xdp.wait_for(lambda: len(replies) + len(errors) == 12)
+        assert len(replies) >= 8
+        assert errors, "more than 8 calls at once from one app are refused"
+        assert all(e.get_dbus_name() == f"{ERROR}.RateLimited" for e in errors)
+
+    @pytest.mark.parametrize("required_templates", [{}])
+    def test_no_implementation_fails_fast_and_backs_off(self, portals, dbus_con, xdp_app_info):
+        """With nothing owning the name and activation failing, a call fails; the next ones fail at once (back-off)
+        and the portal keeps answering everything else meanwhile."""
+        if host(xdp_app_info):
+            pytest.skip("host callers are refused")
+        intf = sync_iface(dbus_con)
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            intf.GetStatus()
+        assert excinfo.value.get_dbus_name() == f"{ERROR}.Failed"
+        start = time.monotonic()
+        replies, errors = [], []
+        for _ in range(4):
+            intf.GetStatus(reply_handler=replies.append, error_handler=errors.append)
+        props = dbus.Interface(
+            dbus_con.get_object("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop"),
+            "org.freedesktop.DBus.Properties",
+        )
+        assert props.Get(IFACE, "version") == 1
+        xdp.wait_for(lambda: len(replies) + len(errors) == 4)
+        assert time.monotonic() - start < 2.0
+        assert not replies
+        assert all(e.get_dbus_name() == f"{ERROR}.Failed" for e in errors)
