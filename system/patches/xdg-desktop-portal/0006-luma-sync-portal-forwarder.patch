From: Project Luma <noreply@projectluma.org>
Subject: [PATCH] luma-sync: add the org.projectluma.portal.Sync forwarder

Connect Sync for apps (Project Luma ADR-057 §3.1): an app keeps its own
records and assets the same on every device of the person's account. The
frontend is a thin forwarder without generated code: GDBus checks each call
against data/org.projectluma.portal.Sync.xml, the portal's authorization
names the caller, the host is refused, and the call goes with its file
descriptors to org.projectluma.impl.portal.Sync on
org.projectluma.ConnectSync1 (luma-connect-syncd), prefixed with
{app_id, kind, pidfd, sender}. The implementation checks the pidfd itself
and answers only this process. Its errors pass through when they are the
interface's own (org.projectluma.portal.Sync.Error.*), anything else is
Failed, and an answer of the wrong type is refused. Changed, AssetChanged
and StatusChanged from the implementation name the app connection they are
for and are sent to that unique name only. Calls go to, and signals are taken
from, the owner of org.projectluma.ConnectSync1 only when its process runs in
luma-connect-syncd.service, addressed by that checked unique name, so a
connection that grabs the name while the service is down gets nothing.
The unit is read through the ProcessFD that GetConnectionCredentials hands
over, and the process must still be alive afterwards, so a recycled PID
can't pass. Every bus call is asynchronous, the owner check and D-Bus
activation included: calls wait in a queue while the implementation is
found, signals from a sender not yet checked wait for the check, and after a
failed activation or check calls fail at once for 2 s, doubling up to 60 s,
until the name changes hands. Forwarding runs on the main context with at
most 8 calls in flight per app connection, so one app can't hold the
portal's threads or its main loop.

Tests: tests/test_luma_sync.py with a dbusmock implementation template.
---
diff --git a/data/meson.build b/data/meson.build
index 5e0ad02..4c6f3f1 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -40,6 +40,13 @@ portal_sources = files(
   'org.freedesktop.portal.Wallpaper.xml',
 )
 
+# Project Luma: Connect Sync for apps (ADR-057). The frontend is a forwarder
+# without generated code; the implementation (org.projectluma.impl.portal.Sync)
+# is luma-connect-syncd's and ships its interface file.
+luma_portal_sources = files(
+  'org.projectluma.portal.Sync.xml',
+)
+
 portal_host_sources = files(
   'org.freedesktop.host.portal.Registry.xml',
 )
@@ -76,6 +83,6 @@ background_monitor_sources = files(
   'org.freedesktop.background.Monitor.xml',
 )
 
-install_data([portal_sources, portal_host_sources, portal_impl_sources],
+install_data([portal_sources, portal_host_sources, portal_impl_sources, luma_portal_sources],
     install_dir: datadir / 'dbus-1' / 'interfaces',
 )
diff --git a/data/org.projectluma.portal.Sync.xml b/data/org.projectluma.portal.Sync.xml
new file mode 100644
index 0000000..4ac656e
--- /dev/null
+++ b/data/org.projectluma.portal.Sync.xml
@@ -0,0 +1,159 @@
+<?xml version="1.0"?>
+<!--
+ SPDX-License-Identifier: LGPL-2.1-or-later
+
+ Connect Sync for apps (Project Luma ADR-057 §3).
+-->
+<!--
+    org.projectluma.portal.Sync:
+    @short_description: An app's own data, the same on every device of the person's Luma account
+
+    Zones (short labels), records (a name and an opaque value with a version),
+    assets (descriptors) and advisory leases. Every call answers at once from
+    the device: reads come from its local mirror, writes are durable before
+    they return and leave when Sync can send them. There are no other
+    people, no device addresses and no way to send anything but the app's
+    own records.
+
+    The frontend names the caller from its sandbox and passes the call, with
+    any file descriptors, to org.projectluma.impl.portal.Sync on
+    org.projectluma.ConnectSync1 (luma-connect-syncd), which checks the
+    caller again and answers. Callers the portal names as the host are
+    refused. Changed, AssetChanged and StatusChanged reach only the
+    connection of the app they belong to, after it called Subscribe.
+
+    Errors are org.projectluma.portal.Sync.Error.{Invalid, TooLarge,
+    BadDescriptor, TimedOut, NotFound, Refused, Quota, RateLimited, Failed,
+    NotSupported}.
+
+    This documentation describes version 1 of this interface.
+-->
+<node>
+  <interface name="org.projectluma.portal.Sync">
+    <method name="GetStatus">
+      <arg type="a{sv}" name="status" direction="out"/>
+    </method>
+    <method name="Subscribe">
+      <arg type="as" name="zones" direction="in"/>
+    </method>
+    <method name="Save">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="a(says)" name="records" direction="in"/>
+      <arg type="a{sv}" name="options" direction="in"/>
+      <arg type="aa{sv}" name="results" direction="out"/>
+    </method>
+    <method name="Delete">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="a(ss)" name="records" direction="in"/>
+      <arg type="a{sv}" name="options" direction="in"/>
+      <arg type="aa{sv}" name="results" direction="out"/>
+    </method>
+    <method name="FetchChanges">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="token" direction="in"/>
+      <arg type="a{sv}" name="options" direction="in"/>
+      <arg type="aa{sv}" name="records" direction="out"/>
+      <arg type="s" name="next_token" direction="out"/>
+      <arg type="b" name="more" direction="out"/>
+    </method>
+    <method name="Get">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="name" direction="in"/>
+      <arg type="b" name="found" direction="out"/>
+      <arg type="a{sv}" name="record" direction="out"/>
+    </method>
+    <method name="List">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="after" direction="in"/>
+      <arg type="u" name="limit" direction="in"/>
+      <arg type="aa{sv}" name="records" direction="out"/>
+      <arg type="s" name="next" direction="out"/>
+    </method>
+    <method name="PutAsset">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="s" name="name" direction="in"/>
+      <arg type="h" name="fd" direction="in"/>
+      <arg type="s" name="base" direction="in"/>
+      <arg type="a{sv}" name="options" direction="in"/>
+      <arg type="a{sv}" name="result" direction="out"/>
+    </method>
+    <method name="RemoveAsset">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="s" name="name" direction="in"/>
+      <arg type="s" name="base" direction="in"/>
+      <arg type="a{sv}" name="result" direction="out"/>
+    </method>
+    <method name="OpenAsset">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="s" name="name" direction="in"/>
+      <arg type="s" name="version" direction="in"/>
+      <arg type="s" name="state" direction="out"/>
+      <arg type="a{sv}" name="info" direction="out"/>
+    </method>
+    <method name="RequestAsset">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="s" name="name" direction="in"/>
+      <arg type="s" name="state" direction="out"/>
+      <arg type="a{sv}" name="info" direction="out"/>
+    </method>
+    <method name="PinAsset">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="s" name="name" direction="in"/>
+      <arg type="b" name="pinned" direction="in"/>
+      <arg type="s" name="state" direction="out"/>
+      <arg type="a{sv}" name="info" direction="out"/>
+    </method>
+    <method name="EvictAsset">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="s" name="name" direction="in"/>
+      <arg type="s" name="state" direction="out"/>
+      <arg type="a{sv}" name="info" direction="out"/>
+    </method>
+    <method name="Lease">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="u" name="seconds" direction="in"/>
+      <arg type="b" name="take_over" direction="in"/>
+      <arg type="a{sv}" name="lease" direction="out"/>
+    </method>
+    <method name="Release">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="a{sv}" name="lease" direction="out"/>
+    </method>
+    <method name="GetLease">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="a{sv}" name="lease" direction="out"/>
+    </method>
+    <method name="ResolveSiblings">
+      <arg type="s" name="zone" direction="in"/>
+      <arg type="s" name="record" direction="in"/>
+      <arg type="s" name="keep" direction="in"/>
+      <arg type="a{sv}" name="result" direction="out"/>
+    </method>
+    <method name="DeleteZone">
+      <arg type="s" name="zone" direction="in"/>
+    </method>
+    <signal name="Changed">
+      <arg type="s" name="zone"/>
+      <arg type="a{sv}" name="details"/>
+    </signal>
+    <signal name="AssetChanged">
+      <arg type="s" name="zone"/>
+      <arg type="s" name="record"/>
+      <arg type="s" name="name"/>
+      <arg type="a{sv}" name="progress"/>
+    </signal>
+    <signal name="StatusChanged">
+      <arg type="a{sv}" name="status"/>
+    </signal>
+    <property name="version" type="u" access="read"/>
+  </interface>
+</node>
diff --git a/src/luma-sync-portal.c b/src/luma-sync-portal.c
new file mode 100644
index 0000000..14cd102
--- /dev/null
+++ b/src/luma-sync-portal.c
@@ -0,0 +1,898 @@
+/*
