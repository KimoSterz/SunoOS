  {
   "name": "cell-3",
   "about": "status cell, 3 apps",
   "window": "#grid .pc:first-child",
   "spec": [
    {
     "eval": "const ids=['diskord','huddle','playground'].slice(0,3);OV.APPS.playground={n:'Playground',i:OV.AP('playground'),what:'Game stats',since:'now'};document.getElementById('grid').innerHTML=OV.cell(ids)+['wifi','shield','bluetooth','battery-medium'].map(n=>`<span class=\"pc\"><span class=\"ind\"><i class=\"g\" style=\"--i:url('../../icons/${n}.svg')\"></i></span></span>`).join('');document.getElementById('pop').innerHTML=OV.pop(ids);document.getElementById('stage').style.visibility='hidden';",
     "wait": 900
    }
   ]
  },
  {
   "name": "tip-1",
   "about": "hover tooltip, one app",
   "window": ".ov-tip",
   "spec": [
    {
     "eval": "const ids=['diskord','huddle','playground'].slice(0,1);OV.APPS.playground={n:'Playground',i:OV.AP('playground'),what:'Game stats',since:'now'};document.getElementById('grid').innerHTML=OV.cell(ids)+['wifi','shield','bluetooth','battery-medium'].map(n=>`<span class=\"pc\"><span class=\"ind\"><i class=\"g\" style=\"--i:url('../../icons/${n}.svg')\"></i></span></span>`).join('');document.getElementById('pop').innerHTML=OV.pop(ids);document.querySelector('.screen').classList.add('hover');document.querySelector('.ov-tip').textContent='Diskord is displaying over other apps';",
     "wait": 900
    }
   ]
  },
  {
   "name": "tip-3",
   "about": "hover tooltip, three apps",
   "window": ".ov-tip",
   "spec": [
    {
     "eval": "const ids=['diskord','huddle','playground'].slice(0,3);OV.APPS.playground={n:'Playground',i:OV.AP('playground'),what:'Game stats',since:'now'};document.getElementById('grid').innerHTML=OV.cell(ids)+['wifi','shield','bluetooth','battery-medium'].map(n=>`<span class=\"pc\"><span class=\"ind\"><i class=\"g\" style=\"--i:url('../../icons/${n}.svg')\"></i></span></span>`).join('');document.getElementById('pop').innerHTML=OV.pop(ids);document.querySelector('.screen').classList.add('hover');document.querySelector('.ov-tip').textContent='3 apps are displaying over other apps';",
     "wait": 900
    }
   ]
  }
 ],
 "phone_states": [
  "pop-1",
  "pop-2",
  "pop-3"
 ],
 "groups": [
  {
   "name": "cell",
   "spec": "#grid .pc:first-child .ov-ic, #grid .pc:first-child .ov-more"
  },
  {
   "name": "fills",
   "spec": "#stage, #stage .q2l, #stage .ov-stop, #grid .pc:first-child .ov-ic, #grid .pc:first-child .ov-more, .ov-tip"
  },
  {
   "name": "content",
   "spec": "#stage .q2h b, #stage .q2i img, #stage .q2t, #stage .ov-stop, #stage .q2more"
  },
  {
   "name": "artwork",
   "spec": "#stage .q2i img"
  }
 ],
 "pairs": [],
 "text_aliases": {},
 "pixel": {
  "max_mean": 4.0,
  "max_over10": 1.0,
  "exclude_groups": [
   "artwork"
  ],
  "fills": "fills",
  "max_fill_over10": 0.005,
  "glyphs_as_text": true,
  "mean_without_text": true
 }
}