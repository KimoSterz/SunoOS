{
 "app": "overlay-indicator",
 "title": "Layer permissions: status cell, tooltip and popover (design-center 51db99e)",
 "spec": {
  "root": "design-center",
  "url": "mockups/overlay-perms/indicator.html",
  "window": "#stage",
  "ready": "html[data-ready]",
  "viewport": {
   "width": 460,
   "height": 420
  },
  "phone_url": "mockups/overlay-perms/indicator.html?posture=phone",
  "phone_viewport": {
   "width": 400,
   "height": 844
  },
  "init_script": "if (matchMedia('(prefers-color-scheme: light)').matches && !/[?&]mode=/.test(location.search)) history.replaceState(null, '', location.pathname + (location.search ? location.search + '&' : '?') + 'mode=light');"
 },
 "states": [
  {
   "name": "pop-1",
   "about": "popover, 1 app",
   "window": "#stage",
   "spec": [
    {
     "eval": "const ids=['diskord','huddle','playground'].slice(0,1);OV.APPS.playground={n:'Playground',i:OV.AP('playground'),what:'Game stats',since:'now'};document.getElementById('grid').innerHTML=OV.cell(ids)+['wifi','shield','bluetooth','battery-medium'].map(n=>`<span class=\"pc\"><span class=\"ind\"><i class=\"g\" style=\"--i:url('../../icons/${n}.svg')\"></i></span></span>`).join('');document.getElementById('pop').innerHTML=OV.pop(ids);",
     "wait": 900
    }
   ]
  },
  {
   "name": "pop-2",
   "about": "popover, 2 apps",
   "window": "#stage",
   "spec": [
    {
     "eval": "const ids=['diskord','huddle','playground'].slice(0,2);OV.APPS.playground={n:'Playground',i:OV.AP('playground'),what:'Game stats',since:'now'};document.getElementById('grid').innerHTML=OV.cell(ids)+['wifi','shield','bluetooth','battery-medium'].map(n=>`<span class=\"pc\"><span class=\"ind\"><i class=\"g\" style=\"--i:url('../../icons/${n}.svg')\"></i></span></span>`).join('');document.getElementById('pop').innerHTML=OV.pop(ids);",
     "wait": 900
    }
   ]
  },
  {
   "name": "pop-3",
   "about": "popover, 3 apps",
   "window": "#stage",
   "spec": [
    {
     "eval": "const ids=['diskord','huddle','playground'].slice(0,3);OV.APPS.playground={n:'Playground',i:OV.AP('playground'),what:'Game stats',since:'now'};document.getElementById('grid').innerHTML=OV.cell(ids)+['wifi','shield','bluetooth','battery-medium'].map(n=>`<span class=\"pc\"><span class=\"ind\"><i class=\"g\" style=\"--i:url('../../icons/${n}.svg')\"></i></span></span>`).join('');document.getElementById('pop').innerHTML=OV.pop(ids);",
     "wait": 900
    }
   ]
  },
  {
   "name": "cell-1",
   "about": "status cell, 1 app",
   "window": "#grid .pc:first-child",
   "spec": [
    {
     "eval": "const ids=['diskord','huddle','playground'].slice(0,1);OV.APPS.playground={n:'Playground',i:OV.AP('playground'),what:'Game stats',since:'now'};document.getElementById('grid').innerHTML=OV.cell(ids)+['wifi','shield','bluetooth','battery-medium'].map(n=>`<span class=\"pc\"><span class=\"ind\"><i class=\"g\" style=\"--i:url('../../icons/${n}.svg')\"></i></span></span>`).join('');document.getElementById('pop').innerHTML=OV.pop(ids);document.getElementById('stage').style.visibility='hidden';",
     "wait": 900
    }
   ]
  },
  {
   "name": "cell-2",
   "about": "status cell, 2 apps",
   "window": "#grid .pc:first-child",
   "spec": [
    {
     "eval": "const ids=['diskord','huddle','playground'].slice(0,2);OV.APPS.playground={n:'Playground',i:OV.AP('playground'),what:'Game stats',since:'now'};document.getElementById('grid').innerHTML=OV.cell(ids)+['wifi','shield','bluetooth','battery-medium'].map(n=>`<span class=\"pc\"><span class=\"ind\"><i class=\"g\" style=\"--i:url('../../icons/${n}.svg')\"></i></span></span>`).join('');document.getElementById('pop').innerHTML=OV.pop(ids);document.getElementById('stage').style.visibility='hidden';",
     "wait": 900
    }
   ]
