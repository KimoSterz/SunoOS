  "root": "design-center",
  "url": "mockups/Suno-tv-settings.html",
  "window": "#stage",
  "ready": "#island .row",
  "viewport": {
   "width": 1920,
   "height": 1080
  },
  "clock": "2026-11-01T16:12:00",
  "exclude": [
   ".bg",
   ".shade",
   "#clock",
   ".tv-toast"
  ]
 },
