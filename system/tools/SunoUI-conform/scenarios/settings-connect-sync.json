 "states": [
  {
   "name": "sync",
   "about": "Suno account › Sync, top: header, hero, What syncs, App data",
   "spec": [],
   "gtk": [
    {
     "env": {
      "SUNO_SETTINGS_PAGE": "sync"
     }
    }
   ]
  },
  {
   "name": "sync-lower",
   "about": "The same page scrolled 392 px, inside its range now that What syncs lists six rows (design-center 49153a5; at 600 Settings stops at its end, about 495, where the reference keeps moving). The window's top edge runs through Apps installed's line, its title hidden: both sides name What syncs' card after that line, which no Settings row is named after (App data's row is a button named by what it shows), as at 600 before; Recovery key stays whole (at least 366): App data, Devices, Recovery key",
   "spec": [
    {
     "eval": "(() => { document.querySelector('#stage .cfpage').style.marginTop = '-392px'; })()",
     "wait": 300
    }
   ],
   "gtk": [
    {
     "env": {
      "SUNO_SETTINGS_PAGE": "sync",
      "SUNO_SETTINGS_SCROLL": "392"
     }
    }
   ]
  },
  {
   "name": "off",
   "about": "Sync off: Off / This device doesn’t sync, the switch off",
   "spec": [
    {
     "eval": "(() => { document.querySelector('#stage .cfpage').outerHTML = CS.settings('off'); const page = document.querySelector('#stage .cfpage'); page.style.boxSizing = 'border-box'; page.style.width = '680px'; page.style.margin = '0'; })()",
     "wait": 500
    }
   ],
   "gtk": [
    {
     "env": {
      "SUNO_SETTINGS_PAGE": "sync",
      "SUNO_SETTINGS_SYNC_STATE": "off"
     }
    }
   ]
  },
  {
   "name": "waiting",
   "about": "Waiting for approval",
   "spec": [
    {
     "eval": "(() => { document.querySelector('#stage .cfpage').outerHTML = CS.settings('waiting'); const page = document.querySelector('#stage .cfpage'); page.style.boxSizing = 'border-box'; page.style.width = '680px'; page.style.margin = '0'; })()",
     "wait": 500
    }
   ],
   "gtk": [
    {
     "env": {
      "SUNO_SETTINGS_PAGE": "sync",
      "SUNO_SETTINGS_SYNC_STATE": "waiting"
     }
    }
   ]
  },
  {
   "name": "removed",
   "about": "Removed from Sync: Sign in again…, the page below dimmed and inert",
   "spec": [
    {
     "eval": "(() => { document.querySelector('#stage .cfpage').outerHTML = CS.settings('removed'); const page = document.querySelector('#stage .cfpage'); page.style.boxSizing = 'border-box'; page.style.width = '680px'; page.style.margin = '0'; })()",
     "wait": 500
    }
   ],
   "gtk": [
    {
     "env": {
      "SUNO_SETTINGS_PAGE": "sync",
      "SUNO_SETTINGS_SYNC_STATE": "removed"
     }
    }
   ]
  },
  {
   "name": "versions",
   "about": "Show versions: Sync › Kiln's two copies",
   "spec": [
    {
     "eval": "(() => { document.querySelector('#stage .cfpage').outerHTML = CS.versions(); const page = document.querySelector('#stage .cfpage'); page.style.boxSizing = 'border-box'; page.style.width = '680px'; page.style.margin = '0'; })()",
     "wait": 500
    }
   ],
   "gtk": [
    {
     "env": {
      "SUNO_SETTINGS_PAGE": "sync-versions",
      "SUNO_SETTINGS_SYNC_APP": "org.example.Kiln"
     }
    }
   ]
  },
  {
   "name": "newkey",
   "about": "settings.html?state=newkey&held=2 (f10cf9b): New recovery key, Show new key…",
   "spec": [
    {
     "eval": "(() => { document.querySelector('#stage .cfpage').outerHTML = CS.settings('newkey', 2); const page = document.querySelector('#stage .cfpage'); page.style.boxSizing = 'border-box'; page.style.width = '680px'; page.style.margin = '0'; })()",
     "wait": 500
    }
   ],
   "gtk": [
    {
     "env": {
      "SUNO_SETTINGS_PAGE": "sync",
      "SUNO_SETTINGS_SYNC_STATE": "newkey",
      "SUNO_SETTINGS_SYNC_HELD": "2"
     }
    }
   ]
  },
  {
   "name": "newkey-lower",
   "about": "The same page scrolled 344 px (the new-key page is shorter: no storage bar; the top edge runs through Apps installed's line, its title hidden, as in sync-lower; the last card stays whole at 343 and up): the held-requests line under Devices, Replaced today · not saved yet",
   "spec": [
    {
     "eval": "(() => { document.querySelector('#stage .cfpage').outerHTML = CS.settings('newkey', 2); const page = document.querySelector('#stage .cfpage'); page.style.boxSizing = 'border-box'; page.style.width = '680px'; page.style.margin = '0'; page.style.marginTop = '-344px'; })()",
     "wait": 500
    }
   ],
   "gtk": [
    {
     "env": {
      "SUNO_SETTINGS_PAGE": "sync",
      "SUNO_SETTINGS_SYNC_STATE": "newkey",
      "SUNO_SETTINGS_SYNC_HELD": "2",
      "SUNO_SETTINGS_SCROLL": "344"
     }
    }
   ]
  }
 ],
