{
 "app": "continue-banner",
 "title": "Continue: the shell banner (desktop)",
 "about": "Continue banner (ADR-055), Shell 0395-0397, against design-center mockups/continue (22047dd). Pixel mode, 1x crops: light over #808080, dark over #0f1218 (the reference pages paint the same backdrop and the lip material).",
 "spec": {
  "root": "design-center",
  "url": "mockups/continue/offer.html",
  "window": "#stage",
  "ready": "html[data-ready]",
  "viewport": {
   "width": 460,
   "height": 480
  },
  "init_script": "if (matchMedia('(prefers-color-scheme: light)').matches && !/[?&]mode=/.test(location.search)) history.replaceState(null, '', location.pathname + (location.search ? location.search + '&' : '?') + 'mode=light');"
 },
 "states": [
  {
   "name": "offer",
   "window": "#stage",
   "spec": [
    {
     "eval": "(async () => { const b=document.getElementById('stage'); b.innerHTML=CN.offer('offer'); await Promise.all([...b.querySelectorAll('img')].map(i=>i.decode().catch(()=>0))); })()",
     "wait": 600
    },
    {
     "eval": "(() => { document.querySelectorAll('#stage svg.i').forEach(s => s.setAttribute('stroke-width', '1.6')); })()",
     "wait": 100
    }
   ]
  },
