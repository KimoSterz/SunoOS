{
  "app": "media-row-compact",
  "title": "SunoMediaRow, compact (vs Quick Options' playing row)",
  "about": "SunoMediaRow at compact density, alone in its window, against the first playing row of the published Quick Options reference (Design Center mockups/sound-mixer/quick.html .mxqr).",
  "spec": {
    "root": "design-center",
    "url": "mockups/sound-mixer/quick.html",
    "window": ".mxqr",
    "ready": "html[data-ready]",
    "exclude": [],
    "before": [
      {
        "eval": "(() => { if (matchMedia('(prefers-color-scheme: light)').matches) document.querySelector('.screen').dataset.theme = 'light'; })()",
        "wait": 300
      }
    ]
  },
  "app_icon": {
    "gtk": "^Suno-v3-"
  },
  "gtk": {
    "module": "pages_rows",
    "app_id": "org.projectSuno.SunoUIRowsConform",
    "pythonpath": [
      "src/Suno-platform/tools/SunoUI-gallery"
    ],
    "fixtures": [
      "assets/wallpapers/meadow.png"
    ],
    "build": {},
    "env": {
      "SUNOUI_ROWS_SURFACE": "media-compact",
      "SUNOUI_ROWS_ART": "{run}/fixtures/meadow.png",
      "SUNO_APPKIT_ICON_PATH": "{run}/preview/python/icons"
    }
  },
  "states": [
    {
      "name": "playing",
      "about": "A song playing at full volume on the main output",
      "spec": [],
      "gtk": []
    }
  ],
  "phone_states": [],
  "groups": [
    {
      "name": "row",
      "spec": ".mxqr"
    }
  ]
}
