{
 "app": "settings-connect-sync-sheet-tv",
 "title": "Settings: Connect Sync sheets (TV)",
 "about": "The sheets of Suno account › Sync (gnome-control-center 0111) against design-center daccee5, mockups/connect-sync/sheet.html: the recovery key (show, ticked), its check (confirm), the new device's code (join) and the recovery entry (enter). The GTK side is the sheet card alone (SUNO_SETTINGS_SYNC_SHEET, fixture only), the reference's #stage the same card. TV posture (SUNO_POSTURE=tv): the sheet at 1.5 times, the remote on Cancel; B3/S1/B2 at f10cf9b: join compare, wait, tampered, the new recovery key.",
 "spec": {
  "root": "design-center",
  "url": "mockups/connect-sync/sheet.html?posture=tv",
  "window": "#stage",
  "ready": "html[data-ready]",
  "exclude": [],
