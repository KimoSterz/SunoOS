{
 "app": "continue-settings-app",
 "title": "Settings: an app's page, the Windows group",
 "about": "The app page's Windows group (gnome-control-center 0116, feature/continue-phase-c; 0114 reopens the page) against design-center 05885a9, mockups/continue/settings.html?page=app: Kiln's page with Windows (Reopen with your windows) after On screen and before Used recently, drawn from tests/fixtures/settings-app-perms.json. self-off uses tests/fixtures/settings-continue-app-self.json (the same with reopen_self false on Kiln's entry), reference &self=off. The reference is the page alone, as settings-overlay-perms; the sidebar and title row are left out of the GTK side.",
 "spec": {
  "root": "design-center",
  "url": "mockups/continue/settings.html?page=app",
  "window": "#stage",
  "ready": "html[data-ready]",
  "exclude": [],
  "viewport": {
   "width": 1180,
   "height": 1400
  },
  "before": [
   {
    "eval": "(() => { if (matchMedia('(prefers-color-scheme: light)').matches && !/[?&]mode=/.test(location.search)) document.documentElement.dataset.mode = 'light'; const s = document.querySelector('#stage'); const page = s.querySelector('.cfpage'); s.style.boxSizing = 'border-box'; s.style.margin = '0'; s.style.minHeight = '0'; s.style.overflow = 'hidden'; if (document.documentElement.dataset.posture === 'phone') { s.style.width = '400px'; s.style.height = '1900px'; s.style.padding = '0'; page.style.boxSizing = 'border-box'; page.style.width = '400px'; page.style.margin = '0'; return; } s.style.width = '1180px'; s.style.height = '1400px'; s.style.padding = '47px 0 0 364px'; page.style.boxSizing = 'border-box'; page.style.width = '680px'; page.style.margin = '0'; const clip = document.createElement('div'); clip.id = 'cs-clip'; clip.style.height = '1353px'; clip.style.overflow = 'hidden'; page.before(clip); clip.append(page); })()",
    "wait": 300
   }
  ],
  "phone_url": "mockups/continue/settings.html?page=app&posture=phone",
  "phone_viewport": {
   "width": 400,
   "height": 1900
  }
 },
