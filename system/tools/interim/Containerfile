# Interim CI image for the Source checks jobs: the pinned x86_64 Fedora builder
# plus the tools those GitHub jobs install with apt/pip (Fedora equivalents).
FROM registry.fedoraproject.org/fedora@sha256:69b1219730fe52d6cbb0874cbc1a36dd43b722354a603f6cdf73acbff8dd7c59
RUN dnf5 -y -q install git-core python3 python3-jsonschema python3-gobject glib2 gobject-introspection \
      gjs gtk4 gtk-vnc2 python3-jwt python3-cryptography python3-pyyaml lua-libs xorriso qemu-img \
      qemu-system-x86-core qemu-system-aarch64-core qemu-device-display-virtio-gpu qemu-device-display-virtio-gpu-pci qemu-device-usb-host edk2-ovmf edk2-aarch64 openssh-clients rsync \
      rpm-build rpmdevtools findutils diffutils glibc-langpack-en which file jq \
    && dnf5 clean all
