{
 "app": "settings-connect-sync",
 "title": "Settings: Luma account › Sync",
 "about": "Luma Connect Sync in Settings (gnome-control-center 0111) against design-center daccee5, mockups/connect-sync/settings.html: Luma account › Sync drawn from tests/fixtures/settings-connect-sync.json (settings-v70 with CFSYNC: up to date, 1.8 of 5 GB, Kiln, Diskord, Tide, Recipe Box (uses the API), ThinkPad, Dell XPS 14, Pixel 9). As settings-overlay-perms: the reference is the page alone; its stage takes the Settings window's size (1180 x 1060, the page clipped below the title row as Settings' scroller clips it; the second state scrolled 600 px) with the page 680 px wide where the main island puts it; the sidebar and title row are left out of the GTK side.",
 "spec": {
  "root": "design-center",
  "url": "mockups/connect-sync/settings.html",
  "window": "#stage",
  "ready": "html[data-ready]",
  "exclude": [],
  "viewport": {
   "width": 1180,
   "height": 1060
  },
  "before": [
   {
    "eval": "(() => { if (matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.mode = 'light'; const s = document.querySelector('#stage'); s.style.boxSizing = 'border-box'; s.style.width = '1180px'; s.style.height = '1060px'; s.style.minHeight = '0'; s.style.overflow = 'hidden'; s.style.margin = '0'; s.style.padding = '47px 0 0 364px'; const page = s.querySelector('.cfpage'); page.style.boxSizing = 'border-box'; page.style.width = '680px'; page.style.margin = '0'; const clip = document.createElement('div'); clip.id = 'cs-clip'; clip.style.height = '1013px'; clip.style.overflow = 'hidden'; page.before(clip); clip.append(page); })()",
    "wait": 300
   }
  ]
 },
 "gtk": {
