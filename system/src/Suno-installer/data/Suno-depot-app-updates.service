[Unit]
Description=Update apps in the background, holding updates that ask for more
Documentation=https://simplyluma.com/apps
# Suno's own system apps update first, whether or not the catalogue lists them.
Wants=Suno-system-app-refresh.service
After=graphical-session.target Suno-system-app-refresh.service
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/Suno-depot --update-apps
Nice=10
IOSchedulingClass=idle
