[Unit]
Description=Give circular application icons Suno's rounded-square silhouette
Documentation=file:///usr/lib/python3/site-packages/Suno_installer/icon_plates.py
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/Suno-icon-plates
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=graphical-session.target
