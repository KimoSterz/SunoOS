[Unit]
Description=Roll back an unpromoted Project Suno Mod deployment
Documentation=https://github.com/SimplyLuma/luma
After=Suno-mod-boot-observe.service
ConditionPathExists=/var/lib/Suno/mods/system-state.json

[Service]
Type=oneshot
ExecStart=/usr/bin/Suno-mod-system-health watchdog
StateDirectory=Suno/mods
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/Suno/mods /var/lib/rpm-ostree /boot
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
