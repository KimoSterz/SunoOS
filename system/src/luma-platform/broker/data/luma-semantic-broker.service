# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Project Luma per-user Semantic Broker
Documentation=https://github.com/SimplyLuma/luma

[Service]
Type=dbus
BusName=org.projectluma.SemanticBroker1
ExecStart=/usr/libexec/luma-semantic-broker
Restart=on-failure
RestartSec=2s
UMask=0077
StateDirectory=luma/semantic-broker
# No mount namespacing (Private*, Protect*, *Paths): in a user manager it
# brings a user namespace, from which callers' /proc entries (a Flatpak's
# .flatpak-info, the Shell's exe) can't be read, and the broker refuses any
# caller it can't read. Revisit with SELinux caller identity.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
