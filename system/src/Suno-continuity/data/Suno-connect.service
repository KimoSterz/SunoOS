# The Suno Connect daemon started on demand, by D-Bus activation of
# org.projectSuno.Connect1 (its service file names this unit, so a second daemon
# is never started outside systemd). When Suno Connect's background agent runs
# (Suno-connect-daemon --agent, started by Suno-background), the agent takes the
# name over and this daemon exits.
[Unit]
Description=Suno Connect account and paired-device service
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.projectSuno.Connect1
ExecStart=/usr/bin/Suno-connect-daemon
Restart=on-failure
RestartSec=3
