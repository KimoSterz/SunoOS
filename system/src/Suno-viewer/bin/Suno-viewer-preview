#!/bin/sh
# Run the isolated scratch preview, beside the installed Viewer.
set -eu
viewer_preview_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -f "$viewer_preview_root/python/Suno_viewer/application.py" ]; then
    echo 'Viewer preview has not been staged in its scratch prefix.' >&2
    exit 2
fi
unset SUNO_VIEWER_FIXTURE SUNO_VIEWER_STATE SUNO_VIEWER_SELECTED SUNO_VIEWER_MODE
export SUNO_VIEWER_PREVIEW=1
export SUNO_VIEWER_PREVIEW_STATE_ROOT="$viewer_preview_root/state"
export PYTHONPATH="$viewer_preview_root/python"
export SUNO_APPKIT_ICON_PATH="$viewer_preview_root/python/icons"
export SUNO_VIEWER_STYLE_PATH="$viewer_preview_root/share/Suno-viewer/viewer.css"
export SUNO_VIEWER_ICON_PATH="$viewer_preview_root/share/Suno-viewer/icons"
if [ -d "$viewer_preview_root/native/lib" ] && [ -d "$viewer_preview_root/native/typelib" ]; then
    export LD_LIBRARY_PATH="$viewer_preview_root/native/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export GI_TYPELIB_PATH="$viewer_preview_root/native/typelib${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
fi
exec python3 -m Suno_viewer.application "$@"
