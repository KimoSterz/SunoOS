[Desktop Entry]
Type=Application
Name=Messages
Comment=Gets new messages while Messages is closed
Exec=prairie-messages --agent --autostart
Icon=org.projectSuno.Messages
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-AutoRestart=false
# Before Suno-background is installed. With it, this start exits at once and the
# service starts the agent under its limits.
X-Suno-Background-Agent=org.projectSuno.Messages.Agent
