[Desktop Entry]
Type=Application
Name=Calendar
Comment=Shows event reminders while Calendar is closed
Exec=prairie-calendar --agent --autostart
Icon=org.projectSuno.Calendar
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-AutoRestart=false
# Before Suno-background is installed. With it, this start exits at once and the
# service starts the agent under its limits.
X-Suno-Background-Agent=org.projectSuno.Calendar.Agent
