[Desktop Entry]
Type=Application
Name=Phone
Comment=Rings for calls from your phone while Phone is closed
Exec=prairie-phone --agent --autostart
Icon=org.projectSuno.Phone
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-AutoRestart=false
# Before Suno-background is installed. With it, this start exits at once and the
# service starts the agent under its limits.
X-Suno-Background-Agent=org.projectSuno.Phone.Agent
