[Unit]
Description=Sync to the Suno Hub when Notes, Contacts, Photos, Clocks, Weather, Books or Music servers change

[Path]
# Directories, so SQLite journal and WAL writes count. PathModified, not
# PathChanged: SQLite keeps the WAL open, so a close-after-write never comes.
PathModified=%h/.local/share/evolution/addressbook/system
PathModified=%h/.local/share/Suno/notes
PathModified=%h/.local/share/prairie/weather
PathModified=%h/.local/share/prairie/clock
PathModified=%h/.local/share/leaf
# Tide signals server edits separately from playback and indexing writes.
PathChanged=%h/.local/share/Suno-tide/sources-changed
# The same apps installed as Flatpaks keep their data in their sandbox's data
# directory.
PathModified=%h/.var/app/org.projectSuno.Notes/data/Suno/notes
PathModified=%h/.var/app/org.projectSuno.Weather/data/prairie/weather
PathModified=%h/.var/app/org.projectSuno.Clock/data/prairie/clock
PathModified=%h/.var/app/org.projectSuno.Leaf/data/leaf
PathChanged=%h/.var/app/org.projectSuno.Tide/data/Suno-tide/sources-changed
# The top of the library; photos filed deeper are picked up by the timer.
PathModified=%h/Pictures
Unit=Suno-connect-sync.service

[Install]
WantedBy=default.target
