// Cisco's binary terms ask for an on/off control where the person manages
// it (Settings › Apps). Turning OpenH264 on or off is the person's choice for
// their own computer: the active local session may run exactly
// "Suno-openh264 enable" or "Suno-openh264 disable" without a password.
// Anything else keeps the action's default, administrator authentication.
polkit.addRule(function(action, subject) {
    if (action.id != "org.projectSuno.openh264" || !subject.active || !subject.local) {
        return polkit.Result.NOT_HANDLED;
    }
    var tool = "/usr/bin/Suno-openh264";
    var requests = ["enable", "disable"];
    if (action.lookup("program") == tool) {
        for (var i = 0; i < requests.length; i++) {
            if (action.lookup("command_line") == tool + " " + requests[i]) {
                return polkit.Result.YES;
            }
        }
    }
    return polkit.Result.NOT_HANDLED;
});
