[Unit]
Description=Suno native eSIM profile management
After=dbus.service
# dbus-broker drops ModemManager when it cannot receive its eSIM transport;
# the image policy carries Suno_esim (config/desktop/selinux). Without it the
# broker does not start, so it never takes cellular down.
ConditionPathExists=/etc/selinux/targeted/active/modules/400/Suno_esim

[Service]
Type=dbus
BusName=org.projectSuno.ESim1
ExecStart=/usr/libexec/Suno-esim-service
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_QIPCRTR
LimitCORE=0
UMask=0077
MemoryMax=128M
MemorySwapMax=0
TasksMax=8
TimeoutStopSec=5s
