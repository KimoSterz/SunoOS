diff --git a/chrome/browser/ui/webui/viola/viola_message_handler.cc b/chrome/browser/ui/webui/viola/viola_message_handler.cc
--- a/chrome/browser/ui/webui/viola/viola_message_handler.cc
+++ b/chrome/browser/ui/webui/viola/viola_message_handler.cc
@@ -7917,17 +7917,37 @@
   find_observation_.Reset();
 }
 
+namespace viola {
+base::DictValue NativeFindResult(const std::string& target_id,
+                                 const std::u16string& text,
+                                 const find_in_page::FindNotificationDetails& result) {
+  base::DictValue value;
+  value.Set("targetId", target_id);
+  value.Set("text", base::UTF16ToUTF8(text));
+  value.Set("active", result.active_match_ordinal());
+  value.Set("matches", result.number_of_matches());
+  value.Set("final", result.final_update());
+  const gfx::Rect& rect = result.selection_rect();
+  if (result.active_match_ordinal() > 0 && !rect.IsEmpty()) {
+    base::DictValue box;
+    box.Set("x", rect.x());
+    box.Set("y", rect.y());
+    box.Set("width", rect.width());
+    box.Set("height", rect.height());
+    value.Set("rect", std::move(box));
+  }
+  return value;
+}
+}  // namespace viola
+
 void ViolaMessageHandler::OnFindResultAvailable(content::WebContents* contents) {
   auto* tabs = GetProductTabStrip();
   if (!IsJavascriptAllowed() || !tabs || tabs->GetActiveWebContents() != contents ||
       !find_observation_.IsObserving()) return;
   auto* helper = find_observation_.GetSource();
-  const auto& result = helper->find_result();
-  base::DictValue value;
-  value.Set("targetId", content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId());
-  value.Set("text", base::UTF16ToUTF8(helper->find_text()));
-  value.Set("active", result.active_match_ordinal());
-  value.Set("matches", result.number_of_matches());
+  base::DictValue value = viola::NativeFindResult(
+      content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId(),
+      helper->find_text(), helper->find_result());
   web_ui()->CallJavascriptFunctionUnsafe("__violaHostReceive",
       base::Value("find:result"), base::Value(std::move(value)));
 }
