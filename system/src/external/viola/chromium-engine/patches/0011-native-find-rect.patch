+#if BUILDFLAG(IS_LINUX)
+// find:result tells the native host where the active match is, so it can keep
+// the match clear of its bar; without an active match there is no rect.
+IN_PROC_BROWSER_TEST_F(ViolaUIBrowserTest, NativeFindResultCarriesActiveRect) {
+  const base::DictValue found = viola::NativeFindResult(
+      "target", u"kernel",
+      find_in_page::FindNotificationDetails(7, 3, gfx::Rect(10, 20, 30, 40), 2, true));
+  EXPECT_EQ("kernel", *found.FindString("text"));
+  EXPECT_EQ(2, *found.FindInt("active"));
+  EXPECT_EQ(3, *found.FindInt("matches"));
+  EXPECT_TRUE(*found.FindBool("final"));
+  const base::DictValue* rect = found.FindDict("rect");
+  ASSERT_TRUE(rect);
+  EXPECT_EQ(10, *rect->FindInt("x"));
+  EXPECT_EQ(20, *rect->FindInt("y"));
+  EXPECT_EQ(30, *rect->FindInt("width"));
+  EXPECT_EQ(40, *rect->FindInt("height"));
+  const base::DictValue none = viola::NativeFindResult(
+      "target", u"kernal",
+      find_in_page::FindNotificationDetails(8, 0, gfx::Rect(), 0, true));
+  EXPECT_FALSE(none.FindDict("rect"));
+}
+#endif
