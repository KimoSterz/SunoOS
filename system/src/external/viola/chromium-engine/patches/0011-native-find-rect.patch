 // readiness handshake and a deliberately narrow active-tab history/reload
 // slice only when the WebUI is the gated non-tab product shell. The same shell
 // may observe its own Chromium tab strip and publish read-only render state.
+#if BUILDFLAG(IS_LINUX)
+namespace viola {
+// find:result for the native host: the engine's count and, while there is an
+// active match, its rect in the page view (DIPs), so the host can keep the
+// match clear of what covers the page (its bar, a TV keyboard).
+base::DictValue NativeFindResult(const std::string& target_id,
+                                 const std::u16string& text,
+                                 const find_in_page::FindNotificationDetails& result);
+}  // namespace viola
+#endif
