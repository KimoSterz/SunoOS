+// The overlay's find channels are implemented end to end: the native host
+// sends find:query and find:close through the bridge, and find:result reaches
+// the surface's listeners instead of throwing in __violaHostReceive.
+IN_PROC_BROWSER_TEST_F(ViolaUIBrowserTest, OverlayBridgeCarriesNativeFind) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://viola/overlay.html")));
+  content::WebContents *web_contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(web_contents);
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    (() => {
+      try {
+        vela.send('find:query', {text: 'Suno', targetId: 'none', forward: true});
+        vela.send('find:close');
+        return true;
+      } catch {
+        return false;
+      }
+    })()
+  )")
+                  .ExtractBool());
+  EXPECT_TRUE(content::EvalJs(web_contents, R"(
+    new Promise((resolve) => {
+      const stop = vela.on('find:result', (result) => {
+        stop();
+        resolve(result?.text === 'Suno' && result?.active === 2 &&
+                result?.matches === 4);
+      });
+      __violaHostReceive('find:result',
+                         {targetId: 'none', text: 'Suno', active: 2, matches: 4});
+    })
+  )")
+                  .ExtractBool());
+  EXPECT_TRUE(viola::IsHostChannelAllowed(
+      "overlay.html", viola::HostTransport::kSend, viola::HostChannel::kFindQuery));
+  EXPECT_TRUE(viola::IsHostChannelAllowed(
+      "overlay.html", viola::HostTransport::kReceive, viola::HostChannel::kFindResult));
+  EXPECT_FALSE(viola::IsHostChannelAllowed(
+      "sidebar.html", viola::HostTransport::kSend, viola::HostChannel::kFindQuery));
+}
