#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# luma-application-sound APP: run APP's own PulseAudio server
# (luma-application-sound@.service; luma-application-sound.conf.in).
set -eu
app=${1:-}
case $app in
    ''|.*|*[!A-Za-z0-9._-]*) echo "luma-application-sound: not an application ID: $app" >&2; exit 2 ;;
esac
runtime=${XDG_RUNTIME_DIR:?}
folder=$runtime/luma-sound/$app
mkdir -p -m 0700 "$folder"
template=${LUMA_APPLICATION_SOUND_TEMPLATE:-/usr/share/luma-application-installer/luma-application-sound.conf.in}
sed -e "s|@APP@|$app|g" -e "s|@ADDRESS@|unix:$folder/native|g" "$template" > "$folder/server.conf.new"
mv -f "$folder/server.conf.new" "$folder/server.conf"
# Its pid file beside its socket, not in the session server's pulse folder.
export PULSE_RUNTIME_PATH="$folder"
export PIPEWIRE_REMOTE=pipewire-0-application-pulse
exec /usr/bin/pipewire -c "$folder/server.conf"
