[Unit]
Description=Fairphone 6: mark the running boot slot successful
Documentation=man:qbootctl(8)
ConditionFirmware=device-tree-compatible(fairphone,fp6)
# While a boot image from Suno-device-boot is on trial, Suno-device-boot-confirm
# decides: a kernel that is not the declared one must not mark its slot.
ConditionPathExists=!/var/lib/Suno-device-boot/pending.json
After=multi-user.target Suno-device-boot.service

[Service]
Type=oneshot
ExecStart=/usr/bin/qbootctl -m

[Install]
WantedBy=multi-user.target
