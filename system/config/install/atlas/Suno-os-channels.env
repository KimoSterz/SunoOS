# SPDX-License-Identifier: LGPL-2.1-or-later
# Suno OS delivery contract the installer media follow (ADR-030, sections 4, 5
# and 9). build-installer-iso.sh reads this file; change it here, not in the
# script, when the contract changes.

# The HTTPS remote every installed system updates from, whatever it was
# installed from.
SUNO_OS_REMOTE=Suno
SUNO_OS_URL=https://dl.simplyluma.com/os/repo
# The remote never names that URL itself: its url is
# mirrorlist=file://$SUNO_OS_MIRRORLIST, and this root-only file (0600) holds
# the repository URL (Suno-update's mirror-list layout; enrollment rewrites
# only the file).
SUNO_OS_MIRRORLIST=/etc/Suno/update-mirrorlist
SUNO_OS_COLLECTION_ID=org.projectSuno.OS

# Refs are Suno/1/x86_64/<channel>.
SUNO_OS_REF_PREFIX=Suno/1/x86_64
SUNO_OS_CHANNELS="stable beta nightly"
SUNO_OS_PREVIEW_CHANNELS="beta nightly"
# Preview repositories are https://dl.simplyluma.com/os/preview/<credential>/repo;
# a preview credential, when a staff medium carries one, is recorded in
# Suno-update's enrollment file.
SUNO_OS_PREVIEW_URL_PREFIX=https://dl.simplyluma.com/os/preview
SUNO_OS_PREVIEW_RECORD=/etc/Suno/update-preview-credential

# Install media built for staff default to nightly; public media pass
# --channel stable.
SUNO_OS_DEFAULT_CHANNEL=nightly

# The Suno OS Release public key. The OS release pipeline publishes it at this
# path on the build host; --release-key overrides it.
SUNO_OS_RELEASE_KEY=/etc/pki/ostree/Suno-release.gpg

# Where the installed system keeps that key (the image ships the same path).
SUNO_OS_TARGET_KEY=/etc/pki/ostree/Suno-release.gpg

# The OSTree stateroot of a fresh install.
SUNO_OS_STATEROOT=Suno

# Where a carried payload lives on the install medium.
SUNO_OS_MEDIUM_REPO=Suno/repo
