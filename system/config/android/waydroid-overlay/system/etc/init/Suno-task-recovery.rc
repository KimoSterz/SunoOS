# Project Suno: keep closing an app window working after Android's system
# process restarts. See /system/etc/Suno-task-recovery.sh.
service Suno_task_recovery /system/bin/sh /system/etc/Suno-task-recovery.sh
    class late_start
    user root
    group root
    disabled

on property:sys.boot_completed=1
    setprop persist.Suno.task_recovery 2
    start Suno_task_recovery
