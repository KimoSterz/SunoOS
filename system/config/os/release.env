# SPDX-License-Identifier: CC-BY-4.0
# Suno OS release contract (ADR-030). Every OS build, gate, publication,
# promotion and migration script reads this file; change the contract here,
# never inside a script. Values are plain KEY=value lines so both shell and
# Python can read them without evaluating anything.

SUNO_OS_NAME=Suno
SUNO_OS_ID=Suno
SUNO_OS_PRODUCT_VERSION=1.0.0
SUNO_OS_VERSION_ID=1
SUNO_OS_MAJOR=1

# Release identity (owner decision 2026-09-17, ADR-040). Every name a person
# sees is rendered from these by scripts/os/lib/release_identity.py, together
# with the build's channel and, for a nightly, the day it is labelled for:
#   nightly  Suno (Prairie, Beta 0, Nightly 20260916)
#   beta     Suno (Prairie, Beta 1), Suno (Prairie, Beta 1.1)
#   final    Suno (Version 1, Prairie)
# SUNO_OS_STAGE is beta or final; SUNO_OS_STAGE_NUMBER is the beta number
# (0 until launch; empty for final). Machine versions do not change with it.
SUNO_OS_CODENAME=prairie
SUNO_OS_STAGE=beta
SUNO_OS_STAGE_NUMBER=1.1
SUNO_OS_FEDORA_RELEASE=44
SUNO_OS_ARCH=x86_64

# OSTree delivery (ADR-030 section 5).
SUNO_OS_COLLECTION_ID=org.projectSuno.OS
SUNO_OS_REMOTE=Suno
SUNO_OS_REF_PREFIX=Suno/1/x86_64
SUNO_OS_CHANNELS=nightly beta stable
SUNO_OS_PREVIEW_CHANNELS=
SUNO_OS_PUBLIC_CHANNELS=nightly beta stable
SUNO_OS_STATEROOT=Suno
SUNO_OS_PUBLIC_BASE_URL=https://dl.simplyluma.com/os
SUNO_OS_STABLE_URL=https://dl.simplyluma.com/os/repo
# Legacy preview URLs remain only for migration of previously enrolled devices.
# Every current channel is public (ADR-030 owner amendment and ADR-053).
# The preview repository is served at /os/preview/<credential>/repo by the CDN
# Worker, which checks the credential and maps the request onto the object
# prefix below. The credential never appears in anything this pipeline writes.
SUNO_OS_PREVIEW_URL_TEMPLATE=https://dl.simplyluma.com/os/preview/<credential>/repo
SUNO_OS_PUBLIC_REPO_PREFIX=os/repo
SUNO_OS_PREVIEW_REPO_PREFIX=os/preview-repo
SUNO_OS_GRAPH_PREFIX=os/graph
SUNO_OS_RELEASES_PREFIX=os/releases
SUNO_OS_KEYS_PREFIX=os/keys

# Trust anchors shipped in the image and embedded in the installer.
SUNO_OS_RELEASE_KEY_PATH=/etc/pki/ostree/Suno-release.gpg
SUNO_OS_RELEASE_KEY_FINGERPRINT=7D3DAFCE2BCA13A2B68F2761C8CE1A1B51D96CE2
SUNO_OS_GRAPH_PUBLIC_KEY_PATH=/usr/share/Suno/update/Suno-update-graph.pub
SUNO_OS_GRAPH_KEY_ID=766A0F8FED784B43

# Update graph (ADR-030 section 5). Hub renders it unsigned for the signing job.
SUNO_OS_HUB_GRAPH_URL_TEMPLATE=https://hub.simplyluma.com/api/updates/graph/<channel>?arch=x86_64
# Suno-update refuses a graph generated more than three days ago: the signing
# job dates each graph it signs (generated_at) and signs the graph again every
# SUNO_OS_GRAPH_RESIGN_HOURS even when no release changed.
SUNO_OS_GRAPH_MAX_AGE_DAYS=1
SUNO_OS_GRAPH_RESIGN_HOURS=12
SUNO_OS_MIRRORLIST_PATH=/etc/Suno/update-mirrorlist

# Base image: the official Fedora Silverblue 44 bootable container, pinned by
# the x86_64 manifest digest. The tag is recorded for people; the digest is
# what the build uses. scripts/os/resolve-base-image.sh finds newer ones.
SUNO_OS_BASE_IMAGE_REPOSITORY=quay.io/fedora-ostree-desktops/silverblue
SUNO_OS_BASE_IMAGE_TAG=44.20261005.0-x86_64
SUNO_OS_BASE_IMAGE_DIGEST=sha256:bb3e50173909123e774e357774ecbc444135d5f1761fd52a147fa58e83cf686c

# Static deltas: from the previous head of each channel only. The origin is a
# small server (about 25 GB for everything); installs come from media, and
# consecutive deltas cover updates.
SUNO_OS_DELTA_PREDECESSORS=1
SUNO_OS_EMPTY_DELTA=0
