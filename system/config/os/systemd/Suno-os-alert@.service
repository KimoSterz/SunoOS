# Suno OS pipeline alert for a failed unit (scripts/os/alert.sh). Named in
# OnFailure= of Suno-os-nightly.service and Suno-os-media.service.
# Installed by scripts/os/install-build-host-units.sh, which fills @ROOT@.
[Unit]
Description=Suno OS pipeline alert for %i
RequiresMountsFor=@ROOT@

[Service]
Type=oneshot
Slice=Suno-os.slice
Environment=SUNO_OS_ROOT=@ROOT@
ExecStart=/usr/bin/bash @ROOT@/src/nightly/scripts/os/alert.sh %i
TimeoutStartSec=2min
